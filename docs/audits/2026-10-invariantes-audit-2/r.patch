+
+/// A first chunk that carries the anchor (a client that already knows the hash, from an earlier
+/// download or from its own upload) is served without asking for the log range: the snapshot
+/// at 5 is served although the log retains only from 8. Only the unanchored first chunk checks
+/// the range.
+#[tokio::test]
+async fn audit_r5_anchored_first_chunk_is_served_without_checking_the_range() {
+    let dir = tempdir().unwrap();
+    let relay = open(&dir);
+    let hash = stage(&relay, 5, &envelope(100, 1)).await.unwrap();
+    let anchored = relay
+        .get_chunk(
+            CorrelationId::new(1),
+            &room(),
+            0,
+            0,
+            Some(hash),
+            bounds(8, 20),
+        )
+        .await;
+    assert!(
+        matches!(anchored, Ok(ServerMessage::SnapshotChunk { snapshot_head_seq, .. }) if snapshot_head_seq == seq(5))
+    );
+    assert_room_not_found(
+        relay
+            .get_chunk(CorrelationId::new(1), &room(), 0, 0, None, bounds(8, 20))
+            .await,
+    );
+}
+
+/// Once the snapshot at 5 expires, another one at the same sequence, with other bytes, may be
+/// staged: a download anchored to the first gets `SnapshotSuperseded`, never chunks of the
+/// second, and a new download gets the second whole.
+#[tokio::test(start_paused = true)]
+async fn audit_r5_replacement_at_the_same_seq_supersedes_an_anchored_download() {
+    let dir = tempdir().unwrap();
+    let relay = open(&dir);
+    let first = envelope(200 * 1024, 1);
+    stage(&relay, 5, &first).await.unwrap();
+    let (total, anchor, data) = chunk(&relay, 0, 0, None).await.unwrap();
+    assert_eq!((total, &data[..]), (4, &first[..64 * 1024]));
+
+    tokio::time::sleep(TTL).await;
+    let second = envelope(200 * 1024, 2);
+    stage(&relay, 5, &second).await.unwrap();
+    assert_superseded(chunk(&relay, 1, 0, Some(anchor)).await);
+    let (_, hash, _) = chunk(&relay, 0, 0, None).await.unwrap();
+    assert_eq!(hash, ServerMessage::compute_snapshot_hash(&second));
+    let mut assembled = Vec::new();
+    for index in 0..4 {
+        assembled.extend_from_slice(&chunk(&relay, index, 0, Some(hash)).await.unwrap().2);
+    }
+    assert_eq!(assembled, second);
+}
