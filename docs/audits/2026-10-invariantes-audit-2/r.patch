+/// A room whose disk maintenance pass (the slow tick, every 30 s of paused time) compresses and
+/// prunes every sealed segment, whose `writer` committed 1..=6 (segments 1..=2, 3..=4 and
+/// 5..=6). Nothing is pruned before the first pass.
+async fn audit_room_pruned_by_every_pass() -> (Fixture, mpsc::Sender<RoomCommand>, ClientId) {
+    let fx = Fixture::with_options(
+        RoomLifecycleOverrides {
+            ram_max_ops: Some(2),
+            warm_disk_ttl_secs: Some(0),
+            cold_disk_ttl_secs: Some(0),
+            ..RoomLifecycleOverrides::default()
+        },
+        |_| {},
+        Some(ActorTimings::default()),
+    )
+    .await;
+    let sender = fx.sender().await;
+    let writer = ClientId::new("writer").unwrap();
+    register(&sender, &writer).await;
+    for n in 1..=6u8 {
+        commit(
+            &sender,
+            &writer,
+            mutation(n),
+            seq(u64::from(n) - 1),
+            insert_op(n.into()),
+        )
+        .await
+        .unwrap();
+    }
+    assert_eq!(metrics(&sender).await.tail_seq, seq(1));
+    (fx, sender, writer)
+}
+
+/// An upload reads the range, a TTL pass prunes past it and the actor publishes the floor, and
+/// then the actor stops (here, a commit whose write fails) before the upload installs. If the
+/// room reopens first, its new actor publishes the floor again and the upload is superseded.
+/// If the upload installs first, there is no floor: the floor lives only as long as the actor,
+/// so the relay installs the upload without checking it and confirms a snapshot that the room
+/// does not offer once it reopens.
+#[tokio::test(start_paused = true)]
+async fn audit_r7_upload_installed_after_its_actor_stopped_is_confirmed_below_the_floor() {
+    for reopened in [true, false] {
+        let (fx, sender, writer) = audit_room_pruned_by_every_pass().await;
+        let active_wal = fx.room_dir().join("segments").join("active.wal");
+        let range = async {
+            let bounds = fx.manager.log_bounds(&fx.room_id).await?;
+            assert!(bounds.admits(seq(2)), "{bounds:?}");
+            // While the upload is under way, the slow tick's TTL pass prunes past 2 and the
+            // actor publishes the new floor ...
+            tokio::time::sleep(SLOW_TICK_PERIOD + Duration::from_secs(1)).await;
+            let floor = fx.relay.snapshot_floor(&fx.room_id);
+            assert!(floor.is_some_and(|floor| floor > seq(2)), "{floor:?}");
+            // ... and then the actor stops.
+            fail_point::arm("warm_append_write", &active_wal);
+            let failed = commit(&sender, &writer, mutation(7), seq(6), insert_op(7)).await;
+            assert!(
+                matches!(failed, Err(ServerError::Unavailable(_))),
+                "{failed:?}"
+            );
+            wait_until("the stopped actor's floor is forgotten", || {
+                fx.relay.snapshot_floor(&fx.room_id).is_none()
+            })
+            .await;
+            if reopened {
+                fx.sender().await;
+            }
+            Ok(bounds)
+        };
+        let staged = fx
+            .relay
+            .stage_snapshot(
+                &fx.room_id,
+                &crate::relay::Uploader::Admin,
+                seq(2),
+                snapshot_envelope(),
+                range,
+            )
+            .await;
+
+        let sender = fx.sender().await;
+        let tail = metrics(&sender).await.tail_seq;
+        let offered = heartbeat(&sender, &writer)
+            .await
+            .unwrap()
+            .active_snapshot_seq;
+        assert!(
+            matches!(staged, Err(ServerError::SnapshotSuperseded(_))),
+            "reopened before the install: {reopened}; the relay answered {:?} to the upload \
+             at 2, but the log's tail is {tail} and the room offers {offered:?}",
+            staged.map(|_| "SnapshotStaged")
+        );
+        fx.manager.shutdown_all().await;
+    }
+}
+
