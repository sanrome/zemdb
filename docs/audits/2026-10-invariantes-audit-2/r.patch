+/// A room whose directory is lost while the server keeps running, created again with the same
+/// id: the old room's snapshot is never offered, served or anchored, not even once the new room
+/// reaches its sequence.
+#[tokio::test]
+async fn audit_r6_room_recreated_without_deletion_while_running_never_offers_the_old_snapshot() {
+    let dir = tempdir().unwrap();
+    let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+    let (room_id, schema_id) = (
+        RoomId::new("reborn").unwrap(),
+        SchemaId::new("first").unwrap(),
+    );
+    let writer = zemdb_core::id::ClientId::new("writer").unwrap();
+    let first = manager
+        .create_room(room_id.clone(), schema_id.clone(), None)
+        .await
+        .unwrap();
+    audit_commit(&manager, &room_id, &writer, 3).await;
+    let old = relay
+        .stage_snapshot(
+            &room_id,
+            &crate::relay::Uploader::Admin,
+            SequenceNumber::new(2),
+            snapshot_envelope(),
+            manager.log_bounds(&room_id),
+        )
+        .await
+        .unwrap();
+    let (announced, served) = audit_offered(&manager, &relay, &room_id).await;
+    assert_eq!(announced, Some(SequenceNumber::new(2)));
+    assert_eq!(served.unwrap(), SequenceNumber::new(2));
+
+    // The room's actor stops (for inactivity, say) and its directory disappears.
+    manager.shutdown_room(&room_id).await;
+    fs::remove_dir_all(room_dir(&dir, &room_id)).unwrap();
+    let created = manager
+        .create_room(room_id.clone(), schema_id, None)
+        .await
+        .unwrap();
+    assert_eq!(relay.active_snapshot_seq(&room_id), None);
+    audit_commit(&manager, &room_id, &writer, 3).await;
+    let (announced, served) = audit_offered(&manager, &relay, &room_id).await;
+    assert_eq!(announced, None);
+    assert!(
+        matches!(served, Err(ServerError::RoomNotFound(_))),
+        "{served:?}"
+    );
+    // A download anchored to the old snapshot does not go on either.
+    let anchored = relay
+        .get_chunk(
+            zemdb_core::id::CorrelationId::new(2),
+            &room_id,
+            0,
+            0,
+            Some(old),
+            manager.log_bounds(&room_id),
+        )
+        .await;
+    assert!(
+        matches!(anchored, Err(ServerError::SnapshotSuperseded(_))),
+        "{anchored:?}"
+    );
+    // Nor does it anchor the new room's pruning, which is another room.
+    assert_eq!(relay.upload_in_progress(&room_id), None);
+    assert_ne!(created.room_incarnation, first.room_incarnation);
+    manager.shutdown_all().await;
+}
