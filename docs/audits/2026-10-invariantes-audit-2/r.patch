+/// Registers `client` in the room and commits `count` operations from it.
+async fn audit_commit(
+    manager: &RoomManager,
+    room_id: &RoomId,
+    client: &zemdb_core::id::ClientId,
+    count: u8,
+) {
+    manager
+        .ask(room_id, |reply| RoomCommand::RegisterClient {
+            client_id: client.clone(),
+            current_seq: None,
+            known_incarnation: None,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    for n in 1..=count {
+        let row = zemdb_core::value::RowBuilder::new()
+            .set("id", i64::from(n))
+            .set("title", "task")
+            .build();
+        let op = test_schema()
+            .to_operation_insert("tasks", &row, 1000)
+            .unwrap();
+        manager
+            .ask(room_id, |reply| RoomCommand::Commit {
+                client_id: client.clone(),
+                mutation_id: zemdb_core::id::MutationId::new([n; 16]),
+                last_ack_seq: SequenceNumber::new(u64::from(n) - 1),
+                op,
+                reply,
+            })
+            .await
+            .unwrap()
+            .unwrap();
+    }
+}
+
+/// What the room offers: the snapshot its `Registered` reports to a new client, and what the
+/// first chunk of a download (no anchor) gets.
+async fn audit_offered(
+    manager: &RoomManager,
+    relay: &SnapshotRelay,
+    room_id: &RoomId,
+) -> (Option<SequenceNumber>, Result<SequenceNumber, ServerError>) {
+    let registered = manager
+        .ask(room_id, |reply| RoomCommand::RegisterClient {
+            client_id: zemdb_core::id::ClientId::new("newcomer").unwrap(),
+            current_seq: None,
+            known_incarnation: None,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let first_chunk = relay
+        .get_chunk(
+            zemdb_core::id::CorrelationId::new(1),
+            room_id,
+            0,
+            0,
+            None,
+            manager.log_bounds(room_id),
+        )
+        .await
+        .map(|chunk| match chunk {
+            zemdb_core::protocol::messages::ServerMessage::SnapshotChunk {
+                snapshot_head_seq,
+                ..
+            } => snapshot_head_seq,
+            other => panic!("{other:?}"),
+        });
+    (registered.active_snapshot_seq, first_chunk)
+}
+
+/// A 200 KiB snapshot envelope cut in three upload chunks, with its hash.
+fn audit_three_chunks() -> (Vec<bytes::Bytes>, u64, [u8; 32]) {
+    use zemdb_core::protocol::snapshot_envelope::{
+        SnapshotCompression, SnapshotEnvelopeHeader, SNAPSHOT_HEADER_LEN,
+    };
+    let body = vec![7u8; 200 * 1024 - SNAPSHOT_HEADER_LEN];
+    let header =
+        SnapshotEnvelopeHeader::for_body(SnapshotCompression::Raw, body.len() as u32, &body);
+    let mut data = header.to_bytes().to_vec();
+    data.extend_from_slice(&body);
+    let hash = zemdb_core::protocol::messages::ServerMessage::compute_snapshot_hash(&data);
+    let chunk_len = data.len().div_ceil(3);
+    let chunks = data
+        .chunks(chunk_len)
+        .map(bytes::Bytes::copy_from_slice)
+        .collect();
+    (chunks, data.len() as u64, hash)
+}
