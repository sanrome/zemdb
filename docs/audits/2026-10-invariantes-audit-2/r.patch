+/// Uploads under way when the room is deleted and created again with the same id: the range
+/// they read is the old room's, and the room is recreated (and moves past their sequence) before
+/// they take the relay's lock. None of them is installed in the new room, which offers nothing.
+#[tokio::test]
+async fn audit_r6_upload_under_way_across_a_deletion_and_recreation_is_not_installed() {
+    let (chunks, total_bytes, hash) = audit_three_chunks();
+    for case in [
+        "single request",
+        "one chunk",
+        "last of three chunks",
+        "last chunk sent after the recreation",
+    ] {
+        let dir = tempdir().unwrap();
+        let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+        let (room_id, schema_id) = (
+            RoomId::new("reborn").unwrap(),
+            SchemaId::new("first").unwrap(),
+        );
+        let writer = zemdb_core::id::ClientId::new("writer").unwrap();
+        manager
+            .create_room(room_id.clone(), schema_id.clone(), None)
+            .await
+            .unwrap();
+        audit_commit(&manager, &room_id, &writer, 3).await;
+        let part = |index: usize, total: u32, data: bytes::Bytes, bytes: u64| {
+            crate::relay::SnapshotChunkUpload {
+                room_id: room_id.clone(),
+                uploader: crate::relay::Uploader::Client(writer.clone()),
+                head_seq: SequenceNumber::new(2),
+                chunk_index: index as u32,
+                total_chunks: total,
+                total_bytes: bytes,
+                snapshot_hash: if total == 1 {
+                    zemdb_core::protocol::messages::ServerMessage::compute_snapshot_hash(&data)
+                } else {
+                    hash
+                },
+                data,
+            }
+        };
+        if case.starts_with("last") {
+            for (index, chunk) in chunks.iter().enumerate().take(2) {
+                let staged = relay
+                    .stage_chunk(
+                        part(index, 3, chunk.clone(), total_bytes),
+                        manager.log_bounds(&room_id),
+                    )
+                    .await
+                    .unwrap();
+                assert!(!staged, "{case}");
+            }
+        }
+        // The range is read from the old room; before the upload goes on, the room is deleted,
+        // created again, and its log passes the upload's sequence.
+        let recreate = || async {
+            manager.delete_room(&room_id).await.unwrap();
+            manager
+                .create_room(room_id.clone(), schema_id.clone(), None)
+                .await
+                .unwrap();
+            audit_commit(&manager, &room_id, &writer, 3).await;
+        };
+        let old_range = async {
+            let bounds = manager.log_bounds(&room_id).await;
+            recreate().await;
+            bounds
+        };
+        let outcome = match case {
+            "single request" => relay
+                .stage_snapshot(
+                    &room_id,
+                    &crate::relay::Uploader::Client(writer.clone()),
+                    SequenceNumber::new(2),
+                    snapshot_envelope(),
+                    old_range,
+                )
+                .await
+                .map(|_| true),
+            "one chunk" => {
+                let data = snapshot_envelope();
+                let bytes = data.len() as u64;
+                relay.stage_chunk(part(0, 1, data, bytes), old_range).await
+            }
+            "last of three chunks" => {
+                relay
+                    .stage_chunk(part(2, 3, chunks[2].clone(), total_bytes), old_range)
+                    .await
+            }
+            _ => {
+                recreate().await;
+                relay
+                    .stage_chunk(
+                        part(2, 3, chunks[2].clone(), total_bytes),
+                        manager.log_bounds(&room_id),
+                    )
+                    .await
+            }
+        };
+        if case == "last chunk sent after the recreation" {
+            // The new room has no upload under way: the chunk starts one.
+            assert!(matches!(outcome, Ok(false)), "{case}: {outcome:?}");
+        } else {
+            assert!(
+                matches!(outcome, Err(ServerError::RoomNotFound(_))),
+                "{case}: {outcome:?}"
+            );
+        }
+        assert_eq!(relay.active_snapshot_seq(&room_id), None, "{case}");
+        let (announced, served) = audit_offered(&manager, &relay, &room_id).await;
+        assert_eq!(announced, None, "{case}");
+        assert!(
+            matches!(served, Err(ServerError::RoomNotFound(_))),
+            "{case}: {served:?}"
+        );
+        manager.shutdown_all().await;
+    }
+}
