+//! The snapshot handlers against a room whose log moves on while a request is under way.
+
+use super::*;
+use crate::actor::room::{room_dir, ActorTimings};
+use crate::actor::RoomCommand;
+use crate::config::ServerConfig;
+use crate::fail_point;
+use crate::log::RoomLifecycleOverrides;
+use crate::relay::{SnapshotRelay, Uploader};
+use crate::schema_registry::SchemaRegistry;
+use crate::RoomManager;
+use std::path::{Path, PathBuf};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::Duration;
+use tempfile::{tempdir, TempDir};
+use zemdb_core::id::{ClientId, CorrelationId, MutationId, SchemaId};
+use zemdb_core::protocol::codec::decode_message;
+use zemdb_core::protocol::messages::ErrorCode;
+use zemdb_core::protocol::snapshot_envelope::{SnapshotCompression, SnapshotEnvelopeHeader};
+use zemdb_core::schema::{Schema, TableSchema};
+use zemdb_core::value::{DataType, RowBuilder};
+
+/// Longest a test waits for a pause point or a condition.
+const CEILING: Duration = Duration::from_secs(20);
+
+fn schema() -> Schema {
+    let tasks = TableSchema::builder("tasks")
+        .primary_key("id", DataType::Int)
+        .nullable_column("title", DataType::String);
+    Schema::builder().table(tasks).build()
+}
+
+fn seq(n: u64) -> SequenceNumber {
+    SequenceNumber::new(n)
+}
+
+fn envelope() -> bytes::Bytes {
+    let body = b"snapshot";
+    let header = SnapshotEnvelopeHeader::for_body(SnapshotCompression::Raw, 8, body);
+    let mut out = header.to_bytes().to_vec();
+    out.extend_from_slice(body);
+    bytes::Bytes::from(out)
+}
+
+/// A room with two operations per segment and maintenance ticks every 100 ms, served by the
+/// handlers of `state`, whose `writer` committed 1..=6 (segments 1..=2, 3..=4 and 5..=6).
+struct Room {
+    _dir: TempDir,
+    state: AppState,
+    manager: Arc<RoomManager>,
+    relay: Arc<SnapshotRelay>,
+    room_id: RoomId,
+    room_dir: PathBuf,
+    writer: ClientId,
+}
+
+impl Room {
+    async fn new(overrides: RoomLifecycleOverrides) -> Self {
+        let dir = tempdir().unwrap();
+        let config = Arc::new(ServerConfig {
+            data_dir: dir.path().to_path_buf(),
+            idle_timeout_secs: 0,
+            ..ServerConfig::default()
+        });
+        let registry = Arc::new(SchemaRegistry::new(dir.path().join("schemas")).unwrap());
+        let schema_id = SchemaId::new("tasks").unwrap();
+        registry
+            .register_schema(schema_id.clone(), schema())
+            .unwrap();
+        let relay = Arc::new(
+            SnapshotRelay::new(
+                dir.path().join("snapshots"),
+                Duration::from_secs(600),
+                config.max_snapshot_bytes,
+                Duration::from_secs(config.snapshot_upload_max_secs),
+            )
+            .unwrap(),
+        );
+        let mut manager = RoomManager::new(
+            Arc::clone(&config),
+            Arc::clone(&registry),
+            Arc::clone(&relay),
+        );
+        manager.set_timings(ActorTimings {
+            fast_tick: Duration::from_millis(50),
+            slow_tick: Duration::from_millis(100),
+            ..ActorTimings::default()
+        });
+        let manager = Arc::new(manager);
+        let state = AppState::new(config, registry, Arc::clone(&manager), Arc::clone(&relay));
+        let room_id = RoomId::new("room").unwrap();
+        manager
+            .create_room(
+                room_id.clone(),
+                schema_id,
+                Some(RoomLifecycleOverrides {
+                    ram_max_ops: Some(2),
+                    ..overrides
+                }),
+            )
+            .await
+            .unwrap();
+        let room = Self {
+            room_dir: room_dir(dir.path(), &room_id),
+            _dir: dir,
+            state,
+            manager,
+            relay,
+            room_id,
+            writer: ClientId::new("writer").unwrap(),
+        };
+        room.manager
+            .ask(&room.room_id, |reply| RoomCommand::RegisterClient {
+                client_id: room.writer.clone(),
+                current_seq: None,
+                known_incarnation: None,
+                reply,
+            })
+            .await
+            .unwrap()
+            .unwrap();
+        for n in 1..=6 {
+            room.commit(n).await;
+        }
+        room
+    }
+
+    async fn commit(&self, n: u8) {
+        let row = RowBuilder::new().set("id", i64::from(n)).build();
+        let op = schema().to_operation_insert("tasks", &row, 1000).unwrap();
+        self.manager
+            .ask(&self.room_id, |reply| RoomCommand::Commit {
+                client_id: self.writer.clone(),
+                mutation_id: MutationId::new([n; 16]),
+                last_ack_seq: seq(u64::from(n) - 1),
+                op,
+                reply,
+            })
+            .await
+            .unwrap()
+            .unwrap();
+    }
+
+    /// The snapshot the writer's heartbeat reports, as `Registered` and `HeartbeatAck` offer it.
+    async fn offered_snapshot(&self) -> Option<SequenceNumber> {
+        self.manager
+            .ask(&self.room_id, |reply| RoomCommand::Heartbeat {
+                client_id: self.writer.clone(),
+                reply,
+            })
+            .await
+            .unwrap()
+            .unwrap()
+            .active_snapshot_seq
+    }
+
+    /// Whether segment 1..=2 is gone from disk, warm and cold.
+    fn first_segment_pruned(&self) -> impl Fn() -> bool + Send + Sync + 'static {
+        let segments = self.room_dir.join("segments");
+        move || {
+            let name = "segment_0000000000000001_0000000000000002";
+            !segments.join(format!("{name}.wal")).exists()
+                && !segments.join(format!("{name}.wal.zst")).exists()
+        }
+    }
+}
+
+/// The first chunk of a download (no anchor) asked through the handler by a newcomer.
+async fn first_chunk(state: AppState, room_id: RoomId) -> ServerMessage {
+    let msg = ClientMessage::RequestSnapshotChunk {
+        correlation_id: CorrelationId::new(1),
+        room_id: room_id.clone(),
+        chunk_index: 0,
+        chunk_size: 0,
+        snapshot_hash: None,
+    };
+    let auth = RelayAuth {
+        room_id,
+        uploader: Uploader::Client(ClientId::new("newcomer").unwrap()),
+    };
+    let response = request_chunk(State(state), auth, BinaryMessage(msg)).await;
+    let body = axum::body::to_bytes(response.into_body(), usize::MAX)
+        .await
+        .unwrap();
+    decode_message(&body).unwrap()
+}
+
+/// What a reply to the first chunk offered: the snapshot's sequence, or the error.
+fn offered(reply: &ServerMessage) -> String {
+    match reply {
+        ServerMessage::SnapshotChunk {
+            snapshot_head_seq, ..
+        } => format!("the snapshot at {snapshot_head_seq}"),
+        other => format!("{other:?}"),
+    }
+}
+
+/// A thread stopped at a hook point until the test lets it go on.
+struct Pause {
+    reached: mpsc::Receiver<()>,
+    resume: mpsc::Sender<()>,
+}
+
+type Ready = Arc<dyn Fn() -> bool + Send + Sync>;
+
+impl Pause {
+    /// Stops the first thread that reaches the hook point `name` for `path` once `ready` holds;
+    /// until then, every thread that reaches it goes on.
+    fn at(
+        name: &'static str,
+        path: &Path,
+        ready: impl Fn() -> bool + Send + Sync + 'static,
+    ) -> Self {
+        let (reached_tx, reached) = mpsc::channel();
+        let (resume, resume_rx) = mpsc::channel();
+        arm(
+            name,
+            path.to_path_buf(),
+            Arc::new(ready),
+            reached_tx,
+            Arc::new(Mutex::new(resume_rx)),
+        );
+        Self { reached, resume }
+    }
+
+    async fn reached(&self, what: &str) {
+        let deadline = tokio::time::Instant::now() + CEILING;
+        while self.reached.try_recv().is_err() {
+            assert!(
+                tokio::time::Instant::now() < deadline,
+                "never reached: {what}"
+            );
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    }
+
+    fn resume(&self) {
+        self.resume.send(()).unwrap();
+    }
+}
+
+fn arm(
+    name: &'static str,
+    path: PathBuf,
+    ready: Ready,
+    reached: mpsc::Sender<()>,
+    resume: Arc<Mutex<mpsc::Receiver<()>>>,
+) {
+    let again = path.clone();
+    fail_point::arm_hook(name, &path, move || {
+        if !ready() {
+            arm(name, again, ready, reached, resume);
+            return;
+        }
+        let _ = reached.send(());
+        // The thread is a runtime worker: its other tasks move to another worker meanwhile.
+        let _ = tokio::task::block_in_place(|| resume.lock().unwrap().recv_timeout(CEILING));
+    });
+}
+
+/// The first chunk of a download checks the snapshot it serves against the log range read
+/// before it picks the snapshot. An upload confirmed in the window that INV-R7 accepts (after a
+/// TTL pass deleted the segments, before the actor published the new floor) lands in between:
+/// the first chunk serves it, although the log no longer retains what follows it. The same
+/// request, with the range read after the snapshot is picked, finds it unusable and drops it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn audit_r5_first_chunk_serves_a_snapshot_installed_after_it_read_the_range() {
+    // Sealed segments are compressed and pruned 2 s after they are sealed.
+    let room = Room::new(RoomLifecycleOverrides {
+        warm_disk_ttl_secs: Some(2),
+        cold_disk_ttl_secs: Some(0),
+        ..RoomLifecycleOverrides::default()
+    })
+    .await;
+
+    // An upload at 2 reads the range now, while the log retains 1..=6.
+    let (range_tx, range_rx) = tokio::sync::oneshot::channel();
+    let (go_tx, go_rx) = tokio::sync::oneshot::channel::<()>();
+    let upload = tokio::spawn({
+        let (relay, manager, room_id) = (
+            Arc::clone(&room.relay),
+            Arc::clone(&room.manager),
+            room.room_id.clone(),
+        );
+        async move {
+            let range = async {
+                let bounds = manager.log_bounds(&room_id).await;
+                let _ = range_tx.send(bounds.as_ref().ok().copied());
+                let _ = go_rx.await;
+                bounds
+            };
+            relay
+                .stage_snapshot(&room_id, &Uploader::Admin, seq(2), envelope(), range)
+                .await
+        }
+    });
+    let range = range_rx.await.unwrap().unwrap();
+    assert!(range.admits(seq(2)), "{range:?}");
+
+    // A newcomer asks for the first chunk; its handler reads the range, while the log still
+    // retains 1..=6, and stops there.
+    let first_chunk_paused = Pause::at("first_chunk_range_read", &room.room_dir, || true);
+    let download = tokio::spawn(first_chunk(room.state.clone(), room.room_id.clone()));
+    first_chunk_paused
+        .reached("the first chunk read the range")
+        .await;
+
+    // A TTL pass prunes the log past 2; the actor stops before publishing the new floor.
+    let pass_paused = Pause::at(
+        "room_disk_maintenance_before_floor",
+        &room.room_dir,
+        room.first_segment_pruned(),
+    );
+    pass_paused.reached("a TTL pass pruned segment 1..=2").await;
+    // The upload completes in that window and is confirmed (INV-R7's accepted limit).
+    go_tx.send(()).unwrap();
+    let staged = upload.await.unwrap();
+    assert!(staged.is_ok(), "{staged:?}");
+    pass_paused.resume();
+
+    // INV-R7's limit relies on INV-R5: the snapshot is neither announced nor served.
+    let bounds = room.manager.log_bounds(&room.room_id).await.unwrap();
+    assert!(!bounds.admits(seq(2)), "{bounds:?}");
+    assert_eq!(room.offered_snapshot().await, None);
+    first_chunk_paused.resume();
+    let reply = download.await.unwrap();
+    room.manager.shutdown_all().await;
+    assert!(
+        matches!(
+            reply,
+            ServerMessage::Error {
+                code: ErrorCode::RoomNotFound,
+                ..
+            }
+        ),
+        "the first chunk offered {} while the room's log has tail {} and head {}",
+        offered(&reply),
+        bounds.tail_seq,
+        bounds.head_seq
+    );
+}
+
+/// A snapshot that becomes active while the first chunk waits between reading the log range and
+/// picking the snapshot is checked against that older range: one above its head is taken for
+/// one the log cannot continue from, and dropped, although it is the usable snapshot of the
+/// room.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn audit_r5_first_chunk_drops_a_newer_usable_snapshot_against_the_range_it_read_before() {
+    let room = Room::new(RoomLifecycleOverrides::default()).await;
+
+    let first_chunk_paused = Pause::at("first_chunk_range_read", &room.room_dir, || true);
+    let download = tokio::spawn(first_chunk(room.state.clone(), room.room_id.clone()));
+    first_chunk_paused
+        .reached("the first chunk read the range")
+        .await;
+
+    // Meanwhile the room moves on to 7 and a snapshot at 7 is staged against that range.
+    room.commit(7).await;
+    let manager = Arc::clone(&room.manager);
+    room.relay
+        .stage_snapshot(
+            &room.room_id,
+            &Uploader::Admin,
+            seq(7),
+            envelope(),
+            manager.log_bounds(&room.room_id),
+        )
+        .await
+        .unwrap();
+    assert_eq!(room.offered_snapshot().await, Some(seq(7)));
+
+    first_chunk_paused.resume();
+    let reply = download.await.unwrap();
+    room.manager.shutdown_all().await;
+    assert!(
+        matches!(&reply, ServerMessage::SnapshotChunk { snapshot_head_seq, .. } if *snapshot_head_seq == seq(7)),
+        "the first chunk answered {} and the relay kept {:?}, with the usable snapshot at 7",
+        offered(&reply),
+        room.relay.active_snapshot_seq(&room.room_id)
+    );
+}
