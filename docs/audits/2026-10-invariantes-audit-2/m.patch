+        (schema.version(), schema.table_ids().collect::<Vec<_>>()),
+        (3, vec![4])
+    );
+    for (case, json) in cases {
+        durable::write_checked(&dir.path().join("todo.json"), json.as_bytes()).unwrap();
+        let opened = SchemaRegistry::new(dir.path());
+        assert!(
+            matches!(opened, Err(ServerError::Serialization(_))),
+            "a verified schema file with {case} loaded: {:?}",
