+/// A snapshot taken under a schema version, holding rows written before a column existed
+/// (two values, and a row cut short after its last non-null value), is applied by a replica
+/// that already has a later version, in both engines; the replica then keeps applying the log
+/// written under the older version, and the new column reads as null.
+async fn audit_old_snapshot_applies_under_a_later_version<E: StorageEngine>(
+    source: &MemoryStorageEngine,
+    replica: &E,
+) {
+    let room_id = RoomId::new("evolving-room").unwrap();
+    let rows = [
+        CompactRow::new(vec![
+            Value::Int(1),
+            Value::String("a".into()),
+            Value::Int(5),
+        ]),
+        CompactRow::new(vec![Value::Int(2), Value::String("b".into())]),
+    ];
+    source.open_room(&room_id, sample_schema()).await.unwrap();
+    let ops = vec![
+        insert_item(1, 1, rows[0].clone(), 10),
+        insert_item(2, 2, rows[1].clone(), 20),
+    ];
+    source.apply_batch(&room_id, ops).await.unwrap();
+    let snapshot = source.create_snapshot(&room_id).await.unwrap();
+
+    replica
+        .open_room(&room_id, audit_evolved_schema())
+        .await
+        .unwrap();
+    let head = replica
+        .apply_snapshot(
+            &room_id,
+            audit_evolved_schema(),
+            snapshot.into(),
+            2u64.into(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(head, SequenceNumber::from(2u64));
+    let later = vec![
+        insert_item(
+            3,
+            3,
+            CompactRow::new(vec![Value::Int(3), Value::String("c".into())]),
+            30,
+        ),
+        sequenced(
+            4,
+            Operation::update(
+                1,
+                PrimaryKey::single(2i64),
+                vec![ColumnUpdate::new(2, Value::Int(7))],
+                40,
+            ),
+        ),
+    ];
+    replica.apply_batch(&room_id, later).await.unwrap();
+    let row = replica
+        .get_by_id(&room_id, 1, &PrimaryKey::single(2i64))
+        .await
+        .unwrap()
+        .expect("row 2 is in the snapshot");
+    assert_eq!(row.get(1), Some(&Value::String("b".into())));
+    assert_eq!(row.get(2), Some(&Value::Int(7)));
+    assert!(matches!(row.get(3), None | Some(Value::Null)));
+}
