+/// Every single bit flip and every truncation of a schema file (two tables, a composite key,
+/// an encrypted column and a column added later) fails the startup: no damaged schema is ever
+/// loaded, whatever it would have renumbered or retyped.
+#[test]
+fn audit_e1_every_damage_to_a_schema_file_fails_the_startup() {
+    let (dir, id, registry) = todo_registry();
+    registry
+        .add_column(&id, "tasks", nullable_int("priority"))
+        .unwrap();
+    let table = TableSchema::builder("tags")
+        .table_id(7)
+        .primary_key("task", DataType::Int)
+        .primary_key("tag", DataType::String)
+        .encrypted_column("note", DataType::Bytes);
+    registry
+        .register_schema(
+            SchemaId::new("other").unwrap(),
+            Schema::builder().table(table).build(),
+        )
+        .unwrap();
+    drop(registry);
+    let original = fs::read(todo_path(&dir)).unwrap();
+
+    let mut damages: Vec<(String, Vec<u8>)> = (0..original.len())
+        .map(|len| (format!("truncated to {len}"), original[..len].to_vec()))
+        .collect();
+    for bit in 0..original.len() * 8 {
+        let mut damaged = original.clone();
+        damaged[bit / 8] ^= 1 << (bit % 8);
+        damages.push((format!("bit {bit} flipped"), damaged));
+    }
+    for (damage, bytes) in damages {
+        fs::write(todo_path(&dir), &bytes).unwrap();
+        let opened = SchemaRegistry::new(dir.path());
+        assert!(
+            matches!(opened, Err(ServerError::Serialization(_))),
+            "a schema file {damage} gave {:?}: {:?}",
+            opened.map(|r| r.get_schema(&id)),
+            String::from_utf8_lossy(&bytes)
+        );
+    }
+    fs::write(todo_path(&dir), &original).unwrap();
+    let reopened = SchemaRegistry::new(dir.path()).unwrap();
+    assert_eq!(reopened.get_schema(&id).unwrap().version(), 2);
+}
