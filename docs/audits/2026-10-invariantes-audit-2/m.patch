+/// A damaged directory entry: one bit of a warm segment's name flipped ('0' to '8' in the
+/// first digit of its end) makes the quota count a sidecar of 8 * 10^15 entries. The next
+/// maintenance pass prunes it, records that end as the pruning point in `log_meta.json`, with
+/// its checksum, and the next open deletes every segment of the log and jumps `head_seq`.
+#[test]
+fn audit_w2_damaged_segment_name_makes_maintenance_delete_the_whole_log() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    append_range(&mut log, 1, 20);
+    drop(log);
+    let segments = segments_dir(dir.path());
+    let end = 8_000_000_000_000_010;
+    let (original, damaged) = (
+        segment_file(&segments, 6, 10, "wal"),
+        segment_file(&segments, 6, end, "wal"),
+    );
+    let (a, b) = (
+        original.file_name().unwrap().as_encoded_bytes(),
+        damaged.file_name().unwrap().as_encoded_bytes(),
+    );
+    let flipped: u32 = a.iter().zip(b).map(|(x, y)| (x ^ y).count_ones()).sum();
+    assert_eq!(flipped, 1, "the two names differ in one bit");
+    std::fs::rename(&original, &damaged).unwrap();
+
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    assert_eq!(log.head_seq().get(), 20);
+    let disk_bytes = log.disk_bytes();
+    let _ = log.run_maintenance_sync();
+    drop(log);
+
+    let (log, _) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    let left = audit_segment_files(&segments);
+    assert!(
+        left.iter()
+            .any(|name| name.starts_with("segment_0000000000000016_0000000000000020")),
+        "one maintenance pass (the log counted {disk_bytes} bytes against a quota of 500 MB) \
+         and a reopen deleted segments 11..=15 and 16..=20, which no prune reached: files \
+         left {left:?}, tail {} and head {} (was 20)",
+        log.tail_seq().get(),
+        log.head_seq().get()
+    );
+}
