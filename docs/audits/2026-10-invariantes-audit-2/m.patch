+/// A log that sealed 1..=20 in segments of five, holds 21..=22 in `active.wal` and pruned
+/// everything below 11, so that both fields of `log_meta.json` are set (10 and 20).
+fn audit_pruned_log(dir: &Path) -> RoomLifecyclePolicy {
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir, policy.clone()).unwrap();
+    append_range(&mut log, 1, 22);
+    log.prune_older_than(SequenceNumber::new(11)).unwrap();
+    policy
+}
