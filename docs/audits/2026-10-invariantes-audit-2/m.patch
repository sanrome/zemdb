+        )
+    };
+    let cases = [
+        (
+            "a repeated table id",
+            format!(
+                r#"{{"version":1,"tables":[{},{}]}}"#,
+                table(r#""table_id":0,"#, "a"),
+                table(r#""table_id":0,"#, "b")
+            ),
+        ),
+        (
+            "a repeated table name",
+            format!(
+                r#"{{"version":1,"tables":[{},{}]}}"#,
+                table(r#""table_id":0,"#, "a"),
+                table(r#""table_id":1,"#, "a")
+            ),
+        ),
+        (
+            "a table without an id",
+            format!(r#"{{"version":1,"tables":[{}]}}"#, table("", "a")),
+        ),
+        (
+            "an unknown field in the schema",
+            format!(
+                r#"{{"version":1,"tables":[{}],"extra":1}}"#,
+                table(r#""table_id":0,"#, "a")
+            ),
+        ),
+        (
+            "an unknown field in a table",
+            format!(
+                r#"{{"version":1,"tables":[{}]}}"#,
+                table(r#""table_id":0,"extra":1,"#, "a")
+            ),
+        ),
+        (
+            "version 0",
+            format!(
+                r#"{{"version":0,"tables":[{}]}}"#,
+                table(r#""table_id":0,"#, "a")
+            ),
+        ),
+        (
+            "a repeated column",
+            r#"{"version":1,"tables":[{"table_id":0,"name":"a","primary_key":["id"],"columns":[{"name":"id","data_type":"Int","nullable":false,"encrypted":false},{"name":"id","data_type":"String","nullable":true,"encrypted":false}]}]}"#.to_string(),
+        ),
+        (
+            "a column without its nullable flag",
+            r#"{"version":1,"tables":[{"table_id":0,"name":"a","primary_key":["id"],"columns":[{"name":"id","data_type":"Int","encrypted":false}]}]}"#.to_string(),
+        ),
