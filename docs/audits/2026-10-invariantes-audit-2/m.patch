+/// A damaged directory entry: one bit of a staged snapshot's name flipped in the room id
+/// ("room-a" to "room-c", 'a' to 'c') hands room-a's snapshot to room-c. The BLAKE3 hash in the
+/// name covers the file, not the room id or the sequence next to it, so recovery accepts it.
+#[tokio::test]
+async fn audit_w2_damaged_snapshot_name_hands_the_snapshot_to_another_room() {
+    let dir = tempdir().unwrap();
+    let (room_a, room_c) = (
+        RoomId::new("room-a").unwrap(),
+        RoomId::new("room-c").unwrap(),
+    );
+    fs::create_dir_all(snapshots_dir(&dir)).unwrap();
+    let staged = write_snapshot_file(&dir, &room_a, 5, &envelope(100, 7));
+    let hash = ServerMessage::compute_snapshot_hash(&envelope(100, 7));
+    let damaged = snapshots_dir(&dir).join(snapshot_file_name(&room_c, seq(5), &hash));
+    let flipped: u32 = name_of(&staged)
+        .bytes()
+        .zip(name_of(&damaged).bytes())
+        .map(|(x, y)| (x ^ y).count_ones())
+        .sum();
+    assert_eq!(flipped, 1, "the two names differ in one bit");
+    fs::rename(&staged, &damaged).unwrap();
+
+    let relay = open(&dir);
+    assert_eq!(
+        relay.active_snapshot_seq(&room_c),
+        None,
+        "after a restart the relay offers room-a's snapshot (seq 5) as room-c's"
+    );
+}
