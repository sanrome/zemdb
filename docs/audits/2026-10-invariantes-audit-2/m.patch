+    let meta_path = meta_room_path(&dir, &room_id);
+    let manager = new_manager(&dir);
+    let lifecycle = RoomLifecycleOverrides {
+        max_room_disk_bytes: Some(64 * 1024 * 1024),
+        idle_timeout_secs: Some(60),
