+async fn audit_e1_old_snapshot_applies_under_a_later_version_in_memory() {
+    audit_old_snapshot_applies_under_a_later_version(
+        &MemoryStorageEngine::new(),
+        &MemoryStorageEngine::new(),
+    )
+    .await;
+}
