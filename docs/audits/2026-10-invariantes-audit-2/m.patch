+    assert!(read_room_metadata(&meta_path).is_ok());
+
+    let mut damages: Vec<(String, Vec<u8>)> = (0..stored.len())
+        .map(|len| (format!("truncated to {len}"), stored[..len].to_vec()))
+        .collect();
