+/// A damaged directory entry: one bit of a retained segment's name flipped ("..._0015.wal" to
+/// "..._0005.wal") gives it an end below its start, and a prune by cursors at 11 (every client
+/// has 10) deletes it, although the clients still need operations 11 to 15. (With the end
+/// flipped to 0 instead, the open itself deletes it: 0 is at or below the pruning point of a
+/// log that never pruned.)
+#[test]
+fn audit_w2_damaged_segment_name_lets_a_cursor_prune_delete_a_needed_segment() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    append_range(&mut log, 1, 17);
+    drop(log);
+    let segments = segments_dir(dir.path());
+    std::fs::rename(
+        segment_file(&segments, 11, 15, "wal"),
+        segment_file(&segments, 11, 5, "wal"),
