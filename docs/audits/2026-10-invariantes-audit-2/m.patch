+                verified_json(&bytes[..len]),
+                None,
+                "a file truncated to {len} of {} bytes verified",
+                bytes.len()
+            );
+        }
+        for bit in 0..bytes.len() * 8 {
+            let mut damaged = bytes.clone();
+            damaged[bit / 8] ^= 1 << (bit % 8);
+            assert_eq!(
+                verified_json(&damaged),
+                None,
+                "flipping bit {bit} gave a file that verifies: {:?}",
+                String::from_utf8_lossy(&damaged)
+            );
+        }
+    }
+}
