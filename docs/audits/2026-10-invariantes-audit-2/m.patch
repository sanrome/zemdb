+/// Concurrent column additions to one schema, watched by a reader: every published version
+/// has exactly one more column than the previous one, no version is published with two
+/// different contents, and each one extends the one before it (nothing lost, renumbered or
+/// retyped). The file left on disk is the last version.
+#[test]
+fn audit_e1_concurrent_add_columns_publish_one_growing_version_per_column() {
+    const WRITERS: usize = 6;
+    const PER_WRITER: usize = 5;
+    let (dir, id, registry) = todo_registry();
+    let done = std::sync::atomic::AtomicBool::new(false);
+    let mut seen: std::collections::BTreeMap<u64, Arc<Schema>> = Default::default();
+
+    std::thread::scope(|scope| {
+        for w in 0..WRITERS {
+            let (registry, id) = (&registry, &id);
+            scope.spawn(move || {
+                for k in 0..PER_WRITER {
+                    registry
+                        .add_column(id, "tasks", nullable_int(format!("w{w}_{k}")))
+                        .unwrap();
+                }
+            });
+        }
+        let reader = scope.spawn(|| {
+            let mut seen: Vec<Arc<Schema>> = Vec::new();
+            while !done.load(std::sync::atomic::Ordering::Acquire) {
+                seen.push(registry.get_schema(&id).unwrap());
+            }
+            seen
+        });
+        // The writers are joined when the scope ends; stop the reader once they are done.
+        while registry.get_schema(&id).unwrap().version() < (1 + WRITERS * PER_WRITER) as u64 {
+            std::thread::yield_now();
+        }
+        done.store(true, std::sync::atomic::Ordering::Release);
+        for schema in reader.join().unwrap() {
+            if let Some(previous) = seen.insert(schema.version(), Arc::clone(&schema)) {
+                assert_eq!(
+                    *previous,
+                    *schema,
+                    "version {} published twice",
+                    schema.version()
+                );
+            }
+        }
+    });
+
+    let last = registry.get_schema(&id).unwrap();
+    seen.insert(last.version(), Arc::clone(&last));
+    seen.insert(1, Arc::new(test_schema()));
+    let columns = |schema: &Schema| {
+        schema
+            .get_table_by_name("tasks")
+            .unwrap()
+            .columns()
+            .to_vec()
+    };
+    let mut previous: Option<(u64, Vec<ColumnDef>)> = None;
+    for (version, schema) in &seen {
+        let cols = columns(schema);
+        assert_eq!(
+            cols.len() as u64,
+            1 + *version,
+            "version {version}: {cols:?}"
+        );
+        if let Some((prev_version, prev_cols)) = &previous {
+            assert!(prev_version < version);
+            assert_eq!(
+                &cols[..prev_cols.len()],
+                &prev_cols[..],
+                "version {version} rewrote a column"
+            );
+        }
+        previous = Some((*version, cols));
+    }
+    assert_eq!(last.version(), (1 + WRITERS * PER_WRITER) as u64);
+    let reopened = SchemaRegistry::new(dir.path()).unwrap();
+    assert_eq!(*reopened.get_schema(&id).unwrap(), *last);
+}
