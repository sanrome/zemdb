+/// Audit (D9, the scenario of the previous audit, ported): a `log_meta.json` damaged in a way
+/// that keeps it valid JSON ("10" -> "18" in the pruning point) makes the open fail without
+/// deleting the retained segment 11..=15, instead of deleting it.
+#[test]
+fn audit_d9_damaged_log_meta_never_deletes_retained_segments() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    append_range(&mut log, 1, 22);
+    log.prune_older_than(SequenceNumber::new(11)).unwrap();
+    assert_eq!(log.tail_seq().get(), 11);
+    drop(log);
+    let meta = dir.path().join("log_meta.json");
+    let text = std::fs::read_to_string(&meta).unwrap();
+    assert!(text.contains("\"pruned_through_seq\":10,"), "{text}");
+    std::fs::write(
+        &meta,
+        text.replace("\"pruned_through_seq\":10,", "\"pruned_through_seq\":18,"),
+    )
+    .unwrap();
+
+    let kept = segment_file(&segments_dir(dir.path()), 11, 15, "wal");
+    let opened = TieredLog::open_or_create(dir.path(), policy);
+    assert!(
+        kept.exists(),
+        "the open deleted the retained segment 11..=15"
+    );
+    match opened {
+        Err(ServerError::WalCorruption(_)) => {}
+        Ok((log, _)) => panic!("opened with tail {}", log.tail_seq().get()),
+        Err(other) => panic!("{other}"),
+    }
+}
