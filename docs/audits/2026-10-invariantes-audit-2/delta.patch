+/// Audit (B2, D74 b): the total deadline bounds an upload only while its session lives. When
+/// it passes, the next chunk of the same uploader (here chunk 0, which it had already sent)
+/// finds the upload expired and starts a new one, with a deadline of its own. An uploader that
+/// restarts its upload with another snapshot every 119 s (which keeps the deadline) and sends a
+/// chunk right at each deadline has an upload in progress for as long as it likes, except at
+/// the instants of the deadlines. While it does, the upload anchors the room's pruning, and the
+/// designee's keeps the designation (D76).
+#[tokio::test(start_paused = true)]
+async fn audit_b2_an_upload_restarted_at_each_deadline_is_never_bounded() {
+    let dir = tempdir().unwrap();
+    let max = Duration::from_secs(300);
+    let relay = SnapshotRelay::new(snapshots_dir(&dir), TTL, MAX_BYTES, max).unwrap();
+    let uploader = ClientId::new("uploader").unwrap();
+    let step = UPLOAD_IDLE_TIMEOUT - Duration::from_secs(1);
+    let (first, second) = (three_part_snapshot(1), three_part_snapshot(2));
+    let mut current = &first;
+    let first_chunk = Instant::now();
+    upload_parts(&relay, 10, [0], current, (0, 10)).await;
+    let mut deadline = Instant::now() + max;
+    for _ in 0..4 {
+        while Instant::now() + step < deadline {
+            tokio::time::advance(step).await;
+            current = if std::ptr::eq(current, &first) {
+                &second
+            } else {
+                &first
+            };
+            upload_parts(&relay, 10, [0], current, (0, 10)).await;
+            assert!(relay.upload_in_progress_by(&room(), Some(&uploader)));
+        }
+        tokio::time::advance(deadline - Instant::now()).await;
+        // The deadline holds for an instant...
+        assert!(!relay.upload_in_progress_by(&room(), Some(&uploader)));
+        // ...and the uploader's next chunk starts a new upload with a new deadline.
+        upload_parts(&relay, 10, [0], current, (0, 10)).await;
+        deadline = Instant::now() + max;
+    }
+    let held = Instant::now() - first_chunk;
+    assert!(
+        !relay.upload_in_progress_by(&room(), Some(&uploader)),
+        "the uploader still has an upload in progress {held:?} after its first chunk, \
+         past the total deadline of {max:?} (D74 b): an expired upload only gives way to a \
+         new one with a fresh deadline"
+    );
+}
