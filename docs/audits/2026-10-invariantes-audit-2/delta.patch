+/// A room whose relay discards an upload `max_upload` after its first chunk, with designations
+/// that time out after 1 ms of real time, so that only an upload in progress keeps a designee.
+async fn audit_designation_fixture(max_upload: Duration) -> Fixture {
+    let dir = tempdir().unwrap();
+    let config = ServerConfig {
+        data_dir: dir.path().to_path_buf(),
+        idle_timeout_secs: 0,
+        ..ServerConfig::default()
+    };
+    let registry =
+        Arc::new(crate::schema_registry::SchemaRegistry::new(dir.path().join("schemas")).unwrap());
+    registry
+        .register_schema(SchemaId::new("todo").unwrap(), test_schema())
+        .unwrap();
+    let relay = Arc::new(
+        SnapshotRelay::new(
+            dir.path().join("snapshots"),
+            Duration::from_secs(600),
+            ServerConfig::default().max_snapshot_bytes,
+            max_upload,
+        )
+        .unwrap(),
+    );
+    let mut manager = RoomManager::new(Arc::new(config), registry, Arc::clone(&relay));
+    manager.set_timings(ActorTimings {
+        designation_timeout: Duration::from_millis(1),
+        ..TEST_TIMINGS
+    });
+    let room_id = RoomId::new("room").unwrap();
+    let incarnation = manager
+        .create_room(
+            room_id.clone(),
+            SchemaId::new("todo").unwrap(),
+            Some(small_segments()),
+        )
+        .await
+        .unwrap()
+        .room_incarnation;
+    Fixture {
+        dir,
+        manager,
+        relay,
+        room_id,
+        incarnation,
+    }
+}
+
+/// Advances the paused clock by `by` and lets the room's actor handle every tick due by then.
+async fn audit_advance(by: Duration) {
+    tokio::time::advance(by).await;
+    for _ in 0..50 {
+        tokio::task::yield_now().await;
+    }
+}
+
+/// Chunk `index` of the writer's three-chunk snapshot at 8, checked against a fixed range so
+/// that the room's actor does not run while it is staged.
+async fn audit_writer_chunk(fx: &Fixture, tail: SequenceNumber, index: u32) -> bool {
+    let (data, hash, chunk_len) = three_chunk_snapshot();
+    let start = index as usize * chunk_len;
+    let end = (start + chunk_len).min(data.len());
+    let bounds = crate::relay::LogBounds {
+        tail_seq: tail,
+        head_seq: seq(8),
+        unrestorable_through: None,
+    };
+    fx.relay
+        .stage_chunk(
+            crate::relay::SnapshotChunkUpload {
+                room_id: fx.room_id.clone(),
+                uploader: crate::relay::Uploader::Client(ClientId::new("writer").unwrap()),
+                head_seq: seq(8),
+                chunk_index: index,
+                total_chunks: 3,
+                total_bytes: data.len() as u64,
+                snapshot_hash: hash,
+                data: bytes::Bytes::copy_from_slice(&data[start..end]),
+            },
+            std::future::ready(Ok(bounds)),
+        )
+        .await
+        .unwrap()
+}
+
+/// The writer is designated and starts uploading at once. Returns the writer, the tail of the
+/// log and the room's events, past the designation.
+async fn audit_designee_uploading(
+    fx: &Fixture,
+) -> (ClientId, SequenceNumber, broadcast::Receiver<RoomEvent>) {
+    let (writer, tail) = prune_with_writer(fx).await;
+    let sender = fx.sender().await;
+    register_at(
+        &sender,
+        &ClientId::new("peer").unwrap(),
+        Some((tail, fx.incarnation)),
+    )
+    .await;
+    let mut events = subscribe(&sender).await;
+    register_at(&sender, &ClientId::new("newcomer").unwrap(), None).await;
+    assert_eq!(
+        next_snapshot_event(&mut events).await,
+        RoomEvent::SnapshotWanted
+    );
+    assert!(snapshot_wanted(&sender, &writer).await);
+    assert!(!audit_writer_chunk(fx, tail, 0).await);
+    // Its designation timed out in real time: only the upload keeps it.
+    std::thread::sleep(Duration::from_millis(5));
+    (writer, tail, events)
+}
+
+/// Control for the next test: a designee whose upload reaches its total deadline (D74 b) and
+/// that sends nothing more loses the role at the next tick.
+#[tokio::test(start_paused = true)]
+async fn audit_b2_control_designee_loses_the_role_once_its_upload_deadline_passes() {
+    let max = Duration::from_millis(3_300);
+    let fx = audit_designation_fixture(max).await;
+    let (writer, _, mut events) = audit_designee_uploading(&fx).await;
+    let sender = fx.sender().await;
+    audit_advance(max - Duration::from_millis(1)).await;
+    assert!(pending_snapshot_events(&mut events).is_empty());
+    audit_advance(Duration::from_secs(1)).await;
+    assert_eq!(
+        pending_snapshot_events(&mut events),
+        vec![RoomEvent::SnapshotWanted]
+    );
+    assert!(!snapshot_wanted(&sender, &writer).await);
+    fx.manager.shutdown_all().await;
+}
+
+/// Audit (B2, D74 b, D76): a designee keeps the role past the total deadline of its upload by
+/// sending a chunk right when the deadline passes. That chunk finds the upload expired and
+/// starts a new one, with a deadline of its own, before any tick sees the designee without an
+/// upload; so the designation (and the anchor of the upload) is held for as long as the
+/// designee keeps doing it, although no upload ever completes.
+#[tokio::test(start_paused = true)]
+async fn audit_b2_designee_keeps_the_role_by_restarting_its_upload_at_each_deadline() {
+    let max = Duration::from_millis(3_300);
+    let fx = audit_designation_fixture(max).await;
+    let (writer, tail, mut events) = audit_designee_uploading(&fx).await;
+    let sender = fx.sender().await;
+    let first_chunk = tokio::time::Instant::now();
+    let mut deadline = first_chunk + max;
+    for _ in 0..4 {
+        // Every tick up to the deadline sees the upload in progress...
+        audit_advance(deadline - Duration::from_millis(1) - tokio::time::Instant::now()).await;
+        audit_advance(Duration::from_millis(1)).await;
+        // ...and at the deadline, chunk 0 again.
+        assert!(!audit_writer_chunk(&fx, tail, 0).await);
+        deadline = tokio::time::Instant::now() + max;
+    }
+    audit_advance(Duration::from_millis(500)).await;
+    let moved = pending_snapshot_events(&mut events);
+    let held = tokio::time::Instant::now() - first_chunk;
+    assert!(
+        !moved.is_empty() && !snapshot_wanted(&sender, &writer).await,
+        "the designee still holds the role {held:?} after its first chunk, past the {max:?} \
+         total deadline of its upload, without completing any upload (events: {moved:?})"
+    );
+    fx.manager.shutdown_all().await;
+}
+
+/// Audit (R5, the scenario of the previous audit's delta review, ported): once a sync finds the
+/// gap after the active snapshot, chunk 0 no longer serves it.
+#[tokio::test]
+async fn audit_r5_chunk_zero_no_longer_serves_a_snapshot_below_a_known_gap() {
+    let fx = Fixture::new(small_segments()).await;
+    let sender = fx.sender().await;
+    let writer = ClientId::new("writer").unwrap();
+    register(&sender, &writer).await;
+    for n in 1..=6u8 {
+        commit(&sender, &writer, mutation(n), seq(0), insert_op(n.into()))
+            .await
+            .unwrap();
+    }
+    stage_snapshot_at(&fx, 2).await;
+    ack(&sender, &writer, seq(6)).await.unwrap();
+    let segments = fx.room_dir().join("segments");
+    fs::remove_file(segment_path(&segments, seq(3), seq(4), Tier::Warm)).unwrap();
+
+    let restorer = ClientId::new("restorer").unwrap();
+    register_at(&sender, &restorer, Some((seq(2), fx.incarnation))).await;
+    let res = sync_from(&sender, &restorer, seq(2)).await;
+    assert!(matches!(res, Err(ServerError::BehindCompaction)), "{res:?}");
+    let hb = heartbeat(&sender, &writer).await.unwrap();
+    assert_eq!(hb.active_snapshot_seq, None, "no longer announced");
+
+    let chunk = fx
+        .relay
+        .get_chunk(
+            zemdb_core::id::CorrelationId::new(1),
+            &fx.room_id,
+            0,
+            1024,
+            None,
+            fx.manager.log_bounds(&fx.room_id),
+        )
+        .await;
+    fx.manager.shutdown_all().await;
+    assert!(
+        matches!(chunk, Err(ServerError::RoomNotFound(_))),
+        "chunk 0 served the snapshot below the gap ({chunk:?})"
+    );
+}
