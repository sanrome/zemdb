+// ---------------------------------------------------------------------------------------------
+// Second invariants audit, challenge of the durability of the server log (INV-D2, INV-D3,
+// INV-D8).
+// ---------------------------------------------------------------------------------------------
+
+/// Flips a payload byte of the `index`-th frame of the segment file at `path`.
+fn audit2_damage_frame(path: &Path, index: usize) {
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(path)
+        .unwrap();
+    damage_payload(&file, index);
+}
+
+/// INV-D3: a compression whose cold copy is durably in place and verified, but whose removal of
+/// the warm original fails (once in the pass and once in its retry), leaves both copies. If the
+/// process stops before the next retry and the warm copy is then damaged by accident, opening
+/// the log must not throw the intact cold copy away and keep the damaged warm one: every
+/// operation of the segment is still on disk, in a file whose frames were all verified.
+#[test]
+fn audit2_d3_open_never_drops_a_verified_cold_copy_for_a_damaged_warm_one() {
+    for damaged_frame in [1, 4] {
+        let dir = tempdir().unwrap();
+        let (mut log, _) =
+            TieredLog::open_or_create(dir.path(), compress_at_once_policy()).unwrap();
+        append_range(&mut log, 1, 7);
+        let segments = segments_dir(dir.path());
+        let warm = segment_file(&segments, 1, 5, "wal");
+        let cold = segment_file(&segments, 1, 5, "wal.zst");
+        // The removal after the compression, and its retry in the same pass.
+        crate::fail_point::arm("remove_file", &warm);
+        crate::fail_point::arm("remove_file", &warm);
+        log.run_maintenance_sync().unwrap();
+        assert!(cold.exists() && warm.exists());
+        // The cold copy is the one in use, and it holds the whole segment.
+        let (ops, _) = log.fetch_deltas(SequenceNumber::new(0), 100).unwrap();
+        assert_contiguous(&ops, 1, 7);
+        drop(log);
+
+        // Accidental damage of the warm copy, which the log no longer reads.
+        audit2_damage_frame(&warm, damaged_frame);
+
+        let (log, _) = TieredLog::open_or_create(dir.path(), compress_at_once_policy()).unwrap();
+        let read = log.fetch_deltas(SequenceNumber::new(0), 100);
+        assert!(
+            matches!(&read, Ok((ops, _)) if seqs(ops) == (1..=7).collect::<Vec<_>>()),
+            "INV-D3 (damaged frame {damaged_frame}): the open deleted the verified cold copy \
+             (still there: {}) and kept the damaged warm one; a read from 0 gives {:?}",
+            cold.exists(),
+            read.map(|(ops, has_more)| (seqs(&ops), has_more))
+        );
+    }
+}
