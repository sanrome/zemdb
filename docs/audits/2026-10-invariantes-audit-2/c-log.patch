+/// INV-D8 and INV-D2: after a rotation that did rename `active.wal` (so the sealed end is
+/// recorded and named), the last frames of the next `active.wal` are damaged and truncated as a
+/// torn write (D78), alone or together with the loss of the sealed segment and its sidecar, or
+/// after a prune of every sealed segment. The head never goes below what any name or
+/// `log_meta.json` records, the next commit gets the next sequence, and a read from the floor
+/// never returns a truncated operation.
+#[test]
+fn audit2_d8_damaged_tail_after_a_rotation_that_renamed_never_lowers_the_floor() {
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    // (last appended, damaged frame of active.wal, lose segment 1..=5, prune it first)
+    let cases = [
+        (8, 2, false, false),
+        (6, 0, false, false),
+        (6, 0, true, false),
+        (7, 1, true, false),
+        (6, 0, false, true),
+        (8, 2, false, true),
+    ];
+    for (last, damaged, lose_segment, prune_first) in cases {
+        let case =
+            format!("last {last}, frame {damaged}, lost {lose_segment}, pruned {prune_first}");
+        let dir = tempdir().unwrap();
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        append_range(&mut log, 1, last);
+        if prune_first {
+            log.prune_older_than(SequenceNumber::new(6)).unwrap();
+        }
+        drop(log);
+        let segments = segments_dir(dir.path());
+        audit2_damage_frame(&segments.join("active.wal"), damaged);
+        if lose_segment {
+            for ext in ["wal", "ids"] {
+                let _ = std::fs::remove_file(segment_file(&segments, 1, 5, ext));
+            }
+        }
+        let floor = audit2_floor_on_disk(dir.path());
+        assert!(floor >= 5, "{case}: floor {floor}");
+
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone())
+            .unwrap_or_else(|e| panic!("{case}: {e}"));
+        let head = log.head_seq().get();
+        assert!(
+            head >= floor,
+            "INV-D8 ({case}): head {head} below the floor {floor}"
+        );
+        assert_eq!(
+            head,
+            last - 1,
+            "{case}: only the damaged last frame is lost (D78)"
+        );
+        // The truncated sequence is never served with the old content.
+        if let Ok((ops, _)) = log.fetch_deltas(SequenceNumber::new(floor), 100) {
+            assert!(
+                seqs(&ops).iter().all(|seq| *seq <= head),
+                "{case}: {:?}",
+                seqs(&ops)
+            );
+        }
+        log.append(make_op(head + 1), Some(mutation_for(head + 1)))
+            .unwrap_or_else(|e| panic!("{case}: {e}"));
+        drop(log);
+        let (log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        assert_eq!(log.head_seq().get(), head + 1, "{case}");
+    }
+}
