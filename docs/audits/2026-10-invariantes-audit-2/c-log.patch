+/// The highest sequence that a name in `segments` (segments, cold copies and sidecars) or
+/// `log_meta.json` in `dir` claims, read from the files themselves.
+fn audit2_floor_on_disk(dir: &Path) -> u64 {
+    let names = std::fs::read_dir(segments_dir(dir))
+        .unwrap()
+        .filter_map(|entry| {
+            let name = entry.unwrap().file_name().into_string().unwrap();
+            let end = name.strip_prefix("segment_")?.split('_').nth(1)?;
+            end.split('.').next()?.parse::<u64>().ok()
+        })
+        .max()
+        .unwrap_or(0);
+    let meta = std::fs::read(dir.join(LOG_META_FILE))
+        .ok()
+        .map(|bytes| {
+            let json = durable::verified_json(&bytes).unwrap().to_owned();
+            let meta: LogMeta = serde_json::from_str(&json).unwrap();
+            meta.pruned_through_seq.max(meta.sealed_through_seq)
+        })
+        .unwrap_or(0);
+    names.max(meta)
+}
