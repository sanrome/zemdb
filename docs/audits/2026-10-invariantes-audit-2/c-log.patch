+/// INV-D8 and INV-Y3 at the edges of the segment index (`iter_from`): with any subset of the
+/// sealed segments lost (warm or cold), every cursor in the retained range gets exactly the
+/// operations after it, or `BehindCompaction` if a lost one is in the way; never an empty answer
+/// below the head, an operation out of order, or a lost sequence reused.
+#[test]
+fn audit2_d8_lost_segments_at_any_position_read_as_gaps_from_every_cursor() {
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 3,
+        warm_disk_ttl: Duration::ZERO,
+        ..RoomLifecyclePolicy::default()
+    };
+    // Segments 1..=3, 4..=6, 7..=9 and 10..=12; 13..=14 in active.wal.
+    let ranges = [(1u64, 3u64), (4, 6), (7, 9), (10, 12)];
+    for compressed in [false, true] {
+        for lost in 0u32..16 {
+            let case = format!("compressed {compressed}, lost mask {lost:04b}");
+            let dir = tempdir().unwrap();
+            let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+            append_range(&mut log, 1, 14);
+            if compressed {
+                log.run_maintenance_sync().unwrap();
+            }
+            drop(log);
+            let segments = segments_dir(dir.path());
+            let mut present = [true; 15];
+            for (i, (start, end)) in ranges.iter().enumerate() {
+                if lost & (1 << i) != 0 {
+                    for ext in ["wal", "wal.zst", "ids"] {
+                        let _ = std::fs::remove_file(segment_file(&segments, *start, *end, ext));
+                    }
+                    for seq in *start..=*end {
+                        present[seq as usize] = false;
+                    }
+                }
+            }
+            let (log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+            assert_eq!(log.head_seq().get(), 14, "{case}");
+            let tail = log.tail_seq().get();
+            for cursor in tail - 1..14 {
+                let reachable = (cursor + 1..=14).all(|seq| present[seq as usize]);
+                let mut got = Vec::new();
+                let mut at = cursor;
+                let outcome = loop {
+                    match log.fetch_deltas(SequenceNumber::new(at), 2) {
+                        Ok((ops, has_more)) => {
+                            assert!(!ops.is_empty(), "{case}: empty answer from {at}");
+                            got.extend(seqs(&ops));
+                            at = *got.last().unwrap();
+                            if !has_more {
+                                break Ok(());
+                            }
+                        }
+                        Err(err) => break Err(err),
+                    }
+                };
+                let delivered_in_order = got
+                    .iter()
+                    .copied()
+                    .eq(cursor + 1..cursor + 1 + got.len() as u64);
+                assert!(delivered_in_order, "{case}: from {cursor} got {got:?}");
+                if reachable {
+                    assert!(outcome.is_ok(), "{case}: from {cursor}: {outcome:?}");
+                    assert_eq!(at, 14, "{case}: from {cursor}");
+                } else {
+                    assert!(
+                        matches!(outcome, Err(ServerError::BehindCompaction)),
+                        "{case}: from {cursor} past a lost segment: {got:?} {outcome:?}"
+                    );
+                }
+            }
+        }
+    }
+}
