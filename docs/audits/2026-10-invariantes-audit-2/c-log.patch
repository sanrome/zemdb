+/// INV-D2 and INV-D8 under D69: a pass over the quota compresses every warm segment (at most
+/// four), applies the RAM window and prunes every sealed segment, the newest included, in the
+/// same pass; one compression leaves its warm copy behind (its removal fails twice). The head
+/// stays, the pruning point is recorded before anything is deleted, the leftover warm copy is
+/// removed by the next open instead of coming back, and the next commit continues the head.
+/// Losing every file of `segments/` afterwards still leaves the floor of `log_meta.json`.
+#[test]
+fn audit2_d2_quota_pass_that_compresses_and_prunes_every_segment_keeps_the_head() {
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ram_ttl: Duration::from_millis(1),
+        warm_disk_ttl: Duration::from_secs(3600),
+        ..RoomLifecyclePolicy::default()
+    };
+    for leftover in [false, true] {
+        let case = format!("leftover warm copy: {leftover}");
+        let dir = tempdir().unwrap();
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        append_range(&mut log, 1, 22);
+        let segments = segments_dir(dir.path());
+        let warm = segment_file(&segments, 6, 10, "wal");
+        if leftover {
+            crate::fail_point::arm("remove_file", &warm);
+            crate::fail_point::arm("remove_file", &warm);
+        }
+        log.policy.max_room_disk_bytes = 1;
+        sleep(Duration::from_millis(5));
+        let report = log.run_maintenance_sync().unwrap();
+        assert_eq!(report.warm_compressed_count, 4, "{case}");
+        assert_eq!(report.pruned_count, 4, "{case}");
+        assert_eq!(log.head_seq().get(), 22, "{case}");
+        assert_eq!(log.tail_seq().get(), 21, "{case}");
+        assert_eq!(warm.exists(), leftover, "{case}");
+        let (ops, _) = log.fetch_deltas(SequenceNumber::new(20), 100).unwrap();
+        assert_contiguous(&ops, 21, 22);
+        assert!(matches!(
+            log.fetch_deltas(SequenceNumber::new(19), 100),
+            Err(ServerError::BehindCompaction)
+        ));
+        drop(log);
+
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        assert!(!warm.exists(), "{case}: the leftover warm copy came back");
+        assert_eq!(log.head_seq().get(), 22, "{case}");
+        assert_eq!(log.tail_seq().get(), 21, "{case}");
+        log.append(make_op(23), None).unwrap();
+        // Rotations after the prune keep the pruning point in log_meta.json.
+        append_range(&mut log, 24, 27);
+        drop(log);
+        for entry in std::fs::read_dir(&segments).unwrap() {
+            std::fs::remove_file(entry.unwrap().path()).unwrap();
+        }
+        let (log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        assert_eq!(
+            log.head_seq().get(),
+            25,
+            "{case}: the sealed end 21..=25 is the floor"
+        );
+    }
+}
