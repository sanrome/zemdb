+/// A runtime with a single thread, whose shutdown drops every task at its current `.await`.
+fn single_thread_runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap()
+}
+
+fn multi_thread_runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .enable_all()
+        .build()
+        .unwrap()
+}
+
+/// Waits up to ten seconds for `condition` to hold.
+async fn wait_until(what: &str, condition: impl Fn() -> bool) {
+    tokio::time::timeout(Duration::from_secs(10), async {
+        while !condition() {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .unwrap_or_else(|_| panic!("{what} never happened"));
+}
+
+/// Shutting down the runtime drops the task of an `apply_snapshot` at its `.await`, but not the
+/// rename it waits for on the blocking pool. Until that rename lands, no other open may take the
+/// room: one that loads the previous snapshot first has the rename land under it, and the next
+/// open skips the batches it acknowledged.
+#[cfg(unix)]
+#[test]
+fn audit2_s1_rename_of_a_snapshot_task_cancelled_by_a_runtime_shutdown_lands_under_the_reopened_room(
+) {
+    let dir = tempfile::tempdir().unwrap();
+    let room = RoomId::new("shutdown-rename").unwrap();
+    let wal_path = engine_at(dir.path()).wal_file_path(&room);
+
+    let first = single_thread_runtime();
+    let (engine, rename) = first.block_on(async {
+        let engine = open_engine(dir.path(), &room).await;
+        apply_range(&engine, &room, 1..=3).await;
+        let snapshot = snapshot_with_rows(&room, 101, 5).await;
+        let mut rename = fail_point::arm_blocking_pause("apply_snapshot.rename", &wal_path);
+        let applying = {
+            let (engine, room) = (engine.clone(), room.clone());
+            tokio::spawn(async move {
+                engine
+                    .apply_snapshot(&room, schema(), snapshot.into(), SequenceNumber::from(5u64))
+                    .await
+            })
+        };
+        rename.reached().await;
+        drop(applying);
+        (engine, rename)
+    });
+    first.shutdown_background();
+    drop(engine);
+
+    let second = multi_thread_runtime();
+    second.block_on(async {
+        let reopened = engine_at(dir.path());
+        let mut loaded = fail_point::arm_pause("recovery.snapshot_loaded", &wal_path);
+        let mut opening = tokio::spawn({
+            let (reopened, room) = (reopened.clone(), room.clone());
+            async move { reopened.open_room(&room, schema()).await }
+        });
+        // Either the open is refused while the rename is in flight, or it recovers meanwhile.
+        let recovering = tokio::select! {
+            _ = loaded.reached() => true,
+            refused = &mut opening => {
+                let refused = refused.unwrap();
+                assert!(matches!(refused, Err(StorageError::RoomLocked(_))), "{refused:?}");
+                false
+            }
+        };
+        rename.release();
+        wait_until("the rename of the cancelled task", || {
+            staged_snapshot_files(dir.path()).is_empty()
+        })
+        .await;
+        loaded.release();
+        if recovering {
+            opening.await.unwrap().unwrap();
+        } else {
+            reopened.open_room(&room, schema()).await.unwrap();
+        }
+
+        let head = reopened.get_head_seq(&room).await.unwrap().get();
+        apply_range(&reopened, &room, head + 1..=head + 3).await;
+        let reopened = reopen(reopened, dir.path(), &room).await;
+        let next_head = reopened.get_head_seq(&room).await.unwrap().get();
+        for key in head + 1..=head + 3 {
+            assert!(
+                has_key(&reopened, &room, key as i64).await,
+                "batch {key}, acknowledged with Ok by the room opened at head {head}, is gone \
+                 after the next open (head {next_head}): the rename of the cancelled snapshot \
+                 task landed under the open room"
+            );
+        }
+    });
+}
