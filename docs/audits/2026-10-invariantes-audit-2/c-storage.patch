+/// Shutting down the runtime drops a compaction task while its cleanup removes the folded
+/// `.wal.compacting` on the blocking pool. Until that removal lands, no other open may take the
+/// room: one that does acknowledges batches 4 to 6 and rotates them into a new
+/// `.wal.compacting` while compacting, the late removal deletes that file, and a crash before
+/// the new snapshot is in place reopens the room without them.
+#[cfg(unix)]
+#[test]
+fn audit2_s3_cleanup_of_a_compaction_cancelled_by_a_runtime_shutdown_removes_the_next_rotated_wal()
+{
+    let dir = tempfile::tempdir().unwrap();
+    let image = tempfile::tempdir().unwrap();
+    let room = RoomId::new("shutdown-cleanup").unwrap();
+    let wal_path = engine_at(dir.path()).wal_file_path(&room);
+    let compacting_path = compacting_wal_path(&wal_path);
+
+    let first = single_thread_runtime();
+    let (engine, removal) = first.block_on(async {
+        let engine = open_engine(dir.path(), &room).await;
+        apply_range(&engine, &room, 1..=3).await;
+        let mut removal = fail_point::arm_blocking_pause("remove", &compacting_path);
+        drop(spawn_compaction(&engine, &room));
+        removal.reached().await;
+        (engine, removal)
+    });
+    first.shutdown_background();
+    drop(engine);
+
+    let second = multi_thread_runtime();
+    second.block_on(async {
+        let reopened = engine_at(dir.path());
+        // Either the open is refused while the removal is in flight, or it takes the room.
+        let pending_removal = match reopened.open_room(&room, schema()).await {
+            Ok(()) => Some(removal),
+            Err(StorageError::RoomLocked(_)) => {
+                removal.release();
+                wait_until("the removal of the cancelled task", || {
+                    !compacting_path.exists()
+                })
+                .await;
+                reopened.open_room(&room, schema()).await.unwrap();
+                None
+            }
+            Err(err) => panic!("{err:?}"),
+        };
+        assert_rows(&reopened, &room, 3).await;
+        apply_range(&reopened, &room, 4..=6).await;
+
+        let mut staging = fail_point::arm_pause("compaction.staging", &wal_path);
+        let compaction = spawn_compaction(&reopened, &room);
+        staging.reached().await;
+        assert!(
+            compacting_path.exists(),
+            "batches 4 to 6 are in `.wal.compacting`"
+        );
+        if let Some(removal) = pending_removal {
+            removal.release();
+            wait_until("the removal of the cancelled task", || {
+                !compacting_path.exists()
+            })
+            .await;
+        }
+        // A crash while the snapshot of this compaction is staged.
+        fail_point::copy_files(dir.path(), image.path());
+        staging.release();
+        compaction.await.unwrap().unwrap();
+
+        let crashed = open_engine(image.path(), &room).await;
+        let head = crashed.get_head_seq(&room).await.unwrap().get();
+        assert_eq!(
+            head, 6,
+            "a crash while compacting batches 4 to 6 reopens the room at head {head}: the cleanup \
+             of the compaction cancelled by the runtime shutdown removed their `.wal.compacting`"
+        );
+        assert_rows(&crashed, &room, 6).await;
+    });
+}
