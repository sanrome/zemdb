+/// An open that creates two levels of the data directory and fails to sync the entry of the
+/// first one leaves it unsynced for good: the next open finds it there, and syncs only the data
+/// directory and its parent.
+#[tokio::test]
+async fn audit2_bajo_a_failed_sync_two_levels_above_the_data_directory_is_never_retried() {
+    let dir = tempfile::tempdir().unwrap();
+    let data = dir.path().join("a").join("b");
+    let engine = engine_at(&data);
+    let room = RoomId::new("nested-data-dir").unwrap();
+
+    fail_point::arm("sync_dir", dir.path());
+    assert!(engine.open_room(&room, schema()).await.is_err());
+    assert!(dir.path().join("a").is_dir() && !data.exists());
+
+    // An open that synced the entries an earlier open may have left unsynced would fail here.
+    fail_point::arm("sync_dir", dir.path());
+    let reopened = engine.open_room(&room, schema()).await;
+    fail_point::disarm("sync_dir", dir.path());
+    assert!(
+        reopened.is_err(),
+        "the room opened, and acknowledges batches, without ever syncing the entry of `a` that \
+         the failed open created in {:?}",
+        dir.path()
+    );
+}
