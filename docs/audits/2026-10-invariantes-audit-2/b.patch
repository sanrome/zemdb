+/// Chunk `index` of a snapshot of `chunks` chunks of 64 KiB filled with `fill`, uploaded by
+/// `uploader` at `n` against the room's current log range. Returns whether it completed.
+async fn upload_chunk_of(
+    fx: &Fixture,
+    uploader: &ClientId,
+    n: u64,
+    (chunks, fill): (u32, u8),
+    index: u32,
+) -> bool {
+    use zemdb_core::protocol::messages::ServerMessage;
+    use zemdb_core::protocol::snapshot_envelope::{
+        SnapshotCompression, SnapshotEnvelopeHeader, SNAPSHOT_HEADER_LEN,
+    };
+    let chunk_len = crate::relay::MIN_CHUNK_BYTES as usize;
+    let body = vec![fill; chunks as usize * chunk_len - SNAPSHOT_HEADER_LEN];
+    let header =
+        SnapshotEnvelopeHeader::for_body(SnapshotCompression::Raw, body.len() as u32, &body);
+    let mut data = header.to_bytes().to_vec();
+    data.extend_from_slice(&body);
+    let hash = ServerMessage::compute_snapshot_hash(&data);
+    let range = index as usize * chunk_len..(index as usize + 1) * chunk_len;
+    fx.relay
+        .stage_chunk(
+            crate::relay::SnapshotChunkUpload {
+                room_id: fx.room_id.clone(),
+                uploader: crate::relay::Uploader::Client(uploader.clone()),
+                head_seq: seq(n),
+                chunk_index: index,
+                total_chunks: chunks,
+                total_bytes: data.len() as u64,
+                snapshot_hash: hash,
+                data: bytes::Bytes::copy_from_slice(&data[range]),
+            },
+            fx.manager.log_bounds(&fx.room_id),
+        )
+        .await
+        .unwrap()
+}
+
+/// A room with the writer designated to upload, a connected peer that could take the role and
+/// a bootstrapping newcomer, whose relay discards a chunked upload `cap` after its first chunk.
+/// Returns the fixture, the actor, the writer, the peer, the events and when the designation
+/// was announced: the actor's maintenance ticks fall a whole number of periods after it.
+async fn designated_writer(
+    cap: Duration,
+) -> (
+    Fixture,
+    mpsc::Sender<RoomCommand>,
+    ClientId,
+    ClientId,
+    broadcast::Receiver<RoomEvent>,
+    tokio::time::Instant,
+) {
+    let fx = Fixture::with_options(
+        small_segments(),
+        |config| config.snapshot_upload_max_secs = cap.as_secs(),
+        Some(ActorTimings {
+            designation_timeout: DESIGNATION_TIMEOUT_IN_TESTS,
+            ..TEST_TIMINGS
+        }),
+    )
+    .await;
+    let (writer, tail) = prune_with_writer(&fx).await;
+    let sender = fx.sender().await;
+    let peer = ClientId::new("peer").unwrap();
+    register_at(&sender, &peer, Some((tail, fx.incarnation))).await;
+    let mut events = subscribe(&sender).await;
+    register_at(&sender, &ClientId::new("newcomer").unwrap(), None).await;
+    assert_eq!(
+        next_snapshot_event(&mut events).await,
+        RoomEvent::SnapshotWanted
+    );
+    let tick = tokio::time::Instant::now();
+    assert!(snapshot_wanted(&sender, &writer).await);
+    (fx, sender, writer, peer, events, tick)
+}
+
+/// An upload by `writer` at 8 that receives a new chunk every second and never its last one,
+/// until the relay discards it at its deadline, `cap` after its first chunk.
+async fn upload_until_its_deadline(
+    fx: &Fixture,
+    sender: &mpsc::Sender<RoomCommand>,
+    (writer, peer): (&ClientId, &ClientId),
+    cap: Duration,
+    fill: u8,
+) {
+    let started = tokio::time::Instant::now();
+    let mut index = 0;
+    while started.elapsed() < cap - Duration::from_millis(200) {
+        assert!(!upload_chunk_of(fx, writer, 8, (6, fill), index).await);
+        index += 1;
+        heartbeat(sender, writer).await.unwrap();
+        heartbeat(sender, peer).await.unwrap();
+        tokio::time::sleep(Duration::from_secs(1)).await;
+    }
+    while fx.relay.upload_in_progress_by(&fx.room_id, Some(writer)) {
+        tokio::time::sleep(Duration::from_millis(1)).await;
+    }
+}
+
+/// Audit (INV-B2): the designee's upload freezes the designation (D76), and the upload has a
+/// cap on its duration (D74), so a designee that never completes should lose the role once the
+/// cap and the designation timeout have passed. A designee that keeps sending new chunks and
+/// starts a new upload as soon as the previous one reaches its deadline keeps it for good.
+/// The deadlines fall halfway between two maintenance ticks; a tick that fell between a
+/// deadline and the next upload (a few milliseconds) would replace the designee.
+#[tokio::test]
+async fn audit_b2_designee_restarting_its_upload_at_the_deadline_keeps_the_role() {
+    let cap = Duration::from_secs(3);
+    let (fx, sender, writer, peer, mut events, tick) = designated_writer(cap).await;
+    tokio::time::sleep_until(tick + TEST_TIMINGS.fast_tick * 3 / 2).await;
+    let first_chunk = tokio::time::Instant::now();
+    for round in 1..=3u8 {
+        upload_until_its_deadline(&fx, &sender, (&writer, &peer), cap, round).await;
+    }
+
+    let held = first_chunk.elapsed();
+    let designations = pending_snapshot_events(&mut events);
+    assert!(
+        !snapshot_wanted(&sender, &writer).await,
+        "the designee kept its role for {held:?} with uploads it never completes \
+         (snapshot_upload_max_secs {cap:?}, designation timeout {DESIGNATION_TIMEOUT_IN_TESTS:?}); \
+         designations meanwhile: {designations:?}"
+    );
+    fx.manager.shutdown_all().await;
+}
+
+/// Control of the audit test above: a designee whose upload reaches its deadline and that does
+/// not start another loses the role.
+#[tokio::test]
+async fn audit_b2_designee_whose_upload_reaches_the_deadline_loses_the_role() {
+    let cap = Duration::from_secs(3);
+    let (fx, sender, writer, peer, mut events, tick) = designated_writer(cap).await;
+    tokio::time::sleep_until(tick + TEST_TIMINGS.fast_tick * 3 / 2).await;
+    upload_until_its_deadline(&fx, &sender, (&writer, &peer), cap, 1).await;
+    assert_eq!(
+        next_snapshot_event(&mut events).await,
+        RoomEvent::SnapshotWanted
+    );
+    assert!(!snapshot_wanted(&sender, &writer).await);
+    assert!(snapshot_wanted(&sender, &peer).await);
+    fx.manager.shutdown_all().await;
+}
