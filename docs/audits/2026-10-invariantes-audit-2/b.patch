+/// Audit (INV-B2): the cap on an upload's duration (D74) is per upload. An uploader that keeps
+/// progressing (a chunk it had not sent within every idle timeout) and starts a new upload as
+/// soon as the previous one reaches its deadline keeps an upload in progress, which freezes its
+/// designation (`upload_in_progress_by`) and anchors pruning, for as long as it likes.
+#[tokio::test(start_paused = true)]
+async fn audit_b2_upload_restarted_at_its_deadline_outlives_the_cap() {
+    let dir = tempdir().unwrap();
+    let max = Duration::from_secs(300);
+    let relay = SnapshotRelay::new(snapshots_dir(&dir), TTL, MAX_BYTES, max).unwrap();
+    let uploader = ClientId::new("uploader").unwrap();
+    // Six chunks of 64 KiB: the uploader sends one new chunk per idle timeout and never the last.
+    const CHUNKS: u32 = 6;
+    let chunk_len = MIN_CHUNK_BYTES as usize;
+    let step = UPLOAD_IDLE_TIMEOUT - Duration::from_secs(1);
+    let first_chunk = tokio::time::Instant::now();
+    for round in 1..=3u8 {
+        let data = envelope(CHUNKS as usize * chunk_len, round);
+        let hash = ServerMessage::compute_snapshot_hash(&data);
+        let layout = (data.len() as u64, CHUNKS);
+        let started = tokio::time::Instant::now();
+        let mut index = 0;
+        // Right at the previous deadline, a new upload; then a new chunk every `step`.
+        while started.elapsed() < max - Duration::from_secs(1) {
+            let range = index * chunk_len..(index + 1) * chunk_len;
+            let staged = relay
+                .stage_chunk(
+                    part(10, index as u32, layout, hash, &data[range]),
+                    bounds(0, 10),
+                )
+                .await
+                .unwrap();
+            assert!(!staged);
+            index += 1;
+            let wait = step.min(max - Duration::from_secs(1) - started.elapsed());
+            tokio::time::advance(wait).await;
+        }
+        let held = first_chunk.elapsed();
+        assert!(
+            !relay.upload_in_progress_by(&room(), Some(&uploader)) || held < max,
+            "round {round}: the uploader has held an upload in progress for {held:?}, \
+             past snapshot_upload_max_secs ({max:?})"
+        );
+        tokio::time::advance(Duration::from_secs(1)).await;
+    }
+}
