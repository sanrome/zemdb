+++ b/crates/server/src/tests/response_budget.rs
@@ -0,0 +1,57 @@
+use super::*;
+use zemdb_core::id::ClientId;
+
+fn holder(room: &str, client: &str) -> BudgetHolder {
+    (
+        RoomId::new(room).unwrap(),
+        Uploader::Client(ClientId::new(client).unwrap()),
+    )
+}
+
+fn held(budget: &InflightBudget) -> usize {
+    budget.held.lock().unwrap().len()
+}
+
+/// Audit (INV-B5, INV-B3): a holder at its part is refused while the others still get theirs,
+/// shrinking returns what a response does not use, and the map of parts forgets every holder
+/// once it holds nothing, however many there were.
+#[test]
+fn audit_b5_parts_are_per_holder_and_forgotten_when_empty() {
+    let frame = MAX_FRAME_SIZE as u64;
+    let budget = Arc::new(InflightBudget::new(4 * frame, 2 * frame));
+    let greedy = holder("room-a", "greedy");
+    let first = budget.reserve_frame(greedy.clone()).unwrap();
+    let mut second = budget.reserve_frame(greedy.clone()).unwrap();
+    assert!(budget.reserve_frame(greedy.clone()).is_none());
+    // The same client in another room, and another client of the room, are other holders.
+    let other_room = budget.reserve_frame(holder("room-b", "greedy")).unwrap();
+    let other_client = budget.reserve_frame(holder("room-a", "other")).unwrap();
+    // The total is now spent.
+    assert!(budget.reserve_frame(holder("room-c", "late")).is_none());
+    drop((other_room, other_client));
+
+    // A response that encodes to 1 KiB keeps only that: the rest of its frame is free again.
+    second.shrink_to(1024);
+    assert!(budget.reserve_frame(greedy.clone()).is_none());
+    let third = budget
+        .reserve(greedy.clone(), (frame - 1024) as u32)
+        .unwrap();
+    assert!(budget.reserve(greedy.clone(), 1).is_none());
+    drop((first, second, third));
+    assert_eq!(held(&budget), 0);
+
+    // Many holders, each with a small response: once dropped, nothing is left.
+    let many: Vec<_> = (0..1_000)
+        .map(|n| {
+            let mut r = budget
+                .reserve_frame(holder("room-a", &format!("c{n}")))
+                .unwrap();
+            r.shrink_to(100);
+            r
+        })
+        .collect();
+    assert_eq!(held(&budget), 1_000);
+    drop(many);
+    assert_eq!(held(&budget), 0);
+    assert_eq!(budget.total.available_permits(), (4 * frame) as usize);
+}
