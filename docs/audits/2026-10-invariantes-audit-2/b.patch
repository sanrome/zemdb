+/// Audit (INV-B1): opening a room decodes all of `active.wal` at once (`inspect_active_segment`
+/// reads it with an unlimited budget, `tiered_log.rs:171`), before the RAM window trims it. Here
+/// the 300 rows of `null_rows_log` (1.2 MiB on the wire, well within the default
+/// `segment_max_bytes` of 32 MiB and `ram_max_ops` of 1,000) are what the open of the room holds.
+#[test]
+fn audit_b1_opening_a_room_decodes_all_of_active_wal() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy::default();
+    drop(null_rows_log(dir.path(), policy.ram_max_bytes));
+
+    let (_warm, (ops, _)) = WarmDiskLog::open_recovering(segments_dir(dir.path())).unwrap();
+    let values = (ops.len() * NULL_ROW_VALUES) as u64;
+    let in_memory = values * std::mem::size_of::<Value>() as u64;
+    assert!(
+        values <= zemdb_core::protocol::limits::MAX_MESSAGE_VALUES
+            && in_memory <= policy.ram_max_bytes,
+        "opening the room decoded {} operations: {values} values, {in_memory} bytes in memory \
+         (MAX_MESSAGE_VALUES {}, ram_max_bytes {})",
+        ops.len(),
+        zemdb_core::protocol::limits::MAX_MESSAGE_VALUES,
+        policy.ram_max_bytes
+    );
+}
