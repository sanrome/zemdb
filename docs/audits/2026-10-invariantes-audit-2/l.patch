+/// Invariants audit (2nd round), INV-L3 and INV-L4: a prune whose write of `log_meta.json`
+/// fails deletes nothing and reports the failure; the tail stays where it was, before and after
+/// reopening the log.
+#[test]
+fn audit_l3_prune_that_fails_to_record_its_end_deletes_nothing() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 3,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    // Segments 1..=3, 4..=6 and 7..=9; 10 in active.wal.
+    append_range(&mut log, 1, 10);
+    let segments = segments_dir(dir.path());
+    let listing = || {
+        let mut names: Vec<_> = std::fs::read_dir(&segments)
+            .unwrap()
+            .map(|entry| entry.unwrap().file_name())
+            .collect();
+        names.sort();
+        names
+    };
+    let before = listing();
+
+    crate::fail_point::arm(
+        "write_atomic_before_rename",
+        &dir.path().join("log_meta.json"),
+    );
+    assert!(log.prune_older_than(SequenceNumber::new(7)).is_err());
+    assert_eq!(log.tail_seq().get(), 1);
+    assert_eq!(
+        listing(),
+        before,
+        "a prune that could not record its end deleted files"
+    );
+    let (ops, _) = log.fetch_deltas(SequenceNumber::new(0), 100).unwrap();
+    assert_contiguous(&ops, 1, 10);
+    drop(log);
+
+    let (log, _) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    assert_eq!(log.tail_seq().get(), 1);
+    assert_eq!(log.head_seq().get(), 10);
+}
diff --git a/crates/server/tests/audit_l_server_binary_tests.rs b/crates/server/tests/audit_l_server_binary_tests.rs
new file mode 100644
index 0000000..e6560b9
--- /dev/null
+++ b/crates/server/tests/audit_l_server_binary_tests.rs
@@ -0,0 +1,279 @@
+//! Invariants audit (2nd round), group l: the `zemdb-server` binary and its `data_dir` lock.
+#![cfg(unix)]
+
+mod common;
+
+use common::*;
+use fs2::FileExt;
+use reqwest::StatusCode;
+use std::io::{BufRead, BufReader, Write};
+use std::path::Path;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+use zemdb_core::*;
+
+/// Starts the server binary on `data_dir` and waits until it listens. Returns the process and
+/// its base URL.
+fn start_server(data_dir: &Path) -> (std::process::Child, String) {
+    let port = std::net::TcpListener::bind("127.0.0.1:0")
+        .unwrap()
+        .local_addr()
+        .unwrap()
+        .port();
+    let mut child = Command::new(env!("CARGO_BIN_EXE_zemdb-server"))
+        .env("ZEMDB_HOST", "127.0.0.1")
+        .env("ZEMDB_PORT", port.to_string())
+        .env("ZEMDB_DATA_DIR", data_dir)
+        .env("ZEMDB_AUTH_SECRET", AUTH_SECRET)
+        .env("ZEMDB_ADMIN_SECRET", ADMIN_SECRET)
+        .env("RUST_LOG", "error")
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    let mut lines = BufReader::new(child.stdout.take().unwrap()).lines();
+    loop {
+        let line = lines.next().expect("the server exited").unwrap();
+        if line.contains("listening") {
+            break;
+        }
+    }
+    (child, format!("http://127.0.0.1:{port}"))
+}
+
+/// Posts `msg` as a binary frame to `/rooms/{path}` and returns the status and the reply.
+async fn post_frame(
+    client: &reqwest::Client,
+    base: &str,
+    path: &str,
+    bearer: Option<&str>,
+    msg: &ClientMessage,
+) -> (StatusCode, ServerMessage) {
+    let mut req = client
+        .post(format!("{base}/rooms/{path}"))
+        .header("content-type", "application/octet-stream")
+        .body(encode_message(msg).unwrap());
+    if let Some(token) = bearer {
+        req = req.bearer_auth(token);
+    }
+    let resp = req.send().await.unwrap();
+    let status = resp.status();
+    (
+        status,
+        decode_message(&resp.bytes().await.unwrap()).unwrap(),
+    )
+}
+
+/// Whether some file of `dir` is a staged snapshot of room `big`.
+fn has_staged_snapshot(dir: &Path) -> bool {
+    std::fs::read_dir(dir).unwrap().any(|entry| {
+        let name = entry.unwrap().file_name();
+        let name = name.to_string_lossy();
+        name.starts_with("big_") && name.ends_with(".snap")
+    })
+}
+
+/// INV-D6: the server binary holds `server.lock` in a local of the body of `#[tokio::main]`,
+/// which is dropped when the body returns, before the runtime is dropped; dropping the runtime
+/// waits for the blocking work still in flight. A multipart upload whose client disconnects
+/// after sending its last chunk keeps running in its own task (`run_to_completion`), and the
+/// shutdown does not wait for it: the server releases `server.lock` while that task is still
+/// syncing, verifying and promoting the upload into `snapshots/`. A second server could take
+/// the lock and start in that window.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn audit_d6_server_binary_releases_the_data_dir_lock_before_it_stops_writing() {
+    let dir = tempfile::tempdir().unwrap();
+    let data_dir = dir.path().join("data");
+    let (mut server, base) = start_server(&data_dir);
+    let client = reqwest::Client::builder()
+        .pool_max_idle_per_host(0)
+        .build()
+        .unwrap();
+
+    let schema = serde_json::json!({"schema_id": "tasks", "schema": tasks_schema()});
+    let resp = client
+        .post(format!("{base}/admin/schemas"))
+        .bearer_auth(ADMIN_SECRET)
+        .json(&schema)
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), StatusCode::CREATED);
+    let resp = client
+        .post(format!("{base}/admin/rooms"))
+        .bearer_auth(ADMIN_SECRET)
+        .json(&serde_json::json!({"room_id": "big", "schema_id": "tasks"}))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), StatusCode::CREATED);
+
+    // One commit, so that a snapshot at sequence 1 is inside the retained range.
+    let (room_id, client_id) = (
+        RoomId::new("big").unwrap(),
+        ClientId::new("member").unwrap(),
+    );
+    let member_token = token(&client_id, &room_id);
+    let register = register_msg(&room_id, &client_id, &member_token);
+    let (status, reply) = post_frame(&client, &base, "big/register", None, &register).await;
+    assert_eq!(status, StatusCode::OK, "{reply:?}");
+    let commit = ClientMessage::Commit {
+        correlation_id: CorrelationId::new(2),
+        room_id: room_id.clone(),
+        client_id: client_id.clone(),
+        mutation_id: MutationId::new([1; 16]),
+        last_ack_seq: SequenceNumber::new(0),
+        op: make_test_op(1),
+    };
+    let (status, reply) =
+        post_frame(&client, &base, "big/commit", Some(&member_token), &commit).await;
+    assert_eq!(status, StatusCode::OK, "{reply:?}");
+
+    // A 256 MiB snapshot in 64 chunks, all but the last one acknowledged.
+    const CHUNK: usize = 4 * 1024 * 1024;
+    const CHUNKS: u32 = 64;
+    let snapshot = envelope(CHUNK * CHUNKS as usize, 9);
+    let snapshot_hash = ServerMessage::compute_snapshot_hash(&snapshot);
+    let chunk = |index: u32| ClientMessage::UploadSnapshotChunk {
+        correlation_id: CorrelationId::new(10 + u64::from(index)),
+        room_id: room_id.clone(),
+        snapshot_head_seq: SequenceNumber::new(1),
+        chunk_index: index,
+        total_chunks: CHUNKS,
+        total_bytes: snapshot.len() as u64,
+        snapshot_hash,
+        data: snapshot[index as usize * CHUNK..][..CHUNK].to_vec().into(),
+    };
+    for index in 0..CHUNKS - 1 {
+        let (status, reply) = post_frame(
+            &client,
+            &base,
+            "big/snapshot/upload-chunk",
+            Some(ADMIN_SECRET),
+            &chunk(index),
+        )
+        .await;
+        assert_eq!(status, StatusCode::OK, "{reply:?}");
+    }
+    drop(client);
+
+    // The last chunk, from a client that disconnects once the request is sent.
+    let body = encode_message(&chunk(CHUNKS - 1)).unwrap();
+    let mut stream = std::net::TcpStream::connect(base.trim_start_matches("http://")).unwrap();
+    write!(
+        stream,
+        "POST /rooms/big/snapshot/upload-chunk HTTP/1.1\r\nHost: zemdb\r\nAuthorization: Bearer \
+         {ADMIN_SECRET}\r\nContent-Type: application/octet-stream\r\nContent-Length: {}\r\n\r\n",
+        body.len()
+    )
+    .unwrap();
+    stream.write_all(&body).unwrap();
+    std::thread::sleep(Duration::from_millis(300));
+    drop(stream);
+    let snapshots_dir = data_dir.join("snapshots");
+    assert!(
+        !has_staged_snapshot(&snapshots_dir),
+        "the upload completed before the shutdown; the window was not reached"
+    );
+
+    // An orderly shutdown. The lock a second server would take is polled meanwhile.
+    let killed = Command::new("kill")
+        .args(["-TERM", &server.id().to_string()])
+        .status()
+        .unwrap();
+    assert!(killed.success());
+    let lock_file = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(data_dir.join("server.lock"))
+        .unwrap();
+    let deadline = Instant::now() + Duration::from_secs(60);
+    while lock_file.try_lock_exclusive().is_err() {
+        assert!(Instant::now() < deadline, "the lock was never released");
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    let alive_when_unlocked = server.try_wait().unwrap().is_none();
+    let staged_when_unlocked = has_staged_snapshot(&snapshots_dir);
+
+    let deadline = Instant::now() + Duration::from_secs(120);
+    while server.try_wait().unwrap().is_none() {
+        assert!(Instant::now() < deadline, "the server did not exit");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    let staged_after_exit = has_staged_snapshot(&snapshots_dir);
+    assert!(
+        !(alive_when_unlocked && !staged_when_unlocked && staged_after_exit),
+        "server.lock was free while the first server was still running (alive: \
+         {alive_when_unlocked}), and that server promoted the upload into snapshots/ after it \
+         released the lock (staged when unlocked: {staged_when_unlocked}, after exit: \
+         {staged_after_exit}): a second server could have started and used data_dir meanwhile"
+    );
+}
+
+/// Every file below `dir` with its length, in order.
+fn tree(dir: &Path) -> Vec<(std::path::PathBuf, u64)> {
+    let mut out = Vec::new();
+    let mut pending = vec![dir.to_path_buf()];
+    while let Some(dir) = pending.pop() {
+        for entry in std::fs::read_dir(&dir).unwrap() {
+            let entry = entry.unwrap();
+            let meta = entry.metadata().unwrap();
+            if meta.is_dir() {
+                pending.push(entry.path());
+            }
+            out.push((entry.path(), if meta.is_dir() { 0 } else { meta.len() }));
+        }
+    }
+    out.sort();
+    out
+}
+
+/// INV-D6: a second server binary on the `data_dir` of a running one refuses to start, saying
+/// why, before it touches any file: the leftovers that its startup would clean up (a partial
+/// upload of the relay, the directory of a deleted room) are still there.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn audit_d6_second_server_binary_refuses_to_start_and_touches_nothing() {
+    let dir = tempfile::tempdir().unwrap();
+    let data_dir = dir.path().join("data");
+    let (mut first, _) = start_server(&data_dir);
+
+    // What the startup of a server removes, created once the first one has started.
+    let upload = data_dir
+        .join("snapshots")
+        .join("uploads")
+        .join("stale_1.part");
+    std::fs::write(&upload, b"partial").unwrap();
+    let tombstone = data_dir.join("rooms").join(".deleted-leftover");
+    std::fs::create_dir_all(tombstone.join("segments")).unwrap();
+    let before = tree(&data_dir);
+
+    let port = std::net::TcpListener::bind("127.0.0.1:0")
+        .unwrap()
+        .local_addr()
+        .unwrap()
+        .port();
+    let second = Command::new(env!("CARGO_BIN_EXE_zemdb-server"))
+        .env("ZEMDB_HOST", "127.0.0.1")
+        .env("ZEMDB_PORT", port.to_string())
+        .env("ZEMDB_DATA_DIR", &data_dir)
+        .env("ZEMDB_AUTH_SECRET", AUTH_SECRET)
+        .env("ZEMDB_ADMIN_SECRET", ADMIN_SECRET)
+        .env("RUST_LOG", "error")
+        .output()
+        .unwrap();
+    assert!(!second.status.success());
+    let stderr = String::from_utf8_lossy(&second.stderr);
+    assert!(
+        stderr.contains("in use by another server process"),
+        "{stderr}"
+    );
+    assert_eq!(
+        tree(&data_dir),
+        before,
+        "the second server touched data_dir"
+    );
+    assert!(upload.exists() && tombstone.exists());
+
+    first.kill().unwrap();
+    first.wait().unwrap();
+}
