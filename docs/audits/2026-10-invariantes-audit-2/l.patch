+/// INV-L2: `POST /admin/rooms` runs `create_room` in the request's future, and the relay purge
+/// that `create_room` makes (D84) is a `spawn_blocking` that the future only awaits. A request
+/// dropped while the purge runs (a client timeout) leaves the purge in flight with neither the
+/// room's spawn lock nor the relay's slot lock. The admin retries, the room is created, a
+/// snapshot is confirmed for it, and only then the purge of the dropped request lands: it
+/// deletes that snapshot's file, which the relay keeps as the room's active snapshot (the room
+/// takes it as usable, so it asks for no other).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn audit_l2_dropped_room_creation_purges_the_snapshot_of_the_room_created_after_it() {
+    use crate::relay::{Uploader, MIN_CHUNK_BYTES};
+    use zemdb_core::id::{ClientId, CorrelationId, MutationId, SequenceNumber};
+    use zemdb_core::protocol::snapshot_envelope::{SnapshotCompression, SnapshotEnvelopeHeader};
+
+    let dir = tempdir().unwrap();
+    let state = TestState::new(dir.path(), |config| {
+        config.admin_secret = ADMIN_SECRET.to_string();
+    });
+    let schema = Schema::builder()
+        .table(TableSchema::builder("tasks").primary_key("id", DataType::Int))
+        .build();
+    state
+        .registry
+        .register_schema(SchemaId::new("todo").unwrap(), schema.clone())
+        .unwrap();
+    let room_id = RoomId::new("reborn").unwrap();
+    let app = build_router(state.app_state());
+
+    // The first request is dropped while its purge is on the blocking pool. The purge waits
+    // up to 2 s, so that a creation that holds the room until its purge ends is not blocked.
+    let (reached_tx, reached_rx) = tokio::sync::oneshot::channel();
+    let (resume_tx, resume_rx) = std::sync::mpsc::channel::<()>();
+    fail_point::arm_hook(
+        "relay_purge_room_files",
+        &dir.path().join("snapshots"),
+        move || {
+            let _ = reached_tx.send(());
+            let _ = resume_rx.recv_timeout(Duration::from_secs(2));
+        },
+    );
+    tokio::select! {
+        res = app.clone().oneshot(audit_create_room_request("reborn")) => {
+            panic!("the purge did not stop: {:?}", res.map(|r| r.status()))
+        }
+        _ = reached_rx => {}
+    }
+
+    // The retry creates the room (or finds it created), which commits one operation and gets
+    // a snapshot at sequence 1 confirmed by the relay.
+    let retry = app
+        .clone()
+        .oneshot(audit_create_room_request("reborn"))
+        .await
+        .unwrap()
+        .status();
+    assert!(
+        retry == StatusCode::CREATED || retry == StatusCode::CONFLICT,
+        "{retry}"
+    );
+    let client_id = ClientId::new("writer").unwrap();
+    state
+        .manager
+        .ask(&room_id, |reply| RoomCommand::RegisterClient {
+            client_id: client_id.clone(),
+            current_seq: None,
+            known_incarnation: None,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let row = zemdb_core::value::RowBuilder::new().set("id", 1).build();
+    let op = schema.to_operation_insert("tasks", &row, 1000).unwrap();
+    state
+        .manager
+        .ask(&room_id, |reply| RoomCommand::Commit {
+            client_id: client_id.clone(),
+            mutation_id: MutationId::new([1; 16]),
+            last_ack_seq: SequenceNumber::new(0),
+            op,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let body = vec![7u8; 1024];
+    let envelope_header =
+        SnapshotEnvelopeHeader::for_body(SnapshotCompression::Raw, body.len() as u32, &body);
+    let mut envelope = envelope_header.to_bytes().to_vec();
+    envelope.extend_from_slice(&body);
+    state
+        .relay
+        .stage_snapshot(
+            &room_id,
+            &Uploader::Admin,
+            SequenceNumber::new(1),
+            bytes::Bytes::from(envelope),
+            state.manager.log_bounds(&room_id),
+        )
+        .await
+        .unwrap();
+    assert_eq!(audit_snapshot_files(dir.path(), "reborn").len(), 1);
+
+    // The purge of the dropped request resumes, if it still waits.
+    let _ = resume_tx.send(());
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(2);
+    while !audit_snapshot_files(dir.path(), "reborn").is_empty()
+        && tokio::time::Instant::now() < deadline
+    {
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+
+    let download = state
+        .relay
+        .get_chunk(
+            CorrelationId::from(1),
+            &room_id,
+            0,
+            MIN_CHUNK_BYTES,
+            None,
+            state.manager.log_bounds(&room_id),
+        )
+        .await;
+    assert!(
+        download.is_ok() && audit_snapshot_files(dir.path(), "reborn").len() == 1,
+        "the purge of a room creation whose request was dropped deleted the snapshot that the \
+         relay confirmed afterwards for the room created by the retry: files left {:?}, active \
+         snapshot {:?}, download {download:?}",
+        audit_snapshot_files(dir.path(), "reborn"),
+        state.relay.active_snapshot_seq(&room_id),
+    );
+    state.manager.shutdown_all().await;
+}
