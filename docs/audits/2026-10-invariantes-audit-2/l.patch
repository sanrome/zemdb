+/// `POST /admin/rooms` for `room` with schema `todo`.
+fn audit_create_room_request(room: &str) -> Request<Body> {
+    Request::post("/admin/rooms")
+        .header(header::AUTHORIZATION, format!("Bearer {ADMIN_SECRET}"))
+        .header(header::CONTENT_TYPE, "application/json")
+        .body(Body::from(
+            serde_json::json!({"room_id": room, "schema_id": "todo"}).to_string(),
+        ))
+        .unwrap()
+}
