+// ---------------------------------------------------------------------------------------------
+// Invariants audit (2nd round), group l: room ownership and lifecycle.
+// ---------------------------------------------------------------------------------------------
+
+/// Registers `client_id` in `room_id` and commits `count` inserts, so that the room's head is
+/// at least `count`.
+async fn audit_commit(manager: &RoomManager, room_id: &RoomId, count: u64) {
+    let client_id = zemdb_core::id::ClientId::new("writer").unwrap();
+    manager
+        .ask(room_id, |reply| RoomCommand::RegisterClient {
+            client_id: client_id.clone(),
+            current_seq: None,
+            known_incarnation: None,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    for n in 1..=count {
+        let row = zemdb_core::value::RowBuilder::new()
+            .set("id", n as i64)
+            .set("title", "t")
+            .build();
+        let op = test_schema()
+            .to_operation_insert("tasks", &row, 1000)
+            .unwrap();
+        let mut id = [0u8; 16];
+        id[..8].copy_from_slice(&n.to_le_bytes());
+        manager
+            .ask(room_id, |reply| RoomCommand::Commit {
+                client_id: client_id.clone(),
+                mutation_id: zemdb_core::id::MutationId::new(id),
+                last_ack_seq: SequenceNumber::new(0),
+                op,
+                reply,
+            })
+            .await
+            .unwrap()
+            .unwrap();
+    }
+}
+
+/// Snapshot files of `room_id` in the relay's directory.
+fn audit_snapshot_files(dir: &TempDir, room_id: &RoomId) -> Vec<PathBuf> {
+    fs::read_dir(dir.path().join("snapshots"))
+        .unwrap()
+        .map(|entry| entry.unwrap().path())
+        .filter(|path| {
+            path.file_name()
+                .and_then(|name| name.to_str())
+                .is_some_and(|name| {
+                    name.starts_with(&format!("{room_id}_")) && name.ends_with(".snap")
+                })
+        })
+        .collect()
+}
+
+/// A room with one commit and a snapshot at sequence 1 in the relay.
+async fn audit_room_with_snapshot(
+    manager: &RoomManager,
+    relay: &crate::relay::SnapshotRelay,
+    room_id: &RoomId,
+) {
+    manager
+        .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+        .await
+        .unwrap();
+    audit_commit(manager, room_id, 1).await;
+    relay
+        .stage_snapshot(
+            room_id,
+            &crate::relay::Uploader::Admin,
+            SequenceNumber::new(1),
+            snapshot_envelope(),
+            manager.log_bounds(room_id),
+        )
+        .await
+        .unwrap();
+}
+
+/// INV-L6, without a restart: wherever a deletion stops (the sync of `rooms/` failing after
+/// the rename, the relay purge failing, or the removal of the renamed directory failing), the
+/// room is gone for this process, and a room created again right away with the same id starts
+/// empty, without the old room's snapshot. A power cut that undoes an unsynced rename brings
+/// the room back whole: its log and its snapshot.
+#[tokio::test]
+async fn audit_l6_room_recreated_without_a_restart_after_an_interrupted_deletion_starts_empty() {
+    let room_id = RoomId::new("reborn").unwrap();
+    for cut in ["rename unsynced", "purge failed", "removal failed"] {
+        let dir = tempdir().unwrap();
+        let rooms = dir.path().join("rooms");
+        let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+        audit_room_with_snapshot(&manager, &relay, &room_id).await;
+        let deleted = match cut {
+            "rename unsynced" => {
+                fail_point::arm("sync_dir", &rooms);
+                manager.delete_room(&room_id).await
+            }
+            "purge failed" => {
+                fail_point::arm("sync_dir", &dir.path().join("snapshots"));
+                manager.delete_room(&room_id).await
+            }
+            _ => {
+                fail_point::arm("room_removal", &room_dir(&dir, &room_id));
+                manager.delete_room(&room_id).await
+            }
+        };
+        assert_eq!(
+            deleted.is_ok(),
+            cut != "rename unsynced",
+            "{cut}: {deleted:?}"
+        );
+        assert!(!manager.room_exists(&room_id).unwrap(), "{cut}");
+        let gone = manager.log_bounds(&room_id).await;
+        assert!(
+            matches!(gone, Err(ServerError::RoomNotFound(_))),
+            "{cut}: {gone:?}"
+        );
+
+        if cut == "rename unsynced" {
+            // The power is cut before the rename reaches the disk: the room is back whole.
+            let tombstone = fs::read_dir(&rooms)
+                .unwrap()
+                .map(|entry| entry.unwrap().path())
+                .find(|path| path.to_string_lossy().contains(".deleted-"))
+                .expect("the room was renamed away");
+            drop(manager);
+            fs::rename(&tombstone, room_dir(&dir, &room_id)).unwrap();
+            let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+            let bounds = manager.log_bounds(&room_id).await.unwrap();
+            assert_eq!(bounds.head_seq, SequenceNumber::new(1), "{cut}");
+            assert_eq!(
+                relay.active_snapshot_seq(&room_id),
+                Some(SequenceNumber::new(1)),
+                "{cut}"
+            );
+            manager.shutdown_all().await;
+            continue;
+        }
+
+        manager
+            .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+            .await
+            .unwrap();
+        let bounds = manager.log_bounds(&room_id).await.unwrap();
+        assert_eq!(bounds.head_seq, SequenceNumber::new(0), "{cut}");
+        assert_eq!(relay.active_snapshot_seq(&room_id), None, "{cut}");
+        assert!(audit_snapshot_files(&dir, &room_id).is_empty(), "{cut}");
+        manager.shutdown_all().await;
+    }
+}
+
+/// INV-L6 and INV-D5: two deletions and a creation of the same room, racing on a multi-thread
+/// runtime, leave the room whole and empty (the creation won last) or gone, never half of it;
+/// the spawn lock serializes them, so at most one actor ever opens the room's log.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn audit_l6_concurrent_deletions_and_creation_leave_the_room_whole_or_gone() {
+    let room_id = RoomId::new("contested").unwrap();
+    for round in 0..20 {
+        let dir = tempdir().unwrap();
+        let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+        let manager = Arc::new(manager);
+        audit_room_with_snapshot(&manager, &relay, &room_id).await;
+
+        let delete = |manager: Arc<RoomManager>, room_id: RoomId| {
+            tokio::spawn(async move { manager.delete_room(&room_id).await })
+        };
+        let first = delete(Arc::clone(&manager), room_id.clone());
+        let create = tokio::spawn({
+            let (manager, room_id) = (Arc::clone(&manager), room_id.clone());
+            async move {
+                manager
+                    .create_room(room_id, SchemaId::new("first").unwrap(), None)
+                    .await
+            }
+        });
+        let second = delete(Arc::clone(&manager), room_id.clone());
+        let (first, create, second) = (
+            first.await.unwrap(),
+            create.await.unwrap(),
+            second.await.unwrap(),
+        );
+        assert!(
+            first.is_ok() || second.is_ok(),
+            "round {round}: neither deletion found the room: {first:?} {second:?}"
+        );
+
+        let exists = manager.room_exists(&room_id).unwrap();
+        let tombstones = fs::read_dir(dir.path().join("rooms"))
+            .unwrap()
+            .filter(|entry| {
+                entry
+                    .as_ref()
+                    .unwrap()
+                    .file_name()
+                    .to_string_lossy()
+                    .starts_with(".deleted-")
+            })
+            .count();
+        assert_eq!(tombstones, 0, "round {round}");
+        if exists {
+            assert!(create.is_ok(), "round {round}: {create:?}");
+            let bounds = manager.log_bounds(&room_id).await.unwrap();
+            assert_eq!(bounds.head_seq, SequenceNumber::new(0), "round {round}");
+        }
+        assert_eq!(relay.active_snapshot_seq(&room_id), None, "round {round}");
+        assert!(
+            audit_snapshot_files(&dir, &room_id).is_empty(),
+            "round {round}"
+        );
+        manager.shutdown_all().await;
+
+        // After a restart, the same.
+        let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+        assert_eq!(
+            manager.room_exists(&room_id).unwrap(),
+            exists,
+            "round {round}"
+        );
+        assert_eq!(relay.active_snapshot_seq(&room_id), None, "round {round}");
+    }
+}
+
+/// INV-D6: a manager that does not own the room's log (another process, as far as the files
+/// can tell) cannot delete the room, and touches nothing: neither the room's directory, nor
+/// the relay's snapshot, in memory or on disk, of either relay.
+#[tokio::test]
+async fn audit_d6_deletion_by_a_process_that_does_not_own_the_log_touches_nothing() {
+    let dir = tempdir().unwrap();
+    let room_id = RoomId::new("owned").unwrap();
+    let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+    audit_room_with_snapshot(&manager, &relay, &room_id).await;
+    let listing = |dir: &Path| {
+        let mut names: Vec<_> = fs::read_dir(dir)
+            .unwrap()
+            .map(|entry| entry.unwrap().file_name())
+            .collect();
+        names.sort();
+        names
+    };
+    let (rooms_before, room_before) = (
+        listing(&dir.path().join("rooms")),
+        listing(&room_dir(&dir, &room_id)),
+    );
+
+    let (foreign, foreign_relay) = test_manager(dir.path(), &["first"], |_| {});
+    assert_eq!(
+        foreign_relay.active_snapshot_seq(&room_id),
+        Some(SequenceNumber::new(1))
+    );
+    let res = foreign.delete_room(&room_id).await;
+    assert!(matches!(res, Err(ServerError::RoomLocked(_))), "{res:?}");
+    assert_eq!(listing(&dir.path().join("rooms")), rooms_before);
+    assert_eq!(listing(&room_dir(&dir, &room_id)), room_before);
+    assert_eq!(audit_snapshot_files(&dir, &room_id).len(), 1);
+    assert_eq!(
+        foreign_relay.active_snapshot_seq(&room_id),
+        Some(SequenceNumber::new(1))
+    );
+    assert_eq!(
+        relay.active_snapshot_seq(&room_id),
+        Some(SequenceNumber::new(1))
+    );
+    // The owner still serves the room.
+    assert_eq!(
+        manager.log_bounds(&room_id).await.unwrap().head_seq,
+        SequenceNumber::new(1)
+    );
+    manager.shutdown_all().await;
+}
+
+/// INV-L4: a room that respawns in the middle of a multipart upload keeps what it confirmed
+/// (head, incarnation) and the upload completes against the new actor, which published its
+/// snapshot floor again when it opened: the snapshot is installed and usable.
+#[tokio::test]
+async fn audit_l4_respawn_during_a_multipart_upload_keeps_the_room_and_the_upload() {
+    use crate::relay::{SnapshotChunkUpload, Uploader, MIN_CHUNK_BYTES};
+    use zemdb_core::protocol::messages::ServerMessage;
+    use zemdb_core::protocol::snapshot_envelope::{SnapshotCompression, SnapshotEnvelopeHeader};
+
+    let dir = tempdir().unwrap();
+    let room_id = RoomId::new("uploading").unwrap();
+    let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+    manager
+        .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+        .await
+        .unwrap();
+    audit_commit(&manager, &room_id, 3).await;
+    let incarnation = manager.room_meta.get(&room_id).unwrap().room_incarnation;
+
+    let chunk_len = MIN_CHUNK_BYTES as usize;
+    let body =
+        vec![5u8; 2 * chunk_len - zemdb_core::protocol::snapshot_envelope::SNAPSHOT_HEADER_LEN];
+    let header =
+        SnapshotEnvelopeHeader::for_body(SnapshotCompression::Raw, body.len() as u32, &body);
+    let mut snapshot = header.to_bytes().to_vec();
+    snapshot.extend_from_slice(&body);
+    let snapshot_hash = ServerMessage::compute_snapshot_hash(&snapshot);
+    let chunk = |index: u32| SnapshotChunkUpload {
+        room_id: room_id.clone(),
+        uploader: Uploader::Admin,
+        head_seq: SequenceNumber::new(2),
+        chunk_index: index,
+        total_chunks: 2,
+        total_bytes: snapshot.len() as u64,
+        snapshot_hash,
+        data: bytes::Bytes::copy_from_slice(&snapshot[index as usize * chunk_len..][..chunk_len]),
+    };
+    assert!(!relay
+        .stage_chunk(chunk(0), manager.log_bounds(&room_id))
+        .await
+        .unwrap());
+
+    // The room stops in the middle of the upload; the last chunk respawns it.
+    assert!(manager.shutdown_room(&room_id).await);
+    assert_eq!(relay.snapshot_floor(&room_id), None);
+    assert!(relay
+        .stage_chunk(chunk(1), manager.log_bounds(&room_id))
+        .await
+        .unwrap());
+
+    let bounds = manager.log_bounds(&room_id).await.unwrap();
+    assert_eq!(bounds.head_seq, SequenceNumber::new(3));
+    assert!(bounds.admits(SequenceNumber::new(2)));
+    assert_eq!(
+        manager.room_meta.get(&room_id).unwrap().room_incarnation,
+        incarnation
+    );
+    assert_eq!(
+        relay.snapshot_floor(&room_id),
+        Some(bounds.snapshot_floor())
+    );
+    assert_eq!(
+        relay.active_snapshot_seq(&room_id),
+        Some(SequenceNumber::new(2))
+    );
+    manager.shutdown_all().await;
+}
+
+/// INV-D5: `delete_room` releases the room's `log.lock` right before renaming the directory
+/// away (Windows cannot rename a directory holding a locked file). In that window no other
+/// path of this process opens the room: a request that would spawn its actor (as the relay
+/// does through `log_bounds`) and a creation of the same room both wait for the spawn lock,
+/// and once the deletion is over the first finds no room and the second creates an empty one.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn audit_d5_nothing_opens_the_room_while_its_deletion_holds_no_log_lock() {
+    let dir = tempdir().unwrap();
+    let room_id = RoomId::new("unlocked").unwrap();
+    let (manager, relay) = test_manager(dir.path(), &["first"], |_| {});
+    let manager = Arc::new(manager);
+    audit_room_with_snapshot(&manager, &relay, &room_id).await;
+
+    let (results_tx, results_rx) = std::sync::mpsc::channel();
+    let runtime = tokio::runtime::Handle::current();
+    let (hook_manager, hook_room, hook_dir) = (
+        Arc::clone(&manager),
+        room_id.clone(),
+        room_dir(&dir, &room_id),
+    );
+    let (window_tx, window_rx) = std::sync::mpsc::channel();
+    fail_point::arm_hook("room_log_unlocked", &room_dir(&dir, &room_id), move || {
+        let bounds_tx = results_tx.clone();
+        let (manager, room) = (Arc::clone(&hook_manager), hook_room.clone());
+        runtime.spawn(async move {
+            let bounds = manager.log_bounds(&room).await;
+            let _ = bounds_tx.send(("bounds", bounds.map(|b| b.head_seq.get())));
+        });
+        let (manager, room) = (Arc::clone(&hook_manager), hook_room.clone());
+        runtime.spawn(async move {
+            let created = manager
+                .create_room(room.clone(), SchemaId::new("first").unwrap(), None)
+                .await
+                .map(|_| 0);
+            let _ = results_tx.send(("create", created));
+        });
+        // Nothing may complete, nor open the room's log, while the directory is in place
+        // without its lock.
+        let early = results_rx.recv_timeout(Duration::from_millis(300)).ok();
+        let lock_free = crate::log::tiered_log::lock_log(&hook_dir)
+            .map(drop)
+            .is_ok();
+        let _ = window_tx.send((early, lock_free, results_rx));
+    });
+    manager.delete_room(&room_id).await.unwrap();
+
+    let (early, lock_free, results_rx) = window_rx.recv().unwrap();
+    assert!(
+        early.is_none(),
+        "{early:?} completed while the deletion held no log lock"
+    );
+    assert!(
+        lock_free,
+        "something opened the room's log while it was being deleted"
+    );
+    let mut results: Vec<_> = (0..2)
+        .map(|_| results_rx.recv_timeout(Duration::from_secs(10)).unwrap())
+        .collect();
+    results.sort_by_key(|(what, _)| *what);
+    assert!(matches!(&results[1], ("create", Ok(0))), "{results:?}");
+    match &results[0] {
+        ("bounds", Err(ServerError::RoomNotFound(_))) | ("bounds", Ok(0)) => {}
+        other => panic!("{other:?}"),
+    }
+    assert_eq!(
+        manager.log_bounds(&room_id).await.unwrap().head_seq,
+        SequenceNumber::new(0)
+    );
+    assert_eq!(relay.active_snapshot_seq(&room_id), None);
+    manager.shutdown_all().await;
+}
