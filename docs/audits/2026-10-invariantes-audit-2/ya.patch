+/// INV-A3: a member cannot alter another member's upload in progress at the same sequence.
+/// Mallory sends a chunk with the parameters of Alice's upload (sequence, layout and hash) and
+/// other bytes; the relay takes it as part of Alice's upload, which then fails.
+#[tokio::test]
+async fn audit_a3_a_chunk_with_the_parameters_of_another_members_upload_breaks_it() {
+    let dir = tempdir().unwrap();
+    let relay = open(&dir);
+    let alice = three_part_snapshot(1);
+    relay
+        .stage_chunk(part_by(member("alice"), 10, 0, &alice), bounds(0, 10))
+        .await
+        .unwrap();
+
+    // Mallory knows the sequence, the layout and the hash, not the bytes.
+    let mut forged = alice.clone();
+    forged.0 = vec![0xAB; alice.0.len()];
+    let mallory = relay
+        .stage_chunk(part_by(member("mallory"), 10, 0, &forged), bounds(0, 10))
+        .await;
+
+    let mut last = Ok(false);
+    for index in 1..3 {
+        last = relay
+            .stage_chunk(part_by(member("alice"), 10, index, &alice), bounds(0, 10))
+            .await;
+    }
+    assert!(
+        matches!(last, Ok(true)) && relay.active_snapshot_seq(&room()) == Some(seq(10)),
+        "Mallory's chunk ({mallory:?}) went into Alice's upload at the same sequence: Alice's \
+         last chunk got {last:?}, and the active snapshot is {:?}",
+        relay.active_snapshot_seq(&room())
+    );
+}
