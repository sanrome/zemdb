+/// INV-A3 / D76: an upload by a member that is not the designee does not keep a designee that
+/// does not upload. Mallory keeps two uploads of one small chunk with a wrong hash in flight
+/// (the most the room admits at once): each holds the relay's lock of the room while its file
+/// is synced and checked, and the actor takes a busy lock as an upload of the designee.
+#[tokio::test]
+async fn audit_a3_a_member_failing_small_uploads_keeps_a_designee_that_does_not_upload() {
+    let fx = Fixture::with_options(
+        small_segments(),
+        |_| {},
+        Some(ActorTimings {
+            designation_timeout: DESIGNATION_TIMEOUT_IN_TESTS,
+            ..TEST_TIMINGS
+        }),
+    )
+    .await;
+    let (writer, tail) = prune_with_writer(&fx).await;
+    let sender = fx.sender().await;
+    let mallory = ClientId::new("mallory").unwrap();
+    register_at(&sender, &mallory, Some((tail, fx.incarnation))).await;
+    let mut events = subscribe(&sender).await;
+    register_at(&sender, &ClientId::new("newcomer").unwrap(), None).await;
+    assert_eq!(
+        next_snapshot_event(&mut events).await,
+        RoomEvent::SnapshotWanted
+    );
+    assert!(snapshot_wanted(&sender, &writer).await);
+
+    let data = snapshot_envelope();
+    let failing_upload = || crate::relay::SnapshotChunkUpload {
+        room_id: fx.room_id.clone(),
+        uploader: crate::relay::Uploader::Client(mallory.clone()),
+        head_seq: seq(8),
+        chunk_index: 0,
+        total_chunks: 1,
+        total_bytes: data.len() as u64,
+        snapshot_hash: [0xEE; 32],
+        data: data.clone(),
+    };
+    let flood_until = tokio::time::Instant::now() + DESIGNATION_TIMEOUT_IN_TESTS * 3;
+    let counts = std::sync::Mutex::new((0u32, 0u32));
+    let floods = (0..crate::relay::MAX_PENDING_SINGLE_UPLOADS).map(|_| async {
+        while tokio::time::Instant::now() < flood_until {
+            let result = fx
+                .relay
+                .stage_chunk(failing_upload(), fx.manager.log_bounds(&fx.room_id))
+                .await;
+            {
+                let mut counts = counts.lock().unwrap();
+                match result {
+                    Err(ServerError::RateLimited) => counts.1 += 1,
+                    _ => counts.0 += 1,
+                }
+            }
+            // A refused upload returns without yielding; the next request comes later.
+            tokio::task::yield_now().await;
+        }
+    });
+    futures::future::join_all(floods).await;
+    let (held, limited) = *counts.lock().unwrap();
+
+    // Three designation timeouts later, the writer must have been replaced at least once.
+    let during_flood = pending_snapshot_events(&mut events);
+    assert!(
+        during_flood.contains(&RoomEvent::SnapshotWanted),
+        "in {:?} the writer, which never uploaded, was never replaced as the designee (snapshot \
+         events meanwhile: {during_flood:?}; Mallory's failed uploads: {held}, rate limited: \
+         {limited})",
+        DESIGNATION_TIMEOUT_IN_TESTS * 3
+    );
+    fx.manager.shutdown_all().await;
+}
+
+/// INV-A3: a member that registers and deregisters in a loop, with and without a cursor,
+/// changes nothing of another client of its room: cursor, state or designation.
+// Paused time: no maintenance tick changes the states under test.
+#[tokio::test(start_paused = true)]
+async fn audit_a3_registering_and_deregistering_in_a_loop_leaves_other_clients_alone() {
+    let fx = Fixture::new(small_segments()).await;
+    let (writer, tail) = prune_with_writer(&fx).await;
+    let sender = fx.sender().await;
+    let mut events = subscribe(&sender).await;
+    register_at(&sender, &ClientId::new("newcomer").unwrap(), None).await;
+    assert_eq!(
+        next_snapshot_event(&mut events).await,
+        RoomEvent::SnapshotWanted
+    );
+    assert!(snapshot_wanted(&sender, &writer).await);
+    let before = (cursor(&sender, &writer).await, states(&sender).await);
+
+    let mallory = ClientId::new("mallory").unwrap();
+    for round in 0..50u64 {
+        let at = match round % 3 {
+            0 => None,
+            1 => Some((tail, fx.incarnation)),
+            _ => Some((seq(8), fx.incarnation)),
+        };
+        register_at(&sender, &mallory, at).await;
+        deregister(&sender, &mallory).await;
+    }
+
+    assert_eq!(
+        (cursor(&sender, &writer).await, states(&sender).await),
+        before
+    );
+    assert!(pending_snapshot_events(&mut events).is_empty());
+    assert!(snapshot_wanted(&sender, &writer).await);
+    fx.manager.shutdown_all().await;
+}
