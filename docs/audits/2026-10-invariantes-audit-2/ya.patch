+use super::*;
+use zemdb_core::id::ClientId;
+
+fn holder(room: &str, client: Option<&str>) -> BudgetHolder {
+    let uploader = client.map_or(Uploader::Admin, |id| {
+        Uploader::Client(ClientId::new(id).unwrap())
+    });
+    (RoomId::new(room).unwrap(), uploader)
+}
+
+/// INV-A3 / D75: what a client holds counts against its own part only. Another client of its
+/// room, the same client id in another room and the admin secret keep theirs, and its part
+/// frees up when its responses are dropped or shrink.
+#[test]
+fn audit_a3_a_client_cannot_take_the_part_of_another_client_of_its_room() {
+    let frame = MAX_FRAME_SIZE as u64;
+    let budget = Arc::new(InflightBudget::new(8 * frame, 2 * frame));
+    let alice = holder("room", Some("alice"));
+    let held: Vec<_> = (0..2)
+        .map(|_| budget.reserve_frame(alice.clone()).unwrap())
+        .collect();
+    assert!(budget.reserve_frame(alice.clone()).is_none());
+
+    for other in [
+        holder("room", Some("bob")),
+        holder("other-room", Some("alice")),
+        holder("room", None),
+    ] {
+        let reserved: Vec<_> = (0..2)
+            .map(|_| budget.reserve_frame(other.clone()))
+            .collect();
+        assert!(reserved.iter().all(Option::is_some), "{other:?}");
+    }
+
+    // Shrinking one of Alice's responses gives back the rest of its frame to her part.
+    let mut held = held;
+    held[0].shrink_to(1024);
+    assert!(budget
+        .reserve(alice.clone(), (frame - 1024) as u32)
+        .is_some());
+    drop(held);
+    assert!(budget.reserve_frame(alice).is_some());
+}
