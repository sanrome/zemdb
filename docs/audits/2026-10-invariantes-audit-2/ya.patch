+/// INV-Y9: the window is a function of the retained log and the same before and after a
+/// respawn. The only client's cursor prunes mutation 1 out of the retained log: a retry of it
+/// must get the same answer before and after the room respawns.
+// Paused time: no maintenance tick runs, so only the ack prunes.
+#[tokio::test(start_paused = true)]
+async fn audit_y9_a_pruned_mutation_is_recognised_only_until_the_room_respawns() {
+    let (fx, writer, tail) = pruned_room().await;
+    assert!(tail > seq(1), "mutation 1 must be out of the retained log");
+
+    let before = retry_outcome(&fx.sender().await, &writer, mutation(1), seq(8)).await;
+    fx.manager.shutdown_all().await;
+    let after = retry_outcome(&fx.sender().await, &writer, mutation(1), seq(8)).await;
+
+    assert_eq!(
+        before, after,
+        "with the retained log {tail}..=8, a retry of mutation 1 got (sequence, head) {before:?} \
+         before a respawn and {after:?} after it: the window in memory is not the one the log \
+         gives"
+    );
+    fx.manager.shutdown_all().await;
+}
+
+/// INV-Y9 (since D69): a pass over the quota prunes recent warm segments that no cursor
+/// confirmed. The retry of a mutation the quota pruned, by a client whose cursor is inside the
+/// log, must get the same answer before and after a respawn.
+#[tokio::test(start_paused = true)]
+async fn audit_y9_a_mutation_pruned_by_the_quota_is_recognised_only_until_the_room_respawns() {
+    let fx = Fixture::new(RoomLifecycleOverrides {
+        max_room_disk_bytes: Some(crate::log::policy::MIN_ROOM_DISK_BYTES),
+        lease_timeout_secs: Some(3600),
+        ..small_segments()
+    })
+    .await;
+    let sender = fx.sender().await;
+    let (writer, slow) = (
+        ClientId::new("writer").unwrap(),
+        ClientId::new("slow").unwrap(),
+    );
+    register(&sender, &writer).await;
+    // A connected client at 0 holds back pruning by cursors: only the quota prunes.
+    register_at(&sender, &slow, Some((seq(0), fx.incarnation))).await;
+    let mut rng = TestRng::new(7);
+    let big = |id: i64, rng: &mut TestRng| {
+        let title: String = (0..160 * 1024)
+            .map(|_| char::from(b'a' + (rng.next_u64() % 26) as u8))
+            .collect();
+        let row = RowBuilder::new().set("id", id).set("title", title).build();
+        test_schema()
+            .to_operation_insert("tasks", &row, 1000)
+            .unwrap()
+    };
+    for n in 1..=12u8 {
+        commit(
+            &sender,
+            &writer,
+            mutation(n),
+            seq(0),
+            big(n.into(), &mut rng),
+        )
+        .await
+        .unwrap();
+    }
+    ack(&sender, &writer, seq(12)).await.unwrap();
+    // The slow tick (500 ms) runs the pass over the quota.
+    let started = tokio::time::Instant::now();
+    while metrics(&sender).await.tail_seq <= seq(2) {
+        assert!(
+            started.elapsed() < Duration::from_secs(60),
+            "the quota never pruned"
+        );
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    let tail = metrics(&sender).await.tail_seq;
+
+    let before = retry_outcome(&sender, &writer, mutation(1), seq(12)).await;
+    fx.manager.shutdown_all().await;
+    let after = retry_outcome(&fx.sender().await, &writer, mutation(1), seq(12)).await;
+
+    assert_eq!(
+        before, after,
+        "with the retained log {tail}..=12 (pruned by the quota), a retry of mutation 1 got \
+         (sequence, head) {before:?} before a respawn and {after:?} after it"
+    );
+    fx.manager.shutdown_all().await;
+}
