+/// INV-Y9 with a damaged sealed segment whose sidecar is missing (disk damage plus a crash
+/// before the sidecar was written): opening skips it and reads older segments (DEF-158), so
+/// the window after the respawn holds mutation 2, which had left the window, and not 4, which
+/// is among the last three.
+#[tokio::test(start_paused = true)]
+async fn audit_y9_a_damaged_segment_without_sidecar_changes_the_window_at_the_respawn() {
+    let fx = Fixture::with_options(
+        small_segments(),
+        |config| config.dedup_lru_capacity = 3,
+        None,
+    )
+    .await;
+    let sender = fx.sender().await;
+    let writer = ClientId::new("writer").unwrap();
+    register(&sender, &writer).await;
+    // Segments 1-2, 3-4 and 5-6; the window holds 4, 5 and 6.
+    for n in 1..=6u8 {
+        commit(&sender, &writer, mutation(n), seq(0), insert_op(n.into()))
+            .await
+            .unwrap();
+    }
+    let segments = fx.room_dir().join("segments");
+    let damaged = segment_path(&segments, seq(3), seq(4), Tier::Warm);
+    let mut bytes = fs::read(&damaged).unwrap();
+    bytes[20] ^= 0xFF;
+    fs::write(&damaged, bytes).unwrap();
+    fs::remove_file(crate::log::segment_index::mutation_ids_path(
+        &segments,
+        seq(3),
+        seq(4),
+    ))
+    .unwrap();
+
+    let before = retry_outcome(&sender, &writer, mutation(4), seq(0)).await;
+    fx.manager.shutdown_all().await;
+    let after = retry_outcome(&fx.sender().await, &writer, mutation(4), seq(0)).await;
+
+    assert_eq!(
+        before, after,
+        "with the segment 3-4 damaged and without its sidecar, a retry of mutation 4 got \
+         (sequence, head) {before:?} before a respawn and {after:?} after it"
+    );
+    fx.manager.shutdown_all().await;
+}
+
+/// INV-Y4: retries of every mutation in the window are recognised after a respawn although one
+/// sidecar is missing, another is damaged and a sealed segment with an intact sidecar is
+/// damaged.
+#[tokio::test(start_paused = true)]
+async fn audit_y4_retries_survive_a_respawn_with_damaged_sidecars_and_segments() {
+    let fx = Fixture::with_options(
+        small_segments(),
+        |config| config.dedup_lru_capacity = 100,
+        None,
+    )
+    .await;
+    let sender = fx.sender().await;
+    let writer = ClientId::new("writer").unwrap();
+    register(&sender, &writer).await;
+    // Segments 1-2, 3-4, 5-6 and 7-8; 9 stays in active.wal.
+    for n in 1..=9u8 {
+        commit(&sender, &writer, mutation(n), seq(0), insert_op(n.into()))
+            .await
+            .unwrap();
+    }
+    fx.manager.shutdown_all().await;
+    let segments = fx.room_dir().join("segments");
+    let ids =
+        |start, end| crate::log::segment_index::mutation_ids_path(&segments, seq(start), seq(end));
+    fs::remove_file(ids(3, 4)).unwrap();
+    let mut sidecar = fs::read(ids(5, 6)).unwrap();
+    sidecar[17] ^= 0xFF;
+    fs::write(ids(5, 6), sidecar).unwrap();
+    let damaged = segment_path(&segments, seq(7), seq(8), Tier::Warm);
+    let mut bytes = fs::read(&damaged).unwrap();
+    bytes[20] ^= 0xFF;
+    fs::write(&damaged, bytes).unwrap();
+
+    let sender = fx.sender().await;
+    for n in 1..=9u8 {
+        let retry = retry_outcome(&sender, &writer, mutation(n), seq(0)).await;
+        assert_eq!(retry, (Ok(n.into()), 9), "retry of mutation {n}");
+    }
+    fx.manager.shutdown_all().await;
+}
