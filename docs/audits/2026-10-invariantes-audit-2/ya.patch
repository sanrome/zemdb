+// Second invariant audit (group ya): isolation inside the room.
+
+/// INV-A3: an upload in progress at sequence S that another member started is replaced, at S,
+/// only by its uploader or by the snapshot worker, whatever the kind of the new upload: chunked,
+/// of one chunk or in one request.
+#[tokio::test]
+async fn audit_a3_an_upload_at_the_same_seq_yields_alike_to_every_kind_of_upload() {
+    let one_chunk = |uploader: Uploader, fill: u8| {
+        let data = envelope(100, fill);
+        let hash = ServerMessage::compute_snapshot_hash(&data);
+        SnapshotChunkUpload {
+            uploader,
+            ..part(10, 0, (data.len() as u64, 1), hash, &data)
+        }
+    };
+    for kind in ["chunked", "one chunk", "one request"] {
+        for (who, replaces) in [
+            (member("mallory"), false),
+            (member("alice"), true),
+            (Uploader::Admin, true),
+        ] {
+            let dir = tempdir().unwrap();
+            let relay = open(&dir);
+            let alice = three_part_snapshot(1);
+            relay
+                .stage_chunk(part_by(member("alice"), 10, 0, &alice), bounds(0, 10))
+                .await
+                .unwrap();
+
+            let other = three_part_snapshot(2);
+            let result = match kind {
+                "chunked" => relay
+                    .stage_chunk(part_by(who.clone(), 10, 0, &other), bounds(0, 10))
+                    .await
+                    .map(drop),
+                "one chunk" => relay
+                    .stage_chunk(one_chunk(who.clone(), 3), bounds(0, 10))
+                    .await
+                    .map(drop),
+                _ => relay
+                    .stage_snapshot(
+                        &room(),
+                        &who,
+                        seq(10),
+                        Bytes::from(envelope(100, 4)),
+                        bounds(0, 10),
+                    )
+                    .await
+                    .map(drop),
+            };
+            let alices_upload_survives = relay
+                .slot(&room())
+                .lock()
+                .await
+                .upload
+                .as_ref()
+                .is_some_and(|upload| {
+                    upload.uploader == member("alice") && upload.snapshot_hash == alice.2
+                });
+            assert_eq!(
+                (result.is_ok(), alices_upload_survives),
+                (replaces, !replaces),
+                "{kind} upload by {who:?} at Alice's sequence: {result:?}"
+            );
+        }
+    }
+}
