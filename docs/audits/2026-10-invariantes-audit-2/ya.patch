+/// INV-Y4: copies of the same commit sent at once, through the manager and across a respawn,
+/// are sequenced once.
+#[tokio::test]
+async fn audit_y4_concurrent_copies_of_a_commit_are_sequenced_once() {
+    let fx = Fixture::new(small_segments()).await;
+    let writer = ClientId::new("writer").unwrap();
+    register(&fx.sender().await, &writer).await;
+    let manager = &fx.manager;
+    let room_id = &fx.room_id;
+    for round in 0..4u8 {
+        let copies = (0..5).map(|_| {
+            manager.ask(room_id, |reply| RoomCommand::Commit {
+                client_id: writer.clone(),
+                mutation_id: mutation(round + 1),
+                last_ack_seq: seq(0),
+                op: insert_op(round.into()),
+                reply,
+            })
+        });
+        let assigned: Vec<u64> = futures::future::join_all(copies)
+            .await
+            .into_iter()
+            .map(|reply| reply.unwrap().unwrap().assigned_seq.get())
+            .collect();
+        assert_eq!(assigned, vec![u64::from(round) + 1; 5], "round {round}");
+        if round % 2 == 1 {
+            manager.shutdown_all().await;
+        }
+    }
+    assert_eq!(metrics(&fx.sender().await).await.head_seq, seq(4));
+    fx.manager.shutdown_all().await;
+}
