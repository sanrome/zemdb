+// Second invariant audit (group ya): idempotency and isolation inside the room.
+
+/// The outcome of a retry of `mutation_id` by `client_id` with cursor `last_ack_seq`: its
+/// sequence (or the error) and the head right after.
+async fn retry_outcome(
+    sender: &mpsc::Sender<RoomCommand>,
+    client_id: &ClientId,
+    mutation_id: MutationId,
+    last_ack_seq: SequenceNumber,
+) -> (Result<u64, String>, u64) {
+    let retried = commit(sender, client_id, mutation_id, last_ack_seq, insert_op(1)).await;
+    let assigned = retried
+        .map(|ack| ack.assigned_seq.get())
+        .map_err(|err| err.to_string());
+    (assigned, metrics(sender).await.head_seq.get())
+}
