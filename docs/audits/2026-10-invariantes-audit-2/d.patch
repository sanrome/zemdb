+/// INV-D1, the same with a rotation by count right after commit 6: the open succeeds, but the
+/// sealed segment holds 1..=4 and 6 under the name 1..=6. Reads count sequences from the name,
+/// so a read from 5 skips commit 6 as if it were 5 and finds nothing: `BehindCompaction`.
+#[test]
+fn audit_d1_commit_after_a_damaged_last_frame_below_the_sealed_end_is_readable() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    append_range(&mut log, 1, 4);
+    let active = segments_dir(dir.path()).join("active.wal");
+    crate::fail_point::arm("exists", &active);
+    let outcome = log.append(make_op(5), Some(mutation_for(5))).unwrap();
+    assert!(outcome.rotation_error.is_some());
+    drop(log);
+    audit_damage_frame_at(&active, 4);
+
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    assert_eq!(log.head_seq().get(), 5);
+    // Commit 6 is acknowledged; it fills active.wal, which is sealed as 1..=6.
+    let outcome = log.append(make_op(6), Some(mutation_for(6))).unwrap();
+    assert!(outcome.rotation_error.is_none());
+    drop(log);
+
+    let (log, mutations) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    assert_eq!(log.head_seq().get(), 6);
+    assert!(mutations.contains(&(mutation_for(6), SequenceNumber::new(6))));
+    // 5 is a gap (the damaged frame): a read from 5 must return commit 6.
+    let (ops, _) = log
+        .fetch_deltas(SequenceNumber::new(5), 10)
+        .unwrap_or_else(|e| {
+            panic!("INV-D1: commit 6 was acknowledged and a read from 5 fails: {e}")
+        });
+    assert_eq!(seqs(&ops), vec![6], "INV-D1: the acknowledged commit 6");
+}
