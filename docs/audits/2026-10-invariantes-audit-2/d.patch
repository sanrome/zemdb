+/// INV-D1: a crash between recording the end of a rotation in `log_meta.json` and renaming
+/// `active.wal` leaves `sealed_through_seq` at the end of `active.wal`. If the last frame of
+/// `active.wal` is then damaged (accidental corruption of a synced frame), the open truncates it
+/// as a torn write while `head_seq` stays at the recorded end (INV-D8). The next commit is then
+/// appended to the same `active.wal` after the missing sequence, and the open after it fails:
+/// that acknowledged commit is no longer reachable.
+#[test]
+fn audit_d1_commit_after_a_damaged_last_frame_below_the_sealed_end_survives_a_reopen() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy::default();
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    append_range(&mut log, 1, 5);
+    let active = segments_dir(dir.path()).join("active.wal");
+    // The rotation records 5 as the sealed end, then stops before the rename.
+    crate::fail_point::arm("exists", &active);
+    assert!(log.force_rotate_warm().is_err());
+    drop(log);
+    audit_damage_frame_at(&active, 4);
+
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    assert_eq!(
+        log.head_seq().get(),
+        5,
+        "5 is in log_meta.json, so it is not reused"
+    );
+    // Commit 6 is acknowledged.
+    let outcome = log.append(make_op(6), Some(mutation_for(6))).unwrap();
+    assert!(outcome.rotation_error.is_none());
+    drop(log);
+
+    let (log, mutations) = TieredLog::open_or_create(dir.path(), policy).unwrap_or_else(|e| {
+        panic!("INV-D1: commit 6 was acknowledged, and the room no longer opens: {e}")
+    });
+    assert_eq!(log.head_seq().get(), 6);
+    assert!(mutations.contains(&(mutation_for(6), SequenceNumber::new(6))));
+    let (ops, _) = log
+        .fetch_deltas(SequenceNumber::new(5), 10)
+        .unwrap_or_else(|e| panic!("INV-D1: commit 6 was acknowledged and cannot be read: {e}"));
+    assert_eq!(seqs(&ops), vec![6]);
+}
