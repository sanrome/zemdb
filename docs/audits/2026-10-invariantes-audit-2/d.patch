+/// Flips a payload byte of the `index`-th frame of the file at `path`.
+fn audit_damage_frame_at(path: &Path, index: usize) {
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(path)
+        .unwrap();
+    damage_payload(&file, index);
+}
