+
+/// INV-D7: a schema write whose directory sync failed leaves `schemas/{id}.json` renamed into
+/// place but with an entry no `fsync` covered; the registration fails. After a restart the
+/// registry reads that entry back and serves the schema (rooms can be created on it and accept
+/// commits), yet no `fsync` of this process covered it, so a power loss can still take it away.
+/// The same holds for the version an `add_column` whose sync failed wrote.
+#[test]
+fn audit_d7_schema_left_unsynced_by_a_failed_write_is_not_served_unsynced_after_a_restart() {
+    // A registration whose directory sync failed.
+    let dir = tempdir().unwrap();
+    let id = SchemaId::new("todo").unwrap();
+    let registry = SchemaRegistry::new(dir.path()).unwrap();
+    fail_point::arm("sync_dir", dir.path());
+    assert!(registry.register_schema(id.clone(), test_schema()).is_err());
+    assert!(registry.get_schema(&id).is_none());
+    drop(registry);
+
+    // The restart: if it syncs `schemas/`, this sync fails and so does the startup.
+    fail_point::arm("sync_dir", dir.path());
+    let restarted = SchemaRegistry::new(dir.path());
+    let served = restarted
+        .as_ref()
+        .ok()
+        .and_then(|registry| registry.get_schema(&id));
+    // Consume the point if the restart did not.
+    let _ = durable::sync_dir(dir.path());
+    assert!(
+        served.is_none(),
+        "INV-D7: schema {id} is served after a restart, but no fsync of this process covered its \
+         directory entry (the only sync of it failed)"
+    );
+
+    // An `add_column` whose directory sync failed.
+    let (dir, id, registry) = todo_registry();
+    fail_point::arm("sync_dir", dir.path());
+    assert!(registry
+        .add_column(&id, "tasks", nullable_int("priority"))
+        .is_err());
+    drop(registry);
+    fail_point::arm("sync_dir", dir.path());
+    let restarted = SchemaRegistry::new(dir.path());
+    let served = restarted
+        .as_ref()
+        .ok()
+        .and_then(|registry| registry.get_schema(&id));
+    let _ = durable::sync_dir(dir.path());
+    assert!(
+        !served.is_some_and(|schema| has_column(&schema, "priority")),
+        "INV-D7: version 2 of {id} is served after a restart, but no fsync of this process \
+         covered the rename that installed it"
+    );
+}
