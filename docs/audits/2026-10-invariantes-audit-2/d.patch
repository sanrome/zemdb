+/// INV-D8: a rotation interrupted at any of its steps (recording its end, the rename, the sync
+/// of `segments/`, the sidecar, the creation of the next `active.wal`), followed by a crash and
+/// the loss of the newest segment and its sidecar, never takes `head_seq` below 5, and the next
+/// commit gets 6.
+#[test]
+fn audit_d8_rotation_interrupted_at_any_step_never_lowers_the_head() {
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    let steps: [(&str, fn(&Path) -> PathBuf); 6] = [
+        ("write_atomic_before_rename", |d| d.join("log_meta.json")),
+        ("sync_dir", |d| d.to_path_buf()),
+        ("exists", |d| segments_dir(d).join("active.wal")),
+        ("sync_dir", segments_dir),
+        ("write_atomic_before_rename", |d| {
+            segment_file(&segments_dir(d), 1, 5, "ids")
+        }),
+        ("none", |d| d.to_path_buf()),
+    ];
+    for (point, path) in steps {
+        for next_append_fails in [false, true] {
+            let dir = tempdir().unwrap();
+            let case = format!(
+                "{point} of {:?}, next append fails: {next_append_fails}",
+                path(dir.path())
+            );
+            let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+            append_range(&mut log, 1, 4);
+            if point != "none" {
+                crate::fail_point::arm(point, &path(dir.path()));
+            }
+            // Commit 5 is durable whatever the rotation does.
+            let _ = log.append(make_op(5), Some(mutation_for(5))).unwrap();
+            if next_append_fails {
+                // The new active.wal cannot be made durable: commit 6 is not acknowledged.
+                crate::fail_point::arm("sync_dir", &segments_dir(dir.path()));
+                let _ = log.append(make_op(6), Some(mutation_for(6)));
+            }
+            drop(log);
+            let segments = segments_dir(dir.path());
+            for ext in ["wal", "ids"] {
+                let _ = std::fs::remove_file(segment_file(&segments, 1, 5, ext));
+            }
+
+            let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone())
+                .unwrap_or_else(|e| panic!("{case}: {e}"));
+            assert!(log.head_seq().get() >= 5, "{case}: head {}", log.head_seq());
+            assert!(log.append(make_op(5), None).is_err(), "{case}: 5 reused");
+            let next = log.head_seq().get() + 1;
+            log.append(make_op(next), None)
+                .unwrap_or_else(|e| panic!("{case}: {e}"));
+        }
+    }
+}
