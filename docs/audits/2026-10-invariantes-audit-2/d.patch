+/// Offset of the last frame of the WAL file `bytes`.
+fn audit_last_frame_offset(bytes: &[u8]) -> usize {
+    let mut offset = 0;
+    let mut last = 0;
+    while offset < bytes.len() {
+        let header =
+            zemdb_core::parse_batch_header(bytes[offset..].first_chunk().unwrap()).unwrap();
+        last = offset;
+        offset += header.frame_len();
+    }
+    last
+}
+
+/// INV-D3 and INV-D7 with the atomic absorption (D85): an absorption renamed its copy over
+/// `.wal.compacting` and stopped before emptying the active WAL (a crash there leaves the same
+/// files), and then the last frame of `.wal.compacting` was damaged. That frame is the copy of a
+/// batch the active WAL still holds: recovery takes the damage as a torn tail of `.wal.compacting`
+/// and replays the batch from the active WAL, so no confirmed batch is lost, and the recovered
+/// state is durable (folded into a synced snapshot) before the room is served.
+#[tokio::test]
+async fn audit_d3_damaged_tail_of_an_absorbed_copy_is_recovered_from_the_active_wal() {
+    for damage in ["payload", "zeroed-to-the-end"] {
+        let dir = tempfile::tempdir().unwrap();
+        let room = RoomId::new("absorbed").unwrap();
+        let engine = open_engine(dir.path(), &room).await;
+        apply_range(&engine, &room, 1..=5).await;
+        fail_compaction_leaving_compacting_wal(&engine, &room).await;
+        apply_range(&engine, &room, 6..=8).await;
+        let wal_path = engine.wal_file_path(&room);
+        fail_point::arm("compaction.absorb", &wal_path);
+        assert!(engine.compact_room(&room).await.is_err());
+        drop(engine);
+
+        let compacting = compacting_wal_path(&wal_path);
+        let mut bytes = std::fs::read(&compacting).unwrap();
+        let last = audit_last_frame_offset(&bytes);
+        match damage {
+            "payload" => bytes[last + zemdb_core::BATCH_HEADER_SIZE + 2] ^= 0xFF,
+            _ => bytes[last..].fill(0),
+        }
+        std::fs::write(&compacting, bytes).unwrap();
+
+        let engine = engine_at(dir.path());
+        engine.open_room(&room, schema()).await.unwrap();
+        assert_rows(&engine, &room, 8).await;
+        assert!(
+            !compacting.exists(),
+            "{damage}: .wal.compacting is folded away"
+        );
+        // What was served came from a snapshot this open wrote and synced.
+        engine.close_room(&room).await.unwrap();
+        let engine = engine_at(dir.path());
+        engine.open_room(&room, schema()).await.unwrap();
+        assert_rows(&engine, &room, 8).await;
+    }
+}
