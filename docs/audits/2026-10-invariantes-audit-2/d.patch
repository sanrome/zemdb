+/// INV-D8: a prune whose write of `log_meta.json` fails (before or after its rename) deletes
+/// nothing, and the log keeps going: a later rotation rewrites `log_meta.json` from the values in
+/// memory, a later prune succeeds, and reopening keeps the head and every retained operation.
+/// The three prunes: by cursors, by the cold TTL and by the quota.
+#[test]
+fn audit_d8_prune_that_fails_to_record_its_floor_deletes_nothing() {
+    #[derive(Clone, Copy, Debug)]
+    enum Prune {
+        Cursor,
+        Ttl,
+        Quota,
+    }
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        warm_disk_ttl: Duration::ZERO,
+        cold_disk_ttl: Duration::from_secs(3600),
+        ..RoomLifecyclePolicy::default()
+    };
+    let expired = MaintenanceClock::after(Duration::from_secs(7200));
+    for prune in [Prune::Cursor, Prune::Ttl, Prune::Quota] {
+        for (point, after_rename) in [("write_atomic_before_rename", false), ("sync_dir", true)] {
+            let dir = tempdir().unwrap();
+            let case = format!("{prune:?} prune, {point}");
+            let meta = dir.path().join("log_meta.json");
+            let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+            // Segments 1..=5, 6..=10 and 11..=15, compressed; 16..=17 in active.wal.
+            append_range(&mut log, 1, 17);
+            log.run_maintenance_sync().unwrap();
+            let before: Vec<PathBuf> = log.segments.iter().map(|s| s.path.clone()).collect();
+            assert_eq!(before.len(), 3);
+
+            let fail_at = if after_rename {
+                dir.path().to_path_buf()
+            } else {
+                meta.clone()
+            };
+            crate::fail_point::arm(point, &fail_at);
+            let result = match prune {
+                Prune::Cursor => log.prune_older_than(SequenceNumber::new(11)).map(|_| ()),
+                Prune::Ttl => log.run_maintenance_sync_at(expired).map(|_| ()),
+                Prune::Quota => {
+                    log.policy.max_room_disk_bytes = 1;
+                    log.run_maintenance_sync().map(|_| ())
+                }
+            };
+            assert!(result.is_err(), "{case}: the failure was not reported");
+            for path in &before {
+                assert!(
+                    path.exists(),
+                    "{case}: {path:?} deleted without a durable floor"
+                );
+            }
+            assert_eq!(log.tail_seq().get(), 1, "{case}");
+            log.policy.max_room_disk_bytes = u64::MAX / 4;
+
+            // The room keeps going: a rotation (which writes log_meta.json from memory), then a
+            // successful prune.
+            append_range(&mut log, 18, 20);
+            log.prune_older_than(SequenceNumber::new(6)).unwrap();
+            assert_eq!(log.tail_seq().get(), 6, "{case}");
+            drop(log);
+
+            let (log, mutations) = TieredLog::open_or_create(dir.path(), policy.clone())
+                .unwrap_or_else(|e| panic!("{case}: {e}"));
+            assert_eq!(log.head_seq().get(), 20, "{case}");
+            let tail = log.tail_seq().get();
+            assert!(tail == 6, "{case}: tail {tail}");
+            let (ops, _) = log
+                .fetch_deltas(SequenceNumber::new(tail - 1), 100)
+                .unwrap();
+            assert_contiguous(&ops, tail, 20);
+            assert_eq!(mutations.len(), (21 - tail) as usize, "{case}");
+        }
+    }
+}
