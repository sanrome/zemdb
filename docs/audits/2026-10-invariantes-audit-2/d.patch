+/// INV-D8 and INV-D1: a prune whose floor was renamed into place but whose directory sync
+/// failed, followed by a crash, is finished by the open (it was a legitimate prune), and the
+/// head and the operations above the floor stay.
+#[test]
+fn audit_d8_prune_interrupted_after_recording_its_floor_is_finished_by_the_open() {
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    let dir = tempdir().unwrap();
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    append_range(&mut log, 1, 12);
+    crate::fail_point::arm("sync_dir", dir.path());
+    assert!(log.prune_older_than(SequenceNumber::new(11)).is_err());
+    drop(log);
+
+    let (log, _) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    assert_eq!(log.head_seq().get(), 12);
+    assert_eq!(log.tail_seq().get(), 11);
+    let (ops, _) = log.fetch_deltas(SequenceNumber::new(10), 100).unwrap();
