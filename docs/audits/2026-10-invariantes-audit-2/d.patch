+/// Flips a payload byte of the `index`-th frame of the WAL file at `path`.
+fn audit_damage_frame(path: &std::path::Path, index: usize) {
+    use zemdb_core::protocol::wal_frame::{parse_batch_header, BATCH_HEADER_SIZE};
+    let mut bytes = fs::read(path).unwrap();
+    let mut offset = 0;
+    for _ in 0..index {
+        let header = parse_batch_header(bytes[offset..].first_chunk().unwrap()).unwrap();
+        offset += header.frame_len();
+    }
+    bytes[offset + BATCH_HEADER_SIZE] ^= 0xFF;
+    fs::write(path, bytes).unwrap();
+}
+
+/// INV-D1: commit 3 is acknowledged and its rotation stops after recording its end in
+/// `log_meta.json`, before the rename (a crash at that point leaves the same files). The last
+/// frame of `active.wal` (commit 3, synced) is then damaged by accident. The respawn truncates it
+/// as a torn write and keeps `head_seq` at 3 (INV-D8), so commit 4 is acknowledged with sequence
+/// 4, but it goes into the same `active.wal`, after a hole: sealed as `1..=4`, it is read as
+/// sequence 3, and no read can return it.
+// Paused time: no maintenance tick runs.
+#[tokio::test(start_paused = true)]
+async fn audit_d1_commit_acknowledged_after_a_truncated_frame_below_the_sealed_end_is_served() {
+    let policy = RoomLifecycleOverrides {
+        ram_max_ops: Some(3),
+        ..RoomLifecycleOverrides::default()
+    };
+    let fx = Fixture::new(policy).await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+    for i in 1..=2u8 {
+        commit(
+            &sender,
+            &client,
+            mutation(i),
+            seq(u64::from(i) - 1),
+            insert_op(i64::from(i)),
+        )
+        .await
+        .unwrap();
+    }
+    let active = fx.room_dir().join("segments").join("active.wal");
+    fail_point::arm("exists", &active);
+    let acked = commit(&sender, &client, mutation(3), seq(2), insert_op(3)).await;
+    assert_eq!(acked.unwrap().assigned_seq, seq(3));
+    assert!(
+        sender.is_closed(),
+        "the room restarts after the failed rotation"
+    );
+    fx.manager.shutdown_all().await;
+    audit_damage_frame(&active, 2);
+
+    let recovered = fx.sender().await;
+    assert_eq!(
+        metrics(&recovered).await.head_seq,
+        seq(3),
+        "3 is not reused"
+    );
+    let acked = commit(&recovered, &client, mutation(4), seq(3), insert_op(4)).await;
+    assert_eq!(acked.unwrap().assigned_seq, seq(4));
+    fx.manager.shutdown_all().await;
+
+    let reopened = fx.sender().await;
+    let (tx, rx) = oneshot::channel();
+    reopened
+        .send(RoomCommand::Sync {
+            client_id: client.clone(),
+            from_seq: seq(3),
+            max_batch_size: 100,
+            reply: tx,
+        })
+        .await
+        .unwrap();
+    let synced = rx.await.unwrap().unwrap_or_else(|e| {
+        panic!("INV-D1: CommitAck 4 was sent, and a sync from 3 after a reopen fails: {e}")
+    });
+    let seqs: Vec<u64> = synced.ops.iter().map(|op| op.seq.get()).collect();
+    assert_eq!(seqs, vec![4], "INV-D1: the acknowledged commit 4");
+    fx.manager.shutdown_all().await;
+}
