+/// INV-D1 and INV-D8 under D69: the quota prunes warm segments (one that cannot be compressed
+/// and recent ones) in the same pass that compresses others, and fails between deleting a
+/// sidecar and its segment, or between a segment and the next. Reopening finishes the prune and
+/// keeps the head and every operation above the floor; nothing below it comes back.
+#[test]
+fn audit_d1_quota_prune_of_warm_segments_interrupted_keeps_the_rest() {
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    for (index, ext) in [
+        (0, "ids"),
+        (0, "wal"),
+        (1, "ids"),
+        (1, "wal.zst"),
+        (2, "wal.zst"),
+    ] {
+        let dir = tempdir().unwrap();
+        let case = format!("removal of segment {index}'s {ext} fails");
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        // Six warm segments of five; 31..=32 in active.wal.
+        append_range(&mut log, 1, 32);
+        let segments = segments_dir(dir.path());
+        // The first segment cannot be compressed, so it stays warm in front of the others.
+        audit_damage_frame_at(&segment_file(&segments, 1, 5, "wal"), 2);
+        let start = 1 + 5 * index as u64;
+        let doomed = segment_file(&segments, start, start + 4, ext);
+        crate::fail_point::arm("remove_file", &doomed);
+
+        // Over the quota: every warm is due, so this pass compresses 2..=4 (1 fails), and the
+        // quota then prunes the oldest prefix, warm 1 and cold 2..=4, keeping the last two.
+        let keep = log
+            .segments
+            .iter()
+            .skip(4)
+            .map(|s| s.disk_bytes())
+            .sum::<u64>();
+        log.policy.max_room_disk_bytes = keep + log.warm_disk.active_len();
+        let _ = log.run_maintenance_sync();
+        assert!(
+            count_in(&log, Tier::Cold) >= 1,
+            "{case}: nothing compressed"
+        );
+        drop(log);
+
+        let (log, mutations) = TieredLog::open_or_create(dir.path(), policy.clone())
+            .unwrap_or_else(|e| panic!("{case}: {e}"));
+        assert_eq!(log.head_seq().get(), 32, "{case}");
+        let tail = log.tail_seq().get();
+        assert!(tail <= 21 + 1, "{case}: tail {tail} over the quota's floor");
+        let (ops, _) = log
+            .fetch_deltas(SequenceNumber::new(tail - 1), 100)
+            .unwrap_or_else(|e| panic!("{case}: tail {tail}: {e}"));
+        assert_contiguous(&ops, tail, 32);
+        for seq in tail..=32 {
+            assert!(
+                mutations.contains(&(mutation_for(seq), SequenceNumber::new(seq))),
+                "{case}: mutation {seq} missing"
+            );
+        }
+        for path in std::fs::read_dir(&segments).unwrap() {
+            let name = path.unwrap().file_name().into_string().unwrap();
+            if let Some(end) = name
+                .strip_prefix("segment_")
+                .and_then(|rest| rest.split('_').nth(1))
+                .and_then(|end| end.split('.').next())
+                .and_then(|end| end.parse::<u64>().ok())
+            {
+                assert!(end >= tail, "{case}: {name} left below the tail {tail}");
+            }
+        }
+    }
+}
+
+/// Where a fail point can be armed in the log at `dir` right now: the files every step touches,
+/// the files of each indexed segment, and those of the next rotation.
+fn audit_fail_points(log: &TieredLog, dir: &Path) -> Vec<(&'static str, PathBuf)> {
+    let segments = segments_dir(dir);
+    let active = segments.join("active.wal");
+    let mut points = vec![
+        ("warm_append_write", active.clone()),
+        ("warm_append_sync", active.clone()),
+        ("warm_open_sync", active.clone()),
+        ("exists", active.clone()),
+        ("sync_dir", segments.clone()),
+        ("sync_dir", dir.to_path_buf()),
+        ("write_atomic_before_rename", dir.join("log_meta.json")),
+    ];
+    for segment in log.segments.iter() {
+        let (start, end) = (segment.start_seq.get(), segment.end_seq.get());
+        points.push(("remove_file", segment.path.clone()));
+        points.push(("remove_file", segment_file(&segments, start, end, "ids")));
+        if segment.tier == Tier::Warm {
+            points.push(("compress_after_warm_removed", segment.path.clone()));
+            points.push((
+                "remove_file",
+                segment_file(&segments, start, end, "wal.zst.tmp"),
+            ));
+        }
+    }
+    if let (Some(start), Some(end)) = (
+        log.warm_disk.active_start_seq(),
+        log.warm_disk.active_end_seq(),
+    ) {
+        for end in [end.get(), start.get() + log.policy.ram_max_ops as u64 - 1] {
+            points.push((
+                "write_atomic_before_rename",
+                segment_file(&segments, start.get(), end, "ids"),
+            ));
+        }
+    }
+    points
+}
