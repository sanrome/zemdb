+/// Review of 4.1: a rotation whose move succeeds and whose reopening fails leaves a dead handle
+/// (as the OPFS can, DC17). The room is not failed by the rotation; the next write fails and marks
+/// it, nothing acknowledged is lost, and the room reopens with every row.
+#[tokio::test]
+async fn review_rotation_that_leaves_a_dead_handle_loses_nothing() {
+    use std::sync::atomic::Ordering;
+    let dir = tempfile::tempdir().unwrap();
+    let layer = OpfsLikeFiles::new(dir.path());
+    let room = RoomId::new("opfs-dead-handle").unwrap();
+    let engine = open_on(&layer, &room).await;
+    let wal_path = engine.wal_file_path(&room);
+    apply_range(&engine, &room, 1..=5).await;
+
+    layer.fail_reopen.store(true, Ordering::SeqCst);
+    let compacted = engine.compact_room(&room).await;
+    assert!(compacted.is_err(), "{compacted:?}");
+    assert!(layer.real(&compacting_wal_path(&wal_path)).exists());
+    assert!(!layer.real(&wal_path).exists());
+    // Readers still see every acknowledged row.
+    assert_rows(&engine, &room, 5).await;
+    // The next write fails on the dead handle and marks the room failed.
+    let write = engine.apply_batch(&room, vec![insert(6)]).await;
+    assert!(write.is_err(), "{write:?}");
+    assert_room_failed(&engine, &room, 6).await;
+    let closed = engine.close_room(&room).await;
+    eprintln!("close_room after a dead handle: {closed:?}");
+    drop(engine);
+
+    let engine = open_on(&layer, &room).await;
+    assert_rows(&engine, &room, 5).await;
+    apply_range(&engine, &room, 6..=7).await;
+    engine.compact_room(&room).await.unwrap();
+    let engine = reopen_on(engine, &layer, &room).await;
+    assert_rows(&engine, &room, 7).await;
+    assert!(layer.refused().is_empty(), "{:?}", layer.refused());
+}
+
+/// Review of 4.1: the same with an absorption pending: nothing renames the WAL, so no dead handle.
+/// A rollback whose reopening fails leaves the room failed.
+#[tokio::test]
+async fn review_rollback_that_leaves_a_dead_handle_marks_the_room_failed() {
+    use std::sync::atomic::Ordering;
+    let dir = tempfile::tempdir().unwrap();
+    let layer = OpfsLikeFiles::new(dir.path());
+    let room = RoomId::new("opfs-dead-rollback").unwrap();
+    let engine = open_on(&layer, &room).await;
+    let wal_path = engine.wal_file_path(&room);
+    apply_range(&engine, &room, 1..=5).await;
+
+    fail_point::arm("compaction.rotate_open", &wal_path);
+    // The rotation moves and reopens fine; the rollback moves back and fails to reopen.
+    let mut renamed = fail_point::arm_pause("compaction.rotate_renamed", &wal_path);
+    let compaction = {
+        let (engine, room) = (engine.clone(), room.clone());
+        tokio::spawn(async move { engine.compact_room(&room).await })
+    };
+    tokio::time::timeout(Duration::from_secs(10), renamed.reached()).await.unwrap();
+    layer.fail_reopen.store(true, Ordering::SeqCst);
+    renamed.release();
+    assert!(compaction.await.unwrap().is_err());
+    assert_room_failed(&engine, &room, 6).await;
+    let _ = engine.close_room(&room).await;
+    drop(engine);
+    let engine = open_on(&layer, &room).await;
+    assert_rows(&engine, &room, 5).await;
+}
