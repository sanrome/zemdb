@@ -0,0 +1,121 @@
+//! Review of Lote 12: a `Registered` that answers its registration but carries another tail.
+
+mod common;
+
+use async_trait::async_trait;
+use common::*;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tempfile::tempdir;
+use zemdb_client::{
+    Client, ClientConfig, ClientError, FileMetadata, TransportClient, TransportError,
+};
+use zemdb_core::*;
+
+/// The transport of the server, which changes the tail of the next `Registered` it carries.
+#[derive(Debug, Clone)]
+struct Tamper {
+    inner: TestTransport,
+    tail: Arc<Mutex<Option<u64>>>,
+}
+
+#[async_trait]
+impl TransportClient for Tamper {
+    async fn send(&self, message: &ClientMessage, token: &str) -> Result<Vec<u8>, TransportError> {
+        let reply = self.inner.send(message, token).await?;
+        let decoded = decode_message::<ServerMessage>(&reply);
+        let mut tail = self.tail.lock().unwrap();
+        match (decoded, *tail) {
+            (
+                Ok(ServerMessage::Registered {
+                    correlation_id,
+                    room_id,
+                    head_seq,
+                    schema_id,
+                    schema,
+                    active_snapshot_seq,
+                    room_incarnation,
+                    ..
+                }),
+                Some(damaged),
+            ) => {
+                *tail = None;
+                let damaged = ServerMessage::Registered {
+                    correlation_id,
+                    room_id,
+                    head_seq,
+                    tail_seq: SequenceNumber::new(damaged),
+                    schema_id,
+                    schema,
+                    active_snapshot_seq,
+                    room_incarnation,
+                };
+                Ok(encode_message(&damaged).unwrap())
+            }
+            _ => Ok(reply),
+        }
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn review_a_damaged_tail_in_registered_leaves_the_replica_waiting_until_it_reopens() {
+    let server = TestServer::new();
+    let room_id = server.create_room("room-a").await;
+    server.commit(&room_id, 1..=3).await;
+    let dir = tempdir().unwrap();
+    let tamper = Tamper {
+        inner: server.transport(),
+        tail: Arc::default(),
+    };
+    let storage = engine(dir.path());
+    let client = Client::open(
+        ClientConfig::new("ana"),
+        storage.clone(),
+        FileMetadata::new(dir.path()),
+        tamper.clone(),
+    )
+    .await
+    .unwrap();
+    open_room(&client, &room_id).await.unwrap();
+    client.sync(room_id.clone()).await.unwrap();
+    assert_eq!(
+        client.status(room_id.clone()).await.unwrap().head_seq.get(),
+        3
+    );
+
+    // The next registration gets the server's `Registered` (head 6) with only its tail
+    // changed, to one the server could have: 5, as if it had pruned up to it.
+    client.close_room(room_id.clone()).await.unwrap();
+    server.commit(&room_id, 4..=6).await;
+    *tamper.tail.lock().unwrap() = Some(5);
+    open_room(&client, &room_id).await.unwrap();
+
+    // What the worker of 4.3 would do: syncs and heartbeats, for 10 minutes.
+    for round in 0..20 {
+        let synced = client.sync(room_id.clone()).await;
+        assert!(
+            matches!(synced, Err(ClientError::Network(_))),
+            "{round}: {synced:?}"
+        );
+        client.heartbeat(room_id.clone()).await.unwrap();
+        tokio::time::sleep(Duration::from_secs(30)).await;
+    }
+    let status = client.status(room_id.clone()).await.unwrap();
+    assert_eq!((status.head_seq.get(), status.registered), (3, true));
+    let written = client.write(room_id.clone(), insert_task(7)).await;
+    assert!(
+        matches!(written, Err(ClientError::Network(_))),
+        "{written:?}"
+    );
+    assert_eq!(tasks(&storage, &room_id).await, [1, 2, 3]);
+
+    // Only closing the room and opening it again gets it out.
+    client.close_room(room_id.clone()).await.unwrap();
+    open_room(&client, &room_id).await.unwrap();
+    client.sync(room_id.clone()).await.unwrap();
+    assert_eq!(
+        client.status(room_id.clone()).await.unwrap().head_seq.get(),
+        6
+    );
+    client.shutdown().await.unwrap();
+}
