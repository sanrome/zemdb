@@ -0,0 +1,78 @@
+//! Review of Lote 12, round 2: an error without a correlation id or a room in place of a reply.
+
+mod common;
+
+use async_trait::async_trait;
+use common::*;
+use std::sync::{Arc, Mutex};
+use tempfile::tempdir;
+use zemdb_client::{
+    Client, ClientConfig, ClientError, FileMetadata, TransportClient, TransportError,
+};
+use zemdb_core::*;
+
+/// The transport of the server, which puts `SchemaViolation` without a correlation id or a room
+/// in place of the server's reply to the next commit, once the server handled it.
+#[derive(Debug, Clone)]
+struct Tamper {
+    inner: TestTransport,
+    armed: Arc<Mutex<bool>>,
+}
+
+#[async_trait]
+impl TransportClient for Tamper {
+    async fn send(&self, message: &ClientMessage, token: &str) -> Result<Vec<u8>, TransportError> {
+        let reply = self.inner.send(message, token).await?;
+        let mut armed = self.armed.lock().unwrap();
+        if matches!(message, ClientMessage::Commit { .. }) && std::mem::take(&mut *armed) {
+            let error = ServerMessage::Error {
+                correlation_id: None,
+                room_id: None,
+                code: ErrorCode::SchemaViolation,
+                message: String::new(),
+            };
+            return Ok(encode_message(&error).unwrap());
+        }
+        Ok(reply)
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn review_an_error_without_correlation_ends_a_sequenced_write_as_refused() {
+    let server = TestServer::new();
+    let room_id = server.create_room("room-a").await;
+    let dir = tempdir().unwrap();
+    let tamper = Tamper {
+        inner: server.transport(),
+        armed: Arc::default(),
+    };
+    let storage = engine(dir.path());
+    let client = Client::open(
+        ClientConfig::new("ana"),
+        storage.clone(),
+        FileMetadata::new(dir.path()),
+        tamper.clone(),
+    )
+    .await
+    .unwrap();
+    open_room(&client, &room_id).await.unwrap();
+
+    *tamper.armed.lock().unwrap() = true;
+    let written = client.write(room_id.clone(), insert_task(1)).await;
+    assert!(
+        matches!(written, Err(ClientError::Validation(_))),
+        "{written:?}"
+    );
+
+    // The server sequenced it, and the replica applies it.
+    let bounds = server
+        .state
+        .room_manager
+        .log_bounds(&room_id)
+        .await
+        .unwrap();
+    assert_eq!(bounds.head_seq.get(), 1);
+    client.sync(room_id.clone()).await.unwrap();
+    assert_eq!(tasks(&storage, &room_id).await, [1]);
+    client.shutdown().await.unwrap();
+}
diff --git a/crates/client/tests/review_tail_tests.rs b/crates/client/tests/review_tail_tests.rs
