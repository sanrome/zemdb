+/// Audit of sub-phase 4.2 (Lote 12): every room that a crash in the middle of `apply_snapshot`
+/// leaves (the snapshot staged, renamed over the old one, the WALs emptied or not), with a rotated
+/// WAL of an interrupted compaction under it, is deleted by `delete_room` through rooms that open
+/// at a prefix of its log, also if `delete_room` is cut at any point: the old log up to 8 (its
+/// snapshot at 3, with 4 and 5 rotated and 6 to 8 in the WAL), or the installed snapshot at 12,
+/// and what of either is left as files go. The suite crashes `delete_room` only over an
+/// interrupted compaction.
+#[cfg(unix)]
+#[tokio::test]
+async fn audit_s8_crash_at_any_point_of_delete_room_after_a_cut_snapshot_install_leaves_a_prefix() {
+    let dir = tempfile::tempdir().unwrap();
+    let (data, images) = (dir.path().join("data"), dir.path().join("images"));
+    let room = RoomId::new("installed").unwrap();
+    let engine = open_engine(&data, &room).await;
+    apply_range(&engine, &room, 1..=3).await;
+    engine.compact_room(&room).await.unwrap();
+    apply_range(&engine, &room, 4..=5).await;
+    fail_compaction_leaving_compacting_wal(&engine, &room).await;
+    apply_range(&engine, &room, 6..=8).await;
+    // The snapshot of another member at 12, of the same log.
+    let member = crate::MemoryStorageEngine::new();
+    member.open_room(&room, schema()).await.unwrap();
+    member
+        .apply_batch(&room, (1..=12).map(insert).collect())
+        .await
+        .unwrap();
+    let snapshot = member.create_snapshot(&room).await.unwrap();
+
+    fail_point::arm_crash_plan(
+        &data,
+        fail_point::CrashAction::CopyAtEveryPoint(images.clone()),
+    );
+    let installed = engine
+        .apply_snapshot(
+            &room,
+            schema(),
+            snapshot.into(),
+            zemdb_core::SequenceNumber::new(12),
+        )
+        .await;
+    let install_points = fail_point::disarm_crash_plan(&data);
+    assert_eq!(installed.unwrap().get(), 12);
+    engine.close_room(&room).await.unwrap();
+    assert!(install_points.len() > 3, "{install_points:?}");
+
+    let mut cases = Vec::new();
+    for n in 1..=install_points.len() + 1 {
+        // The files at the crash, and once `apply_snapshot` returned.
+        let image = match n {
+            n if n <= install_points.len() => images.join(n.to_string()),
+            _ => data.clone(),
+        };
+        let pristine = dir.path().join(format!("pristine-{n}"));
+        fail_point::copy_files(&image, &pristine);
+        let start = open_head(&image, &room).await;
+        assert!(start == 8 || start == 12, "image {n}: {start}");
+
+        // `delete_room` over the files as the crash left them, cut at every point.
+        let deleted = dir.path().join(format!("deleted-{n}"));
+        let cuts = dir.path().join(format!("cuts-{n}"));
+        fail_point::copy_files(&pristine, &deleted);
+        fail_point::arm_crash_plan(
+            &deleted,
+            fail_point::CrashAction::CopyAtEveryPoint(cuts.clone()),
+        );
+        engine_at(&deleted).delete_room(&room).await.unwrap();
+        let delete_points = fail_point::disarm_crash_plan(&deleted);
+        let mut heads = Vec::new();
+        for m in 1..=delete_points.len() {
+            heads.push(open_head(&cuts.join(m.to_string()), &room).await);
+        }
+        heads.dedup();
+        // Every head is one of the prefixes of the log the room had, in the order the files go.
+        assert!(
+            heads.windows(2).all(|w| w[0] > w[1]),
+            "image {n}: {heads:?}"
+        );
+        assert!(
+            heads.iter().all(|head| [12, 8, 5, 3, 0].contains(head)),
+            "image {n}: {heads:?}"
+        );
+        assert_eq!(open_head(&deleted, &room).await, 0, "image {n}");
+        cases.push((start, heads));
+    }
+    cases.dedup();
+    eprintln!(
+        "{} images of apply_snapshot: {cases:?}",
+        install_points.len()
+    );
+}
