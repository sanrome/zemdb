+
+// ---------------------------------------------------------------------------------------------
+// Audit of sub-phase 4.2 (Lote 12, group "Réplica y log")
+
+/// Audit (INV-K1, the epoch of the replica): a batch of the old room, asked for at head 0 before
+/// the room is created again, arrives once the room was closed and opened again with its
+/// metadata damaged meanwhile (a bit flipped), which discarded the replica and registered it in
+/// the new room. The batch follows the head of the new, empty replica, and is not applied: the
+/// replica holds only what the new room logged.
+#[tokio::test]
+async fn audit_a_batch_held_across_a_discard_for_damaged_metadata_is_not_applied() {
+    let dir = tempdir().unwrap();
+    let (server, room_id, transport, storage, client) = setup(dir.path(), engine(dir.path())).await;
+    server.commit(&room_id, 1..=3).await;
+    let mut held = transport.hold_next_reply(Sync);
+    let late = client.sync(room_id.clone());
+    let meanwhile = async {
+        held.replied().await;
+        server.recreate_room(&room_id).await;
+        server.commit(&room_id, 7..=8).await;
+        client.close_room(room_id.clone()).await.unwrap();
+        let path = dir.path().join("room_room-a.meta");
+        let mut bytes = std::fs::read(&path).unwrap();
+        bytes[5] ^= 0x04;
+        std::fs::write(&path, bytes).unwrap();
+        open_room(&client, &room_id).await.unwrap();
+        // Discarded once more, and registered without a cursor in the new room.
+        assert_eq!(client.status(room_id.clone()).await, Ok(status(0, 2, true)));
+        held.release();
+    };
+    let (late, ()) = tokio::join!(late, meanwhile);
+    late.unwrap();
+    assert_eq!(tasks(&storage, &room_id).await, [7, 8]);
+    assert_eq!(client.status(room_id.clone()).await, Ok(status(2, 2, true)));
+    assert_eq!(transport.registrations(), [(None, None), (None, None)]);
+    let saved = FileMetadata::new(dir.path()).room(&room_id).await.unwrap();
+    assert_eq!(
+        saved.unwrap().room_incarnation,
+        server.incarnation(&room_id).await
+    );
+}
+
+/// A transport that checks every cursor a request presents as it leaves the client (INV-K5): a
+/// registration's, a sync's, an ack's and a commit's are never above the head of the storage
+/// room of the replica, and a registration's goes with the incarnation of its metadata.
+#[derive(Debug, Clone)]
+struct AuditCursors {
+    inner: TestTransport,
+    storage: DiskStorageEngine,
+    dir: std::path::PathBuf,
+    room: RoomId,
+    checked: Arc<std::sync::atomic::AtomicUsize>,
+}
+
+#[async_trait::async_trait]
+impl zemdb_client::TransportClient for AuditCursors {
+    async fn send(
+        &self,
+        message: &ClientMessage,
+        token: &str,
+    ) -> Result<Vec<u8>, zemdb_client::TransportError> {
+        let presented = match message {
+            ClientMessage::RegisterClient {
+                current_seq,
+                known_incarnation,
+                ..
+            } => {
+                assert_eq!(current_seq.is_some(), known_incarnation.is_some());
+                if let Some(known) = known_incarnation {
+                    let saved = FileMetadata::new(&self.dir).room(&self.room).await.unwrap();
+                    let saved = saved.map(|saved| saved.room_incarnation);
+                    assert_eq!(saved, Some(*known), "A cursor of another incarnation");
+                }
+                *current_seq
+            }
+            ClientMessage::Sync { from_seq, .. } => Some(*from_seq),
+            ClientMessage::Ack { ack_seq, .. } => Some(*ack_seq),
+            ClientMessage::Commit { last_ack_seq, .. } => Some(*last_ack_seq),
+            _ => None,
+        };
+        if let Some(cursor) = presented {
+            // A storage room closed meanwhile (a reopen) has no head to compare with.
+            if let Ok(head) = self.storage.get_head_seq(&self.room).await {
+                assert!(
+                    cursor <= head,
+                    "{message:?} presents {cursor:?} above {head:?}"
+                );
+                self.checked
+                    .fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            }
+        }
+        self.inner.send(message, token).await
+    }
+}
+
+/// Audit (INV-K5): syncs, writes, heartbeats, reopens of the room and opens with a new token run
+/// at once on one client over a disk engine, while another client commits, the room's actor is
+/// shut down (its roster comes back from disk, and the client may have to register again with
+/// its cursor) and replies are lost or delayed. No request ever presents a cursor above the head
+/// of the replica, nor a registration one of another incarnation, and the replica ends with the
+/// log.
+#[tokio::test(start_paused = true)]
+async fn audit_no_request_presents_a_cursor_above_the_head_of_the_replica() {
+    let server = TestServer::new();
+    let room_id = server.create_room("room-a").await;
+    let dir = tempdir().unwrap();
+    let storage = engine(dir.path());
+    let inner = server.transport();
+    let checked = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let transport = AuditCursors {
+        inner: inner.clone(),
+        storage: storage.clone(),
+        dir: dir.path().to_path_buf(),
+        room: room_id.clone(),
+        checked: Arc::clone(&checked),
+    };
+    let client = Client::open(
+        ClientConfig::new("ana"),
+        storage.clone(),
+        FileMetadata::new(dir.path()),
+        transport,
+    )
+    .await
+    .unwrap();
+    open_room(&client, &room_id).await.unwrap();
+    let mut seed: u64 = 0x4_2_12;
+    let mut next = move |n: u64| {
+        seed = seed
+            .wrapping_mul(6364136223846793005)
+            .wrapping_add(1442695040888963407);
+        (seed >> 33) % n
+    };
+    let mut id = 0;
+    for round in 0..60 {
+        inner.slow(Duration::from_millis(next(8)));
+        match next(6) {
+            0 => inner.lose_next_reply(ClientMessageKind::Ack),
+            1 => inner.lose_next_reply(ClientMessageKind::Commit),
+            2 => inner.lose_next_reply(ClientMessageKind::Sync),
+            3 => inner.slow_next(ClientMessageKind::RegisterClient, Duration::from_millis(5)),
+            _ => {}
+        }
+        let room = || room_id.clone();
+        let call = |kind: u64, id: i64| {
+            let client = &client;
+            let room = room();
+            async move {
+                let _ = match kind {
+                    0 | 1 => client.write(room, insert_task(id % 9 + 1)).await,
+                    2 => client.sync(room).await,
+                    3 => client.heartbeat(room).await,
+                    4 => {
+                        let _ = client.close_room(room.clone()).await;
+                        open_room(client, &room).await
+                    }
+                    _ => open_room(client, &room).await,
+                };
+            }
+        };
+        let (a, b, c) = (next(6), next(6), next(6));
+        id += 3;
+        let others = async {
+            if round % 3 == 0 {
+                server.commit(&room_id, [id % 9 + 1]).await;
+            }
+            if round % 7 == 3 {
+                server.state.room_manager.shutdown_room(&room_id).await;
+            }
+        };
+        tokio::join!(call(a, id), call(b, id + 1), call(c, id + 2), others);
+        inner.settled().await;
+    }
+    inner.slow(Duration::ZERO);
+    let _ = open_room(&client, &room_id).await;
+    client.sync(room_id.clone()).await.unwrap();
+    let head = server
+        .state
+        .room_manager
+        .log_bounds(&room_id)
+        .await
+        .unwrap();
+    let status_now = client.status(room_id.clone()).await.unwrap();
+    assert_eq!(status_now.head_seq, head.head_seq);
+    assert!(checked.load(std::sync::atomic::Ordering::SeqCst) > 100);
+}
