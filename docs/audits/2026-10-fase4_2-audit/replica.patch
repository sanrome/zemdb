+// ---------------------------------------------------------------------------------------------
+// Audit of sub-phase 4.2 (Lote 12, group "Réplica y log")
+
+/// Audit (INV-K5, INV-K1, INV-W2 for the metadata of the client): the metadata file of a room
+/// replaced with that of another room, under its own valid CRC32 (the content does not name its
+/// room), verifies: the replica presents its head with the incarnation of the other room, the
+/// server resets it, and the replica is discarded and downloaded again. It fails safe: nothing
+/// of the other room is applied, and the replica ends with its own log.
+#[tokio::test]
+async fn audit_the_metadata_of_another_room_get_a_reset_and_the_replica_is_downloaded_again() {
+    let (server, dir) = (TestServer::new(), tempdir().unwrap());
+    let room_a = server.create_room("room-a").await;
+    let room_b = server.create_room("room-b").await;
+    let transport = server.transport();
+    let storage = engine(dir.path());
+    let client = open_client(dir.path(), storage.clone(), &transport).await;
+    open_room(&client, &room_a).await.unwrap();
+    open_room(&client, &room_b).await.unwrap();
+    server.commit(&room_a, 1..=3).await;
+    server.commit(&room_b, 1..=2).await;
+    client.sync(room_a.clone()).await.unwrap();
+    client.sync(room_b.clone()).await.unwrap();
+    client.shutdown().await.unwrap();
+    let (inc_a, inc_b) = (
+        server.incarnation(&room_a).await,
+        server.incarnation(&room_b).await,
+    );
+    assert_ne!(inc_a, inc_b);
+    std::fs::copy(
+        dir.path().join("room_room-a.meta"),
+        dir.path().join("room_room-b.meta"),
+    )
+    .unwrap();
+    let saved = metadata(dir.path(), &room_b).await.unwrap();
+    assert_eq!(saved.room_incarnation, inc_a);
+
+    let transport = server.transport();
+    let storage = engine(dir.path());
+    let client = open_client(dir.path(), storage.clone(), &transport).await;
+    open_room(&client, &room_b).await.unwrap();
+    assert_eq!(
+        transport.registrations(),
+        [(Some(2), Some(inc_a)), (None, None)]
+    );
+    client.sync(room_b.clone()).await.unwrap();
+    assert_eq!(client.status(room_b.clone()).await, Ok(status(2, 1, true)));
+    assert_eq!(tasks(&storage, &room_b).await, [1, 2]);
+    let saved = metadata(dir.path(), &room_b).await.unwrap();
+    assert_eq!(saved.room_incarnation, inc_b);
+}
