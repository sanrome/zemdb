+
+// ---------------------------------------------------------------------------------------------
+// Audit of sub-phase 4.2 (Lote 12, group "Réplica y log")
+
+/// The log of `room_id`, as a client of the server's own receives it.
+async fn audit_log(server: &TestServer, room_id: &RoomId) -> Vec<SequencedOperation> {
+    let transport = server.transport();
+    let client_id = ClientId::new("eve#reader").unwrap();
+    let token = token(&client_id, room_id);
+    let send = |message: ClientMessage| {
+        let (transport, token) = (transport.clone(), token.clone());
+        async move {
+            let reply = transport.send(&message, &token).await.unwrap();
+            decode_message::<ServerMessage>(&reply).unwrap()
+        }
+    };
+    let registered = send(ClientMessage::RegisterClient {
+        correlation_id: CorrelationId::new(1),
+        room_id: room_id.clone(),
+        client_id: client_id.clone(),
+        auth_token: token.clone(),
+        current_seq: None,
+        known_incarnation: None,
+    })
+    .await;
+    assert!(matches!(registered, ServerMessage::Registered { .. }));
+    let mut log: Vec<SequencedOperation> = Vec::new();
+    loop {
+        let reply = send(ClientMessage::Sync {
+            correlation_id: CorrelationId::new(2),
+            room_id: room_id.clone(),
+            client_id: client_id.clone(),
+            from_seq: SequenceNumber::new(log.len() as u64),
+            max_batch_size: u32::MAX,
+        })
+        .await;
+        let ServerMessage::SyncBatch { ops, has_more, .. } = reply else {
+            panic!("{reply:?}");
+        };
+        log.extend(ops);
+        if !has_more {
+            return log;
+        }
+    }
+}
+
+/// The rows of `rows` without the nulls at the end of each, which a row gets when it is widened
+/// to a later schema in one replica and not in another.
+fn audit_trimmed(rows: &oracle::Rows) -> Vec<(u16, Vec<String>, Vec<String>)> {
+    let mut dump = oracle::dump(rows);
+    for (_, _, row) in &mut dump {
+        while row.last().is_some_and(|value| value == "Null") {
+            row.pop();
+        }
+    }
+    dump
+}
+
+/// The decision of a reference replica on an operation, as a write reports it.
+fn audit_decision(reason: Option<&oracle::Reason>) -> Result<(), ClientError> {
+    use zemdb_client::Violation;
+    let violation = match reason.cloned() {
+        None => return Ok(()),
+        Some(oracle::Reason::MissingRow) => return Err(ClientError::RowMissing),
+        Some(oracle::Reason::Duplicate) => Violation::Duplicate,
+        Some(oracle::Reason::NotOwner) => Violation::NotOwner,
+        Some(oracle::Reason::Unique(constraint)) => Violation::Unique { constraint },
+        Some(oracle::Reason::ForeignKey(constraint)) => Violation::ForeignKey { constraint },
+        Some(oracle::Reason::Restrict(constraint)) => Violation::Restrict { constraint },
+    };
+    Err(ClientError::ConstraintViolation(violation))
+}
+
+/// Audit (INV-K4, INV-K6, INV-C1 in the client, INV-K1): a column with a `UNIQUE` constraint is
+/// added to the schema while syncs, writes and heartbeats of two clients (one over a disk engine
+/// with its metadata in files, one in memory) are in flight, with several calls on the same
+/// client at once, at many points of their requests. Every reply announces the schema its
+/// operations need, before or after the reload, and the replicas switch to it only through
+/// `Registered`. Afterwards, the disk client crashes (dropped without a shutdown) and opens again
+/// from its directory. Every replica ends at the head of the log with the state of a reference
+/// replica that applies the whole log with the last schema, and of a client that joins at the
+/// end; every write that got a decision got the one of the reference replica on its operation.
+#[tokio::test(start_paused = true)]
+async fn audit_a_column_added_while_calls_are_in_flight_leaves_every_replica_as_the_log() {
+    use zemdb_client::MemoryMetadata;
+    use zemdb_storage::{DiskStorageEngine, MemoryStorageEngine};
+    let grid = (0u64..24).flat_map(|delay| [(delay, 10, 7), (delay, 3, 11), (delay, 1, 1)]);
+    for (delay, disk_ms, mem_ms) in grid {
+        let server = TestServer::new();
+        let room_id = server.create_room("room-a").await;
+        server.commit(&room_id, 1..=2).await;
+        let dir = tempdir().unwrap();
+        let (disk_t, mem_t) = (server.transport(), server.transport());
+        let disk_storage = engine(dir.path());
+        let disk = open_client(dir.path(), disk_storage.clone(), &disk_t).await;
+        let mem_storage = MemoryStorageEngine::new();
+        let mem = Client::open(
+            ClientConfig::new("bea"),
+            mem_storage.clone(),
+            MemoryMetadata::default(),
+            mem_t.clone(),
+        )
+        .await
+        .unwrap();
+        open_room(&disk, &room_id).await.unwrap();
+        open_room(&mem, &room_id).await.unwrap();
+        disk_t.slow(Duration::from_millis(disk_ms));
+        mem_t.slow(Duration::from_millis(mem_ms));
+
+        let room = || room_id.clone();
+        let mut writes: Vec<(Operation, Result<(), ClientError>)> = Vec::new();
+        // Phase A: the column is added `delay` ms after the calls start.
+        let phase_a = async {
+            tokio::join!(
+                disk.sync(room()),
+                disk.write(room(), insert_task(3)),
+                disk.heartbeat(room()),
+                mem.write(room(), update_task(1)),
+                mem.sync(room()),
+                mem.write(room(), insert_tagged(4, "a")),
+            )
+        };
+        let evolve = async {
+            tokio::time::sleep(Duration::from_millis(delay)).await;
+            add_tag_column(&server).await;
+            server
+                .commit_ops(&room_id, [insert_tagged(5, "a"), update_tag(2, "a")])
+                .await;
+        };
+        let ((_, w3, _, w1, _, w4), ()) = tokio::join!(phase_a, evolve);
+        writes.push((insert_task(3), w3));
+        writes.push((update_task(1), w1));
+        writes.push((insert_tagged(4, "a"), w4));
+
+        // Phase B: writes of the new version from both clients at once, on the same tag.
+        let (w6, w33, _, w7, w11, _) = tokio::join!(
+            disk.write(room(), insert_tagged(6, "b")),
+            disk.write(room(), update_tag(3, "c")),
+            disk.sync(room()),
+            mem.write(room(), insert_tagged(7, "b")),
+            mem.write(room(), update_tag(1, "c")),
+            mem.heartbeat(room()),
+        );
+        writes.push((insert_tagged(6, "b"), w6));
+        writes.push((update_tag(3, "c"), w33));
+        writes.push((insert_tagged(7, "b"), w7));
+        writes.push((update_tag(1, "c"), w11));
+
+        // The network heals; the disk client crashes and opens again from its directory.
+        disk_t.slow(Duration::ZERO);
+        mem_t.slow(Duration::ZERO);
+        disk_t.settled().await;
+        mem_t.settled().await;
+        drop(disk);
+        drop(disk_storage);
+        let mut reopened = None;
+        for _ in 0..200 {
+            let storage = DiskStorageEngine::new(options(dir.path())).unwrap();
+            let metadata = FileMetadata::new(dir.path());
+            let client = Client::open(
+                ClientConfig::new("ana"),
+                storage.clone(),
+                metadata,
+                disk_t.clone(),
+            );
+            match client.await {
+                Ok(client) => {
+                    reopened = Some((client, storage));
+                    break;
+                }
+                Err(_) => tokio::time::sleep(Duration::from_millis(1)).await,
+            }
+        }
+        let (disk, disk_storage) = reopened.expect("the crashed client opens again");
+        open_room(&disk, &room_id).await.unwrap();
+        disk.sync(room()).await.unwrap();
+        mem.sync(room()).await.unwrap();
+        // A client that joins at the end applies the whole log with the last schema.
+        let late_storage = MemoryStorageEngine::new();
+        let late = Client::open(
+            ClientConfig::new("eva"),
+            late_storage.clone(),
+            MemoryMetadata::default(),
+            server.transport(),
+        )
+        .await
+        .unwrap();
+        open_room(&late, &room_id).await.unwrap();
+        late.sync(room()).await.unwrap();
+
+        let log = audit_log(&server, &room_id).await;
+        let mut reference = oracle::Oracle::new(tagged_schema());
+        let rejected: BTreeMap<u64, oracle::Reason> =
+            reference.apply_batch(&log).into_iter().collect();
+        let head = log.len() as u64;
+        let expected = audit_trimmed(reference.rows());
+        for (name, client, storage) in [
+            ("disk", &disk, &disk_storage as &dyn StorageEngine),
+            ("mem", &mem, &mem_storage as &dyn StorageEngine),
+            ("late", &late, &late_storage as &dyn StorageEngine),
+        ] {
+            let status_now = client.status(room()).await.unwrap();
+            assert_eq!(status_now.head_seq.get(), head, "{delay}: {name}");
+            assert!(!status_now.failed_closed, "{delay}: {name}");
+            let mut table = BTreeMap::new();
+            for id in 1..=9 {
+                let pk = PrimaryKey::single(id);
+                if let Some(row) = storage.get_by_id(&room_id, 0, &pk).await.unwrap() {
+                    table.insert(pk, row);
+                }
+            }
+            let replica = oracle::Rows::from([(0, table)]);
+            assert_eq!(audit_trimmed(&replica), expected, "{delay}: {name}");
+        }
+        let saved = FileMetadata::new(dir.path()).room(&room_id).await.unwrap();
+        assert_eq!(saved.unwrap().schema, tagged_schema(), "{delay}");
+        // A write with a decision has the one of the reference replica on its operation.
+        for (op, result) in writes {
+            let at: Vec<u64> = log
+                .iter()
+                .filter(|logged| logged.op == op)
+                .map(|logged| logged.seq.get())
+                .collect();
+            assert!(at.len() <= 1, "{delay}: {op:?} sequenced twice");
+            match &result {
+                Ok(()) | Err(ClientError::ConstraintViolation(_) | ClientError::RowMissing) => {
+                    assert_eq!(at.len(), 1, "{delay}: {op:?} {result:?} not in the log");
+                    let expected = audit_decision(rejected.get(&at[0]));
+                    assert_eq!(result, expected, "{delay}: {op:?}");
+                }
+                // Refused by the server before it had the column, or uncertain.
+                Err(ClientError::Validation(_)) => assert!(at.is_empty(), "{delay}: {op:?}"),
+                Err(ClientError::OutcomeUnknown) => {}
+                Err(err) => panic!("{delay}: {op:?} ended with {err:?}"),
+            }
+        }
+    }
+}
+
+/// The name of the directory `dir`, as the test file layer logs it.
+fn audit_dir_name(dir: &Path) -> &'static str {
+    let name = dir.file_name().unwrap().to_str().unwrap().to_string();
+    Box::leak(name.into_boxed_str())
+}
+
+/// What the scenarios of a failed sync of the directory of the metadata share: a client over a
+/// disk engine in `data_dir`, with its metadata in `meta_dir` through `files`, at the head 2 of
+/// the version 1 of the schema; then the column with `UNIQUE` is added, and the log rejects the
+/// update of row 2 to the tag of row 1 (seq 4), after which row 1 takes another tag (seq 5).
+/// Returns the server, the room, the client, its engine and the state of the log at its head 5.
+async fn audit_failed_sync_setup(
+    data_dir: &Path,
+    meta_dir: &Path,
+    files: &TestFiles,
+    engine_files: Option<TestFiles>,
+) -> (
+    TestServer,
+    RoomId,
+    Client,
+    zemdb_storage::DiskStorageEngine<TestFiles>,
+    oracle::Rows,
+) {
+    let server = TestServer::new();
+    let room_id = server.create_room("room-a").await;
+    let engine_files = engine_files.unwrap_or_default();
+    let storage =
+        zemdb_storage::DiskStorageEngine::with_files(options(data_dir), engine_files).unwrap();
+    let client = Client::open(
+        ClientConfig::new("ana"),
+        storage.clone(),
+        FileMetadata::with_files(meta_dir, files.clone()),
+        server.transport(),
+    )
+    .await
+    .unwrap();
+    open_room(&client, &room_id).await.unwrap();
+    server.commit(&room_id, 1..=2).await;
+    client.sync(room_id.clone()).await.unwrap();
+    add_tag_column(&server).await;
+    let ops = [update_tag(1, "a"), update_tag(2, "a"), update_tag(1, "b")];
+    server.commit_ops(&room_id, ops).await;
+    let log = audit_log(&server, &room_id).await;
+    let mut reference = oracle::Oracle::new(tasks_schema());
+    reference.apply_batch(&log[..2]);
+    reference.evolve(tagged_schema());
+    let rejected = reference.apply_batch(&log[2..]);
+    let unique = oracle::Reason::Unique("tasks_tag".to_string());
+    assert_eq!(rejected, [(4, unique)]);
+    let rows = reference.rows().clone();
+    (server, room_id, client, storage, rows)
+}
+
+/// Audit (INV-C1 in the client, INV-K6, INV-D4-like atomic replace of the metadata): the save of
+/// a new schema whose rename lands but whose `sync_dir` fails is an error, and the room leaves
+/// the client; its next open, in the same process, takes the renamed file, which the failed sync
+/// did not make durable. Before the replica applies any operation of the new version, the disk
+/// engine's `open_room` syncs the same directory (the metadata live in the data directory of the
+/// engine, ARCHITECTURE.md §11), so the rename is durable by then, and the replica, reopened
+/// after a crash, has the schema its log was applied with.
+#[tokio::test]
+async fn audit_a_failed_sync_of_a_saved_schema_is_made_durable_by_the_next_open_of_the_room() {
+    let dir = tempdir().unwrap();
+    let dir_name = audit_dir_name(dir.path());
+    let files = TestFiles::default();
+    let (server, room_id, client, storage, expected) =
+        audit_failed_sync_setup(dir.path(), dir.path(), &files, Some(files.clone())).await;
+    files.fail_next("sync_dir", dir_name);
+    let failed_at = files.log().len();
+    let synced = client.sync(room_id.clone()).await;
+    assert!(matches!(synced, Err(ClientError::Storage(_))), "{synced:?}");
+    open_room(&client, &room_id).await.unwrap();
+    client.sync(room_id.clone()).await.unwrap();
+    assert_eq!(client.status(room_id.clone()).await, Ok(status(5, 1, true)));
+    let replica = rows(&storage, &room_id).await;
+    assert_eq!(audit_trimmed(&replica), audit_trimmed(&expected));
+
+    // After the failed sync: the rename of the metadata, then a sync of the directory by the
+    // open of the storage room, then the first write of the WAL with the new version.
+    let log = files.log()[failed_at..].to_vec();
+    let at = |entry: &str| log.iter().position(|logged| logged == entry);
+    let renamed = at("rename room_room-a.meta.tmp room_room-a.meta").expect("renamed");
+    let failed = renamed + 1;
+    assert_eq!(log[failed], format!("sync_dir {dir_name}"));
+    let synced_again = (log.iter().enumerate().skip(failed + 1))
+        .find(|(_, logged)| **logged == format!("sync_dir {dir_name}"))
+        .map(|(index, _)| index)
+        .expect("the directory is synced again");
+    let written = (log.iter().enumerate().skip(failed + 1))
+        .find(|(_, logged)| logged.starts_with("write_at room_room-a.wal"))
+        .map(|(index, _)| index)
+        .expect("the operations of version 2 are written");
+    assert!(synced_again < written, "{log:#?}");
+    drop(server);
+}
+
+/// Audit (INV-C1 in the client, INV-K1, INV-K4): as above, but with the metadata in a directory
+/// of their own, which the API allows ("nothing ties the two in code") and §11 does not:
+/// nothing syncs that directory after the failed sync, so a crash may keep the operations of the
+/// new version in the WAL and lose the rename. The replica then opens with the earlier schema,
+/// narrower than its log, which decides those operations without the `UNIQUE` constraint
+/// (outside the premise of INV-C1, INV-S6, INV-S7): the update the log rejected is applied, the
+/// later update removes the conflict, and the reload to the schema of `Registered` finds no row
+/// that breaks it. The replica holds another state than the log, at its head, without notice.
+/// Fails on 9de2c1b: it shows a Bajo (the durability of a failed save of the metadata rests on
+/// an undocumented sync of the engine).
+#[tokio::test]
+async fn audit_metadata_apart_from_the_engine_diverge_after_a_failed_sync_and_a_crash() {
+    let (data_dir, meta_dir) = (tempdir().unwrap(), tempdir().unwrap());
+    let meta_name = audit_dir_name(meta_dir.path());
+    let files = TestFiles::default();
+    let (server, room_id, client, storage, expected) =
+        audit_failed_sync_setup(data_dir.path(), meta_dir.path(), &files, None).await;
+    let meta_path = meta_dir.path().join("room_room-a.meta");
+    // What the disk holds durably of the metadata: the schema of version 1.
+    let durable = std::fs::read(&meta_path).unwrap();
+    files.fail_next("sync_dir", meta_name);
+    let failed_at = files.log().len();
+    let synced = client.sync(room_id.clone()).await;
+    assert!(matches!(synced, Err(ClientError::Storage(_))), "{synced:?}");
+    open_room(&client, &room_id).await.unwrap();
+    client.sync(room_id.clone()).await.unwrap();
+    let replica = rows(&storage, &room_id).await;
+    assert_eq!(audit_trimmed(&replica), audit_trimmed(&expected));
+    // Nothing synced the directory of the metadata after the failed sync.
+    let synced_meta = format!("sync_dir {meta_name}");
+    let log = files.log()[failed_at..].to_vec();
+    assert_eq!(
+        log.iter().filter(|logged| **logged == synced_meta).count(),
+        1
+    );
+
+    // A crash: the operations of the WAL were synced, the rename of the metadata was not.
+    drop(client);
+    drop(storage);
+    std::fs::write(&meta_path, &durable).unwrap();
+    let storage = zemdb_storage::DiskStorageEngine::new(options(data_dir.path())).unwrap();
+    let client = Client::open(
+        ClientConfig::new("ana"),
+        storage.clone(),
+        FileMetadata::new(meta_dir.path()),
+        server.transport(),
+    )
+    .await
+    .unwrap();
+    open_room(&client, &room_id).await.unwrap();
+    client.sync(room_id.clone()).await.unwrap();
+    let saved = FileMetadata::new(meta_dir.path())
+        .room(&room_id)
+        .await
+        .unwrap();
+    assert_eq!(saved.unwrap().schema, tagged_schema());
+    let status_now = client.status(room_id.clone()).await.unwrap();
+    assert_eq!(
+        (status_now.head_seq.get(), status_now.failed_closed),
+        (5, false)
+    );
+    let replica = rows(&storage, &room_id).await;
+    assert_eq!(
+        audit_trimmed(&replica),
+        audit_trimmed(&expected),
+        "the replica at the head of the log holds another state than the log"
+    );
+}
