+// ---------------------------------------------------------------------------------------------
+// Audit of sub-phase 4.2 (Lote 12, group "Réplica y log")
+
+/// An update of the tag of row `id` of `tasks` of [`tagged_schema`].
+fn audit_update_tag(id: i64, tag: &str) -> Operation {
+    let fields = std::collections::BTreeMap::from([("tag".to_string(), Value::from(tag))]);
+    tagged_schema()
+        .to_operation_update("tasks", PrimaryKey::single(id), &fields, 1000)
+        .unwrap()
+}
+
+/// The rows of the tasks 1 to 12 of `room_id` in `storage`, without the nulls at the end of each.
+async fn audit_rows(
+    storage: &impl StorageEngine,
+    room_id: &RoomId,
+) -> Vec<(u16, Vec<String>, Vec<String>)> {
+    let mut table = std::collections::BTreeMap::new();
+    for id in 1..=12 {
+        let pk = PrimaryKey::single(id);
+        if let Some(row) = storage.get_by_id(room_id, 0, &pk).await.unwrap() {
+            table.insert(pk, row);
+        }
+    }
+    audit_trimmed(&oracle::Rows::from([(0, table)]))
+}
+
+fn audit_trimmed(rows: &oracle::Rows) -> Vec<(u16, Vec<String>, Vec<String>)> {
+    let mut dump = oracle::dump(rows);
+    for (_, _, row) in &mut dump {
+        while row.last().is_some_and(|value| value == "Null") {
+            row.pop();
+        }
+    }
+    dump
+}
+
+/// Audit (INV-K4 through the snapshot that the designated client uploads, INV-C1 and INV-K6 in
+/// the client): a column with `UNIQUE` is added to the schema while the heartbeat of the
+/// designated client (at the head 9 of the version 1) is in flight, at several points of it, and
+/// the log then rejects an update for the new constraint and removes the conflict. The client
+/// behind the pruned log learns the version 2, installs the snapshot uploaded (of either
+/// version) and syncs the rest. Both replicas end at the head of the log with the state of the
+/// reference model that applied the log with the version it was sequenced under.
+#[tokio::test(start_paused = true)]
+async fn audit_a_snapshot_uploaded_while_a_column_is_added_converges_with_the_log() {
+    for delay in [0u64, 1, 2, 3, 4, 5, 6, 8, 10, 13] {
+        let (server, room_id, mut log, designee, lagging) = designated_with(
+            "room-a",
+            ("tasks", tasks_schema()),
+            (1..=9).map(insert_task),
+        )
+        .await;
+        designee.transport.slow(Duration::from_millis(3));
+        let evolve = async {
+            tokio::time::sleep(Duration::from_millis(delay)).await;
+            let registry = &server.state.schema_registry;
+            let tag = ColumnDef::new("tag", DataType::String).nullable(true);
+            let unique = UniqueConstraint::new("tasks_tag", ["tag"]);
+            let tasks_id = SchemaId::new("tasks").unwrap();
+            let added =
+                registry.add_column_with_constraints(&tasks_id, "tasks", tag, vec![unique], vec![]);
+            added.unwrap();
+            let manager = &server.state.room_manager;
+            manager.reload_schema_for_rooms(&tasks_id).await;
+            let ops = [
+                audit_update_tag(1, "a"),
+                audit_update_tag(2, "a"),
+                audit_update_tag(1, "b"),
+                insert_tagged(10, "c"),
+            ];
+            server.commit_ops(&room_id, ops).await
+        };
+        let (_, tagged) = tokio::join!(designee.client.heartbeat(room_id.clone()), evolve);
+        log.extend(tagged);
+        designee.transport.slow(Duration::ZERO);
+        let mut caught_up = false;
+        for _ in 0..10 {
+            let _ = designee.client.heartbeat(room_id.clone()).await;
+            let _ = lagging.client.heartbeat(room_id.clone()).await;
+            if lagging.client.sync(room_id.clone()).await.is_ok() {
+                caught_up = true;
+                break;
+            }
+            tokio::time::sleep(Duration::from_secs(1)).await;
+        }
+        assert!(caught_up, "{delay}: the client behind the log catches up");
+        designee.client.sync(room_id.clone()).await.unwrap();
+        let mut reference = oracle::Oracle::new(tasks_schema());
+        reference.apply_batch(&log[..9]);
+        reference.evolve(tagged_schema());
+        let rejected = reference.apply_batch(&log[9..]);
+        assert_eq!(rejected.len(), 1, "{delay}");
+        let expected = audit_trimmed(reference.rows());
+        for (name, member) in [("designee", &designee), ("lagging", &lagging)] {
+            let status_now = member.client.status(room_id.clone()).await.unwrap();
+            assert_eq!(status_now.head_seq.get(), 13, "{delay}: {name}");
+            let replica = audit_rows(&member.storage, &room_id).await;
+            assert_eq!(replica, expected, "{delay}: {name}");
+        }
+        assert!(
+            !chunks(&lagging.transport).is_empty(),
+            "{delay}: downloaded"
+        );
+        assert!(
+            !uploads(&designee.transport).is_empty(),
+            "{delay}: uploaded"
+        );
+    }
+}
