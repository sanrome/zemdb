+// ---------------------------------------------------------------------------------------------
+// Audit of sub-phase 4.2 (Lote 12, group "Réplica y log")
+
+/// Audit (INV-W2 and INV-W1 for the metadata of the client): the metadata of a room with a random
+/// valid schema (several tables, `UNIQUE` constraints and foreign keys, owners, immutable tables,
+/// encrypted and added columns), a random schema id and an incarnation anywhere in `u128`
+/// survive a save and a read unchanged, also from another store over the directory; a file with
+/// any bit flipped, or cut anywhere, counts as missing, without a panic; and so does one that
+/// holds the metadata of another room, under its own valid CRC32, only if it does not parse as
+/// the metadata of a room: the content does not name its room.
+#[tokio::test]
+async fn audit_room_metadata_with_random_schemas_survive_a_save_and_damage_counts_as_missing() {
+    let dir = tempdir().unwrap();
+    let store = FileMetadata::new(dir.path());
+    store.open().await.unwrap();
+    let mut rng = generators::Rng::new(0x0042_1200);
+    for case in 0..300u32 {
+        let schema = generators::schema(&mut rng);
+        let high = u128::from(rng.next_u64()) << 64;
+        let room_incarnation = match case % 4 {
+            0 => u128::MAX - rng.below(3) as u128,
+            1 => rng.below(3) as u128,
+            _ => high | u128::from(rng.next_u64()),
+        };
+        let metadata = RoomMetadata {
+            room_incarnation,
+            schema_id: generators::schema_id(&mut rng),
+            schema,
+        };
+        store.save_room(&room(), &metadata).await.unwrap();
+        let read = store.room(&room()).await.unwrap();
+        assert_eq!(read.as_ref(), Some(&metadata), "case {case}");
+        let other = FileMetadata::new(dir.path()).room(&room()).await.unwrap();
+        assert_eq!(other.as_ref(), Some(&metadata), "case {case}");
+        if case % 60 == 0 {
+            let bytes = std::fs::read(room_file(dir.path())).unwrap();
+            for damaged in damaged(&bytes) {
+                std::fs::write(room_file(dir.path()), &damaged).unwrap();
+                assert_eq!(store.room(&room()).await.unwrap(), None, "case {case}");
+            }
+            std::fs::write(room_file(dir.path()), &bytes).unwrap();
+        }
+    }
+    // The file of another room, copied in place of this one's, verifies and is taken.
+    let other_room = RoomId::new("room-b").unwrap();
+    store.save_room(&other_room, &metadata(9)).await.unwrap();
+    let copied = std::fs::read(dir.path().join("room_room-b.meta")).unwrap();
+    std::fs::write(room_file(dir.path()), copied).unwrap();
+    assert_eq!(store.room(&room()).await.unwrap(), Some(metadata(9)));
+}
