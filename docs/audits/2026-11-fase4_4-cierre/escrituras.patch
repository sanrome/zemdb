+++ b/crates/client/tests/review_a_tests.rs
@@ -0,0 +1,294 @@
+//! Tests of the closing review of the sub-phase 4.4 (reviewer A: the writes and the encryption),
+//! against the server in process: an encrypted column of type `Bytes`, whose plaintext the server
+//! would take as it is, goes out and is stored only encrypted; and a write of the facade cut at
+//! each `.await` before the `write` of the core sends nothing and leaves nothing in flight.
+
+mod common;
+
+use common::*;
+use std::path::Path;
+use std::sync::Arc;
+use tempfile::tempdir;
+use zemdb_client::{FileMetadata, Key, RoomHandle, Row, ZemdbClient};
+use zemdb_core::{
+    encode_message, ClientMessage, CryptoEngine, DataType, Operation, OperationKind, RoomId,
+    Schema, TableSchema, Value,
+};
+use zemdb_storage::{MemoryStorageEngine, ScanOptions, StorageEngine};
+
+/// The mark that the plaintext of every encrypted value of these tests holds.
+const MARK: &[u8] = b"BLOB-IN-THE-CLEAR";
+
+/// Table `files`: an int key `id`, a string `name`, the nullable encrypted bytes `blob` and the
+/// encrypted bytes `digest`, which does not take `NULL`. A ciphertext is a `Value::Bytes` too, so
+/// the validation of the operation that is sent (`Schema::validate_operation`) takes the plaintext
+/// of these columns as it is: only the facade tells them apart.
+fn files_schema() -> Schema {
+    let files = TableSchema::builder("files")
+        .primary_key("id", DataType::Int)
+        .column("name", DataType::String)
+        .nullable_column("blob", DataType::Bytes)
+        .encrypted_column("blob", DataType::Bytes)
+        .encrypted_column("digest", DataType::Bytes);
+    Schema::builder().table(files).build()
+}
+
+/// The positions of the encrypted columns of `files`.
+const ENCRYPTED: [usize; 2] = [2, 3];
+
+/// `MARK` followed by `tail`, as the plaintext of a value.
+fn marked(tail: &str) -> Vec<u8> {
+    [MARK, tail.as_bytes()].concat()
+}
+
+fn file_key(id: i64) -> Key {
+    Key::new().with("id", id)
+}
+
+/// A facade of `person` over `storage`, with its metadata in `dir`, `crypto` and the precheck.
+async fn facade(
+    dir: &Path,
+    storage: impl StorageEngine + 'static,
+    transport: &TestTransport,
+    person: &str,
+    crypto: Option<Arc<TestCrypto>>,
+) -> ZemdbClient {
+    let metadata = FileMetadata::new(dir);
+    let tokens = TestTokens::new();
+    let crypto = crypto.map(|crypto| crypto as Arc<dyn CryptoEngine>);
+    let client = ZemdbClient::open(
+        manual(person),
+        storage,
+        metadata,
+        transport.clone(),
+        tokens,
+        crypto,
+    );
+    let client = client.await.unwrap();
+    transport.hush(&client.client_id());
+    client
+}
+
+async fn open(client: &ZemdbClient, room_id: &RoomId) -> RoomHandle {
+    client.room(room_id.clone()).await.unwrap()
+}
+
+/// The operations of the commits sent through `transport`.
+fn committed(transport: &TestTransport) -> Vec<Operation> {
+    let op = |message| match message {
+        ClientMessage::Commit { op, .. } => Some(op),
+        _ => None,
+    };
+    transport.sent().into_iter().filter_map(op).collect()
+}
+
+fn holds(bytes: &[u8], needle: &[u8]) -> bool {
+    bytes.windows(needle.len()).any(|window| window == needle)
+}
+
+/// Checks that no file under `dir` holds `MARK`.
+fn no_file_holds_the_mark(dir: &Path) {
+    let mut pending = vec![dir.to_path_buf()];
+    let mut files = 0;
+    while let Some(path) = pending.pop() {
+        if path.is_dir() {
+            for entry in std::fs::read_dir(&path).unwrap() {
+                pending.push(entry.unwrap().path());
+            }
+        } else if let Ok(bytes) = std::fs::read(&path) {
+            files += 1;
+            assert!(
+                !holds(&bytes, MARK),
+                "{} holds the plaintext",
+                path.display()
+            );
+        }
+    }
+    assert!(files > 0, "No file under {}", dir.display());
+}
+
+/// The values of the encrypted columns of `files` that `op` carries.
+fn encrypted_values(op: &Operation) -> Vec<Value> {
+    match op.kind() {
+        OperationKind::Insert { row } => (row.values().iter().enumerate())
+            .filter(|(index, _)| ENCRYPTED.contains(index))
+            .map(|(_, value)| value.clone())
+            .collect(),
+        OperationKind::Update { updates } => (updates.iter())
+            .filter(|update| ENCRYPTED.contains(&usize::from(update.column_idx())))
+            .map(|update| update.value().clone())
+            .collect(),
+        OperationKind::Delete { .. } => Vec::new(),
+    }
+}
+
+#[tokio::test]
+async fn review_a_an_encrypted_bytes_column_goes_out_and_is_stored_only_encrypted() {
+    let server = TestServer::new();
+    let room_id = server
+        .create_room_with("room-a", "files", files_schema())
+        .await;
+    let dir = tempdir().unwrap();
+    let (transport, crypto) = (server.transport(), TestCrypto::new());
+    let storage = engine(dir.path());
+    let client = facade(
+        dir.path(),
+        storage.clone(),
+        &transport,
+        "ana",
+        Some(Arc::clone(&crypto)),
+    )
+    .await;
+    let room = open(&client, &room_id).await;
+    let files = room.table("files").unwrap();
+
+    // An insert with both columns, an update of `blob`, an insert without `blob`, which is
+    // `NULL`, and an update of `blob` to `NULL`: every value of an encrypted column, `NULL`
+    // too, is encrypted once.
+    let first = Row::new()
+        .with("id", 1)
+        .with("name", "first")
+        .with("blob", marked("blob-1"))
+        .with("digest", marked("digest-1"));
+    assert_eq!(files.insert(&first).await, Ok(file_key(1)));
+    let blob = Row::new().with("blob", marked("blob-2"));
+    files.update(&file_key(1), &blob).await.unwrap();
+    let second = Row::new()
+        .with("id", 2)
+        .with("name", "second")
+        .with("digest", marked("digest-2"));
+    files.insert(&second).await.unwrap();
+    let cleared = Row::new().with("blob", Value::Null);
+    files.update(&file_key(2), &cleared).await.unwrap();
+    assert_eq!(crypto.encryptions(), 2 + 1 + 2 + 1);
+
+    // No message holds the plaintext, and each commit carries a ciphertext in each encrypted
+    // column that it writes, `NULL` too.
+    for message in transport.sent() {
+        let bytes = encode_message(&message).unwrap();
+        assert!(!holds(&bytes, MARK), "{message:?}");
+    }
+    let ops = committed(&transport);
+    assert_eq!(ops.len(), 4);
+    for op in &ops {
+        let values = encrypted_values(op);
+        assert!(!values.is_empty(), "{op:?}");
+        for value in values {
+            let Value::Bytes(bytes) = &value else {
+                panic!("Not a ciphertext: {value:?}");
+            };
+            assert!(!holds(bytes, MARK), "{value:?}");
+        }
+    }
+
+    // Neither the storage of the client nor the files of the client or of the server hold it.
+    let mut scan = storage
+        .scan_by_id(&room_id, 0, ScanOptions::default())
+        .await
+        .unwrap();
+    let mut rows = 0;
+    while let Some(item) = futures::StreamExt::next(&mut scan).await {
+        let (_, row) = item.unwrap();
+        rows += 1;
+        for index in ENCRYPTED {
+            match row.get(index) {
+                Some(Value::Bytes(bytes)) => assert!(!holds(bytes, MARK), "{row:?}"),
+                other => panic!("Not a ciphertext: {other:?}"),
+            }
+        }
+    }
+    assert_eq!(rows, 2);
+    no_file_holds_the_mark(dir.path());
+    no_file_holds_the_mark(&server.state.config.data_dir);
+
+    // The facade reads them in the clear, with their type, and so does another member.
+    let first = Row::new()
+        .with("id", 1)
+        .with("name", "first")
+        .with("blob", marked("blob-2"))
+        .with("digest", marked("digest-1"));
+    let second = Row::new()
+        .with("id", 2)
+        .with("name", "second")
+        .with("blob", Value::Null)
+        .with("digest", marked("digest-2"));
+    assert_eq!(files.get(&file_key(1)).await, Ok(Some(first.clone())));
+    assert_eq!(files.get(&file_key(2)).await, Ok(Some(second.clone())));
+    let bob_dir = tempdir().unwrap();
+    let bob_transport = server.transport();
+    let bob = facade(
+        bob_dir.path(),
+        MemoryStorageEngine::new(),
+        &bob_transport,
+        "bob",
+        Some(TestCrypto::new()),
+    )
+    .await;
+    let bob_room = open(&bob, &room_id).await;
+    bob_room.sync().await.unwrap();
+    let bob_files = bob_room.table("files").unwrap();
+    assert_eq!(bob_files.get(&file_key(1)).await, Ok(Some(first)));
+    assert_eq!(bob_files.get(&file_key(2)).await, Ok(Some(second)));
+}
+
+#[tokio::test]
+async fn review_a_a_write_cut_while_it_encrypts_or_prechecks_sends_nothing_and_leaves_nothing() {
+    let server = TestServer::new();
+    let room_id = server
+        .create_room_with("room-a", "files", files_schema())
+        .await;
+    let dir = tempdir().unwrap();
+    let (transport, crypto) = (server.transport(), TestCrypto::new());
+    let storage = TestEngine::new(engine(dir.path()));
+    let client = facade(
+        dir.path(),
+        storage.clone(),
+        &transport,
+        "ana",
+        Some(Arc::clone(&crypto)),
+    )
+    .await;
+    let room = open(&client, &room_id).await;
+    let files = room.table("files").unwrap();
+    let row = |id: i64| {
+        Row::new()
+            .with("id", id)
+            .with("name", "cut")
+            .with("digest", marked("digest"))
+    };
+    let sent = transport.sent().len();
+
+    // Cut while the `CryptoEngine` encrypts its first value.
+    let mut encrypting = crypto.hold_next_encrypt();
+    let cut = files.clone();
+    let write = tokio::spawn(async move { cut.insert(&row(1)).await });
+    encrypting.replied().await;
+    write.abort();
+    assert!(write.await.unwrap_err().is_cancelled());
+    drop(encrypting);
+
+    // Cut while the storage checks it.
+    let mut checking = storage.hold_next("check_operation");
+    let cut = files.clone();
+    let write = tokio::spawn(async move { cut.insert(&row(2)).await });
+    checking.replied().await;
+    write.abort();
+    assert!(write.await.unwrap_err().is_cancelled());
+    drop(checking);
+
+    // Nothing went out, nothing is in flight, and nothing is retained for them.
+    assert_eq!(transport.sent().len(), sent);
+    let status = room.status().await.unwrap();
+    assert_eq!((status.writes_in_flight, status.retained), (0, 0));
+    assert_eq!(files.get(&file_key(1)).await, Ok(None));
+    assert_eq!(files.get(&file_key(2)).await, Ok(None));
+
+    // The same writes then go out, once each, and the replica takes them.
+    assert_eq!(files.insert(&row(1)).await, Ok(file_key(1)));
+    assert_eq!(files.insert(&row(2)).await, Ok(file_key(2)));
+    assert_eq!(committed(&transport).len(), 2);
+    let status = room.status().await.unwrap();
+    assert_eq!((status.writes_in_flight, status.retained), (0, 0));
+    let read = files.get(&file_key(2)).await.unwrap().unwrap();
+    assert_eq!(read.get("digest"), Some(&Value::from(marked("digest"))));
+}
