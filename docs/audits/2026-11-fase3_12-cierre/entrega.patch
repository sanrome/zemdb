+/// A commit whose answer the room manager stops waiting for (`Timeout`) while the group in
+/// front of it waits for its fsync is still sequenced when the room gets to it: `Timeout`
+/// leaves the commit uncertain, it does not reject it, and a retry gets its sequence.
+// Paused time: the actor timeout passes while the fsync is held, without waiting for it.
+#[tokio::test(start_paused = true)]
+async fn review_b_a_commit_answered_timeout_while_a_group_syncs_is_still_sequenced() {
+    let fx = Fixture::new(RoomLifecycleOverrides::default()).await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+
+    let (release, held) = hold_next_fsync(&fx.active_wal());
+    let first = send_commit(&sender, &client, mutation(1), seq(0), insert_op(1)).await;
+    held.await.unwrap();
+    let asked = fx.manager.ask(&fx.room_id, |reply| RoomCommand::Commit {
+        client_id: client.clone(),
+        mutation_id: mutation(2),
+        last_ack_seq: seq(0),
+        op: insert_op(2),
+        reply,
+    });
+    let (answer, ()) = tokio::join!(asked, async {
+        tokio::task::yield_now().await;
+        tokio::time::advance(crate::actor::manager::ACTOR_TIMEOUT + Duration::from_millis(100))
+            .await;
+    });
+    assert!(
+        matches!(answer, Err(ServerError::Timeout(_))),
+        "{answer:?}"
+    );
+    release.send(()).unwrap();
+    assert_eq!(first.await.unwrap().unwrap().assigned_seq, seq(1));
+
+    let retry = commit(&sender, &client, mutation(2), seq(0), insert_op(2))
+        .await
+        .unwrap();
+    assert_eq!(
+        retry.assigned_seq,
+        seq(2),
+        "the commit answered Timeout was sequenced"
+    );
+    assert_eq!(metrics(&sender).await.head_seq, seq(2));
+    fx.manager.shutdown_all().await;
+}
