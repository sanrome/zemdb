+// Closing review of the phase (reviewer B): sequence, delivery, schema and isolation across the
+// group commit, the `ops` event and the operations shared with the RAM buffer.
+
+/// The operations, schema version and room incarnation of an `ops` event.
+fn review_b_event_parts(event: &RoomEvent) -> (Vec<SequencedOperation>, u64, u128) {
+    use base64::Engine;
+    let RoomEvent::Ops(event) = event else {
+        panic!("expected an ops event, got {event:?}");
+    };
+    let frame = base64::engine::general_purpose::STANDARD
+        .decode(event.data())
+        .unwrap();
+    match zemdb_core::protocol::codec::decode_message(&frame).unwrap() {
+        zemdb_core::protocol::messages::ServerMessage::OpsEvent {
+            ops,
+            schema_version,
+            room_incarnation,
+            head_seq,
+            ..
+        } => {
+            assert_eq!(Some(head_seq), ops.last().map(|op| op.seq));
+            (ops, schema_version, room_incarnation)
+        }
+        other => panic!("expected an OpsEvent frame, got {other:?}"),
+    }
+}
+
+/// In the middle of a group, commits rejected for each reason a commit can be rejected there
+/// (its operation, its size, its client, its cursor) leave no trace: none moves the cursor of
+/// its client, though each names a cursor above it; their mutation ids stay free for the next
+/// commits of the same client, which are new mutations; the sequences of the group stay
+/// contiguous; and only the new operations are announced. After a reopen, the window rebuilt
+/// from the log recognizes exactly those new mutations.
+#[tokio::test]
+async fn review_b_commits_rejected_in_a_group_move_no_cursor_and_free_their_mutation_ids() {
+    let fx = Fixture::new(RoomLifecycleOverrides::default()).await;
+    let sender = fx.sender().await;
+    let (writer, other) = (
+        ClientId::new("writer").unwrap(),
+        ClientId::new("other").unwrap(),
+    );
+    let ghost = ClientId::new("ghost").unwrap();
+    register(&sender, &writer).await;
+    register(&sender, &other).await;
+    commit(&sender, &writer, mutation(1), seq(0), insert_op(1))
+        .await
+        .unwrap();
+    assert_eq!(cursor(&sender, &other).await, Some(seq(0)));
+    let mut events = subscribe(&sender).await;
+
+    let (release, held) = hold_next_fsync(&fx.active_wal());
+    let first = send_commit(&sender, &writer, mutation(2), seq(1), insert_op(2)).await;
+    held.await.unwrap();
+    // Rejected, each with a cursor inside the log (1), above the cursor of `other` (0). The
+    // commit in front is durable when they are checked: the visible head is then 2.
+    let invalid = send_commit(&sender, &other, mutation(10), seq(1), invalid_op()).await;
+    let too_large = send_commit(
+        &sender,
+        &other,
+        mutation(11),
+        seq(1),
+        insert_op_with_title(11, 17 << 20),
+    )
+    .await;
+    let unregistered = send_commit(&sender, &ghost, mutation(12), seq(1), insert_op(12)).await;
+    // A cursor that names a sequence of its own group (3), not visible yet.
+    let ahead = send_commit(&sender, &other, mutation(13), seq(3), insert_op(13)).await;
+    // The same mutation ids, now accepted: new mutations, not retries.
+    let again_invalid = send_commit(&sender, &other, mutation(10), seq(0), insert_op(20)).await;
+    let again_large = send_commit(&sender, &other, mutation(11), seq(0), insert_op(21)).await;
+    let again_ahead = send_commit(&sender, &other, mutation(13), seq(0), insert_op(23)).await;
+    release.send(()).unwrap();
+
+    assert_eq!(first.await.unwrap().unwrap().assigned_seq, seq(2));
+    assert!(matches!(
+        invalid.await.unwrap(),
+        Err(ServerError::SchemaViolation(_))
+    ));
+    assert!(matches!(
+        too_large.await.unwrap(),
+        Err(ServerError::BadRequest(_))
+    ));
+    assert!(matches!(
+        unregistered.await.unwrap(),
+        Err(ServerError::ClientNotRegistered(_))
+    ));
+    assert!(matches!(
+        ahead.await.unwrap(),
+        Err(ServerError::InvalidSequence { .. })
+    ));
+    assert_eq!(again_invalid.await.unwrap().unwrap().assigned_seq, seq(3));
+    assert_eq!(again_large.await.unwrap().unwrap().assigned_seq, seq(4));
+    assert_eq!(again_ahead.await.unwrap().unwrap().assigned_seq, seq(5));
+
+    // No rejected commit recorded its cursor (1): the cursor of `other` is still 0, the one
+    // its accepted commits reported, and the unregistered client is still not in the roster.
+    assert_eq!(cursor(&sender, &other).await, Some(seq(0)));
+    assert_eq!(cursor(&sender, &ghost).await, None);
+    assert_eq!(metrics(&sender).await.head_seq, seq(5));
+    assert_eq!(fx.fsyncs(), 3, "the first commit, the one in front, the group");
+
+    // Announced: the commit in front and the new operations of the group, the log itself.
+    let announced = pending_events(&mut events);
+    assert_eq!(
+        announced.iter().map(seqs_in).collect::<Vec<_>>(),
+        vec![vec![2], vec![3, 4, 5]]
+    );
+    let synced = sync_all(&sender, &writer).await.unwrap().ops;
+    let delivered: Vec<SequencedOperation> =
+        announced.iter().flat_map(|event| ops_in(event).0).collect();
+    assert_eq!(
+        delivered,
+        synced[1..]
+            .iter()
+            .map(|op| (**op).clone())
+            .collect::<Vec<_>>()
+    );
+    let ids: Vec<i64> = synced
+        .iter()
+        .map(|op| match op.op.pk().values()[0] {
+            Value::Int(id) => id,
+            ref other => panic!("unexpected key {other:?}"),
+        })
+        .collect();
+    assert_eq!(ids, vec![1, 2, 20, 21, 23]);
+
+    // Reopened from disk, the window of the log recognizes the new mutations, not the
+    // rejected ones.
+    fx.manager.shutdown_room(&fx.room_id).await;
+    let sender = fx.sender().await;
+    for (id, expected) in [(10, 3), (11, 4), (13, 5)] {
+        let retry = commit(&sender, &other, mutation(id), seq(0), insert_op(99))
+            .await
+            .unwrap();
+        assert_eq!(retry.assigned_seq, seq(expected), "mutation {id}");
+    }
+    assert_eq!(metrics(&sender).await.head_seq, seq(5));
+    fx.manager.shutdown_all().await;
+}
