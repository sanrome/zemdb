+/// Across a reopen of the room after its schema evolved: the stream of the actor that stops
+/// receives the events of that actor (its operations, then the reload, then its operations
+/// with the new version) and then ends, without any of the actor that replaces it; the
+/// stream of the new actor announces its operations with the version the registry holds and
+/// the incarnation of the room. The operations of both streams, in order, are the log.
+#[tokio::test]
+async fn review_b_events_across_a_reopen_after_an_evolution_continue_the_log() {
+    let dir = tempdir().unwrap();
+    let schema_id = SchemaId::new("todo").unwrap();
+    let registry =
+        Arc::new(crate::schema_registry::SchemaRegistry::new(dir.path().join("schemas")).unwrap());
+    registry
+        .register_schema(schema_id.clone(), test_schema())
+        .unwrap();
+    let config = ServerConfig {
+        data_dir: dir.path().to_path_buf(),
+        roster_persist_secs: 1,
+        idle_timeout_secs: 0,
+        ..ServerConfig::default()
+    };
+    let relay = Arc::new(
+        SnapshotRelay::new(
+            dir.path().join("snapshots"),
+            Duration::from_secs(60),
+            ServerConfig::default().max_snapshot_bytes,
+            Duration::from_secs(ServerConfig::default().snapshot_upload_max_secs),
+        )
+        .unwrap(),
+    );
+    let io = IoThreads::new(config.io_threads);
+    let mut manager = RoomManager::new(Arc::new(config), Arc::clone(&registry), relay, io);
+    manager.set_timings(TEST_TIMINGS);
+    let room_id = RoomId::new("room").unwrap();
+    let incarnation = manager
+        .create_room(room_id.clone(), schema_id.clone(), None)
+        .await
+        .unwrap()
+        .room_incarnation;
+
+    let sender = manager.get_or_spawn(&room_id, None).await.unwrap();
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+    let mut before = subscribe(&sender).await;
+    commit(&sender, &client, mutation(1), seq(0), insert_op(1))
+        .await
+        .unwrap();
+
+    let evolved = registry
+        .add_column(
+            &schema_id,
+            "tasks",
+            zemdb_core::schema::ColumnDef::new("tag", zemdb_core::value::DataType::String)
+                .nullable(true),
+        )
+        .unwrap();
+    assert_eq!(
+        manager.reload_schema_for_rooms(&schema_id).await,
+        vec![room_id.clone()]
+    );
+    let tagged = |id: i64| {
+        let row = RowBuilder::new()
+            .set("id", id)
+            .set("title", "t")
+            .set("tag", "x")
+            .build();
+        evolved.to_operation_insert("tasks", &row, 1000).unwrap()
+    };
+    commit(&sender, &client, mutation(2), seq(1), tagged(2))
+        .await
+        .unwrap();
+    manager.shutdown_room(&room_id).await;
+    let old = events_until_the_room_stops(&mut before).await;
+
+    let sender = manager.get_or_spawn(&room_id, None).await.unwrap();
+    let mut after = subscribe(&sender).await;
+    commit(&sender, &client, mutation(3), seq(2), tagged(3))
+        .await
+        .unwrap();
+    let new = pending_events(&mut after);
+
+    assert_eq!(old.len(), 3, "{old:?}");
+    assert_eq!(old[1], RoomEvent::SchemaReloaded(schema_id.clone()));
+    let parts: Vec<(Vec<u64>, u64, u128)> = [&old[0], &old[2]]
+        .into_iter()
+        .chain(new.iter())
+        .map(|event| {
+            let (ops, version, room) = review_b_event_parts(event);
+            (ops.iter().map(|op| op.seq.get()).collect(), version, room)
+        })
+        .collect();
+    assert_eq!(
+        parts,
+        vec![
+            (vec![1], 1, incarnation),
+            (vec![2], 2, incarnation),
+            (vec![3], 2, incarnation),
+        ]
+    );
+    let delivered: Vec<SequencedOperation> = [&old[0], &old[2]]
+        .into_iter()
+        .chain(new.iter())
+        .flat_map(|event| review_b_event_parts(event).0)
+        .collect();
+    let synced: Vec<SequencedOperation> = sync_all(&sender, &client)
+        .await
+        .unwrap()
+        .ops
+        .iter()
+        .map(|op| (**op).clone())
+        .collect();
+    assert_eq!(delivered, synced);
+    manager.shutdown_all().await;
+}
