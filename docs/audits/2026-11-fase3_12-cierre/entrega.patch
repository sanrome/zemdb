+/// In the middle of a group, a commit whose cursor fell behind the log is rejected with
+/// `BehindCompaction` and leaves no trace: the cursor its client has inside the log is not
+/// lowered, it is not announced, its mutation id stays free, and the group's sequences stay
+/// contiguous around it.
+// Paused time: no maintenance tick changes the lifecycle states under test.
+#[tokio::test(start_paused = true)]
+async fn review_b_a_commit_behind_the_log_in_a_group_leaves_no_trace() {
+    let (fx, writer, tail) = pruned_room().await;
+    let behind = seq(tail.get() - 2);
+    let client = ClientId::new("client").unwrap();
+    let sender = fx
+        .restart_with_roster(&[(&writer, "Connected", 8), (&client, "Connected", 8)])
+        .await;
+    let mut events = subscribe(&sender).await;
+
+    let (release, held) = hold_next_fsync(&fx.active_wal());
+    let first = send_commit(&sender, &writer, mutation(30), seq(8), insert_op(30)).await;
+    held.await.unwrap();
+    let stale = send_commit(&sender, &client, mutation(31), behind, insert_op(31)).await;
+    let fresh = send_commit(&sender, &client, mutation(31), seq(8), insert_op(32)).await;
+    let next = send_commit(&sender, &writer, mutation(33), seq(8), insert_op(33)).await;
+    release.send(()).unwrap();
+
+    assert_eq!(first.await.unwrap().unwrap().assigned_seq, seq(9));
+    assert!(matches!(
+        stale.await.unwrap(),
+        Err(ServerError::BehindCompaction)
+    ));
+    assert_eq!(fresh.await.unwrap().unwrap().assigned_seq, seq(10));
+    assert_eq!(next.await.unwrap().unwrap().assigned_seq, seq(11));
+
+    assert_eq!(cursor(&sender, &client).await, Some(seq(8)));
+    assert_eq!(states(&sender).await, (0, 2, 0, 0));
+    assert_eq!(metrics(&sender).await.head_seq, seq(11));
+    let announced = pending_events(&mut events);
+    assert_eq!(
+        announced
+            .iter()
+            .filter(|event| matches!(event, RoomEvent::Ops(_)))
+            .map(seqs_in)
+            .collect::<Vec<_>>(),
+        vec![vec![9], vec![10, 11]]
+    );
+    let synced = sync_from(&sender, &writer, seq(8)).await.unwrap();
+    let ids: Vec<i64> = synced
+        .ops
+        .iter()
+        .map(|op| match op.op.pk().values()[0] {
+            Value::Int(id) => id,
+            ref other => panic!("unexpected key {other:?}"),
+        })
+        .collect();
+    assert_eq!(ids, vec![30, 32, 33]);
+    fx.manager.shutdown_all().await;
+}
