+/// A group larger than the RAM window, which seals `active.wal` at its end: the catch-up of
+/// each of its commits is read from the sealed segment on the file I/O threads, with the
+/// reservation by chunks, and still carries exactly the operations after its cursor up to the
+/// head of the group, the same ones a sync returns and, from the head before the group, the
+/// ones its `ops` event carries.
+#[tokio::test]
+async fn review_b_catch_ups_of_a_group_larger_than_the_ram_window_are_the_log() {
+    let fx = Fixture::new(RoomLifecycleOverrides {
+        ram_max_ops: Some(2),
+        ..RoomLifecycleOverrides::default()
+    })
+    .await;
+    let sender = fx.sender().await;
+    let writer = ClientId::new("writer").unwrap();
+    register(&sender, &writer).await;
+    let clients: Vec<ClientId> = (0..5)
+        .map(|n| ClientId::new(format!("c{n}")).unwrap())
+        .collect();
+    for client in &clients {
+        register(&sender, client).await;
+    }
+    let mut events = subscribe(&sender).await;
+
+    let (release, held) = hold_next_fsync(&fx.active_wal());
+    let first = send_commit(&sender, &writer, mutation(1), seq(0), insert_op(1)).await;
+    held.await.unwrap();
+    let mut replies = Vec::new();
+    for (n, client) in (2u8..).zip(&clients) {
+        // Cursors 0 and 1: from before the RAM window, which keeps the last two.
+        let cursor = seq(u64::from(n % 2));
+        replies.push((
+            cursor,
+            send_commit(&sender, client, mutation(n), cursor, insert_op(n.into())).await,
+        ));
+    }
+    release.send(()).unwrap();
+    first.await.unwrap().unwrap();
+    let mut answered = Vec::new();
+    for (cursor, reply) in replies {
+        answered.push((cursor, reply.await.unwrap().unwrap()));
+    }
+
+    let segments = fx.room_dir().join("segments");
+    let mut names: Vec<String> = fs::read_dir(&segments)
+        .unwrap()
+        .map(|entry| entry.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    names.sort();
+    assert!(
+        segment_path(&segments, seq(1), seq(6), Tier::Warm).exists(),
+        "the group must have sealed active.wal at its end: {names:?}"
+    );
+    let synced: Vec<SequencedOperation> = sync_all(&sender, &writer)
+        .await
+        .unwrap()
+        .ops
+        .iter()
+        .map(|op| (**op).clone())
+        .collect();
+    assert_eq!(synced.len(), 6);
+    for (n, (cursor, reply)) in (2u64..).zip(answered) {
+        assert_eq!(reply.assigned_seq, seq(n));
+        let catch_up: Vec<SequencedOperation> =
+            reply.catchup_ops.iter().map(|op| (**op).clone()).collect();
+        assert_eq!(
+            catch_up,
+            synced[cursor.get() as usize..].to_vec(),
+            "the catch-up of commit {n} from {cursor}"
+        );
+        assert!(!reply.has_more);
+    }
+    let announced = pending_events(&mut events);
+    let delivered: Vec<SequencedOperation> =
+        announced.iter().flat_map(|event| ops_in(event).0).collect();
+    assert_eq!(delivered, synced);
+    fx.manager.shutdown_all().await;
+}
