+// Review A of the closing review of Fase 3.12 (durability, recovery and lifecycle).
+
+/// A prune that deletes on the slow tick, after a commit reported the cursor that moved the
+/// floor (no Ack prunes), writes the roster before it deletes, also inside the roster's period:
+/// the cursor on disk never falls behind the pruned tail (INV-R1, D56, with the grid of DS7).
+// Paused time: the test moves the Tokio clock and runs the ticks itself.
+#[tokio::test(start_paused = true)]
+async fn review_a_a_prune_that_deletes_on_the_slow_tick_writes_the_roster_first() {
+    tokio::time::advance(CLOCK_AHEAD).await;
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 2,
+        ..RoomLifecyclePolicy::default()
+    };
+    let mut actor = roster_actor(&dir, &relay_on(&dir), policy);
+    let client = ClientId::new("writer").unwrap();
+    actor.register(&client, None, None).unwrap();
+    let mut flow = ControlFlow::Continue(());
+    for n in 1..=4u8 {
+        actor
+            .commit(&client, mutation(n), seq(0), insert_op(n.into()), &mut flow)
+            .await
+            .unwrap();
+    }
+    actor.run_fast_maintenance().await;
+    assert_eq!(cursor_on_disk(&dir, &client), Some(seq(0)));
+
+    tokio::time::advance(Duration::from_secs(1)).await;
+    // The commit reports cursor 4, which moves the floor; it prunes nothing itself.
+    actor
+        .commit(&client, mutation(5), seq(4), insert_op(5), &mut flow)
+        .await
+        .unwrap();
+    assert_eq!(actor.log().tail_seq(), seq(1));
+    assert!(
+        !actor.roster_due(),
+        "the slow tick must run inside the roster's period"
+    );
+    actor.run_disk_maintenance().await;
+    let tail = actor.log().tail_seq();
+    assert!(tail > seq(1), "the slow tick must prune a segment");
+    let on_disk = cursor_on_disk(&dir, &client).unwrap();
+    assert!(
+        on_disk.get() + 1 >= tail.get(),
+        "the cursor on disk {on_disk} is behind the pruned tail {tail}"
+    );
+}
+
+/// A group of commits whose fsync fails leaves nothing of it confirmed, deduplicated or
+/// announced once the room reopens from disk without its records: with the records lost (here
+/// cut from `active.wal` while the room is stopped, as a power cut before the reopen would
+/// leave it), a retry of each mutation of the group is a new mutation, written and synced
+/// again, sequenced after what was durable and announced only then (INV-D1, INV-D7, INV-L3).
+#[tokio::test]
+async fn review_a_a_failed_group_whose_records_are_lost_leaves_nothing_behind() {
+    const WAITING: u8 = 3;
+    let fx = Fixture::new(RoomLifecycleOverrides::default()).await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+
+    // Holds the fsync of commit 1, and notes how long `active.wal` is then: its record only.
+    let (release_tx, release_rx) = std::sync::mpsc::channel::<()>();
+    let (held_tx, held_rx) = oneshot::channel();
+    let synced_len = Arc::new(Mutex::new(0u64));
+    fail_point::arm_hook("warm_append_sync", &fx.active_wal(), {
+        let (active, synced_len) = (fx.active_wal(), Arc::clone(&synced_len));
+        move || {
+            *synced_len.lock().unwrap() = fs::metadata(&active).unwrap().len();
+            let _ = held_tx.send(());
+            let _ = release_rx.recv_timeout(POLL_CEILING);
+        }
+    });
+    let first = send_commit(&sender, &client, mutation(1), seq(0), insert_op(1)).await;
+    held_rx.await.unwrap();
+    let mut replies = Vec::new();
+    for n in 2..=WAITING + 1 {
+        replies.push(send_commit(&sender, &client, mutation(n), seq(0), insert_op(n.into())).await);
+    }
+    let active = fx.active_wal();
+    before_next_fsync(&fx.active_wal(), move || {
+        fail_point::arm("warm_append_sync", &active)
+    });
+    release_tx.send(()).unwrap();
+    assert_eq!(first.await.unwrap().unwrap().assigned_seq, seq(1));
+    for reply in replies {
+        assert!(matches!(reply.await, Ok(Err(ServerError::Unavailable(_)))));
+    }
+
+    // The room stops; then the records of the failed group are lost.
+    assert!(sender.is_closed(), "the room must stop after a failed fsync");
+    fx.manager.shutdown_room(&fx.room_id).await;
+    let synced_len = *synced_len.lock().unwrap();
+    let file = fs::OpenOptions::new()
+        .write(true)
+        .open(fx.active_wal())
+        .unwrap();
+    assert!(
+        file.metadata().unwrap().len() > synced_len,
+        "the records of the failed group reached the file"
+    );
+    file.set_len(synced_len).unwrap();
+    drop(file);
+
+    let recovered = fx.sender().await;
+    let mut events = subscribe(&recovered).await;
+    let fsyncs = fx.fsyncs();
+    for n in 2..=WAITING + 1 {
+        let retry = commit(&recovered, &client, mutation(n), seq(0), insert_op(n.into()))
+            .await
+            .unwrap();
+        assert_eq!(retry.assigned_seq, seq(n.into()));
+    }
+    assert_eq!(
+        fx.fsyncs() - fsyncs,
+        usize::from(WAITING),
+        "every retry must be written and synced again, as a new mutation"
+    );
+    let announced: Vec<Vec<u64>> = pending_events(&mut events).iter().map(seqs_in).collect();
+    assert_eq!(announced, vec![vec![2], vec![3], vec![4]]);
+    let synced = sync_all(&recovered, &client).await.unwrap();
+    assert_eq!(synced.ops.len(), usize::from(WAITING) + 1);
+    fx.manager.shutdown_all().await;
+}
