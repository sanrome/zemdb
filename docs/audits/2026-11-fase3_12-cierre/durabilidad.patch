+// Review A of the closing review of Fase 3.12 (durability, recovery and lifecycle).
+
+/// The client's cursor in the roster file at `path`, if the file holds the client.
+fn review_a_cursor_in_roster(path: &Path, client_id: &ClientId) -> Option<SequenceNumber> {
+    let bytes = fs::read(path).ok()?;
+    let roster: serde_json::Value =
+        serde_json::from_str(durable::verified_json(&bytes)?).unwrap();
+    let entries: Vec<crate::actor::lease::ClientEntry> =
+        serde_json::from_value(roster["clients"].clone()).unwrap();
+    entries
+        .into_iter()
+        .find(|entry| &entry.client_id == client_id)
+        .map(|entry| entry.last_ack_seq)
+}
+
+/// A room stopped by a failed fsync writes its roster on the file I/O threads on its way out.
+/// A request that arrives meanwhile reopens the room only once that write ended and the old
+/// actor released the room's files, and the reopened room reads the roster that the stop wrote
+/// (INV-L7, INV-L5, INV-R3): an operation of the old actor never lands after the room reopens.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn review_a_a_room_stopped_by_a_failed_fsync_reopens_only_after_its_stop_wrote_the_roster()
+{
+    let dir = tempdir().unwrap();
+    // A period longer than the test: the fast tick does not write the last changes.
+    let (manager, _relay) = test_manager(dir.path(), &["first"], |config| {
+        config.roster_persist_secs = 300;
+    });
+    let manager = Arc::new(manager);
+    let client = ClientId::new("writer").unwrap();
+    let room_id = RoomId::new("failing").unwrap();
+    open_with_client(&manager, &room_id, &client).await;
+    assert_eq!(
+        commit_nth(&manager, &room_id, &client, 1).await,
+        SequenceNumber::new(1)
+    );
+    // A commit that reports cursor 1, and a heartbeat, so that the stop has something to write
+    // whatever the fast tick wrote.
+    let second = manager
+        .ask(&room_id, |reply| RoomCommand::Commit {
+            client_id: client.clone(),
+            mutation_id: MutationId::new([2; 16]),
+            last_ack_seq: SequenceNumber::new(1),
+            op: insert_op(2),
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(second.assigned_seq, SequenceNumber::new(2));
+    manager
+        .ask(&room_id, |reply| RoomCommand::Heartbeat {
+            client_id: client.clone(),
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+
+    let roster = room_dir(&dir, &room_id).join(format!("meta_clients_{room_id}.json"));
+    let stop = Stop::arm("write_atomic_before_rename", &roster);
+    fail_point::arm("warm_append_sync", &active_wal(&dir, &room_id));
+    let failed = manager
+        .ask(&room_id, |reply| RoomCommand::Commit {
+            client_id: client.clone(),
+            mutation_id: MutationId::new([3; 16]),
+            last_ack_seq: SequenceNumber::new(2),
+            op: insert_op(3),
+            reply,
+        })
+        .await
+        .unwrap();
+    assert!(
+        matches!(failed, Err(ServerError::Unavailable(_))),
+        "{failed:?}"
+    );
+    stop.wait_reached().await;
+
+    let reopening = tokio::spawn({
+        let (manager, room_id, client) = (Arc::clone(&manager), room_id.clone(), client.clone());
+        async move {
+            manager
+                .ask(&room_id, |reply| RoomCommand::GetClientCursor {
+                    client_id: client.clone(),
+                    reply,
+                })
+                .await
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    assert!(
+        !reopening.is_finished(),
+        "the room reopened while its stop was writing the roster"
+    );
+    assert!(
+        crate::log::tiered_log::lock_log(&room_dir(&dir, &room_id)).is_err(),
+        "the room's files were released while its stop was writing the roster"
+    );
+
+    stop.let_go();
+    assert!(stop.was_released().await, "the stop's write was not held");
+    let cursor = reopening.await.unwrap().unwrap().unwrap();
+    assert_eq!(
+        cursor,
+        Some(SequenceNumber::new(1)),
+        "the reopened room must read the roster that the stop wrote"
+    );
+    assert_eq!(
+        review_a_cursor_in_roster(&roster, &client),
+        Some(SequenceNumber::new(1))
+    );
+    manager.shutdown_all().await;
+}
+
+/// With one file I/O thread and a roster period longer than the test, the rooms that
+/// `shutdown_all` closes together each write, on their way out and in turn on that thread, the
+/// cursor of their last change, which no tick wrote (INV-L5, INV-R3).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn review_a_shutdown_all_with_one_io_thread_writes_every_roster_changed_within_its_period()
+{
+    let dir = tempdir().unwrap();
+    let (manager, _relay) = test_manager(dir.path(), &["first"], |config| {
+        config.io_threads = 1;
+        config.roster_persist_secs = 300;
+    });
+    let client = ClientId::new("writer").unwrap();
+    let mut rooms = Vec::new();
+    for i in 0..8 {
+        let room_id = RoomId::new(format!("closing-{i}")).unwrap();
+        open_with_client(&manager, &room_id, &client).await;
+        commit_nth(&manager, &room_id, &client, 1).await;
+        manager
+            .ask(&room_id, |reply| RoomCommand::Ack {
+                client_id: client.clone(),
+                ack_seq: SequenceNumber::new(1),
+                reply,
+            })
+            .await
+            .unwrap()
+            .unwrap();
+        rooms.push(room_id);
+    }
+
+    manager.shutdown_all().await;
+    for room_id in &rooms {
+        let roster = room_dir(&dir, room_id).join(format!("meta_clients_{room_id}.json"));
+        assert_eq!(
+            review_a_cursor_in_roster(&roster, &client),
+            Some(SequenceNumber::new(1)),
+            "{room_id} lost the cursor of its last ack in the shutdown"
+        );
+    }
+}
