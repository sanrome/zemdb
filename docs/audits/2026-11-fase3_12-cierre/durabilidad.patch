+++ b/crates/server/src/log/tests/tiered_log.rs
@@ -3599,3 +3599,49 @@ fn damage_in_the_last_group_after_its_fsync_is_truncated_from_the_damage() {
         Err(ServerError::BehindCompaction)
     ));
 }
+
+// Review A of the closing review of Fase 3.12 (durability, recovery and lifecycle).
+
+/// Damage after its fsync to a group that is not the last one written (a media failure in group
+/// 4..=7, acknowledged), when the power cut during the fsync of the group written after it
+/// (record 8, never acknowledged) lost every sector of that group: nothing valid of the later
+/// group is left, so the open takes the damaged group for the last one, as DS9 does for the last
+/// group, and truncates acknowledged records of it; their sequences are assigned again. With any
+/// frame of the later group left, the same damage is corruption and nothing is truncated. Fixes
+/// the behaviour behind the reading of "the last group" in `INVARIANTES.md` (INV-D2, D3 and the
+/// row of D78 in §4): the last group of which valid frames are left.
+#[test]
+fn review_a_damage_in_a_synced_group_whose_later_group_was_lost_whole_truncates_it() {
+    let dir = tempdir().unwrap();
+    let (mut bytes, ends) = write_groups(dir.path(), &[(1, 3), (4, 7), (8, 8)], true);
+    // Media damage to record 5, synced and acknowledged with its group 4..=7.
+    bytes[ends[4] - 10] ^= 0xFF;
+
+    // Record 8, of a later group, is left: corruption, and nothing is truncated.
+    let (copy, opened) = open_image(&bytes);
+    assert!(opened.is_err(), "a frame of a later group follows the damage");
+    let on_disk = std::fs::read(segments_dir(copy.path()).join("active.wal")).unwrap();
+    assert_eq!(on_disk, bytes, "nothing may be truncated");
+
+    // The power cut lost every sector of record 8 (the file kept its length).
+    bytes[ends[6]..ends[7]].fill(0);
+    let (copy, opened) = open_image(&bytes);
+    let (mut log, mutations) = opened.expect("damage followed only by its own group is torn");
+    assert_eq!(
+        log.head_seq().get(),
+        4,
+        "records 5..=7, acknowledged, are truncated with the damaged group"
+    );
+    assert_eq!(mutations.len(), 4);
+    assert_eq!(
+        std::fs::read(segments_dir(copy.path()).join("active.wal"))
+            .unwrap()
+            .len(),
+        ends[3],
+        "active.wal is truncated from the damaged record on"
+    );
+    // The sequence of record 5 is assigned again, to another operation.
+    log.append_group(group_of(5, 5)).unwrap();
+    let (ops, _) = log.fetch_deltas(SequenceNumber::new(4), 10, None).unwrap();
+    assert_eq!(owned(ops), vec![make_op(5)]);
+}
