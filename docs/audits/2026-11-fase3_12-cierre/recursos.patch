+//! Review C of the closing review of Fase 3.12: what the search after a damaged frame of the last
+//! group of commits (`find_frame_after_group`, Lote 4b) allocates when the bytes after the damage
+//! hold a frame that a member stored as a value.
+//!
+//! The search decodes the payload of every frame it finds after the damage, to read where its
+//! group starts. Log records are decoded without a budget of values (they come from operations
+//! the server accepted), but a frame the search finds after the damage can be any bytes a member
+//! wrote: a payload of `Null`s takes 4 bytes per value in the log and 24 decoded.
+//!
+//! The file holds a single test, because it measures the peak resident memory of the whole
+//! process (`VmHWM` in `/proc/self/status`, reset through `/proc/self/clear_refs`): Linux only.
+
+use std::io::Cursor;
+
+use zemdb_core::mutation::Operation;
+use zemdb_core::protocol::codec::{MAX_FRAME_SIZE, MAX_MESSAGE_SIZE};
+use zemdb_core::protocol::limits::MAX_MESSAGE_VALUES;
+use zemdb_core::protocol::messages::SequencedOperation;
+use zemdb_core::protocol::wal_frame::{
+    encode_wal_batch_in_group, find_frame_after_group, FrameAnomaly, InvalidHeader,
+    BATCH_HEADER_SIZE, BATCH_MAGIC,
+};
+use zemdb_core::schema::MAX_COLUMNS;
+use zemdb_core::value::{CompactRow, PrimaryKey, Value};
+
+/// A field of `/proc/self/status`, in bytes.
+fn status_bytes(field: &str) -> usize {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap();
+    let line = status
+        .lines()
+        .find(|line| line.starts_with(field))
+        .unwrap_or_else(|| panic!("no {field} in /proc/self/status"));
+    let kib: usize = line
+        .split_whitespace()
+        .nth(1)
+        .and_then(|kib| kib.parse().ok())
+        .unwrap();
+    kib * 1024
+}
+
+/// Resets the peak resident memory of the process (`VmHWM`) to what it holds now, and returns
+/// that.
+fn reset_peak() -> usize {
+    std::fs::write("/proc/self/clear_refs", "5").unwrap();
+    status_bytes("VmRSS:")
+}
+
+/// Bytes before the operations in a payload of the log: where its group starts (8 bytes), no
+/// mutation id (1) and the number of operations (8).
+const PAYLOAD_PREFIX: usize = 17;
+
+/// A frame of the log holding `count` copies of `encoded_op`, the encoding of one operation in a
+/// payload, built from the bytes alone, so that the test never holds the operations decoded.
+fn frame_of(encoded_op: &[u8], count: usize) -> Vec<u8> {
+    let mut payload = Vec::with_capacity(PAYLOAD_PREFIX + encoded_op.len() * count);
+    payload.extend_from_slice(&0u64.to_le_bytes());
+    payload.push(0);
+    payload.extend_from_slice(&(count as u64).to_le_bytes());
+    for _ in 0..count {
+        payload.extend_from_slice(encoded_op);
+    }
+    let mut frame = Vec::with_capacity(BATCH_HEADER_SIZE + payload.len());
+    frame.extend_from_slice(&BATCH_MAGIC);
+    frame.extend_from_slice(&(payload.len() as u32).to_le_bytes());
+    frame.extend_from_slice(&crc32fast::hash(&payload).to_le_bytes());
+    frame.extend_from_slice(&(count as u32).to_le_bytes());
+    let header_crc = crc32fast::hash(&frame);
+    frame.extend_from_slice(&header_crc.to_le_bytes());
+    frame.extend_from_slice(&payload);
+    frame
+}
+
+/// The search after a damaged frame of the last group decodes no more values than a client
+/// message may (`MAX_MESSAGE_VALUES`), so that opening a room whose last group was torn holds at
+/// most what reading one frame of its log takes: the frame, and the values of one operation.
+///
+/// Here the bytes after the damage hold a valid frame, as a member can store one in a `Bytes`
+/// value of its commit (`DS9`'s accepted risk is that it turns a torn write into corruption, not
+/// what it allocates): a full payload of operations whose rows are `MAX_COLUMNS` `Null`s, about
+/// 4 million values, about 100 MB decoded from 16 MiB in the log.
+#[cfg(target_os = "linux")]
+#[test]
+fn review_c_the_search_after_a_damaged_group_decodes_no_more_values_than_a_client_message_may() {
+    let (encoded_op, count) = {
+        let row = CompactRow::new(vec![Value::Null; MAX_COLUMNS]);
+        let op =
+            SequencedOperation::new(1, Operation::insert(0, PrimaryKey::single(1i64), row, 100));
+        let one = encode_wal_batch_in_group(std::slice::from_ref(&op), None, 0).unwrap();
+        let encoded_op = one[BATCH_HEADER_SIZE + PAYLOAD_PREFIX..].to_vec();
+        // The frame built from the bytes alone is the one the log writes.
+        assert_eq!(frame_of(&encoded_op, 1), one);
+        let count = (MAX_MESSAGE_SIZE as usize - PAYLOAD_PREFIX) / encoded_op.len();
+        (encoded_op, count)
+    };
+    let values = (count * MAX_COLUMNS) as u64;
+    assert!(
+        values > 3 * MAX_MESSAGE_VALUES,
+        "the frame holds {values} values"
+    );
+
+    // Damage that leaves no header at offset 0, and the stored frame right after it.
+    let mut log = vec![0u8; BATCH_HEADER_SIZE];
+    log.extend_from_slice(&frame_of(&encoded_op, count));
+    drop(encoded_op);
+    let anomaly = FrameAnomaly::InvalidHeader(InvalidHeader::Magic([0, 0]));
+    let end = log.len() as u64;
+    let mut reader = Cursor::new(log.as_slice());
+
+    let before = reset_peak();
+    let found = find_frame_after_group(&mut reader, 0, &anomaly, end).unwrap();
+    let allocated = status_bytes("VmHWM:").saturating_sub(before);
+    eprintln!(
+        "values in the stored frame: {values}; peak resident memory of the search: {allocated} \
+         bytes ({} MiB); before it: {} MiB",
+        allocated >> 20,
+        before >> 20
+    );
+
+    // Its group starts after the damage, so it is a later write: corruption, the room fails to
+    // open, as `DS9` accepts.
+    assert_eq!(found, Some(BATCH_HEADER_SIZE as u64));
+    // What one frame of the log takes read and decoded: the frame, and at most the values of a
+    // client message, with room for the rest of the operations and the allocator.
+    let bound =
+        MAX_FRAME_SIZE + MAX_MESSAGE_VALUES as usize * std::mem::size_of::<Value>() + (8 << 20);
+    assert!(
+        allocated <= bound,
+        "the search took {allocated} bytes of resident memory at once, over {bound}: it decoded {values} \
+         values of a frame a member stored"
+    );
+}
