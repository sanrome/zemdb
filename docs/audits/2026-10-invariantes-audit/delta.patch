+// AUDIT (delta 3.8): once a sync finds the gap after the active snapshot, the snapshot is no
+// longer announced, but chunk 0 (the request that starts a download, without a hash) still
+// serves it: `get_chunk` checks only `LogBounds::admits`, not the unrestorable mark.
+#[tokio::test]
+async fn audit_chunk_zero_serves_a_snapshot_below_a_known_gap() {
+    let fx = Fixture::new(small_segments()).await;
+    let sender = fx.sender().await;
+    let writer = ClientId::new("writer").unwrap();
+    register(&sender, &writer).await;
+    for n in 1..=6u8 {
+        commit(&sender, &writer, mutation(n), seq(0), insert_op(n.into()))
+            .await
+            .unwrap();
+    }
+    stage_snapshot_at(&fx, 2).await;
+    ack(&sender, &writer, seq(6)).await.unwrap();
+    let segments = fx.room_dir().join("segments");
+    fs::remove_file(segment_path(&segments, seq(3), seq(4), Tier::Warm)).unwrap();
+
+    let restorer = ClientId::new("restorer").unwrap();
+    register_at(&sender, &restorer, Some((seq(2), fx.incarnation))).await;
+    let res = sync_from(&sender, &restorer, seq(2)).await;
+    assert!(matches!(res, Err(ServerError::BehindCompaction)), "{res:?}");
+    let hb = heartbeat(&sender, &writer).await.unwrap();
+    assert_eq!(hb.active_snapshot_seq, None, "no longer announced");
+
+    // A new client (or one with a stale `snapshot_available`) starts a download.
+    let chunk = fx
+        .relay
+        .get_chunk(
+            zemdb_core::id::CorrelationId::new(1),
+            &fx.room_id,
+            0,
+            1024,
+            None,
+            async {
+                let (tail_seq, head_seq) = fx.manager.log_bounds(&fx.room_id).await?;
+                Ok(crate::relay::LogBounds { tail_seq, head_seq })
+            },
+        )
+        .await;
+    let served = match &chunk {
+        Ok(zemdb_core::protocol::messages::ServerMessage::SnapshotChunk {
+            snapshot_head_seq, ..
+        }) => Some(*snapshot_head_seq),
+        _ => None,
+    };
+    fx.manager.shutdown_all().await;
+    assert_eq!(
+        served, None,
+        "chunk 0 served the snapshot below the gap ({chunk:?})"
+    );
+}
