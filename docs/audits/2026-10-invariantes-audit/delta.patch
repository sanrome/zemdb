+// AUDIT (delta 3.8): a damaged `log_meta.json` that is still valid JSON (one bit flipped in a
+// digit: "10" -> "18") makes the open delete retained segments that nothing pruned.
+#[test]
+fn audit_damaged_log_meta_deletes_retained_segments() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    // Sealed [1..=5], [6..=10], [11..=15], [16..=20]; 21..=22 in active.wal.
+    append_range(&mut log, 1, 22);
+    // A legitimate prune of [1..=5] and [6..=10]: log_meta.json says 10.
+    log.prune_older_than(SequenceNumber::new(11)).unwrap();
+    assert_eq!(log.tail_seq().get(), 11);
+    drop(log);
+    let meta = dir.path().join("log_meta.json");
+    let text = std::fs::read_to_string(&meta).unwrap();
+    assert!(text.contains("10"), "{text}");
+    // One bit flipped: '0' (0x30) -> '8' (0x38).
+    std::fs::write(&meta, text.replace("10", "18")).unwrap();
+
+    let kept = segment_file(&segments_dir(dir.path()), 11, 15, "wal");
+    assert!(kept.exists());
+    let (log, _) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    // Operations 11..=15 were never pruned; the open must not discard them.
+    assert!(kept.exists(), "the open deleted the retained segment 11..=15");
+    assert_eq!(log.tail_seq().get(), 11, "tail moved past retained operations");
+}
