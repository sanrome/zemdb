@@ -0,0 +1,345 @@
+//! Auditoría INV-B4: costo por request del actor y de la apertura frente a la historia
+//! retenida y al roster. Mediciones manuales (`#[ignore]`), sin runtime (blocking_io corre en el
+//! lugar). Los segmentos se fabrican directamente en disco (frames + sidecars), sin fsync.
+
+use super::*;
+use crate::actor::test_support::test_schema;
+use crate::log::segment_index::{encode_mutation_ids, mutation_ids_path, segment_path, Tier};
+use std::io::Write as _;
+use std::time::Instant as StdInstant;
+use tempfile::tempdir;
+use zemdb_core::protocol::wal_frame::encode_wal_record;
+use zemdb_core::value::{RowBuilder, Value};
+
+fn op_with(payload: usize, id: i64) -> Operation {
+    let title: String = "x".repeat(payload);
+    let row = RowBuilder::new()
+        .set("id", id)
+        .set("title", Value::String(title.into_boxed_str()))
+        .build();
+    test_schema()
+        .to_operation_insert("tasks", &row, 1000)
+        .unwrap()
+}
+
+fn mid(i: u64) -> MutationId {
+    let mut b = [0u8; 16];
+    b[..8].copy_from_slice(&i.to_le_bytes());
+    b[8] = 0x5A;
+    MutationId::new(b)
+}
+
+/// Writes a room log with `sealed` operations in segments of `seg_ops` (cold if `cold`), and
+/// `active` more operations in `active.wal`, every operation with a title of `payload` bytes.
+fn write_log(room_dir: &Path, sealed: u64, seg_ops: u64, active: u64, payload: usize, cold: bool) {
+    let segs = room_dir.join("segments");
+    std::fs::create_dir_all(&segs).unwrap();
+    let template = op_with(payload, 1);
+    let mut start = 1u64;
+    while start <= sealed {
+        let end = (start + seg_ops - 1).min(sealed);
+        let mut frames = Vec::new();
+        let mut ids = Vec::new();
+        for s in start..=end {
+            let op = SequencedOperation::new(SequenceNumber::new(s), template.clone());
+            frames.extend(encode_wal_record(&op, Some(mid(s))).unwrap());
+            ids.push((mid(s), SequenceNumber::new(s)));
+        }
+        let (a, b) = (SequenceNumber::new(start), SequenceNumber::new(end));
+        if cold {
+            let z = zstd::stream::encode_all(&frames[..], 3).unwrap();
+            std::fs::write(segment_path(&segs, a, b, Tier::Cold), z).unwrap();
+        } else {
+            std::fs::write(segment_path(&segs, a, b, Tier::Warm), &frames).unwrap();
+        }
+        std::fs::write(mutation_ids_path(&segs, a, b), encode_mutation_ids(a, b, &ids)).unwrap();
+        start = end + 1;
+    }
+    let mut f = std::fs::File::create(segs.join("active.wal")).unwrap();
+    for s in sealed + 1..=sealed + active {
+        let op = SequencedOperation::new(SequenceNumber::new(s), template.clone());
+        f.write_all(&encode_wal_record(&op, Some(mid(s))).unwrap()).unwrap();
+    }
+}
+
+/// Writes a roster of `clients` connected clients at cursor `cursor`.
+fn write_roster(room_dir: &Path, room: &RoomId, clients: usize, cursor: u64) {
+    let path = room_dir.join(format!("meta_clients_{}.json", room.as_str()));
+    let mut t = ClientLeaseTracker::open_or_create(&path).unwrap();
+    for i in 0..clients {
+        let c = ClientId::new(format!("client-{i:06}")).unwrap();
+        t.register_client(&c, Some(SequenceNumber::new(cursor)), SequenceNumber::new(1));
+    }
+    t.save().unwrap();
+}
+
+struct Env {
+    _dir: tempfile::TempDir,
+    data_dir: PathBuf,
+    room: RoomId,
+    relay: Arc<SnapshotRelay>,
+    config: Arc<ServerConfig>,
+}
+
+fn env() -> Env {
+    let dir = tempdir().unwrap();
+    let data_dir = dir.path().to_path_buf();
+    let relay = Arc::new(
+        SnapshotRelay::new(data_dir.join("snapshots"), Duration::from_secs(60), 1 << 30).unwrap(),
+    );
+    let config = Arc::new(ServerConfig {
+        data_dir: data_dir.clone(),
+        ..ServerConfig::default()
+    });
+    Env {
+        _dir: dir,
+        data_dir,
+        room: RoomId::new("room").unwrap(),
+        relay,
+        config,
+    }
+}
+
+impl Env {
+    fn room_dir(&self) -> PathBuf {
+        room_dir(&self.data_dir, &self.room)
+    }
+    fn open(&self) -> (mpsc::Sender<RoomCommand>, RoomActor) {
+        RoomActor::open(
+            self.room.clone(),
+            7,
+            SchemaId::new("todo").unwrap(),
+            Arc::new(test_schema()),
+            &self.data_dir,
+            Arc::clone(&self.config),
+            RoomLifecyclePolicy::default(),
+            Arc::clone(&self.relay),
+            ActorTimings::default(),
+        )
+        .unwrap()
+    }
+    /// Median open time of `n` opens, in ms.
+    fn open_ms(&self, n: usize) -> f64 {
+        let mut t = Vec::new();
+        for _ in 0..n {
+            let s = StdInstant::now();
+            let (tx, actor) = self.open();
+            t.push(s.elapsed().as_secs_f64() * 1e3);
+            drop(actor);
+            drop(tx);
+        }
+        t.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        t[t.len() / 2]
+    }
+}
+
+fn median_us(mut v: Vec<f64>) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[v.len() / 2]
+}
+
+#[test]
+#[ignore]
+fn inv_b4_open_cost_vs_history() {
+    println!("== open cost vs retained history (segments of 1000 ops + 500 ops in active.wal)");
+    for (sealed, payload, cold) in [
+        (0u64, 16usize, false),
+        (1_000, 16, false),
+        (10_000, 16, false),
+        (100_000, 16, false),
+        (1_000_000, 16, false),
+        (1_000, 20_000, true),
+        (10_000, 20_000, true),
+        (100_000, 20_000, true),
+    ] {
+        let e = env();
+        let s = StdInstant::now();
+        write_log(&e.room_dir(), sealed, 1000, 500, payload, cold);
+        let gen = s.elapsed();
+        let files = std::fs::read_dir(e.room_dir().join("segments")).unwrap().count();
+        let ms = e.open_ms(5);
+        println!(
+            "   sealed={sealed:>8} payload={payload:>6} cold={cold:<5} files={files:>5} gen={gen:>8.1?} open median={ms:.2} ms"
+        );
+    }
+}
+
+#[test]
+#[ignore]
+fn inv_b4_open_cost_vs_roster() {
+    println!("== open cost vs roster size (10^4 ops retained)");
+    for clients in [0usize, 10, 1_000, 10_000] {
+        let e = env();
+        write_log(&e.room_dir(), 10_000, 1000, 500, 16, false);
+        write_roster(&e.room_dir(), &e.room, clients, 10_000);
+        let ms = e.open_ms(5);
+        println!("   clients={clients:>6} open median={ms:.2} ms");
+    }
+}
+
+/// Per-request costs with `sealed` retained 20 KB operations (cold) and `clients` connected
+/// clients plus one lagging client at cursor 0 that keeps the history from being pruned.
+fn per_request(sealed: u64, clients: usize) {
+    let e = env();
+    write_log(&e.room_dir(), sealed, 1000, 200, 20_000, true);
+    let head = sealed + 200;
+    write_roster(&e.room_dir(), &e.room, clients, head - 100);
+    let (_tx, mut a) = e.open();
+    let lag = ClientId::new("lagging").unwrap();
+    a.register(&lag, Some(SequenceNumber::new(0)), Some(7)).unwrap();
+    let roster = e.room_dir().join(format!("meta_clients_{}.json", e.room.as_str()));
+    let roster_before = std::fs::metadata(&roster).unwrap().modified().unwrap();
+    let me = ClientId::new("client-000000").unwrap();
+
+    // Acks inside active.wal (the lagging client keeps the floor at 0).
+    let mut t = Vec::new();
+    for k in 0..100u64 {
+        let s = StdInstant::now();
+        a.ack(&me, SequenceNumber::new(head - 100 + k)).unwrap();
+        t.push(s.elapsed().as_secs_f64() * 1e6);
+    }
+    let ack_us = median_us(t);
+
+    // Heartbeats.
+    let mut t = Vec::new();
+    for _ in 0..100 {
+        let s = StdInstant::now();
+        a.heartbeat(&me).unwrap();
+        t.push(s.elapsed().as_secs_f64() * 1e6);
+    }
+    let hb_us = median_us(t);
+
+    // Registration storm: 1000 new connected clients.
+    let s = StdInstant::now();
+    for i in 0..1000 {
+        let c = ClientId::new(format!("storm-{i:06}")).unwrap();
+        a.register(&c, Some(SequenceNumber::new(head)), Some(7)).unwrap();
+    }
+    let reg_us = s.elapsed().as_secs_f64() * 1e6 / 1000.0;
+    let roster_after = std::fs::metadata(&roster).unwrap().modified().unwrap();
+
+    // Sync from the middle of the history (a cold segment) and from the newest sealed segment.
+    let mid_cursor = (sealed / 2).max(1);
+    let s = StdInstant::now();
+    let r = a.sync(&me, SequenceNumber::new(mid_cursor), 10);
+    let sync_mid_ms = s.elapsed().as_secs_f64() * 1e3;
+    let mid_ok = r.map(|r| r.ops.len()).unwrap_or(0);
+    let s = StdInstant::now();
+    let r = a.sync(&me, SequenceNumber::new(sealed.saturating_sub(5)), 10);
+    let sync_last_ms = s.elapsed().as_secs_f64() * 1e3;
+    let last_ok = r.map(|r| r.ops.len()).unwrap_or(0);
+
+    // Commits of 20 KB (append + fsync), with the client up to date.
+    let mut t = Vec::new();
+    for k in 0..20u64 {
+        let mut flow = ControlFlow::Continue(());
+        let h = a.head_seq;
+        let s = StdInstant::now();
+        a.commit(&me, mid(10_000_000 + k), h, op_with(20_000, 5_000_000 + k as i64), &mut flow)
+            .unwrap();
+        t.push(s.elapsed().as_secs_f64() * 1e3);
+    }
+    let commit_ms = median_us(t);
+    println!(
+        "   sealed={sealed:>7} clients={clients:>6}: ack={ack_us:>7.1} us  heartbeat={hb_us:>6.1} us  register={reg_us:>6.1} us/op  \
+         sync(mid, {mid_ok} ops)={sync_mid_ms:>7.2} ms  sync(last sealed, {last_ok} ops)={sync_last_ms:>6.2} ms  commit={commit_ms:.2} ms  \
+         roster written during acks/storm: {}",
+        roster_after != roster_before
+    );
+}
+
+#[test]
+#[ignore]
+fn inv_b4_per_request_costs() {
+    println!("== per-request costs (20 KB ops; 1 lagging client keeps the history)");
+    per_request(1_000, 10);
+    per_request(1_000, 1_000);
+    per_request(100_000, 10);
+    per_request(100_000, 1_000);
+    per_request(100_000, 10_000);
+}
+
+#[test]
+#[ignore]
+fn inv_b4_bootstrapping_registration_storm() {
+    // A pruned room (tail > 1) with no connected client: every registration without a cursor
+    // is Bootstrapping, turns the demand on and looks for an uploader among the clients.
+    println!("== bootstrapping registration storm (no connected client, tail > 1)");
+    for n in [1_000usize, 10_000] {
+        let e = env();
+        write_log(&e.room_dir(), 0, 1000, 10, 16, false);
+        std::fs::write(e.room_dir().join("log_meta.json"), br#"{"pruned_through_seq":100}"#)
+            .unwrap();
+        // active.wal starts at 1 in write_log: rewrite it to start after the pruned range.
+        let segs = e.room_dir().join("segments");
+        let mut f = std::fs::File::create(segs.join("active.wal")).unwrap();
+        for s in 101..=110u64 {
+            let op = SequencedOperation::new(SequenceNumber::new(s), op_with(16, 1));
+            f.write_all(&encode_wal_record(&op, Some(mid(s))).unwrap()).unwrap();
+        }
+        drop(f);
+        let (_tx, mut a) = e.open();
+        let mut first = Vec::new();
+        let mut last = Vec::new();
+        let s0 = StdInstant::now();
+        for i in 0..n {
+            let c = ClientId::new(format!("boot-{i:06}")).unwrap();
+            let s = StdInstant::now();
+            a.register(&c, None, None).unwrap();
+            let us = s.elapsed().as_secs_f64() * 1e6;
+            if i < 100 {
+                first.push(us);
+            } else if i >= n - 100 {
+                last.push(us);
+            }
+        }
+        println!(
+            "   n={n:>6}: total {:?}; median register first100={:.1} us, last100={:.1} us",
+            s0.elapsed(),
+            median_us(first),
+            median_us(last)
+        );
+    }
+}
+
+#[test]
+#[ignore]
+fn inv_b4_open_and_sync_cost_vs_segment_count() {
+    // Segments of 10 operations (as with ram_max_ops = 10, or large operations that seal a
+    // segment every few commits): the same history in many files.
+    println!("== open / sync cost vs number of sealed segments (10 ops each)");
+    for segments in [100u64, 1_000, 10_000, 50_000] {
+        let e = env();
+        write_log(&e.room_dir(), segments * 10, 10, 5, 16, false);
+        // Warm the page cache, then time the segment index scan alone and the whole open.
+        let segs = e.room_dir().join("segments");
+        let _ = e.open_ms(1);
+        let mut scan = Vec::new();
+        for _ in 0..5 {
+            let s = StdInstant::now();
+            let idx = crate::log::segment_index::SegmentIndex::scan(&segs, SequenceNumber::new(0)).unwrap();
+            scan.push(s.elapsed().as_secs_f64() * 1e3);
+            assert_eq!(idx.iter().count() as u64, segments);
+        }
+        let open = e.open_ms(5);
+        let (_tx, mut a) = e.open();
+        let c = ClientId::new("c").unwrap();
+        a.register(&c, Some(SequenceNumber::new(0)), Some(7)).unwrap();
+        // Evict RAM so that a sync near the head reads the newest sealed segment from disk.
+        let near_head = segments * 10 - 3;
+        a.tiered_log.prune_older_than(SequenceNumber::new(0)).unwrap();
+        let mut t = Vec::new();
+        for _ in 0..20 {
+            let s = StdInstant::now();
+            let r = a.sync(&c, SequenceNumber::new(near_head), 2).unwrap();
+            t.push(s.elapsed().as_secs_f64() * 1e6);
+            assert_eq!(r.ops.len(), 2);
+        }
+        println!(
+            "   segments={segments:>6}: SegmentIndex::scan median={:.2} ms, open median={open:.2} ms, \
+             sync near head (disk) median={:.1} us",
+            median_us(scan),
+            median_us(t)
+        );
+    }
+}
