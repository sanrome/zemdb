diff --git a/crates/server/src/relay/tests/inv_b2.rs b/crates/server/src/relay/tests/inv_b2.rs
new file mode 100644
index 0000000..2fa9fc9
--- /dev/null
+++ b/crates/server/src/relay/tests/inv_b2.rs
@@ -0,0 +1,45 @@
+//! Auditoría INV-B2: una subida por chunks que no progresa se retiene sin plazo.
+
+use super::*;
+use crate::relay::test_common::*;
+use crate::relay::UPLOAD_IDLE_TIMEOUT;
+
+#[tokio::test(start_paused = true)]
+#[ignore]
+async fn inv_b2_upload_resending_the_same_chunk_is_retained_without_deadline() {
+    let dir = tempdir().unwrap();
+    let relay = open(&dir);
+    let snap = three_part_snapshot(1);
+    // One chunk of three; the upload can never complete without the other two.
+    upload_parts(&relay, 10, [0], &snap, (0, 10)).await;
+
+    // Resend the chunk already received every 119 s for 24 h, while the sweeper runs.
+    let period = UPLOAD_IDLE_TIMEOUT - Duration::from_secs(1);
+    let mut elapsed = Duration::ZERO;
+    let mut resends = 0u32;
+    while elapsed < Duration::from_secs(24 * 3600) {
+        tokio::time::advance(period).await;
+        elapsed += period;
+        relay.cleanup_expired().await;
+        upload_parts(&relay, 10, [0], &snap, (0, 10)).await;
+        resends += 1;
+    }
+    relay.cleanup_expired().await;
+
+    let in_progress = relay.upload_in_progress(&room());
+    let files = files_in(&uploads_dir(&dir));
+    println!(
+        "after {elapsed:?} ({resends} resends of chunk 0, no new chunk): upload_in_progress={in_progress:?}, \
+         uploads dir={files:?} (idle timeout {UPLOAD_IDLE_TIMEOUT:?})"
+    );
+    assert_eq!(in_progress, Some(seq(10)));
+    assert_eq!(files, vec!["relay-room_10.part"]);
+
+    // Meanwhile another member cannot upload a snapshot at the same sequence.
+    let other = three_part_snapshot(2);
+    let refused = relay
+        .stage_chunk(part_by(member("honest"), 10, 0, &other), bounds(0, 10))
+        .await;
+    println!("another member's upload at seq 10: {refused:?}");
+    assert_superseded(refused);
+}
diff --git a/crates/server/tests/inv_b_memory.rs b/crates/server/tests/inv_b_memory.rs
new file mode 100644
index 0000000..df485e9
--- /dev/null
+++ b/crates/server/tests/inv_b_memory.rs
@@ -0,0 +1,375 @@
+//! Auditoría INV-B1/INV-B3: memoria que materializa una respuesta de sync / catch-up.
+//! Mediciones manuales (#[ignore]) con un asignador que cuenta bytes vivos y el pico.
+#![allow(unsafe_code)]
+
+mod common;
+
+use axum::body::Body;
+use axum::http::Request;
+use common::*;
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+use std::time::Instant;
+use tower::ServiceExt;
+use zemdb_core::*;
+use zemdb_server::build_router;
+
+struct Counting;
+static CUR: AtomicUsize = AtomicUsize::new(0);
+static PEAK: AtomicUsize = AtomicUsize::new(0);
+
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+        let p = System.alloc(l);
+        if !p.is_null() {
+            let c = CUR.fetch_add(l.size(), Relaxed) + l.size();
+            PEAK.fetch_max(c, Relaxed);
+        }
+        p
+    }
+    unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
+        let p = System.alloc_zeroed(l);
+        if !p.is_null() {
+            let c = CUR.fetch_add(l.size(), Relaxed) + l.size();
+            PEAK.fetch_max(c, Relaxed);
+        }
+        p
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+        System.dealloc(p, l);
+        CUR.fetch_sub(l.size(), Relaxed);
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: Layout, new: usize) -> *mut u8 {
+        let q = System.realloc(p, l, new);
+        if !q.is_null() {
+            if new >= l.size() {
+                let c = CUR.fetch_add(new - l.size(), Relaxed) + (new - l.size());
+                PEAK.fetch_max(c, Relaxed);
+            } else {
+                CUR.fetch_sub(l.size() - new, Relaxed);
+            }
+        }
+        q
+    }
+}
+
+#[global_allocator]
+static A: Counting = Counting;
+
+fn mib(b: usize) -> f64 {
+    b as f64 / (1024.0 * 1024.0)
+}
+
+/// Resets the peak to the current live bytes and returns them.
+fn start() -> usize {
+    let c = CUR.load(Relaxed);
+    PEAK.store(c, Relaxed);
+    c
+}
+
+fn wide_schema(cols: usize) -> Schema {
+    let mut table = TableSchema::builder("wide").primary_key("id", DataType::Int);
+    for i in 1..cols {
+        table = table.nullable_column(format!("c{i}"), DataType::Int);
+    }
+    Schema::builder().table(table).build()
+}
+
+fn null_row_op(table_id: u16, cols: usize, id: i64) -> Operation {
+    let mut vals = vec![Value::Null; cols];
+    vals[0] = Value::Int(id);
+    Operation::insert(table_id, PrimaryKey::single(Value::Int(id)), CompactRow::new(vals), 0)
+}
+
+fn mid(i: u64) -> MutationId {
+    let mut b = [0u8; 16];
+    b[..8].copy_from_slice(&i.to_le_bytes());
+    b[8] = 0xAB;
+    MutationId::new(b)
+}
+
+async fn run(cols: usize, commits: u64) {
+    let base0 = CUR.load(Relaxed);
+    let schema = wide_schema(cols);
+    let parts = build(|_| {});
+    let schema_id = parts.register_schema("wide", schema.clone());
+    let room_id = parts.create_room("wide-room", &schema_id).await;
+    let sender = parts
+        .room_manager
+        .get_or_spawn(&room_id, None)
+        .await
+        .unwrap();
+    let client = ClientId::new("w").unwrap();
+    register(&sender, &client).await;
+    let table_id = schema.get_table_id("wide").unwrap();
+    let after_open = CUR.load(Relaxed);
+
+    let probe = SequencedOperation::new(SequenceNumber::new(1), null_row_op(table_id, cols, 1));
+    let wire = bincode::Options::serialized_size(bincode::DefaultOptions::new(), &probe).unwrap();
+    println!("== cols={cols} commits={commits}: wire bytes per op = {wire}");
+
+    let t = Instant::now();
+    for i in 1..=commits {
+        commit(&sender, &client, mid(i), i - 1, null_row_op(table_id, cols, i as i64))
+            .await
+            .unwrap();
+    }
+    println!("   commits took {:?}", t.elapsed());
+    let resident = CUR.load(Relaxed);
+    println!(
+        "   live after open: {:.1} MiB; live after commits (HotBuffer etc.): {:.1} MiB (delta {:.1} MiB)",
+        mib(after_open - base0),
+        mib(resident - base0),
+        mib(resident - after_open)
+    );
+
+    // (B) Sync from 0 at the actor.
+    let before = start();
+    let resp = sync(&sender, &client, 0, 1000).await.unwrap();
+    let peak = PEAK.load(Relaxed) - before;
+    let n = resp.ops.len();
+    let enc: u64 = resp
+        .ops
+        .iter()
+        .map(|o| bincode::Options::serialized_size(bincode::DefaultOptions::new(), o).unwrap())
+        .sum();
+    let values: usize = resp
+        .ops
+        .iter()
+        .map(|o| match o.op.kind() {
+            OperationKind::Insert { row } => row.len() + o.op.pk().len(),
+            _ => o.op.pk().len(),
+        })
+        .sum();
+    println!(
+        "   [actor sync from 0] ops={n} has_more={} wire={:.1} MiB values={} ({}x MAX_MESSAGE_VALUES) peak alloc={:.1} MiB (ratio {:.1}x wire)",
+        resp.has_more,
+        mib(enc as usize),
+        values,
+        values as u64 / MAX_MESSAGE_VALUES.max(1),
+        mib(peak),
+        peak as f64 / enc as f64
+    );
+    drop(resp);
+
+    // (C) Commit with a stale cursor: catch-up of up to 100 ops.
+    let before = start();
+    let c = commit(&sender, &client, mid(10_000_000), 0, null_row_op(table_id, cols, 9_999_999))
+        .await
+        .unwrap();
+    let peak = PEAK.load(Relaxed) - before;
+    let enc: u64 = c
+        .catchup_ops
+        .iter()
+        .map(|o| bincode::Options::serialized_size(bincode::DefaultOptions::new(), o).unwrap())
+        .sum();
+    println!(
+        "   [actor commit catch-up from 0] ops={} wire={:.1} MiB peak alloc={:.1} MiB",
+        c.catchup_ops.len(),
+        mib(enc as usize),
+        mib(peak)
+    );
+    drop(c);
+
+    // (D) Same sync through the HTTP router (decode, actor, encode, budget).
+    let app = build_router(parts.state());
+    let tok = token(&client, &room_id);
+    let body = encode_message(&ClientMessage::Sync {
+        correlation_id: CorrelationId::new(7),
+        room_id: room_id.clone(),
+        client_id: client.clone(),
+        from_seq: SequenceNumber::new(0),
+        max_batch_size: 1000,
+    })
+    .unwrap();
+    let before = start();
+    let req = Request::post(format!("/rooms/{room_id}/sync"))
+        .header("authorization", format!("Bearer {tok}"))
+        .header("content-type", "application/octet-stream")
+        .body(Body::from(body.clone()))
+        .unwrap();
+    let resp = app.clone().oneshot(req).await.unwrap();
+    let status = resp.status();
+    let bytes = axum::body::to_bytes(resp.into_body(), usize::MAX).await.unwrap();
+    let peak = PEAK.load(Relaxed) - before;
+    println!(
+        "   [HTTP /sync] status={status} response={:.1} MiB peak alloc={:.1} MiB",
+        mib(bytes.len()),
+        mib(peak)
+    );
+    drop(bytes);
+
+    // (E) Two concurrent HTTP syncs of the same room.
+    let before = start();
+    let mut handles = Vec::new();
+    for _ in 0..2 {
+        let app = app.clone();
+        let req = Request::post(format!("/rooms/{room_id}/sync"))
+            .header("authorization", format!("Bearer {tok}"))
+            .header("content-type", "application/octet-stream")
+            .body(Body::from(body.clone()))
+            .unwrap();
+        handles.push(tokio::spawn(async move {
+            let resp = app.oneshot(req).await.unwrap();
+            let s = resp.status();
+            // Hold the response without reading it, as a client that has not read it yet.
+            (s, resp)
+        }));
+    }
+    let mut held = Vec::new();
+    for h in handles {
+        held.push(h.await.unwrap());
+    }
+    let peak = PEAK.load(Relaxed) - before;
+    let live = CUR.load(Relaxed) - before;
+    println!(
+        "   [2 concurrent HTTP /sync] statuses={:?} peak alloc={:.1} MiB, live while held={:.1} MiB (budget 256 MiB)",
+        held.iter().map(|(s, _)| s.as_u16()).collect::<Vec<_>>(),
+        mib(peak),
+        mib(live)
+    );
+    drop(held);
+    parts.room_manager.shutdown_all().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[ignore]
+async fn inv_b1_sync_materializes_far_beyond_its_frame_65535_cols() {
+    run(65535, 300).await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[ignore]
+async fn inv_b1_sync_materializes_far_beyond_its_frame_4096_cols() {
+    run(4096, 1000).await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[ignore]
+async fn inv_b1_sync_baseline_tasks_schema() {
+    // Baseline: the 3-column `tasks` schema of the other tests.
+    let base0 = CUR.load(Relaxed);
+    let room = TestRoom::spawn(None).await;
+    let client = ClientId::new("w").unwrap();
+    register(&room.sender, &client).await;
+    for i in 1..=1000u64 {
+        commit(&room.sender, &client, mid(i), i - 1, make_test_op(i as i64))
+            .await
+            .unwrap();
+    }
+    let before = start();
+    let resp = sync(&room.sender, &client, 0, 1000).await.unwrap();
+    let peak = PEAK.load(Relaxed) - before;
+    let enc: u64 = resp
+        .ops
+        .iter()
+        .map(|o| bincode::Options::serialized_size(bincode::DefaultOptions::new(), o).unwrap())
+        .sum();
+    println!(
+        "== tasks schema: ops={} wire={:.2} MiB peak={:.2} MiB ratio {:.1}x; live total {:.1} MiB",
+        resp.ops.len(),
+        mib(enc as usize),
+        mib(peak),
+        peak as f64 / enc as f64,
+        mib(CUR.load(Relaxed) - base0)
+    );
+}
+
+/// Responses that carry the schema (`Schema`, `Registered`) do not take the budget of response
+/// bytes in flight: held unread, they add up past `max_inflight_response_bytes`.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[ignore]
+async fn inv_b1_schema_responses_are_outside_the_budget() {
+    let schema = wide_schema(65535);
+    let parts = build(|c| c.max_inflight_response_bytes = MAX_FRAME_SIZE as u64);
+    let schema_id = parts.register_schema("wide", schema);
+    let room_id = parts.create_room("wide-room", &schema_id).await;
+    let client = ClientId::new("w").unwrap();
+    let tok = token(&client, &room_id);
+    let app = build_router(parts.state());
+    // Warm up: open the room.
+    let msg = encode_message(&ClientMessage::GetSchema {
+        correlation_id: CorrelationId::new(1),
+        room_id: room_id.clone(),
+    })
+    .unwrap();
+    let mk = || {
+        Request::post(format!("/rooms/{room_id}/schema"))
+            .header("authorization", format!("Bearer {tok}"))
+            .header("content-type", "application/octet-stream")
+            .body(Body::from(msg.clone()))
+            .unwrap()
+    };
+    let first = app.clone().oneshot(mk()).await.unwrap();
+    let size = axum::body::to_bytes(first.into_body(), usize::MAX).await.unwrap().len();
+    let before = start();
+    let mut held = Vec::new();
+    for _ in 0..64 {
+        held.push(app.clone().oneshot(mk()).await.unwrap());
+    }
+    let live = CUR.load(Relaxed) - before;
+    println!(
+        "== 64 unread /schema responses of {:.2} MiB each: live {:.1} MiB with max_inflight_response_bytes={:.1} MiB; statuses all 200: {}",
+        mib(size),
+        mib(live),
+        mib(MAX_FRAME_SIZE),
+        held.iter().all(|r| r.status() == 200)
+    );
+    drop(held);
+}
+
+/// Unauthenticated: a request to an unknown Data Plane path is answered with a frame that
+/// echoes the whole path, outside the budget. Held unread by many connections.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[ignore]
+async fn inv_b1_unknown_path_echo_is_outside_the_budget() {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let parts = build(|c| c.max_inflight_response_bytes = MAX_FRAME_SIZE as u64);
+    let (addr, stop, server) = parts.serve_until_stopped().await;
+    async fn send(addr: std::net::SocketAddr, path_len: usize) -> tokio::net::TcpStream {
+        let mut s = tokio::net::TcpStream::connect(addr).await.unwrap();
+        let req = format!(
+            "GET /rooms/a/{} HTTP/1.1\r\nhost: x\r\n\r\n",
+            "b".repeat(path_len)
+        );
+        s.write_all(req.as_bytes()).await.unwrap();
+        s
+    }
+    // One full response, to see its size.
+    let mut s = send(addr, 65_000).await;
+    let mut head = Vec::new();
+    let mut buf = vec![0u8; 1 << 20];
+    let deadline = Instant::now();
+    while deadline.elapsed() < std::time::Duration::from_secs(5) {
+        match tokio::time::timeout(std::time::Duration::from_millis(500), s.read(&mut buf)).await {
+            Ok(Ok(0)) | Err(_) => break,
+            Ok(Ok(n)) => head.extend_from_slice(&buf[..n]),
+            Ok(Err(_)) => break,
+        }
+    }
+    let text = String::from_utf8_lossy(&head[..head.len().min(200)]).to_string();
+    println!(
+        "== unknown path of 65 000 bytes: {} response bytes; starts with {:?}",
+        head.len(),
+        text.lines().next()
+    );
+    drop(s);
+    for (label, len) in [("short path", 10usize), ("65 000-byte path", 65_000)] {
+        let before = start();
+        let mut conns = Vec::new();
+        for _ in 0..200 {
+            conns.push(send(addr, len).await);
+        }
+        tokio::time::sleep(std::time::Duration::from_millis(1500)).await;
+        let live = CUR.load(Relaxed) as isize - before as isize;
+        println!(
+            "   200 unread connections, {label}: server live delta {:.1} MiB (budget {:.1} MiB)",
+            live as f64 / (1024.0 * 1024.0),
+            mib(MAX_FRAME_SIZE)
+        );
+        drop(conns);
+        tokio::time::sleep(std::time::Duration::from_millis(500)).await;
+    }
+    stop.send(()).unwrap();
+    let _ = server.await;
+}
