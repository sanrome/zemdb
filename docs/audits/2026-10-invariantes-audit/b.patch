@@ -0,0 +1,162 @@
+//! Auditoría INV-B3: el disco de la sala frente a `max_room_disk_bytes`.
+
+use super::*;
+use std::time::Duration;
+use tempfile::tempdir;
+use zemdb_core::mutation::Operation;
+use zemdb_core::value::{CompactRow, PrimaryKey, Value};
+
+/// An insert of ~`size` bytes of incompressible data at `seq`.
+fn big_op(seq: u64, size: usize) -> SequencedOperation {
+    let mut x = seq.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1;
+    let data: Vec<u8> = (0..size)
+        .map(|_| {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            x as u8
+        })
+        .collect();
+    let pk = PrimaryKey::single(Value::Int(seq as i64));
+    let row = CompactRow::new(vec![Value::Int(seq as i64), Value::Bytes(data.into_boxed_slice())]);
+    SequencedOperation::new(SequenceNumber::new(seq), Operation::insert(1, pk, row, 0))
+}
+
+fn mid(seq: u64) -> MutationId {
+    MutationId::from_u128(u128::from(seq) | (7u128 << 100))
+}
+
+const MIB: u64 = 1024 * 1024;
+
+fn policy(warm_ttl: Duration) -> RoomLifecyclePolicy {
+    RoomLifecyclePolicy {
+        ram_max_ops: 1_000,
+        segment_max_bytes: MIB,     // minimum accepted
+        max_room_disk_bytes: MIB,   // minimum accepted
+        warm_disk_ttl: warm_ttl,
+        ..RoomLifecyclePolicy::default()
+    }
+}
+
+/// Default warm TTL (24 h): a burst of 8 MiB is never pruned by the 1 MiB quota until the
+/// segments are compressed a day later.
+#[test]
+#[ignore]
+fn inv_b3_quota_does_not_bound_warm_segments_default_warm_ttl() {
+    let dir = tempdir().unwrap();
+    let policy = policy(RoomLifecyclePolicy::default().warm_disk_ttl);
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    for seq in 1..=80u64 {
+        log.append(big_op(seq, 100 * 1024), Some(mid(seq))).unwrap();
+    }
+    let report = log.run_maintenance_sync().unwrap();
+    let segments = dir.path().join("segments");
+    let on_disk: u64 = std::fs::read_dir(&segments)
+        .unwrap()
+        .map(|e| e.unwrap().metadata().unwrap().len())
+        .sum();
+    println!(
+        "warm_ttl=24h quota={} MiB: after maintenance disk_bytes={:.1} MiB (files {:.1} MiB), \
+         compressed={}, pruned={}, tail={}",
+        MIB / MIB,
+        log.disk_bytes() as f64 / MIB as f64,
+        on_disk as f64 / MIB as f64,
+        report.warm_compressed_count,
+        report.cold_pruned_count,
+        log.tail_seq()
+    );
+    assert!(log.disk_bytes() > 4 * log.policy.max_room_disk_bytes);
+}
+
+/// Warm TTL 0 (compress at once): with a sustained write rate above 4 sealed segments per
+/// maintenance pass, the warm backlog (which the quota cannot prune) grows every pass.
+#[test]
+#[ignore]
+fn inv_b3_quota_does_not_bound_a_sustained_writer_warm_ttl_zero() {
+    let dir = tempdir().unwrap();
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy(Duration::ZERO)).unwrap();
+    let mut seq = 0u64;
+    for round in 1..=6 {
+        // ~6 sealed segments of ~1 MiB between two slow ticks (6 MiB per 30 s ≈ 0.2 MiB/s).
+        for _ in 0..60 {
+            seq += 1;
+            log.append(big_op(seq, 100 * 1024), Some(mid(seq))).unwrap();
+        }
+        let report = log.run_maintenance_sync().unwrap();
+        let warm = log
+            .segments
+            .iter()
+            .filter(|s| s.tier == crate::log::segment_index::Tier::Warm)
+            .count();
+        println!(
+            "round {round}: disk_bytes={:.1} MiB (quota 1 MiB), warm segments={warm}, \
+             compressed={}, pruned={}, tail={}",
+            log.disk_bytes() as f64 / MIB as f64,
+            report.warm_compressed_count,
+            report.cold_pruned_count,
+            log.tail_seq()
+        );
+    }
+    assert!(log.disk_bytes() > 8 * log.policy.max_room_disk_bytes);
+}
+
+/// Small operations with realistic (hash-like) mutation IDs, already compressed: the quota
+/// counts the cold segments but not their mutation ID sidecars (24 bytes per operation).
+#[test]
+#[ignore]
+fn inv_b3_sidecars_are_outside_the_quota() {
+    use crate::log::segment_index::{encode_mutation_ids, mutation_ids_path, segment_path, Tier};
+    use zemdb_core::protocol::wal_frame::encode_wal_record;
+    let dir = tempdir().unwrap();
+    let segs = dir.path().join("segments");
+    std::fs::create_dir_all(&segs).unwrap();
+    let hash_mid = |s: u64| {
+        let h = blake3::hash(&s.to_le_bytes());
+        MutationId::new(std::array::from_fn(|i| h.as_bytes()[i]))
+    };
+    let total_ops = 400_000u64;
+    let mut start = 1u64;
+    while start <= total_ops {
+        let end = start + 999;
+        let mut frames = Vec::new();
+        let mut ids = Vec::new();
+        for s in start..=end {
+            let pk = PrimaryKey::single(Value::Int(s as i64 % 1000));
+            let op = SequencedOperation::new(SequenceNumber::new(s), Operation::delete(1, pk, 0));
+            frames.extend(encode_wal_record(&op, Some(hash_mid(s))).unwrap());
+            ids.push((hash_mid(s), SequenceNumber::new(s)));
+        }
+        let (a, b) = (SequenceNumber::new(start), SequenceNumber::new(end));
+        let z = zstd::stream::encode_all(&frames[..], 3).unwrap();
+        std::fs::write(segment_path(&segs, a, b, Tier::Cold), z).unwrap();
+        std::fs::write(mutation_ids_path(&segs, a, b), encode_mutation_ids(a, b, &ids)).unwrap();
+        start = end + 1;
+    }
+    let policy = RoomLifecyclePolicy {
+        max_room_disk_bytes: 4 * MIB,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create_with_dedup_window(dir.path(), policy, 10_000).unwrap();
+    let report = log.run_maintenance_sync().unwrap();
+    let (mut ids_bytes, mut seg_bytes) = (0u64, 0u64);
+    for e in std::fs::read_dir(&segs).unwrap() {
+        let e = e.unwrap();
+        let len = e.metadata().unwrap().len();
+        if e.file_name().to_str().unwrap().ends_with(".ids") {
+            ids_bytes += len;
+        } else {
+            seg_bytes += len;
+        }
+    }
+    println!(
+        "quota=4 MiB: pruned={} tail={} disk_bytes(counted)={:.2} MiB, segments on disk={:.2} MiB, \
+         sidecars on disk={:.2} MiB, total={:.2} MiB ({:.2}x quota)",
+        report.cold_pruned_count,
+        log.tail_seq(),
+        log.disk_bytes() as f64 / MIB as f64,
+        seg_bytes as f64 / MIB as f64,
+        ids_bytes as f64 / MIB as f64,
+        (seg_bytes + ids_bytes) as f64 / MIB as f64,
+        (seg_bytes + ids_bytes) as f64 / (4 * MIB) as f64
+    );
+}
