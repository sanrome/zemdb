+/// AUDIT (INV-R2): a cursor-driven prune whose deletion fails in the middle of its prefix keeps
+/// the range contiguous, and reopening finishes it without moving the tail back.
+#[test]
+fn audit_r2_prune_failing_mid_prefix_stays_contiguous_and_reopen_finishes_it() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 3,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+    append_range(&mut log, 1, 13);
+    let segments = segments_dir(dir.path());
+    crate::fail_point::arm("remove_file", &segment_file(&segments, 4, 6, "wal"));
+
+    assert!(log.prune_older_than(SequenceNumber::new(10)).is_err());
+    let tail = log.tail_seq().get();
+    assert_eq!(tail, 4, "only the first segment went");
+    let (ops, _) = log.fetch_deltas(SequenceNumber::new(tail - 1), 100).unwrap();
+    assert_contiguous(&ops, tail, 13);
+    drop(log);
+
+    let (log, _) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    let reopened = log.tail_seq().get();
+    assert!(reopened >= tail, "tail moved back from {tail} to {reopened}");
+    assert_eq!(reopened, 10);
+    let (ops, _) = log.fetch_deltas(SequenceNumber::new(reopened - 1), 100).unwrap();
+    assert_contiguous(&ops, reopened, 13);
+}
