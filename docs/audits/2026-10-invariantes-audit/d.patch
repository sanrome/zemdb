+// ---------------------------------------------------------------------------------------------
+// Audit §3.1 (INV-D1, INV-D2): tests that break the invariants. Not part of the project.
+// ---------------------------------------------------------------------------------------------
+
+/// INV-D2: the newest sealed segment is lost (an accidental missing file, §2) right after a
+/// rotation, when `active.wal` does not exist yet. Its sidecar is still there, naming the
+/// range. `head_seq` falls back to the previous segment and the next append reuses sequences
+/// that were already assigned (and could have been delivered).
+#[test]
+fn audit_d2_lost_newest_segment_reuses_sequence_numbers() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    {
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        append_range(&mut log, 1, 10);
+        assert_eq!(log.head_seq().get(), 10);
+        // Sealed at 10: no active.wal until the next append.
+        assert!(!segments_dir(dir.path()).join("active.wal").exists());
+    }
+    std::fs::remove_file(segment_file(&segments_dir(dir.path()), 6, 10, "wal")).unwrap();
+    assert!(segment_file(&segments_dir(dir.path()), 6, 10, "ids").exists());
+
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    println!("head_seq after reopen = {}", log.head_seq().get());
+    // Sequence 6 was already assigned to another operation; the log accepts it again.
+    let reused = log.append(make_op(6), None);
+    println!("append of seq 6 again = {:?}", reused.as_ref().map(|_| ()));
+    assert_eq!(
+        log.head_seq().get(),
+        10,
+        "INV-D2: head_seq went back below sequences already assigned"
+    );
+}
+
+/// INV-D1 (disparador raro): `active.wal` is created by an actor whose directory sync then
+/// fails. The next actor finds the file, keeps it and acknowledges records in it without ever
+/// syncing the segments directory: the file's directory entry is not durable when the first
+/// record in it is acknowledged.
+#[test]
+fn audit_d1_active_wal_entry_left_unsynced_by_a_failed_append_is_never_synced() {
+    let dir = tempdir().unwrap();
+    let segments = segments_dir(dir.path());
+    {
+        let (mut log, _) =
+            TieredLog::open_or_create(dir.path(), RoomLifecyclePolicy::default()).unwrap();
+        crate::fail_point::arm("sync_dir", &segments);
+        // Creates active.wal, then the directory sync fails: nothing acknowledged.
+        assert!(log.append(make_op(1), None).is_err());
+    }
+    assert!(segments.join("active.wal").exists());
+
+    let (mut log, _) =
+        TieredLog::open_or_create(dir.path(), RoomLifecyclePolicy::default()).unwrap();
+    // Any directory sync of `segments` from here to the acknowledgement would hit this.
+    crate::fail_point::arm("sync_dir", &segments);
+    let acked = log.append(make_op(1), None);
+    println!("append (acknowledged) = {:?}", acked.as_ref().map(|_| ()));
+    let still_armed = crate::durable::sync_dir(&segments).is_err();
+    println!("segments dir never synced before the ack = {still_armed}");
+    assert!(
+        acked.is_err() || !still_armed,
+        "INV-D1: a record was acknowledged in an active.wal whose directory entry was never synced"
+    );
+}
+
+/// INV-D1 (disparador raro), same pattern for the segments directory itself: created by an
+/// open whose parent sync failed, it is never synced into the room directory again.
+#[test]
+fn audit_d1_segments_dir_left_unsynced_by_a_failed_open_is_never_synced() {
+    let dir = tempdir().unwrap();
+    crate::fail_point::arm("sync_dir", dir.path());
+    assert!(TieredLog::open_or_create(dir.path(), RoomLifecyclePolicy::default()).is_err());
+
+    let (mut log, _) =
+        TieredLog::open_or_create(dir.path(), RoomLifecyclePolicy::default()).unwrap();
+    crate::fail_point::arm("sync_dir", dir.path());
+    let acked = log.append(make_op(1), None);
+    let still_armed = crate::durable::sync_dir(dir.path()).is_err();
+    println!("append (acknowledged) = {:?}, room dir never synced = {still_armed}", acked.as_ref().map(|_| ()));
+    assert!(
+        acked.is_err() || !still_armed,
+        "INV-D1: a record was acknowledged inside a segments directory whose entry was never synced"
+    );
+}
+
+/// INV-D2 / INV-D3 interplay: damage to the payload of the last (acknowledged) frame of
+/// `active.wal` is indistinguishable from a torn write; it is truncated and its sequence is
+/// assigned again.
+#[test]
+fn audit_d2_damaged_last_frame_of_active_wal_reuses_its_sequence() {
+    let dir = tempdir().unwrap();
+    let active = write_log(dir.path(), 3);
+    let len = file_len(&active);
+    let mut bytes = std::fs::read(&active).unwrap();
+    bytes[(len - 2) as usize] ^= 0xFF;
+    std::fs::write(&active, bytes).unwrap();
+
+    let (log, _) = TieredLog::open_or_create(dir.path(), RoomLifecyclePolicy::default()).unwrap();
+    println!("head_seq after reopen = {}", log.head_seq().get());
+    assert_eq!(log.head_seq().get(), 3, "INV-D2: sequence 3 will be assigned again");
+}
+
+/// INV-D3 (supporting evidence for "se sostiene"): every single-byte flip of every frame of
+/// `active.wal`. Damage in a frame followed by a valid frame fails the open and leaves the file
+/// as it was; damage in the last frame truncates exactly at that frame. Never a decoded
+/// operation from a damaged frame.
+#[test]
+fn audit_d3_every_byte_flip_of_active_wal_is_corruption_or_a_torn_tail() {
+    let (clean, offsets) = crate::log::test_support::frames(1..=3);
+    let mut checked = 0;
+    for position in 0..clean.len() {
+        for mask in [0x01u8, 0x80, 0xFF] {
+            let dir = tempdir().unwrap();
+            let segments = segments_dir(dir.path());
+            std::fs::create_dir_all(&segments).unwrap();
+            let mut bytes = clean.clone();
+            bytes[position] ^= mask;
+            std::fs::write(segments.join("active.wal"), &bytes).unwrap();
+            let frame = offsets.iter().rposition(|&o| o <= position).unwrap();
+            let opened = TieredLog::open_or_create(dir.path(), RoomLifecyclePolicy::default());
+            let on_disk = std::fs::read(segments.join("active.wal")).unwrap();
+            if frame < 2 {
+                assert!(opened.is_err(), "flip at {position}: corruption must fail the open");
+                assert_eq!(on_disk, bytes, "flip at {position}: nothing may be truncated");
+            } else {
+                let (log, _) = opened.unwrap_or_else(|e| panic!("flip at {position}: {e}"));
+                assert_eq!(log.head_seq().get(), 2, "flip at {position}");
+                assert_eq!(on_disk.len(), offsets[2], "flip at {position}: truncated from the damage");
+            }
+            checked += 1;
+        }
+    }
+    println!("checked {checked} flips over {} bytes", clean.len());
+}
