+/// Audit §3.1 (INV-D4, backlog): a roster damaged into invalid UTF-8 (one high bit flipped in
+/// an ASCII byte) is not discarded like any other unreadable roster: opening fails, so the
+/// room cannot be opened until the file is fixed by hand.
+#[test]
+fn audit_d4_roster_with_invalid_utf8_fails_instead_of_being_discarded() {
+    let dir = tempdir().unwrap();
+    let path = dir.path().join("meta_clients_room.json");
+    let mut tracker = ClientLeaseTracker::open_or_create(&path).unwrap();
+    tracker.register_client(&ClientId::new("a").unwrap(), None, seq(1));
+    tracker.save().unwrap();
+    let mut bytes = fs::read(&path).unwrap();
+    bytes[0] ^= 0x80; // '{' (0x7B) becomes 0xFB, not UTF-8
+    fs::write(&path, bytes).unwrap();
+
+    let opened = ClientLeaseTracker::open_or_create(&path);
+    println!("open of a non-UTF-8 roster: {:?}", opened.as_ref().map(|_| ()));
+    assert!(opened.is_ok(), "an unreadable roster must be discarded, not fail the open");
+}
