+// ---------------------------------------------------------------------------------------------
+// Audit §3.1 (INV-D1, INV-D2): a test that breaks the invariants. Not part of the project.
+// ---------------------------------------------------------------------------------------------
+
+/// INV-D1: the record of a commit is written but its `sync_data` never runs (a failed fsync,
+/// or a process crash inside it). The respawned actor reads the record back from the page
+/// cache and acknowledges the retry through deduplication without syncing anything. A power
+/// loss then drops the bytes that were never synced (§2 allows it), and the acknowledged
+/// sequence is gone and handed to another operation (INV-D2).
+#[tokio::test]
+async fn audit_d1_retry_after_failed_fsync_is_acknowledged_without_being_durable() {
+    let fx = Fixture::new(RoomLifecycleOverrides::default()).await;
+    let active = fx.room_dir().join("segments").join("active.wal");
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+    commit(&sender, &client, mutation(1), seq(0), insert_op(1))
+        .await
+        .unwrap();
+    // Everything up to here went through a successful sync_data.
+    let synced_len = fs::metadata(&active).unwrap().len();
+
+    // The record of mutation 2 reaches the file; its sync_data is never called.
+    fail_point::arm("warm_append_sync", &active);
+    let failed = commit(&sender, &client, mutation(2), seq(1), insert_op(2)).await;
+    assert!(matches!(failed, Err(ServerError::Unavailable(_))));
+
+    // The client retries: the respawned room acknowledges it.
+    let recovered = fx.sender().await;
+    let acked = commit(&recovered, &client, mutation(2), seq(1), insert_op(2))
+        .await
+        .unwrap();
+    println!("retry acknowledged with seq {}", acked.assigned_seq.get());
+    assert_eq!(acked.assigned_seq, seq(2));
+    fx.manager.shutdown_all().await;
+
+    // Power loss: what was never synced is lost (warm_disk.rs:102 never ran for that record,
+    // and neither the reopen nor the deduplicated retry synced active.wal).
+    let file = fs::OpenOptions::new().write(true).open(&active).unwrap();
+    file.set_len(synced_len).unwrap();
+    drop(file);
+
+    let reopened = fx.sender().await;
+    let other = ClientId::new("other").unwrap();
+    register(&reopened, &other).await;
+    let next = commit(&reopened, &other, mutation(9), seq(0), insert_op(9))
+        .await
+        .unwrap();
+    println!(
+        "after the power loss, a different mutation gets seq {}",
+        next.assigned_seq.get()
+    );
+    assert_ne!(
+        next.assigned_seq,
+        seq(2),
+        "INV-D1/INV-D2: acknowledged seq 2 was lost and reassigned to another operation"
+    );
+    fx.manager.shutdown_all().await;
+}
