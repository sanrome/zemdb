+// ---------------------------------------------------------------------------------------------
+// Audit §3.1 (INV-D5): a test that breaks the invariant. Not part of the project.
+// ---------------------------------------------------------------------------------------------
+
+/// INV-D5: two server processes on the same `data_dir` (simulated with two managers: the
+/// `fs2` locks are per open file description, so they conflict inside one process exactly as
+/// across processes). The second cannot open the room's log (`log.lock`), but nothing stops
+/// it from deleting the room directory while the first one owns and writes it. The first
+/// keeps acknowledging commits into unlinked files.
+#[tokio::test]
+async fn audit_d5_second_process_deletes_a_room_owned_by_the_first() {
+    let dir = tempdir().unwrap();
+    let room_id = RoomId::new("owned").unwrap();
+    let owner = new_manager(&dir);
+    owner
+        .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+        .await
+        .unwrap();
+    let client = zemdb_core::id::ClientId::new("writer").unwrap();
+    owner
+        .ask(&room_id, |reply| RoomCommand::RegisterClient {
+            client_id: client.clone(),
+            current_seq: None,
+            known_incarnation: None,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+
+    let commit_n = |n: u8, last_ack: u64| {
+        let row = zemdb_core::value::RowBuilder::new()
+            .set("id", i64::from(n))
+            .set("title", "x")
+            .build();
+        let op = test_schema().to_operation_insert("tasks", &row, 1).unwrap();
+        let client = client.clone();
+        let owner = &owner;
+        let room_id = room_id.clone();
+        async move {
+            owner
+                .ask(&room_id, |reply| RoomCommand::Commit {
+                    client_id: client,
+                    mutation_id: zemdb_core::id::MutationId::new([n; 16]),
+                    last_ack_seq: SequenceNumber::new(last_ack),
+                    op,
+                    reply,
+                })
+                .await
+                .unwrap()
+                .map(|ack| ack.assigned_seq.get())
+        }
+    };
+    println!("owner commit before the delete: {:?}", commit_n(1, 0).await);
+
+    // A second process on the same data_dir: its log open is refused...
+    let intruder = new_manager(&dir);
+    let refused = intruder.get_or_spawn(&room_id, None).await;
+    println!("second process opening the room: {:?}", refused.as_ref().map(|_| ()));
+    assert!(matches!(refused, Err(ServerError::RoomLocked(_))));
+    // ...but deleting the room is not.
+    let deleted = intruder.delete_room(&room_id).await;
+    println!("second process deleting the room: {deleted:?}");
+    println!(
+        "room directory exists after the delete: {}",
+        room_dir(&dir, &room_id).exists()
+    );
+    // The owner keeps acknowledging commits, into files that no longer exist.
+    println!("owner commit after the delete: {:?}", commit_n(2, 1).await);
+    // The second process recreates the room: its log lock is on a new file, so it succeeds
+    // while the first process still runs its actor for the same room id and path.
+    let recreated = intruder
+        .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+        .await;
+    println!("second process recreating the room: {:?}", recreated.as_ref().map(|_| ()));
+    println!(
+        "both processes have a live actor for the room: {} / {}",
+        owner.get_room(&room_id).is_some(),
+        intruder.get_room(&room_id).is_some()
+    );
+    println!("owner commit while both own the room: {:?}", commit_n(3, 2).await);
+    intruder.shutdown_all().await;
+    owner.shutdown_all().await;
+    let restarted = new_manager(&dir);
+    println!(
+        "after restarting, the room: {:?}",
+        restarted.get_or_spawn(&room_id, None).await.map(|_| ())
+    );
+    assert!(
+        deleted.is_err() && room_dir(&dir, &room_id).exists(),
+        "INV-D5: a second process deleted the files of a room owned by the first"
+    );
+}
