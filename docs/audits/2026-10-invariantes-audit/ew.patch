+#![allow(dead_code)]
+//! Shared fuzzing support: a byte-counting global allocator, a PRNG, libFuzzer-like mutators
+//! and valid sample inputs for every format.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+
+use zemdb_core::mutation::{ColumnUpdate, Operation, OperationKind};
+use zemdb_core::schema::{ColumnDef, Schema, TableBuilder};
+use zemdb_core::value::{CompactRow, DataType, PrimaryKey, Value};
+use zemdb_core::{
+    ClientId, ClientMessage, CorrelationId, ErrorCode, MutationId, RoomId, SchemaId,
+    SequenceNumber, SequencedOperation, ServerMessage,
+};
+
+// ---------------------------------------------------------------------------------------------
+// Counting allocator
+// ---------------------------------------------------------------------------------------------
+
+pub struct Counting;
+
+pub static CURRENT: AtomicUsize = AtomicUsize::new(0);
+pub static PEAK: AtomicUsize = AtomicUsize::new(0);
+pub static MAX_SINGLE: AtomicUsize = AtomicUsize::new(0);
+
+fn grow(n: usize, single: usize) {
+    let now = CURRENT.fetch_add(n, Relaxed) + n;
+    PEAK.fetch_max(now, Relaxed);
+    MAX_SINGLE.fetch_max(single, Relaxed);
+}
+
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let p = unsafe { System.alloc(layout) };
+        if !p.is_null() {
+            grow(layout.size(), layout.size());
+        }
+        p
+    }
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        let p = unsafe { System.alloc_zeroed(layout) };
+        if !p.is_null() {
+            grow(layout.size(), layout.size());
+        }
+        p
+    }
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(ptr, layout) };
+        CURRENT.fetch_sub(layout.size(), Relaxed);
+    }
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        let q = unsafe { System.realloc(ptr, layout, new_size) };
+        if !q.is_null() {
+            if new_size >= layout.size() {
+                grow(new_size - layout.size(), new_size);
+            } else {
+                CURRENT.fetch_sub(layout.size() - new_size, Relaxed);
+            }
+        }
+        q
+    }
+}
+
+#[global_allocator]
+static GLOBAL: Counting = Counting;
+
+/// Peak bytes allocated above the starting level while `f` ran, and the largest single
+/// allocation request.
+pub fn measure<R>(f: impl FnOnce() -> R) -> (R, usize, usize) {
+    let base = CURRENT.load(Relaxed);
+    PEAK.store(base, Relaxed);
+    MAX_SINGLE.store(0, Relaxed);
+    let r = f();
+    let peak = PEAK.load(Relaxed).saturating_sub(base);
+    (r, peak, MAX_SINGLE.load(Relaxed))
+}
+
+/// Statistics of a fuzzing campaign.
+#[derive(Debug, Default)]
+pub struct Stats {
+    pub iterations: u64,
+    pub ok: u64,
+    pub errors: u64,
+    pub max_peak: usize,
+    pub max_peak_input_len: usize,
+    pub max_single: usize,
+    pub worst_ratio: f64,
+    pub worst_ratio_peak: usize,
+    pub worst_ratio_len: usize,
+    pub worst_ratio_input: Vec<u8>,
+}
+
+impl Stats {
+    pub fn record(&mut self, input: &[u8], ok: bool, peak: usize, single: usize) {
+        self.iterations += 1;
+        if ok {
+            self.ok += 1
+        } else {
+            self.errors += 1
+        }
+        if peak > self.max_peak {
+            self.max_peak = peak;
+            self.max_peak_input_len = input.len();
+        }
+        self.max_single = self.max_single.max(single);
+        let ratio = peak as f64 / (input.len().max(1)) as f64;
+        if ratio > self.worst_ratio {
+            self.worst_ratio = ratio;
+            self.worst_ratio_peak = peak;
+            self.worst_ratio_len = input.len();
+            self.worst_ratio_input = input.to_vec();
+        }
+    }
+
+    pub fn report(&self, name: &str) {
+        eprintln!(
+            "[{name}] iters={} ok={} err={} max_peak={}B (input {}B) max_single_alloc={}B worst_ratio={:.1}x (peak {}B / input {}B) worst_input_prefix={}",
+            self.iterations,
+            self.ok,
+            self.errors,
+            self.max_peak,
+            self.max_peak_input_len,
+            self.max_single,
+            self.worst_ratio,
+            self.worst_ratio_peak,
+            self.worst_ratio_len,
+            hex(&self.worst_ratio_input[..self.worst_ratio_input.len().min(64)]),
+        );
+    }
+}
+
+pub fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+
+/// Runs `f` catching panics; on a panic, fails the test printing the input.
+pub fn no_panic<R>(name: &str, input: &[u8], f: impl FnOnce() -> R) -> R {
+    match catch_unwind(AssertUnwindSafe(f)) {
+        Ok(r) => r,
+        Err(e) => {
+            let msg = e
+                .downcast_ref::<String>()
+                .cloned()
+                .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+                .unwrap_or_default();
+            panic!("[{name}] PANIC on input {} : {msg}", hex(input));
+        }
+    }
+}
+
+pub fn iterations(default: u64) -> u64 {
+    std::env::var("FUZZ_ITERS")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(default)
+}
+
+// ---------------------------------------------------------------------------------------------
+// PRNG and mutators
+// ---------------------------------------------------------------------------------------------
+
+pub struct Rng(u64);
+
+impl Rng {
+    pub fn new(seed: u64) -> Self {
+        Rng(seed ^ 0x9E37_79B9_7F4A_7C15)
+    }
+    pub fn next(&mut self) -> u64 {
+        // splitmix64
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+    pub fn below(&mut self, n: usize) -> usize {
+        if n == 0 {
+            0
+        } else {
+            (self.next() % n as u64) as usize
+        }
+    }
+    pub fn chance(&mut self, num: u64, den: u64) -> bool {
+        self.next() % den < num
+    }
+    pub fn bytes(&mut self, n: usize) -> Vec<u8> {
+        (0..n).map(|_| self.next() as u8).collect()
+    }
+}
+
+const INTERESTING_U8: [u8; 12] = [0, 1, 0x7F, 0x80, 0xFA, 0xFB, 0xFC, 0xFD, 0xFE, 0xFF, 0x10, 0x40];
+const INTERESTING_U64: [u64; 14] = [
+    0,
+    1,
+    0xFF,
+    0xFFFF,
+    0x1_0000,
+    65_535,
+    65_536,
+    1 << 20,
+    (1 << 20) + 1,
+    16 * 1024 * 1024,
+    0x7FFF_FFFF,
+    0xFFFF_FFFF,
+    1 << 40,
+    u64::MAX,
+];
+
+/// Applies 1-4 random mutations to `data`, never touching the first `keep` bytes unless
+/// `rng` decides to (with low probability).
+pub fn mutate(rng: &mut Rng, data: &mut Vec<u8>, keep: usize, pool: &[Vec<u8>]) {
+    let rounds = 1 + rng.below(4);
+    for _ in 0..rounds {
+        let lo = if rng.chance(1, 20) { 0 } else { keep.min(data.len()) };
+        let len = data.len();
+        match rng.below(11) {
+            0 if len > lo => {
+                let i = lo + rng.below(len - lo);
+                data[i] ^= 1 << rng.below(8);
+            }
+            1 if len > lo => {
+                let i = lo + rng.below(len - lo);
+                data[i] = rng.next() as u8;
+            }
+            2 if len > lo => {
+                let i = lo + rng.below(len - lo);
+                data[i] = INTERESTING_U8[rng.below(INTERESTING_U8.len())];
+            }
+            3 => {
+                let i = lo + rng.below(len - lo + 1);
+                let n = 1 + rng.below(16);
+                let ins = rng.bytes(n);
+                data.splice(i..i, ins);
+            }
+            4 if len > lo => {
+                let i = lo + rng.below(len - lo);
+                let n = 1 + rng.below((len - i).min(32));
+                data.drain(i..i + n);
+            }
+            5 if len > lo => {
+                // bincode varint marker followed by an interesting value
+                let i = lo + rng.below(len - lo);
+                let v = INTERESTING_U64[rng.below(INTERESTING_U64.len())];
+                let mut enc = Vec::new();
+                match rng.below(4) {
+                    0 => {
+                        enc.push(0xFB);
+                        enc.extend_from_slice(&(v as u16).to_le_bytes());
+                    }
+                    1 => {
+                        enc.push(0xFC);
+                        enc.extend_from_slice(&(v as u32).to_le_bytes());
+                    }
+                    2 => {
+                        enc.push(0xFD);
+                        enc.extend_from_slice(&v.to_le_bytes());
+                    }
+                    _ => enc.extend_from_slice(&v.to_le_bytes()), // fixint
+                }
+                let end = (i + enc.len()).min(data.len());
+                data.splice(i..end, enc);
+            }
+            6 if len > lo => {
+                let i = lo + rng.below(len - lo);
+                data.truncate(i);
+            }
+            7 if len > lo + 1 => {
+                // duplicate a range
+                let a = lo + rng.below(len - lo);
+                let n = 1 + rng.below((len - a).min(64));
+                let chunk = data[a..a + n].to_vec();
+                let at = lo + rng.below(data.len() - lo + 1);
+                data.splice(at..at, chunk);
+            }
+            8 if !pool.is_empty() => {
+                // splice from another sample
+                let other = &pool[rng.below(pool.len())];
+                if !other.is_empty() {
+                    let a = rng.below(other.len());
+                    let n = 1 + rng.below((other.len() - a).min(64));
+                    let at = lo + rng.below(data.len() - lo + 1);
+                    let end = (at + n).min(data.len());
+                    data.splice(at..end, other[a..a + n].iter().copied());
+                }
+            }
+            9 if len > lo => {
+                // overwrite a random u32 / u64 little endian
+                let i = lo + rng.below(len - lo);
+                let v = INTERESTING_U64[rng.below(INTERESTING_U64.len())];
+                let bytes = v.to_le_bytes();
+                for (k, b) in bytes.iter().enumerate().take(if rng.chance(1, 2) { 4 } else { 8 }) {
+                    if i + k < data.len() {
+                        data[i + k] = *b;
+                    }
+                }
+            }
+            _ => {
+                if len > lo {
+                    let i = lo + rng.below(len - lo);
+                    data[i] = data[i].wrapping_add(1 + rng.below(4) as u8);
+                }
+            }
+        }
+    }
+}
+
