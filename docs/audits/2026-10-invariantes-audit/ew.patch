+}
+
+pub fn sample_schema() -> Schema {
+    let mut s = Schema::builder()
+        .table(
+            TableBuilder::new("items")
+                .table_id(0)
+                .primary_key("id", DataType::Int)
+                .column("name", DataType::String)
+                .nullable_column("price", DataType::Float),
+        )
+        .table(
+            TableBuilder::new("links")
+                .table_id(1)
+                .primary_key("a", DataType::Int)
+                .primary_key("b", DataType::Uuid)
+                .encrypted_column("secret", DataType::String)
+                .nullable_column("flag", DataType::Bool),
+        )
+        .build();
+    s.add_column("items", ColumnDef::new("extra", DataType::Bytes).nullable(true))
+        .unwrap();
+    s
+}
+
+pub fn client_messages() -> Vec<ClientMessage> {
+    let ops = sample_ops();
+    let cid = ClientId::new("client-ä").unwrap();
+    let mut out = vec![];
+    for op in &ops {
+        out.push(ClientMessage::Commit {
+            correlation_id: CorrelationId::new(7),
+            room_id: room(),
+            client_id: cid.clone(),
+            mutation_id: MutationId::from_u128(99),
+            last_ack_seq: SequenceNumber::new(300),
+            op: op.op.clone(),
+        });
+    }
+    out.extend([
+        ClientMessage::Ack {
+            correlation_id: CorrelationId::new(1),
+            room_id: room(),
+            client_id: cid.clone(),
+            ack_seq: SequenceNumber::new(u64::MAX),
+        },
