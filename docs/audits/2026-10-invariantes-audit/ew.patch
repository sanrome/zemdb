index 0000000..ffb53a5
--- /dev/null
+++ b/crates/fuzzw/tests/fuzz_decoders.rs
@@ -0,0 +1,279 @@
+//! Homemade fuzzing of every decoder of INV-W1, with a byte-counting allocator.
+//!
+//! Run in release, one thread: `cargo test -p fuzzw --release --test fuzz_decoders -- --test-threads=1 --nocapture`.
+
+mod common;
+
+use common::*;
+use std::io::Cursor;
+use zemdb_core::protocol::wal_frame::{decode_batch_payload, parse_batch_header, BATCH_HEADER_SIZE};
+use zemdb_core::schema::Schema;
+use zemdb_core::{
+    decode_client_message, decode_message, decode_wal_batch_from_slice, encode_message,
+    encode_wal_batch, find_valid_frame, peek_client_message_kind, replay_wal_records,
+    validate_snapshot_envelope, ClientMessage, MutationId, ServerMessage, SnapshotEnvelopeHeader,
+    SnapshotEnvelopeValidator,
+};
+
+fn wire_pool_client() -> Vec<Vec<u8>> {
+    client_messages()
+        .iter()
+        .map(|m| encode_message(m).unwrap())
+        .collect()
+}
+
+fn wire_pool_server() -> Vec<Vec<u8>> {
+    server_messages()
+        .iter()
+        .map(|m| encode_message(m).unwrap())
+        .collect()
+}
+
+fn next_input(rng: &mut Rng, pool: &[Vec<u8>], header: &[u8]) -> Vec<u8> {
+    let mut data = if rng.chance(1, 10) {
+        let mut d = header.to_vec();
+        let n = rng.below(96);
+        d.extend(rng.bytes(n));
+        d
+    } else {
+        pool[rng.below(pool.len())].clone()
+    };
+    mutate(rng, &mut data, header.len(), pool);
+    data
+}
+
+#[test]
+fn fuzz_decode_client_message() {
+    let pool = wire_pool_client();
+    let mut rng = Rng::new(1);
+    let mut stats = Stats::default();
+    let mut peek = Stats::default();
+    let n = iterations(3_000_000);
+    for _ in 0..n {
+        let input = next_input(&mut rng, &pool, b"ZM\x01\x00");
+        let (r, peak, single) = measure(|| {
+            no_panic("decode_client_message", &input, || decode_client_message(&input))
+        });
+        stats.record(&input, r.is_ok(), peak, single);
+        let (r, peak, single) = measure(|| {
+            no_panic("peek_client_message_kind", &input, || peek_client_message_kind(&input))
+        });
+        peek.record(&input, r.is_ok(), peak, single);
+    }
+    stats.report("decode_client_message");
+    peek.report("peek_client_message_kind");
+}
+
+#[test]
+fn fuzz_decode_message_server_and_client_types() {
+    let pool = wire_pool_server();
+    let mut rng = Rng::new(2);
+    let mut stats = Stats::default();
+    let n = iterations(3_000_000);
+    for _ in 0..n {
+        let input = next_input(&mut rng, &pool, b"ZM\x01\x00");
+        let (r, peak, single) = measure(|| {
+            no_panic("decode_message<ServerMessage>", &input, || {
+                decode_message::<ServerMessage>(&input)
+            })
+        });
+        stats.record(&input, r.is_ok(), peak, single);
+    }
+    stats.report("decode_message<ServerMessage>");
+
+    // decode_message<ClientMessage> (the unbudgeted path a client SDK could use) over the client pool.
+    let pool = wire_pool_client();
+    let mut stats = Stats::default();
+    for _ in 0..n / 3 {
+        let input = next_input(&mut rng, &pool, b"ZM\x01\x00");
+        let (r, peak, single) = measure(|| {
+            no_panic("decode_message<ClientMessage>", &input, || {
+                decode_message::<ClientMessage>(&input)
+            })
+        });
+        stats.record(&input, r.is_ok(), peak, single);
+    }
+    stats.report("decode_message<ClientMessage>");
+}
+
+/// A log of several frames, with and without mutation ids and an empty frame.
+fn sample_log() -> Vec<u8> {
+    let ops = sample_ops();
+    let mut log = Vec::new();
+    log.extend(encode_wal_batch(&ops[..1], Some(MutationId::from_u128(1))).unwrap());
+    log.extend(encode_wal_batch(&ops[1..3], None).unwrap());
+    log.extend(encode_wal_batch(&[], None).unwrap());
+    log.extend(encode_wal_batch(&ops[3..], Some(MutationId::from_u128(9))).unwrap());
+    log
+}
+
+/// Rewrites the CRCs of the frame starting at `at` (payload CRC, then header CRC), if a header
+/// fits there and declares a payload that fits.
+fn fix_frame_crcs(data: &mut [u8], at: usize) {
+    if data.len() < at + BATCH_HEADER_SIZE {
+        return;
+    }
+    let len = u32::from_le_bytes(data[at + 2..at + 6].try_into().unwrap()) as usize;
+    let start = at + BATCH_HEADER_SIZE;
+    if start + len <= data.len() {
+        let crc = crc32fast::hash(&data[start..start + len]);
+        data[at + 6..at + 10].copy_from_slice(&crc.to_le_bytes());
+    }
+    let hcrc = crc32fast::hash(&data[at..at + 14]);
+    data[at + 14..at + 18].copy_from_slice(&hcrc.to_le_bytes());
+}
+
+#[test]
+fn fuzz_wal_frames() {
+    let log = sample_log();
+    // Offsets of the frames in the sample log.
+    let mut offsets = vec![];
+    let mut at = 0;
+    while at < log.len() {
+        offsets.push(at);
+        let len = u32::from_le_bytes(log[at + 2..at + 6].try_into().unwrap()) as usize;
+        at += BATCH_HEADER_SIZE + len;
+    }
+    let pool = vec![log.clone()];
+    let mut rng = Rng::new(3);
+    let mut replay = Stats::default();
+    let mut single_frame = Stats::default();
+    let mut payload_stats = Stats::default();
+    let n = iterations(2_000_000);
+    for i in 0..n {
+        let mut data = log.clone();
+        mutate(&mut rng, &mut data, 0, &pool);
+        // Two thirds of the inputs get their CRCs fixed so that the payload decoder is reached.
+        if i % 3 != 0 {
+            let frame = offsets[rng.below(offsets.len())];
+            let at = frame.min(data.len());
+            fix_frame_crcs(&mut data, at);
+        }
+        let (r, peak, single) = measure(|| {
+            no_panic("replay_wal_records", &data, || replay_wal_records(&data))
+        });
+        replay.record(&data, r.is_ok(), peak, single);
+
+        let off = offsets[rng.below(offsets.len())].min(data.len());
+        let slice = &data[off..];
+        let (r, peak, single) = measure(|| {
+            no_panic("decode_wal_batch_from_slice", slice, || {
+                let r = decode_wal_batch_from_slice(slice);
+                let _ = find_valid_frame(&mut Cursor::new(slice), rng_offset(slice.len()), slice.len() as u64);
+                if let Some(h) = slice.first_chunk::<BATCH_HEADER_SIZE>() {
+                    let _ = parse_batch_header(h);
+                }
+                r
+            })
+        });
+        single_frame.record(slice, r.is_ok(), peak, single);
+    }
+    // Arbitrary payloads under a matching header: the bincode payload decoder alone.
+    let payloads: Vec<Vec<u8>> = offsets
+        .iter()
+        .map(|&o| {
+            let len = u32::from_le_bytes(log[o + 2..o + 6].try_into().unwrap()) as usize;
+            log[o + BATCH_HEADER_SIZE..o + BATCH_HEADER_SIZE + len].to_vec()
+        })
+        .collect();
+    for _ in 0..n {
+        let mut p = payloads[rng.below(payloads.len())].clone();
+        mutate(&mut rng, &mut p, 0, &payloads);
+        let mut frame = encode_wal_batch(&[], None).unwrap()[..BATCH_HEADER_SIZE].to_vec();
+        frame[2..6].copy_from_slice(&(p.len() as u32).to_le_bytes());
+        frame[10..14].copy_from_slice(&((rng.next() % 4) as u32).to_le_bytes());
+        frame.extend_from_slice(&p);
+        fix_frame_crcs(&mut frame, 0);
+        let header = parse_batch_header(frame[..BATCH_HEADER_SIZE].try_into().unwrap()).unwrap();
+        let (r, peak, single) = measure(|| {
+            no_panic("decode_batch_payload", &p, || decode_batch_payload(&header, &p))
+        });
+        payload_stats.record(&p, r.is_ok(), peak, single);
+    }
+    replay.report("replay_wal_records");
+    single_frame.report("decode_wal_batch_from_slice+find_valid_frame+parse_batch_header");
+    payload_stats.report("decode_batch_payload(valid CRC, arbitrary payload)");
+}
+
+fn rng_offset(len: usize) -> u64 {
+    (len / 3) as u64
+}
+
+#[test]
+fn fuzz_snapshot_envelope_header() {
+    let body = b"payload bytes of a raw snapshot".to_vec();
+    let header = SnapshotEnvelopeHeader::for_body(
+        zemdb_core::SnapshotCompression::Raw,
+        body.len() as u32,
+        &body,
+    );
+    let mut env = header.to_bytes().to_vec();
+    env.extend_from_slice(&body);
+    let pool = vec![env.clone()];
+    let mut rng = Rng::new(4);
+    let mut stats = Stats::default();
+    let n = iterations(3_000_000);
+    for _ in 0..n {
+        let mut data = if rng.chance(1, 10) {
+            let k = rng.below(40);
+            rng.bytes(k)
+        } else {
+            env.clone()
+        };
+        mutate(&mut rng, &mut data, 0, &pool);
+        let (r, peak, single) = measure(|| {
+            no_panic("SnapshotEnvelopeHeader::parse", &data, || {
+                let parsed = SnapshotEnvelopeHeader::parse(&data);
+                let whole = validate_snapshot_envelope(&data);
+                // The incremental validator must agree with the whole one, whatever the split.
+                let mut v = SnapshotEnvelopeValidator::new();
+                let mut rest: &[u8] = &data;
+                while !rest.is_empty() {
+                    let k = (1 + (rest.len() % 7)).min(rest.len());
+                    v.update(&rest[..k]);
+                    rest = &rest[k..];
+                }
+                let inc = v.finish();
+                assert_eq!(whole.is_ok(), inc.is_ok(), "incremental validator disagrees");
+                if let (Ok(a), Ok(b)) = (&whole, &inc) {
+                    assert_eq!(a, b);
+                }
+                parsed
+            })
+        });
+        stats.record(&data, r.is_ok(), peak, single);
+    }
+    stats.report("SnapshotEnvelopeHeader::parse+validate");
+}
+
+#[test]
+fn fuzz_schema_json() {
+    let schema = sample_schema();
+    let pretty = serde_json::to_vec_pretty(&schema).unwrap();
+    let compact = serde_json::to_vec(&schema).unwrap();
+    let pool = vec![pretty.clone(), compact.clone()];
+    let mut rng = Rng::new(5);
+    let mut stats = Stats::default();
+    let mut accepted_different = 0u64;
+    let n = iterations(2_000_000);
+    for _ in 0..n {
+        let mut data = pool[rng.below(2)].clone();
+        mutate(&mut rng, &mut data, 0, &pool);
+        let (r, peak, single) = measure(|| {
+            no_panic("serde_json::from_slice::<Schema>", &data, || {
+                serde_json::from_slice::<Schema>(&data)
+            })
+        });
+        if let Ok(s) = &r {
+            if *s != schema {
+                accepted_different += 1;
+            }
+        }
+        stats.record(&data, r.is_ok(), peak, single);
+    }
+    stats.report("serde_json::from_slice::<Schema>");
+    eprintln!("[schema json] mutated inputs accepted as a DIFFERENT valid schema: {accepted_different}");
+    // Deep nesting must be rejected, not overflow the stack.
+    let deep = format!("{}{}", "[".repeat(100_000), "]".repeat(100_000));
+    assert!(serde_json::from_str::<Schema>(&deep).is_err());
+}
diff --git a/crates/fuzzw/tests/fuzz_storage.rs b/crates/fuzzw/tests/fuzz_storage.rs
new file mode 100644
index 0000000..b515a17
--- /dev/null
+++ b/crates/fuzzw/tests/fuzz_storage.rs
@@ -0,0 +1,276 @@
+//! Homemade fuzzing of the storage snapshot decoders (`apply_snapshot`, `decode_snapshot_envelope`)
+//! and of opening a disk room from damaged files.
+
+mod common;
+
+use bytes::Bytes;
+use common::*;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Mutex;
+use zemdb_core::mutation::{ColumnUpdate, Operation};
+use zemdb_core::value::{CompactRow, PrimaryKey, Value};
+use zemdb_core::{
+    RoomId, SequenceNumber, SequencedOperation, SnapshotCompression, SnapshotEnvelopeHeader,
+    SNAPSHOT_HEADER_LEN,
+};
+use zemdb_storage::snapshot::decode_snapshot_envelope;
+use zemdb_storage::{
+    DiskStorageEngine, DiskStorageOptions, MemoryStorageEngine, ScanOptions, StorageEngine,
+    StorageError,
+};
+
+static PANICS: AtomicU64 = AtomicU64::new(0);
+static LAST_PANIC: Mutex<String> = Mutex::new(String::new());
+
+fn install_panic_counter() {
+    std::panic::set_hook(Box::new(|info| {
+        PANICS.fetch_add(1, Ordering::SeqCst);
+        let msg = info.to_string();
+        eprintln!("PANIC HOOK: {}", &msg[..msg.len().min(4000)]);
+        *LAST_PANIC.lock().unwrap() = msg;
+    }));
+}
+
+fn check_no_panic(name: &str, input: &[u8], res: &Result<SequenceNumber, StorageError>) {
+    if PANICS.load(Ordering::SeqCst) > 0 {
+        panic!(
+            "[{name}] panic inside the engine: {} ; input {}",
+            LAST_PANIC.lock().unwrap(),
+            hex(input)
+        );
+    }
+    if let Err(StorageError::Other(msg)) = res {
+        assert!(!msg.contains("Join error"), "[{name}] {msg} input {}", hex(input));
+    }
+}
+
+fn source_ops() -> Vec<SequencedOperation> {
+    let mut ops = vec![
+        Operation::insert(
+            0,
+            PrimaryKey::single(1i64),
+            CompactRow::new(vec![Value::Int(1), "a".into(), Value::Null, Value::Null]),
+            1,
+        ),
+        Operation::update(0, PrimaryKey::single(1i64), vec![ColumnUpdate::new(2, Value::Float(-0.0))], 2),
+        Operation::insert(
+            1,
+            PrimaryKey::composite([Value::Int(1), Value::Uuid([3; 16])]),
+            CompactRow::new(vec![Value::Int(1), Value::Uuid([3; 16]), Value::Bytes(vec![1, 2].into()), Value::Null]),
+            3,
+        ),
+        // A short row, from before the column `extra` was added.
+        Operation::insert(0, PrimaryKey::single(2i64), CompactRow::new(vec![Value::Int(2), "b".into(), Value::Float(f64::NAN)]), 4),
+        Operation::delete(0, PrimaryKey::single(3i64), 5),
+    ];
+    for k in 10..40i64 {
+        ops.push(Operation::insert(
+            0,
+            PrimaryKey::single(k),
+            CompactRow::new(vec![Value::Int(k), format!("row {k}").into(), Value::Float(k as f64), Value::Bytes(vec![k as u8; 5].into())]),
+            k as u64,
+        ));
+    }
+    ops.into_iter()
+        .enumerate()
+        .map(|(i, op)| SequencedOperation::new(i as u64 + 1, op))
+        .collect()
+}
+
+fn rt() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap()
+}
+
+fn rebuild_raw(payload: &[u8]) -> Vec<u8> {
+    let h = SnapshotEnvelopeHeader::for_body(SnapshotCompression::Raw, payload.len() as u32, payload);
+    let mut v = h.to_bytes().to_vec();
+    v.extend_from_slice(payload);
+    v
+}
+
+fn rebuild_zstd(body: &[u8], declared: u32) -> Vec<u8> {
+    let h = SnapshotEnvelopeHeader::for_body(SnapshotCompression::Zstd, declared, body);
+    let mut v = h.to_bytes().to_vec();
+    v.extend_from_slice(body);
+    v
+}
+
+#[test]
+fn fuzz_apply_snapshot_and_envelopes() {
+    install_panic_counter();
+    let rt = rt();
+    let schema = sample_schema();
+    let src_room = RoomId::new("src").unwrap();
+    let ops = source_ops();
+    let head = SequenceNumber::new(ops.len() as u64);
+
+    // A raw envelope (memory engine) and a Zstandard one (disk engine) of the same state.
+    let (raw, zst) = rt.block_on(async {
+        let mem = MemoryStorageEngine::new();
+        mem.open_room(&src_room, schema.clone()).await.unwrap();
+        mem.apply_batch(&src_room, ops.clone()).await.unwrap();
+        let raw = mem.create_snapshot(&src_room).await.unwrap();
+        let dir = tempfile::tempdir().unwrap();
+        let disk = DiskStorageEngine::new(DiskStorageOptions::new(dir.path())).unwrap();
+        disk.open_room(&src_room, schema.clone()).await.unwrap();
+        disk.apply_batch(&src_room, ops.clone()).await.unwrap();
+        let zst = disk.create_snapshot(&src_room).await.unwrap();
+        (raw, zst)
+    });
+    let raw_payload = raw[SNAPSHOT_HEADER_LEN..].to_vec();
+    let zst_body = zst[SNAPSHOT_HEADER_LEN..].to_vec();
+    let zst_payload = decode_snapshot_envelope(&zst).unwrap();
+    // The table map is a HashMap: the two engines may write the tables in different orders.
+    eprintln!("[snapshot] memory and disk payload bytes identical: {}", zst_payload == raw_payload);
+    let pool = vec![raw_payload.clone()];
+
+    let target = MemoryStorageEngine::new();
+    let room = RoomId::new("dst").unwrap();
+    rt.block_on(target.open_room(&room, schema.clone())).unwrap();
+
+    let mut rng = Rng::new(11);
+    let mut apply_stats = Stats::default();
+    let mut env_stats = Stats::default();
+    let n = iterations(400_000);
+    let mut accepted = 0u64;
+    for i in 0..n {
+        let env: Vec<u8> = match i % 4 {
+            0 => {
+                let mut e = if rng.chance(1, 2) { raw.clone() } else { zst.clone() };
+                mutate(&mut rng, &mut e, 0, &pool);
+                e
+            }
+            1 => {
+                let mut p = raw_payload.clone();
+                mutate(&mut rng, &mut p, 0, &pool);
+                rebuild_raw(&p)
+            }
+            2 => {
+                let mut p = raw_payload.clone();
+                mutate(&mut rng, &mut p, 0, &pool);
+                let body = zstd::encode_all(&p[..], 1).unwrap();
+                let declared = if rng.chance(1, 4) { rng.next() as u32 % (1 << 22) } else { p.len() as u32 };
+                rebuild_zstd(&body, declared)
+            }
+            _ => {
+                let mut b = zst_body.clone();
+                mutate(&mut rng, &mut b, 0, &[]);
+                let declared = if rng.chance(1, 4) { rng.next() as u32 } else { raw_payload.len() as u32 };
+                rebuild_zstd(&b, declared)
+            }
+        };
+        let (r, peak, single) = measure(|| {
+            no_panic("decode_snapshot_envelope", &env, || decode_snapshot_envelope(&env).map(|_| ()))
+        });
+        env_stats.record(&env, r.is_ok(), peak, single);
+
+        let bytes = Bytes::from(env.clone());
+        let (res, peak, single) = measure(|| {
+            no_panic("apply_snapshot", &env, || {
+                rt.block_on(target.apply_snapshot(&room, schema.clone(), bytes, head))
+            })
+        });
+        check_no_panic("apply_snapshot", &env, &res);
+        apply_stats.record(&env, res.is_ok(), peak, single);
+        if res.is_ok() {
+            accepted += 1;
+            // Start from an empty room again, so that the next snapshot is not a no-op.
+            rt.block_on(async {
+                target.close_room(&room).await.unwrap();
+                target.open_room(&room, schema.clone()).await.unwrap();
+            });
+        }
+    }
+    env_stats.report("decode_snapshot_envelope");
+    apply_stats.report("MemoryStorageEngine::apply_snapshot");
+    eprintln!("[apply_snapshot] accepted {accepted} mutated snapshots");
+}
+
+/// Opening a disk room from a damaged snapshot file or WAL (with and without fixed CRCs).
+#[test]
+fn fuzz_disk_open_from_damaged_files() {
+    install_panic_counter();
+    let rt = rt();
+    let schema = sample_schema();
+    let room = RoomId::new("r").unwrap();
+    let ops = source_ops();
+    let base = tempfile::tempdir().unwrap();
+    let (snap, wal) = rt.block_on(async {
+        let disk = DiskStorageEngine::new(DiskStorageOptions::new(base.path()).auto_compact(false)).unwrap();
+        disk.open_room(&room, schema.clone()).await.unwrap();
+        disk.apply_batch(&room, ops[..20].to_vec()).await.unwrap();
+        disk.compact_room(&room).await.unwrap();
+        for op in &ops[20..] {
+            disk.apply_batch(&room, vec![op.clone()]).await.unwrap();
+        }
+        disk.close_room(&room).await.unwrap();
+        let snap = std::fs::read(disk.snap_file_path(&room)).unwrap();
+        let wal = std::fs::read(disk.wal_file_path(&room)).unwrap();
+        (snap, wal)
+    });
+    assert!(snap.len() > 64 && !wal.is_empty());
+
+    let mut rng = Rng::new(12);
+    let mut stats = Stats::default();
+    let n = iterations(20_000).min(60_000);
+    let mut opened = 0u64;
+    for i in 0..n {
+        let dir = tempfile::tempdir().unwrap();
+        let mut s = snap.clone();
+        let mut w = wal.clone();
+        let which = i % 4;
+        if which == 0 || which == 3 {
+            mutate(&mut rng, &mut s, 0, &[]);
+            if rng.chance(2, 3) && s.len() >= 64 {
+                // Fix the payload CRC and the header CRC so that the decoder is reached.
+                let len = u64::from_le_bytes(s[24..32].try_into().unwrap());
+                if (64 + len) as usize <= s.len() {
+                    let crc = crc32fast::hash(&s[64..64 + len as usize]);
+                    s[32..36].copy_from_slice(&crc.to_le_bytes());
+                }
+                let h = crc32fast::hash(&s[..36]);
+                s[36..40].copy_from_slice(&h.to_le_bytes());
+            }
+        }
+        if which == 1 || which == 3 {
+            mutate(&mut rng, &mut w, 0, &[]);
+        }
+        let compacting = which == 2;
+        if compacting {
+            mutate(&mut rng, &mut w, 0, &[]);
+        }
+        let engine = DiskStorageEngine::new(DiskStorageOptions::new(dir.path()).auto_compact(false)).unwrap();
+        std::fs::write(engine.snap_file_path(&room), &s).unwrap();
+        if compacting {
+            let mut p = engine.wal_file_path(&room).into_os_string();
+            p.push(".compacting");
+            std::fs::write(p, &w).unwrap();
+            std::fs::write(engine.wal_file_path(&room), b"").unwrap();
+        } else {
+            std::fs::write(engine.wal_file_path(&room), &w).unwrap();
+        }
+        let input = [s.as_slice(), w.as_slice()].concat();
+        let (res, peak, single) = measure(|| {
+            no_panic("disk open_room", &input, || {
+                rt.block_on(async {
+                    let r = engine.open_room(&room, schema.clone()).await;
+                    if r.is_ok() {
+                        let _ = engine.scan_by_id(&room, 0, ScanOptions::default()).await.map(|_| ());
+                        let _ = engine.close_room(&room).await;
+                    }
+                    r.map(|_| SequenceNumber::new(0))
+                })
+            })
+        });
+        check_no_panic("disk open_room", &input, &res);
+        if res.is_ok() {
+            opened += 1;
+        }
+        stats.record(&input, res.is_ok(), peak, single);
+    }
+    stats.report("DiskStorageEngine::open_room (damaged .snap/.wal/.wal.compacting)");
+    eprintln!("[disk open] opened {opened} of {n}");
+}
