diff --git a/crates/fuzzw/tests/schema_evolution.rs b/crates/fuzzw/tests/schema_evolution.rs
new file mode 100644
index 0000000..8253a8a
--- /dev/null
+++ b/crates/fuzzw/tests/schema_evolution.rs
@@ -0,0 +1,206 @@
+//! INV-E1: every operation valid under a schema stays valid under any later version of it,
+//! and a replica opened with the evolved schema replays the log written under the old one.
+
+use proptest::collection::vec;
+use proptest::prelude::*;
+use zemdb_core::mutation::{ColumnUpdate, Operation};
+use zemdb_core::schema::{ColumnDef, Schema, TableSchema};
+use zemdb_core::value::{CompactRow, DataType, PrimaryKey, Value};
+use zemdb_core::{RoomId, SequenceNumber, SequencedOperation};
+use zemdb_storage::{DiskStorageEngine, DiskStorageOptions, ScanOptions, StorageEngine};
+
+fn cases(default: u32) -> u32 {
+    std::env::var("PROP_CASES").ok().and_then(|s| s.parse().ok()).unwrap_or(default)
+}
+
+fn ty() -> impl Strategy<Value = DataType> {
+    prop_oneof![
+        Just(DataType::Int),
+        Just(DataType::Float),
+        Just(DataType::Timestamp),
+        Just(DataType::String),
+        Just(DataType::Bool),
+        Just(DataType::Bytes),
+        Just(DataType::Uuid),
+    ]
+}
+
+fn value_of(t: DataType, seed: u64) -> Value {
+    match t {
+        DataType::Int => Value::Int(seed as i64),
+        DataType::Float => Value::Float(if seed % 3 == 0 { -0.0 } else { seed as f64 / 3.0 }),
+        DataType::Timestamp => Value::Timestamp(seed as i64),
+        DataType::String => Value::String(format!("s{seed}").into()),
+        DataType::Bool => Value::Bool(seed % 2 == 0),
+        DataType::Bytes => Value::Bytes(seed.to_le_bytes().to_vec().into()),
+        DataType::Uuid => Value::Uuid([seed as u8; 16]),
+        DataType::Null => Value::Null,
+    }
+}
+
+/// A value valid for `col` (encrypted columns travel as bytes); `None` for a null if allowed.
+fn cell(col: &ColumnDef, seed: u64) -> Value {
+    if col.is_nullable() && seed % 4 == 0 {
+        return Value::Null;
+    }
+    if col.is_encrypted() {
+        return Value::Bytes(vec![seed as u8; 3].into());
+    }
+    value_of(col.data_type(), seed)
+}
+
+/// Random table definitions: (id, columns as (type, nullable, encrypted), pk width).
+type TableSpec = (u16, Vec<(DataType, bool, bool)>, usize);
+
+fn build_schema(specs: &[TableSpec]) -> Schema {
+    let mut tables = vec![];
+    let mut ids = std::collections::BTreeSet::new();
+    for (i, (id, cols, pk_n)) in specs.iter().enumerate() {
+        if !ids.insert(*id) {
+            continue;
+        }
+        let pk_n = (*pk_n).min(cols.len());
+        let defs: Vec<ColumnDef> = cols
+            .iter()
+            .enumerate()
+            .map(|(c, (t, n, e))| {
+                let is_pk = c < pk_n;
+                ColumnDef::new(format!("c{c}"), *t).nullable(*n && !is_pk).encrypted(*e && !is_pk)
+            })
+            .collect();
+        let pk = (0..pk_n).map(|c| format!("c{c}")).collect();
+        tables.push(TableSchema::try_new(*id, format!("t{i}"), pk, defs).unwrap());
+    }
+    Schema::try_from_tables(tables).unwrap()
+}
+
+fn ops_for(schema: &Schema, seeds: &[(u8, u64, u8)]) -> Vec<Operation> {
+    let tables: Vec<&TableSchema> = schema.tables().collect();
+    seeds
+        .iter()
+        .map(|&(t, seed, kind)| {
+            let table = tables[t as usize % tables.len()];
+            let key_seed = seed % 7;
+            let pk: Vec<Value> = table
+                .primary_key()
+                .iter()
+                .map(|name| value_of(table.get_column(name).unwrap().data_type(), key_seed))
+                .collect();
+            let pk = PrimaryKey::composite(pk.clone());
+            let cols = table.columns();
+            match kind % 3 {
+                0 => {
+                    // A full row, or one cut short after its non-null columns.
+                    let mut row: Vec<Value> = cols
+                        .iter()
+                        .enumerate()
+                        .map(|(i, c)| {
+                            if i < table.primary_key().len() {
+                                pk[i].clone()
+                            } else {
+                                cell(c, seed.wrapping_add(i as u64))
+                            }
+                        })
+                        .collect();
+                    while row.len() > 1 && seed % 2 == 0 && cols[row.len() - 1].is_nullable() {
+                        row.pop();
+                    }
+                    Operation::insert(table.table_id(), pk, CompactRow::new(row), seed)
+                }
+                1 => {
+                    let updates: Vec<ColumnUpdate> = cols
+                        .iter()
+                        .enumerate()
+                        .skip(table.primary_key().len())
+                        .filter(|(i, _)| (seed >> i) & 1 == 1)
+                        .map(|(i, c)| ColumnUpdate::new(i as u16, cell(c, seed ^ i as u64)))
+                        .collect();
+                    if updates.is_empty() {
+                        Operation::delete(table.table_id(), pk, seed)
+                    } else {
+                        Operation::update(table.table_id(), pk, updates, seed)
+                    }
+                }
+                _ => Operation::delete(table.table_id(), pk, seed),
+            }
+        })
+        .collect()
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig { cases: cases(3_000), .. ProptestConfig::default() })]
+
+    #[test]
+    fn operations_stay_valid_under_every_later_version(
+        specs in vec((0u16..6, vec((ty(), any::<bool>(), any::<bool>()), 1..6), 1usize..3), 1..4),
+        seeds in vec((any::<u8>(), any::<u64>(), any::<u8>()), 1..30),
+        additions in vec((any::<u8>(), ty(), any::<bool>()), 1..6),
+    ) {
+        let v1 = build_schema(&specs);
+        let ops = ops_for(&v1, &seeds);
+        for op in &ops {
+            prop_assert!(v1.validate_operation(op).is_ok(), "generator: {:?}", v1.validate_operation(op));
+        }
+        let mut evolved = v1.clone();
+        let names: Vec<String> = v1.tables().map(|t| t.name().to_string()).collect();
+        for (k, (t, dt, enc)) in additions.iter().enumerate() {
+            let name = &names[*t as usize % names.len()];
+            let before = evolved.version();
+            evolved.add_column(name, ColumnDef::new(format!("added{k}"), *dt).nullable(true).encrypted(*enc)).unwrap();
+            prop_assert_eq!(evolved.version(), before + 1);
+            // Nothing is lost, renumbered or retyped.
+            for old in v1.tables() {
+                let new = evolved.get_table_by_id(old.table_id()).unwrap();
+                prop_assert_eq!(new.name(), old.name());
+                prop_assert_eq!(new.primary_key(), old.primary_key());
+                prop_assert_eq!(&new.columns()[..old.columns().len()], old.columns());
+            }
+            for op in &ops {
+                prop_assert!(evolved.validate_operation(op).is_ok(), "{:?}", evolved.validate_operation(op));
+            }
+            // A non-nullable addition is refused and changes nothing.
+            let mut refused = evolved.clone();
+            prop_assert!(refused.add_column(name, ColumnDef::new("strict", *dt)).is_err());
+            prop_assert_eq!(&refused, &evolved);
+        }
+        // The evolved schema survives JSON and comes back with the same version.
+        let json = serde_json::to_string(&evolved).unwrap();
+        prop_assert_eq!(serde_json::from_str::<Schema>(&json).unwrap(), evolved.clone());
+
+        // A disk replica written under v1 reopens under the evolved schema with the same rows.
+        let rt = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+        rt.block_on(async {
+            let dir = tempfile::tempdir().unwrap();
+            let room = RoomId::new("evo").unwrap();
+            let seqd: Vec<_> = ops.iter().cloned().enumerate()
+                .map(|(i, op)| SequencedOperation::new(i as u64 + 1, op)).collect();
+            let engine = DiskStorageEngine::new(DiskStorageOptions::new(dir.path()).auto_compact(false)).unwrap();
+            engine.open_room(&room, v1.clone()).await.unwrap();
+            engine.apply_batch(&room, seqd).await.unwrap();
+            let before = dump(&engine, &room, &v1).await;
+            engine.close_room(&room).await.unwrap();
+            engine.open_room(&room, evolved.clone()).await.unwrap();
+            assert_eq!(engine.get_head_seq(&room).await.unwrap(), SequenceNumber::new(ops.len() as u64));
+            assert_eq!(dump(&engine, &room, &v1).await, before);
+        });
+    }
+}
+
+async fn dump(e: &DiskStorageEngine, room: &RoomId, schema: &Schema) -> Vec<(PrimaryKey, CompactRow)> {
+    use futures::StreamExt;
+    let mut out = vec![];
+    for t in schema.table_ids() {
+        let mut s = e.scan_by_id(room, t, ScanOptions::default()).await.unwrap();
+        while let Some(r) = s.next().await {
+            // Compared without trailing nulls: an update widens a row to the width of the schema
+            // it is applied with (see the audit notes), which is not a change of content.
+            let (pk, row) = r.unwrap();
+            let mut v = row.into_values();
+            while v.last() == Some(&Value::Null) {
+                v.pop();
+            }
+            out.push((pk, CompactRow::new(v)));
+        }
+    }
+    out
+}
