+/// AUDIT (backlog): a failed directory sync after the rename leaves the new version on disk
+/// but the previous one in the registry; the next write overwrites the disk from the cache.
+#[test]
+fn audit_failed_directory_sync_leaves_the_disk_ahead_of_the_registry() {
+    let (dir, id, registry) = todo_registry();
+    fail_point::arm("sync_dir", dir.path());
+    assert!(registry
+        .add_column(&id, "tasks", nullable_int("priority"))
+        .is_err());
+    assert!(!has_column(&registry.get_schema(&id).unwrap(), "priority"));
+    let on_disk: Schema =
+        serde_json::from_slice(&std::fs::read(todo_path(&dir)).unwrap()).unwrap();
+    assert!(has_column(&on_disk, "priority"), "the rename already happened");
+    // A restart now would serve `priority`; without one, the next column takes its index.
+    registry
+        .add_column(
+            &id,
+            "tasks",
+            ColumnDef::new("estimate", DataType::String).nullable(true),
+        )
+        .unwrap();
+    let on_disk: Schema =
+        serde_json::from_slice(&std::fs::read(todo_path(&dir)).unwrap()).unwrap();
+    assert!(!has_column(&on_disk, "priority"));
+    assert!(has_column(&on_disk, "estimate"));
+}
