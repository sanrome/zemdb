+/// AUDIT INV-W2: `log_meta.json` is not under a checksum. One flipped bit that keeps the JSON
+/// valid raises the recorded pruning point, and opening the log then deletes, without any
+/// error, sealed segments that were never pruned.
+#[test]
+fn audit_single_bit_flip_in_log_meta_deletes_retained_segments() {
+    let dir = tempdir().unwrap();
+    let policy = || RoomLifecyclePolicy {
+        ram_max_ops: 5,
+        ..RoomLifecyclePolicy::default()
+    };
+    {
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy()).unwrap();
+        append_range(&mut log, 1, 40);
+        log.prune_older_than(SequenceNumber::new(11)).unwrap();
+        assert_eq!(log.tail_seq().get(), 11);
+        let (ops, _) = log.fetch_deltas(SequenceNumber::new(10), 100).unwrap();
+        assert_contiguous(&ops, 11, 40);
+    }
+    let segments = segments_dir(dir.path());
+    assert!(segment_file(&segments, 11, 15, "wal").exists());
+
+    let meta = dir.path().join("log_meta.json");
+    let mut bytes = std::fs::read(&meta).unwrap();
+    eprintln!("[audit] log_meta.json before: {}", String::from_utf8_lossy(&bytes));
+    let at = bytes.windows(2).position(|w| w == b"10").unwrap();
+    bytes[at] ^= 0b10; // "10" -> "30": one bit.
+    std::fs::write(&meta, &bytes).unwrap();
+    eprintln!("[audit] log_meta.json after:  {}", String::from_utf8_lossy(&bytes));
+
+    let (log, _) = TieredLog::open_or_create(dir.path(), policy()).expect("opens without error");
+    eprintln!("[audit] reopened: tail_seq={} head_seq={}", log.tail_seq(), log.head_seq());
+    assert_eq!(log.tail_seq().get(), 31);
+    for (a, b) in [(11, 15), (16, 20), (21, 25), (26, 30)] {
+        assert!(!segment_file(&segments, a, b, "wal").exists(), "segment {a}..={b} deleted");
+    }
+    assert!(log.fetch_deltas(SequenceNumber::new(10), 100).is_err());
+}
