+            let mut decoder = zstd::stream::read::Decoder::new(&compressed[..]).unwrap();
+            let mut budget = ReadBudget::ops(budget_ops);
+            let streamed = read_frames(&mut decoder, None, start, from, &mut budget);
+            (read.is_ok(), streamed.is_ok())
+        });
+        match result {
+            Ok((true, _)) => outcomes[0] += 1,
+            Ok((false, _)) => outcomes[1] += 1,
+            Err(_) => {
+                outcomes[2] += 1;
+                panic!("read_frames panicked on {data:02x?} start={start:?} from={from:?}");
+            }
+        }
+    }
+    eprintln!("[segment_reader] iters={iters} ok={} err={} panics={}", outcomes[0], outcomes[1], outcomes[2]);
+}
+
+fn next_u64(data: &[u8]) -> u64 {
+    data.len() as u64
+}
