+/// AUDIT INV-W2 (and its consequence on INV-E1): a single flipped bit in `schemas/{id}.json`
+/// that keeps the JSON valid is not detected. The registry restarts with a schema in which a
+/// table has another id, so every operation of that table in the rooms' logs refers to a
+/// table the schema no longer has.
+#[test]
+fn audit_single_bit_flip_in_a_schema_file_renumbers_a_table() {
+    let dir = tempdir().unwrap();
+    let id = SchemaId::new("todo").unwrap();
+    let registry = SchemaRegistry::new(dir.path()).unwrap();
+    let schema = Schema::builder()
+        .table(
+            TableSchema::builder("tasks")
+                .table_id(0)
+                .primary_key("id", DataType::Int)
+                .column("title", DataType::String),
+        )
+        .table(
+            TableSchema::builder("notes")
+                .table_id(1)
+                .primary_key("id", DataType::Int),
+        )
+        .build();
+    registry.register_schema(id.clone(), schema).unwrap();
+    drop(registry);
+
+    let path = dir.path().join("todo.json");
+    let mut bytes = std::fs::read(&path).unwrap();
+    let needle = b"\"table_id\": 1";
+    let at = bytes
+        .windows(needle.len())
+        .position(|w| w == needle)
+        .unwrap()
+        + needle.len()
+        - 1;
+    bytes[at] ^= 0b10; // '1' (0x31) -> '3' (0x33): one bit.
+    std::fs::write(&path, &bytes).unwrap();
+
+    let reopened = SchemaRegistry::new(dir.path()).expect("the damaged file is accepted");
+    let schema = reopened.get_schema(&id).unwrap();
+    assert_eq!(schema.get_table_id("notes"), Some(3));
+    assert!(!schema.has_table_by_id(1));
+    eprintln!("[audit] table 'notes' reloaded with id 3 instead of 1, no error");
+}
