+    vec![
+        Value::Null,
+        Value::Int(-5),
+        Value::Int(i64::MAX),
+        Value::Float(-0.0),
+        Value::Float(f64::NAN),
+        Value::Float(1.5),
+        Value::Timestamp(1_700_000_000),
+        Value::String("héllo".into()),
+        Value::Bool(true),
+        Value::Bytes(vec![1, 2, 3, 0xFF].into_boxed_slice()),
+        Value::Uuid([7u8; 16]),
+    ]
+}
+
