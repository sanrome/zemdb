+fn cases(default: u32) -> u32 {
+    std::env::var("PROP_CASES")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(default)
+}
+
+// ------------------------------------------------------------------------------------------
+// Strategies
+// ------------------------------------------------------------------------------------------
+
+fn float() -> impl Strategy<Value = f64> {
+    prop_oneof![
+        any::<f64>(),
+        Just(-0.0),
+        Just(0.0),
+        Just(f64::NAN),
+        Just(-f64::NAN),
+        Just(f64::INFINITY),
+        Just(f64::NEG_INFINITY),
+        Just(f64::MIN_POSITIVE),
+        any::<u64>().prop_map(f64::from_bits),
+    ]
+}
+
+fn value() -> impl Strategy<Value = Value> {
+    prop_oneof![
+        Just(Value::Null),
+        any::<i64>().prop_map(Value::Int),
+        float().prop_map(Value::Float),
+        any::<i64>().prop_map(Value::Timestamp),
+        ".{0,12}".prop_map(|s: String| Value::String(s.into())),
+        any::<bool>().prop_map(Value::Bool),
+        vec(any::<u8>(), 0..24).prop_map(|b| Value::Bytes(b.into())),
+        any::<[u8; 16]>().prop_map(Value::Uuid),
+    ]
+}
+
+fn pk() -> impl Strategy<Value = PrimaryKey> {
+    vec(value(), 0..4).prop_map(|v| PrimaryKey::from_smallvec(SmallVec::from_vec(v)))
+}
+
+fn row() -> impl Strategy<Value = CompactRow> {
+    vec(value(), 0..6).prop_map(CompactRow::new)
+}
+
+fn kind() -> impl Strategy<Value = OperationKind> {
+    prop_oneof![
+        row().prop_map(|row| OperationKind::Insert { row }),
+        vec((any::<u16>(), value()), 0..5).prop_map(|u| OperationKind::Update {
+            updates: u.into_iter().map(|(i, v)| ColumnUpdate::new(i, v)).collect()
+        }),
+        Just(OperationKind::Delete),
+    ]
+}
+
+fn operation() -> impl Strategy<Value = Operation> {
+    (any::<u16>(), pk(), any::<u64>(), kind()).prop_map(|(t, pk, ts, k)| Operation::new(t, pk, ts, k))
+}
+
+fn seq_op() -> impl Strategy<Value = SequencedOperation> {
+    (any::<u64>(), operation()).prop_map(|(s, op)| SequencedOperation::new(s, op))
+}
+
+fn path_id() -> impl Strategy<Value = String> {
+    "[a-z0-9_-]{1,64}".prop_filter("not a reserved name", |s| RoomId::new(s.clone()).is_ok())
+}
+
+fn room_id() -> impl Strategy<Value = RoomId> {
+    path_id().prop_map(|s| RoomId::new(s).unwrap())
+}
+
+fn schema_id() -> impl Strategy<Value = SchemaId> {
+    path_id().prop_map(|s| SchemaId::new(s).unwrap())
+}
+
+fn client_id() -> impl Strategy<Value = ClientId> {
+    prop_oneof!["[a-zA-Z0-9 _.@-]{1,40}", ".{1,20}"]
+        .prop_filter_map("valid client id", |s| ClientId::new(s).ok())
+}
+
+fn seq() -> impl Strategy<Value = SequenceNumber> {
+    any::<u64>().prop_map(SequenceNumber::new)
+}
+
+fn corr() -> impl Strategy<Value = CorrelationId> {
+    any::<u64>().prop_map(CorrelationId::new)
+}
+
+fn mid() -> impl Strategy<Value = MutationId> {
+    any::<[u8; 16]>().prop_map(MutationId::new)
+}
+
+fn data_type() -> impl Strategy<Value = DataType> {
+    prop_oneof![
+        Just(DataType::Int),
+        Just(DataType::Float),
+        Just(DataType::Timestamp),
+        Just(DataType::String),
+        Just(DataType::Bool),
+        Just(DataType::Bytes),
+        Just(DataType::Uuid),
+    ]
+}
+
+/// A random valid schema, including evolutions with `add_column`.
+fn schema() -> impl Strategy<Value = Schema> {
+    let table = (
+        any::<u16>(),
+        "[a-z]{1,6}",
+        vec(("[a-z]{1,5}", data_type(), any::<bool>(), any::<bool>()), 1..6),
+        1usize..3,
+    );
+    (vec(table, 0..4), vec(("[a-z]{1,6}", data_type(), any::<bool>()), 0..4)).prop_map(
+        |(tables, additions)| {
+            let mut out = Vec::new();
+            let mut ids = BTreeSet::new();
+            let mut names = BTreeSet::new();
+            for (id, name, cols, pk_n) in tables {
+                if !ids.insert(id) || !names.insert(name.clone()) {
+                    continue;
+                }
+                let mut seen = BTreeSet::new();
+                let cols: Vec<ColumnDef> = cols
+                    .into_iter()
+                    .filter(|(n, ..)| seen.insert(n.clone()))
+                    .enumerate()
+                    .map(|(i, (n, t, nullable, enc))| {
+                        let is_pk = i < pk_n;
+                        ColumnDef::new(n, t).nullable(nullable && !is_pk).encrypted(enc && !is_pk)
+                    })
+                    .collect();
+                let pk: Vec<String> = cols.iter().take(pk_n).map(|c| c.name().to_string()).collect();
+                if let Ok(t) = TableSchema::try_new(id, name, pk, cols) {
+                    out.push(t);
+                }
+            }
+            let mut s = Schema::try_from_tables(out).unwrap();
+            let names: Vec<String> = s.tables().map(|t| t.name().to_string()).collect();
+            for (i, (col, t, enc)) in additions.into_iter().enumerate() {
+                if names.is_empty() {
+                    break;
+                }
+                let table = &names[i % names.len()];
+                let r = s.add_column(table, ColumnDef::new(col, t).nullable(true).encrypted(enc));
+                assert!(matches!(r, Ok(_) | Err(ValidationError::DuplicateColumn { .. })));
+            }
+            s
+        },
+    )
+}
+
+fn client_message() -> impl Strategy<Value = ClientMessage> {
+    prop_oneof![
+        (corr(), room_id(), client_id(), mid(), seq(), operation()).prop_map(|(c, r, cl, m, s, op)| {
+            ClientMessage::Commit { correlation_id: c, room_id: r, client_id: cl, mutation_id: m, last_ack_seq: s, op }
+        }),
+        (corr(), room_id(), client_id(), seq()).prop_map(|(c, r, cl, s)| ClientMessage::Ack {
+            correlation_id: c, room_id: r, client_id: cl, ack_seq: s
+        }),
+        (corr(), room_id(), client_id(), seq(), any::<u32>()).prop_map(|(c, r, cl, s, m)| ClientMessage::Sync {
+            correlation_id: c, room_id: r, client_id: cl, from_seq: s, max_batch_size: m
+        }),
+        (corr(), room_id(), client_id()).prop_map(|(c, r, cl)| ClientMessage::Heartbeat {
+            correlation_id: c, room_id: r, client_id: cl
+        }),
+        (corr(), room_id(), client_id(), ".{0,40}", proptest::option::of(seq()), proptest::option::of(any::<u128>()))
+            .prop_map(|(c, r, cl, t, s, k)| ClientMessage::RegisterClient {
+                correlation_id: c, room_id: r, client_id: cl, auth_token: t, current_seq: s, known_incarnation: k
+            }),
+        (corr(), room_id()).prop_map(|(c, r)| ClientMessage::GetSchema { correlation_id: c, room_id: r }),
+        (corr(), room_id(), client_id()).prop_map(|(c, r, cl)| ClientMessage::DeregisterClient {
+            correlation_id: c, room_id: r, client_id: cl
+        }),
+        (corr(), room_id(), any::<u32>(), any::<u32>(), proptest::option::of(any::<[u8; 32]>()))
+            .prop_map(|(c, r, i, s, h)| ClientMessage::RequestSnapshotChunk {
+                correlation_id: c, room_id: r, chunk_index: i, chunk_size: s, snapshot_hash: h
+            }),
+        (corr(), room_id(), seq(), any::<u32>(), any::<u32>(), any::<u64>(), any::<[u8; 32]>(), vec(any::<u8>(), 0..64))
+            .prop_map(|(c, r, s, i, t, b, h, d)| ClientMessage::UploadSnapshotChunk {
+                correlation_id: c, room_id: r, snapshot_head_seq: s, chunk_index: i, total_chunks: t,
+                total_bytes: b, snapshot_hash: h, data: Bytes::from(d)
+            }),
+    ]
+}
+
+fn error_code() -> impl Strategy<Value = ErrorCode> {
+    (0u32..21).prop_map(|i| {
+        let frame = [&[0x5A, 0x4D, 1, 0][..], &[i as u8]].concat();
+        decode_message::<ErrorCode>(&frame).unwrap()
+    })
+}
+
+fn server_message() -> impl Strategy<Value = ServerMessage> {
+    prop_oneof![
+        (corr(), room_id(), mid(), seq(), vec(seq_op(), 0..6), any::<bool>(), any::<bool>(), any::<u64>())
+            .prop_map(|(c, r, m, s, ops, h, w, v)| ServerMessage::CommitAck {
+                correlation_id: c, room_id: r, mutation_id: m, assigned_seq: s, catchup_ops: ops,
+                has_more: h, snapshot_wanted: w, schema_version: v
+            }),
+        (corr(), room_id(), seq(), seq()).prop_map(|(c, r, a, h)| ServerMessage::AckConfirmed {
+            correlation_id: c, room_id: r, ack_seq: a, head_seq: h
+        }),
+        (corr(), room_id(), seq(), vec(seq_op(), 0..6), any::<bool>(), any::<bool>(), any::<u64>())
+            .prop_map(|(c, r, hs, ops, h, w, v)| ServerMessage::SyncBatch {
+                correlation_id: c, room_id: r, head_seq: hs, ops, has_more: h, snapshot_wanted: w, schema_version: v
+            }),
+        (corr(), room_id(), seq(), any::<u32>(), any::<u32>(), any::<u64>(), any::<[u8; 32]>(), vec(any::<u8>(), 0..64))
+            .prop_map(|(c, r, s, i, t, b, h, d)| ServerMessage::SnapshotChunk {
+                correlation_id: c, room_id: r, snapshot_head_seq: s, chunk_index: i, total_chunks: t,
+                total_bytes: b, snapshot_hash: h, data: Bytes::from(d)
+            }),
+        (corr(), room_id(), any::<u32>(), any::<u32>(), any::<bool>()).prop_map(|(c, r, i, t, s)| {
+            ServerMessage::SnapshotUploadChunkAck { correlation_id: c, room_id: r, chunk_index: i, total_chunks: t, staged: s }
+        }),
+        (room_id(), seq(), any::<[u8; 32]>()).prop_map(|(r, s, h)| ServerMessage::SnapshotStaged {
+            room_id: r, snapshot_head_seq: s, snapshot_hash: h
+        }),
+        (corr(), room_id(), seq(), any::<bool>(), proptest::option::of(seq()), any::<u64>()).prop_map(
+            |(c, r, h, w, a, v)| ServerMessage::HeartbeatAck {
+                correlation_id: c, room_id: r, current_head_seq: h, snapshot_wanted: w, active_snapshot_seq: a, schema_version: v
+            }
+        ),
+        (corr(), room_id(), client_id()).prop_map(|(c, r, cl)| ServerMessage::DeregisterAck {
+            correlation_id: c, room_id: r, client_id: cl
+        }),
+        (corr(), room_id(), seq(), seq(), schema_id(), schema(), proptest::option::of(seq()), any::<u128>())
+            .prop_map(|(c, r, h, t, si, s, a, inc)| ServerMessage::Registered {
+                correlation_id: c, room_id: r, head_seq: h, tail_seq: t, schema_id: si, schema: s,
+                active_snapshot_seq: a, room_incarnation: inc
+            }),
+        (corr(), room_id(), schema_id(), schema()).prop_map(|(c, r, si, s)| ServerMessage::Schema {
+            correlation_id: c, room_id: r, schema_id: si, schema: s
+        }),
+        (proptest::option::of(corr()), proptest::option::of(room_id()), error_code(), ".{0,30}")
+            .prop_map(|(c, r, code, m)| ServerMessage::Error { correlation_id: c, room_id: r, code, message: m }),
+    ]
+}
+
+// ------------------------------------------------------------------------------------------
+// Properties
+// ------------------------------------------------------------------------------------------
+
+proptest! {
+    #![proptest_config(ProptestConfig { cases: cases(20_000), .. ProptestConfig::default() })]
+
+    #[test]
+    fn client_messages_round_trip(m in client_message()) {
+        let frame = encode_message(&m).unwrap();
+        prop_assert_eq!(frame.len() as u64, encoded_len(&m).unwrap() + 4);
+        let back = decode_client_message(&frame).unwrap();
+        prop_assert_eq!(&back, &m);
+        prop_assert_eq!(decode_message::<ClientMessage>(&frame).unwrap(), m.clone());
+        prop_assert_eq!(zemdb_core::peek_client_message_kind(&frame).unwrap(), m.kind());
+        // Same bytes again: encoding is a function of the value.
+        prop_assert_eq!(encode_message(&back).unwrap(), frame);
+    }
+
+    #[test]
+    fn server_messages_round_trip(m in server_message()) {
+        let frame = encode_message(&m).unwrap();
+        prop_assert_eq!(frame.len() as u64, encoded_len(&m).unwrap() + 4);
+        let back: ServerMessage = decode_message(&frame).unwrap();
+        prop_assert_eq!(&back, &m);
+        prop_assert_eq!(encode_message(&back).unwrap(), frame);
+    }
+
+    #[test]
+    fn wal_frames_round_trip(batches in vec((vec(seq_op(), 0..5), proptest::option::of(mid())), 1..5)) {
+        let mut log = Vec::new();
+        let mut all = Vec::new();
+        for (ops, m) in &batches {
+            let frame = encode_wal_batch(ops, *m).unwrap();
+            let header = parse_batch_header(frame[..BATCH_HEADER_SIZE].try_into().unwrap()).unwrap();
+            prop_assert_eq!(header.ops_count(), ops.len());
+            prop_assert_eq!(header.frame_len(), frame.len());
+            if ops.len() == 1 {
+                prop_assert_eq!(wal_record_payload_len(&ops[0], *m).unwrap() as usize, frame.len() - BATCH_HEADER_SIZE);
+            }
+            match decode_wal_batch_from_slice(&frame).unwrap() {
+                WalBatchDecodeResult::Ok { ops: back, mutation_id, bytes_consumed } => {
+                    prop_assert_eq!(&back, ops);
+                    prop_assert_eq!(mutation_id, *m);
+                    prop_assert_eq!(bytes_consumed, frame.len());
+                }
+                other => prop_assert!(false, "{other:?}"),
+            }
+            log.extend(frame);
+            all.extend(ops.iter().cloned());
+        }
+        let (ops, valid, torn) = replay_wal_records(&log).unwrap();
+        prop_assert_eq!(ops, all);
+        prop_assert_eq!(valid, log.len());
+        prop_assert!(torn.is_none());
+    }
+
+    #[test]
+    fn schemas_round_trip_in_json_and_binary(s in schema()) {
+        let json = serde_json::to_string(&s).unwrap();
+        let back: Schema = serde_json::from_str(&json).unwrap();
+        prop_assert_eq!(&back, &s);
+        prop_assert_eq!(back.version(), s.version());
+        let pretty = serde_json::to_string_pretty(&s).unwrap();
+        prop_assert_eq!(&serde_json::from_str::<Schema>(&pretty).unwrap(), &s);
+        let frame = encode_message(&s).unwrap();
+        prop_assert_eq!(decode_message::<Schema>(&frame).unwrap(), s);
+    }
+
+    #[test]
+    fn envelopes_round_trip(payload in vec(any::<u8>(), 0..4096), zstd in any::<bool>()) {
+        let env = encode_snapshot_envelope(&payload, zstd, 3).unwrap();
+        prop_assert_eq!(decode_snapshot_envelope(&env).unwrap(), payload.clone());
+        let header = SnapshotEnvelopeHeader::parse(&env).unwrap();
+        prop_assert_eq!(SnapshotEnvelopeHeader::parse(&header.to_bytes()).unwrap(), header);
+        prop_assert_eq!(header.compression() == SnapshotCompression::Zstd, zstd);
+    }
+}
+
+// ------------------------------------------------------------------------------------------
+// Snapshot state round trip (both engines, both directions)
+// ------------------------------------------------------------------------------------------
+
+fn state_schema() -> Schema {
+    let mut s = Schema::builder()
+        .table(
+            TableSchema::builder("items")
+                .table_id(3)
+                .primary_key("id", DataType::Int)
+                .column("name", DataType::String)
+                .nullable_column("price", DataType::Float),
+        )
+        .table(
+            TableSchema::builder("pairs")
+                .table_id(0)
+                .primary_key("a", DataType::Float)
+                .primary_key("b", DataType::Bytes)
+                .nullable_column("u", DataType::Uuid),
+        )
+        .build();
+    s.add_column("items", ColumnDef::new("blob", DataType::Bytes).nullable(true)).unwrap();
+    s
+}
+
+fn state_op() -> impl Strategy<Value = Operation> {
+    let opt = |s: BoxedStrategy<Value>| prop_oneof![Just(Value::Null), s];
+    let item_key = 0i64..20;
+    let items = prop_oneof![
+        (item_key.clone(), ".{0,6}", opt(float().prop_map(Value::Float).boxed()), opt(vec(any::<u8>(), 0..6).prop_map(|b| Value::Bytes(b.into())).boxed()), any::<bool>())
+            .prop_map(|(k, n, p, b, short)| {
+                let mut v = vec![Value::Int(k), Value::String(n.into()), p, b];
+                if short { v.truncate(3) }
+                Operation::insert(3, PrimaryKey::single(k), CompactRow::new(v), 1)
+            }),
+        (item_key.clone(), opt(float().prop_map(Value::Float).boxed()))
+            .prop_map(|(k, p)| Operation::update(3, PrimaryKey::single(k), vec![ColumnUpdate::new(2, p)], 1)),
+        (item_key.clone(), vec(any::<u8>(), 0..4))
+            .prop_map(|(k, b)| Operation::update(3, PrimaryKey::single(k), vec![ColumnUpdate::new(3, Value::Bytes(b.into()))], 1)),
+        item_key.prop_map(|k| Operation::delete(3, PrimaryKey::single(k), 1)),
+    ];
+    let pair_key = (prop_oneof![Just(0.0f64), Just(-0.0f64), Just(f64::NAN), Just(1.5), Just(-2.0)], vec(any::<u8>(), 0..3));
+    let pairs = prop_oneof![
+        (pair_key.clone(), opt(any::<[u8; 16]>().prop_map(Value::Uuid).boxed())).prop_map(|((a, b), u)| {
+            let key = PrimaryKey::composite([Value::Float(a), Value::Bytes(b.clone().into())]);
+            Operation::insert(0, key, CompactRow::new(vec![Value::Float(a), Value::Bytes(b.into()), u]), 1)
+        }),
+        pair_key.prop_map(|(a, b)| Operation::delete(0, PrimaryKey::composite([Value::Float(a), Value::Bytes(b.into())]), 1)),
+    ];
+    prop_oneof![items, pairs]
+}
+
+async fn dump<E: StorageEngine>(e: &E, room: &RoomId) -> Vec<(u16, Vec<(PrimaryKey, CompactRow)>)> {
+    use futures::StreamExt;
+    let mut out = vec![];
+    for t in [0u16, 3] {
+        let mut s = e.scan_by_id(room, t, ScanOptions::default()).await.unwrap();
+        let mut rows = vec![];
+        while let Some(r) = s.next().await {
+            rows.push(r.unwrap());
+        }
+        out.push((t, rows));
+    }
+    out
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig { cases: cases(20_000) / 40, .. ProptestConfig::default() })]
+
+    #[test]
+    fn snapshots_round_trip_between_engines(ops in vec(state_op(), 1..40)) {
+        let rt = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+        rt.block_on(async {
+            let schema = state_schema();
+            let room = RoomId::new("r").unwrap();
+            let seqd: Vec<_> = ops.into_iter().enumerate().map(|(i, op)| SequencedOperation::new(i as u64 + 1, op)).collect();
+            let head = SequenceNumber::new(seqd.len() as u64);
+
+            let mem = MemoryStorageEngine::new();
+            mem.open_room(&room, schema.clone()).await.unwrap();
+            mem.apply_batch(&room, seqd.clone()).await.unwrap();
+            let expected = dump(&mem, &room).await;
+
+            let dir = tempfile::tempdir().unwrap();
+            let disk = DiskStorageEngine::new(DiskStorageOptions::new(dir.path())).unwrap();
+            disk.open_room(&room, schema.clone()).await.unwrap();
+            disk.apply_batch(&room, seqd.clone()).await.unwrap();
+            assert_eq!(dump(&disk, &room).await, expected, "engines disagree after the same log");
+
+            for snap in [mem.create_snapshot(&room).await.unwrap(), disk.create_snapshot(&room).await.unwrap()] {
+                let m2 = MemoryStorageEngine::new();
+                m2.open_room(&room, schema.clone()).await.unwrap();
+                assert_eq!(m2.apply_snapshot(&room, schema.clone(), Bytes::from(snap.clone()), head).await.unwrap(), head);
+                assert_eq!(dump(&m2, &room).await, expected);
+
+                let d2dir = tempfile::tempdir().unwrap();
+                let d2 = DiskStorageEngine::new(DiskStorageOptions::new(d2dir.path())).unwrap();
+                d2.open_room(&room, schema.clone()).await.unwrap();
+                assert_eq!(d2.apply_snapshot(&room, schema.clone(), Bytes::from(snap), head).await.unwrap(), head);
+                assert_eq!(dump(&d2, &room).await, expected);
+                // And through the engine's own file: compact, close, reopen.
+                d2.compact_room(&room).await.unwrap();
+                d2.close_room(&room).await.unwrap();
+                d2.open_room(&room, schema.clone()).await.unwrap();
+                assert_eq!(dump(&d2, &room).await, expected, "disk file round trip");
+            }
+            // The disk WAL alone: close and reopen without compaction.
+            disk.close_room(&room).await.unwrap();
+            disk.open_room(&room, schema.clone()).await.unwrap();
+            assert_eq!(dump(&disk, &room).await, expected, "WAL replay round trip");
+        });
+    }
+}
