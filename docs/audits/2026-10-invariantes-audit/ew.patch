index 8877bf5..5585c3d 100644
--- a/crates/server/src/log/tests/segment_index.rs
+++ b/crates/server/src/log/tests/segment_index.rs
@@ -68,3 +68,66 @@ fn total_bytes_follow_inserts_replacements_and_removals() {
     assert_eq!(index.total_bytes(), 0);
     assert!(index.remove(seq(1)).is_none());
 }
+
+/// AUDIT INV-W1/INV-W2: the sidecar codec round-trips, a sidecar of another segment is
+/// rejected, and no damaged sidecar panics; every single-bit flip is detected.
+#[test]
+fn audit_sidecar_round_trips_and_never_panics() {
+    let mut state = 0x1234_5678u64;
+    let mut next = move || {
+        state = state.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = state;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    };
+    let iters: u64 = std::env::var("FUZZ_ITERS")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(2_000_000);
+    let (mut flips, mut flips_accepted, mut other_accepted) = (0u64, 0u64, 0u64);
+    for _ in 0..iters {
+        let start = if next() % 8 == 0 { next() } else { next() % 10_000 };
+        let n = (next() % 10) as usize;
+        let end = start.saturating_add(n as u64);
+        let ids: Vec<(MutationId, SequenceNumber)> = (0..n)
+            .map(|k| {
+                let id = u128::from(next()) | (u128::from(next()) << 64);
+                (MutationId::from_u128(id), seq(start.wrapping_add(k as u64)))
+            })
+            .collect();
+        let bytes = encode_mutation_ids(seq(start), seq(end), &ids);
+        assert_eq!(bytes.len(), 16 + 24 * n + 4);
+        assert_eq!(decode_mutation_ids(&bytes, seq(start), seq(end)), Some(ids.clone()));
+        assert_eq!(decode_mutation_ids(&bytes, seq(start ^ 1), seq(end)), None);
+        assert_eq!(decode_mutation_ids(&bytes, seq(start), seq(end ^ 1)), None);
+
+        let mut m = bytes.clone();
+        let kind = next() % 5;
+        match kind {
+            0 => {
+                let i = (next() as usize) % m.len();
+                m[i] ^= 1 << (next() % 8);
+            }
+            1 => m.truncate((next() as usize) % m.len()),
+            2 => m.extend((0..1 + next() % 30).map(|_| next() as u8)),
+            3 => {
+                let i = (next() as usize) % m.len();
+                m[i] = next() as u8;
+            }
+            _ => m = (0..(next() % 80)).map(|_| next() as u8).collect(),
+        }
+        let decoded = std::panic::catch_unwind(|| decode_mutation_ids(&m, seq(start), seq(end)))
+            .unwrap_or_else(|_| panic!("decode_mutation_ids panicked on {m:02x?}"));
+        if kind == 0 {
+            flips += 1;
+            flips_accepted += u64::from(decoded.is_some());
+        } else if m != bytes && decoded.is_some() {
+            other_accepted += 1;
+        }
+    }
+    eprintln!(
+        "[sidecar] iters={iters} single-bit flips={flips} accepted={flips_accepted} other damaged accepted={other_accepted}"
+    );
+    assert_eq!(flips_accepted, 0);
+}
