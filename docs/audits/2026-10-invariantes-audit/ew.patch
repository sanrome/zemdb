+        if at + 18 + len <= data.len() {
+            let crc = crc32fast::hash(&data[at + 18..at + 18 + len]);
+            data[at + 6..at + 10].copy_from_slice(&crc.to_le_bytes());
+        }
+        let h = crc32fast::hash(&data[at..at + 14]);
+        data[at + 14..at + 18].copy_from_slice(&h.to_le_bytes());
+    };
+    let mut outcomes = [0u64; 3];
+    for i in 0..iters {
+        let mut data = log.clone();
+        for _ in 0..1 + next() % 3 {
+            if data.is_empty() {
+                break;
+            }
+            let p = (next() as usize) % data.len();
+            match next() % 5 {
