+//! Hand-crafted worst cases for INV-W1, measured with the counting allocator.
+
+mod common;
+
+use common::*;
+use zemdb_core::mutation::Operation;
+use zemdb_core::value::{CompactRow, PrimaryKey, Value};
+use zemdb_core::{
+    decode_client_message, decode_message, encode_message, ClientId, ClientMessage, CorrelationId,
+    DecodeError, MutationId, SequenceNumber, SequencedOperation, ServerMessage, MAX_FRAME_SIZE,
+};
+
+fn report(name: &str, input: usize, peak: usize, single: usize, ok: bool) {
+    eprintln!(
+        "[{name}] input={input}B ok={ok} peak={peak}B ({:.1}x) max_single={single}B",
+        peak as f64 / input as f64
+    );
+}
+
+#[test]
+fn widest_commit_the_server_accepts() {
+    let pk = PrimaryKey::composite(vec![Value::Null; 65_535]);
+    let op = Operation::insert(0, pk, CompactRow::new(vec![Value::Null; 65_535]), 0);
+    let msg = ClientMessage::Commit {
+        correlation_id: CorrelationId::new(1),
+        room_id: room(),
+        client_id: ClientId::new("c").unwrap(),
+        mutation_id: MutationId::from_u128(1),
+        last_ack_seq: SequenceNumber::new(0),
+        op,
+    };
+    let frame = encode_message(&msg).unwrap();
+    let (r, peak, single) = measure(|| decode_client_message(&frame));
+    report("commit 2x65535 nulls", frame.len(), peak, single, r.is_ok());
+    assert!(r.is_ok());
+    assert!(peak < 4 << 20);
+}
+
+#[test]
+fn row_over_the_column_limit_is_rejected_before_decoding() {
+    let op = Operation::insert(0, PrimaryKey::single(1i64), CompactRow::new(vec![Value::Null; 65_536]), 0);
+    let msg = ClientMessage::Commit {
+        correlation_id: CorrelationId::new(1),
+        room_id: room(),
+        client_id: ClientId::new("c").unwrap(),
+        mutation_id: MutationId::from_u128(1),
+        last_ack_seq: SequenceNumber::new(0),
+        op,
+    };
+    let frame = encode_message(&msg).unwrap();
+    let (r, peak, single) = measure(|| decode_client_message(&frame));
+    report("row of 65536 nulls", frame.len(), peak, single, r.is_ok());
+    assert!(matches!(r, Err(DecodeError::Malformed(_))));
+}
+
+#[test]
+fn largest_sync_batch_of_tiny_operations_decoded_by_a_client() {
+    // As many single-null-key deletes as fit in one frame: the documented unbudgeted path.
+    let one = SequencedOperation::new(1u64, Operation::delete(0, PrimaryKey::single(Value::Null), 0));
+    let per = zemdb_core::protocol::encoded_len(&one).unwrap() as usize;
+    let n = (MAX_FRAME_SIZE - 64) / per;
+    let msg = ServerMessage::SyncBatch {
+        correlation_id: CorrelationId::new(1),
+        room_id: room(),
+        head_seq: SequenceNumber::new(1),
+        ops: vec![one; n],
+        has_more: false,
+        snapshot_wanted: false,
+        schema_version: 1,
+    };
+    let frame = encode_message(&msg).unwrap();
+    let (r, peak, single) = measure(|| decode_message::<ServerMessage>(&frame).map(|_| ()));
+    report("SyncBatch of tiny ops", frame.len(), peak, single, r.is_ok());
+    assert!(r.is_ok());
+}
+
+#[test]
+fn declared_lengths_far_beyond_the_frame() {
+    // Commit whose row declares u64::MAX values, and SyncBatch declaring u64::MAX ops.
+    let mut commit = vec![0x5A, 0x4D, 1, 0, 0, 1, 6];
+    commit.extend_from_slice(b"room-1");
+    commit.extend_from_slice(&[1, b'c']);
+    commit.extend_from_slice(&[0u8; 16]);
+    commit.extend_from_slice(&[0, 0, 0, 0, 0]); // last_ack, table, ts, pk len, kind Insert
+    commit.push(0xFD);
+    commit.extend_from_slice(&u64::MAX.to_le_bytes());
+    let (r, peak, single) = measure(|| decode_client_message(&commit));
+    report("row declaring u64::MAX values", commit.len(), peak, single, r.is_ok());
+    assert!(r.is_err());
+
+    let mut sync = vec![0x5A, 0x4D, 1, 0, 2, 1, 6];
+    sync.extend_from_slice(b"room-1");
+    sync.push(1);
+    sync.push(0xFD);
+    sync.extend_from_slice(&u64::MAX.to_le_bytes());
+    let (r, peak, single) = measure(|| decode_message::<ServerMessage>(&sync).map(|_| ()));
+    report("SyncBatch declaring u64::MAX ops", sync.len(), peak, single, r.is_ok());
+    assert!(r.is_err());
+    assert!(single <= 1 << 20);
+}
+
+#[test]
+fn unknown_fields_inside_a_column_are_ignored() {
+    use zemdb_core::schema::Schema;
+    let json = r#"{"version":1,"tables":[{"table_id":0,"name":"t","primary_key":["id"],
+        "columns":[{"name":"id","data_type":"Int","nullable":false,"encrypted":false,"primary_key":true,"default":7}]}]}"#;
+    let parsed = serde_json::from_str::<Schema>(json);
+    eprintln!("[column unknown fields] accepted: {}", parsed.is_ok());
+    let at_table = r#"{"version":1,"tables":[{"table_id":0,"name":"t","primary_key":["id"],"extra":1,
+        "columns":[{"name":"id","data_type":"Int","nullable":false,"encrypted":false}]}]}"#;
+    eprintln!("[table unknown fields] accepted: {}", serde_json::from_str::<Schema>(at_table).is_ok());
+    let dup_pk = r#"{"version":1,"tables":[{"table_id":0,"name":"t","primary_key":["id","id"],
+        "columns":[{"name":"id","data_type":"Int","nullable":false,"encrypted":false}]}]}"#;
+    eprintln!("[repeated primary key column] accepted: {}", serde_json::from_str::<Schema>(dup_pk).is_ok());
+    let dup_key = r#"{"version":1,"version":5,"tables":[]}"#;
+    eprintln!("[repeated JSON key] accepted: {:?}", serde_json::from_str::<Schema>(dup_key).map(|s| s.version()));
+}
+
+#[test]
+fn apply_snapshot_memory_per_payload_byte() {
+    use bytes::Bytes;
+    use zemdb_core::schema::{Schema, TableBuilder};
+    use zemdb_core::value::DataType;
+    use zemdb_core::RoomId;
+    use zemdb_storage::{MemoryStorageEngine, StorageEngine};
+    let schema = Schema::builder()
+        .table(TableBuilder::new("t").table_id(0).primary_key("id", DataType::Int))
+        .build();
+    let rt = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+    let room = RoomId::new("big").unwrap();
+    let n = 300_000u64;
+    let snap = rt.block_on(async {
+        let src = MemoryStorageEngine::new();
+        src.open_room(&room, schema.clone()).await.unwrap();
+        let ops: Vec<_> = (1..=n)
+            .map(|k| SequencedOperation::new(k, Operation::insert(0, PrimaryKey::single(k as i64), CompactRow::new(vec![Value::Int(k as i64)]), 0)))
+            .collect();
+        src.apply_batch(&room, ops).await.unwrap();
+        src.create_snapshot(&room).await.unwrap()
+    });
+    let compressed = zstd::encode_all(&snap[14..], 19).unwrap();
+    let dst = MemoryStorageEngine::new();
+    rt.block_on(dst.open_room(&room, schema.clone())).unwrap();
+    let len = snap.len();
+    let (r, peak, single) = measure(|| rt.block_on(dst.apply_snapshot(&room, schema.clone(), Bytes::from(snap), SequenceNumber::new(n))));
+    assert!(r.is_ok());
+    eprintln!(
+        "[apply_snapshot {n} rows] raw payload={len}B zstd19={}B peak={peak}B ({:.2}x raw, {:.1}x zstd) max_single={single}B",
+        compressed.len(),
+        peak as f64 / len as f64,
+        peak as f64 / compressed.len() as f64
+    );
+}
diff --git a/crates/fuzzw/tests/fuzz_decoders.rs b/crates/fuzzw/tests/fuzz_decoders.rs
