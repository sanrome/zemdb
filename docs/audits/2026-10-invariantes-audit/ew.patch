+        },
+        ClientMessage::Heartbeat {
+            correlation_id: CorrelationId::new(1),
+            room_id: room(),
+            client_id: cid.clone(),
+        },
+        ClientMessage::RegisterClient {
+            correlation_id: CorrelationId::new(1),
+            room_id: room(),
+            client_id: cid.clone(),
+            auth_token: "v1.abc.def.123.ff".into(),
+            current_seq: Some(SequenceNumber::new(5)),
