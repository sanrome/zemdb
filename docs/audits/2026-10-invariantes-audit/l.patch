+/// Audit §3.7, INV-L2. Runs a `DELETE /admin/rooms/doomed` over TCP whose client disconnects
+/// while the relay purges the room's snapshot. With `shutdown`, an orderly shutdown follows
+/// right away and `main` returns (the runtime is dropped); without it, the server keeps running
+/// until the room directory is gone. Returns, at the next start, whether the room exists and
+/// its active snapshot.
+fn audit_l2_dropped_delete(shutdown: bool) -> (bool, Option<zemdb_core::id::SequenceNumber>) {
+    use crate::api::serve::{serve_until_shutdown, SHUTDOWN_GRACE_PERIOD};
+    use crate::relay::LogBounds;
+    use tokio::io::AsyncWriteExt;
+    use zemdb_core::id::SequenceNumber;
+    use zemdb_core::protocol::snapshot_envelope::{SnapshotCompression, SnapshotEnvelopeHeader};
+
+    let dir = tempdir().unwrap();
+    let snapshots = dir.path().join("snapshots");
+    let room_dir = dir.path().join("rooms").join("doomed");
+    let room_id = RoomId::new("doomed").unwrap();
+    let (resume_tx, resume_rx) = std::sync::mpsc::channel::<()>();
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .enable_all()
+        .build()
+        .unwrap();
+
+    let resume_tx = runtime.block_on(async {
+        let state = TestState::new(dir.path(), |config| {
+            config.admin_secret = ADMIN_SECRET.to_string();
+        });
+        let schema_id = SchemaId::new("todo").unwrap();
+        state
+            .registry
+            .register_schema(
+                schema_id.clone(),
+                Schema::builder()
+                    .table(TableSchema::builder("tasks").primary_key("id", DataType::Int))
+                    .build(),
+            )
+            .unwrap();
+        state
+            .manager
+            .create_room(room_id.clone(), schema_id, None)
+            .await
+            .unwrap();
+        // The room has a staged snapshot.
+        let body = vec![7u8; 1024];
+        let header =
+            SnapshotEnvelopeHeader::for_body(SnapshotCompression::Raw, body.len() as u32, &body);
+        let mut envelope = header.to_bytes().to_vec();
+        envelope.extend_from_slice(&body);
+        let bounds = LogBounds {
+            tail_seq: SequenceNumber::new(1),
+            head_seq: SequenceNumber::new(1),
+        };
+        state
+            .relay
+            .stage_snapshot(
+                &room_id,
+                SequenceNumber::new(1),
+                bytes::Bytes::from(envelope),
+                std::future::ready(Ok(bounds)),
+            )
+            .await
+            .unwrap();
+        assert_eq!(
+            state.relay.active_snapshot_seq(&room_id),
+            Some(SequenceNumber::new(1))
+        );
+
+        // The deletion stops while the relay purges the room's snapshot files.
+        let (reached_tx, reached_rx) = tokio::sync::oneshot::channel();
+        fail_point::arm_hook("relay_purge_room_files", &snapshots, move || {
+            let _ = reached_tx.send(());
+            let _ = resume_rx.recv();
+        });
+
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let (stop_tx, stop_rx) = tokio::sync::oneshot::channel::<()>();
+        let server = tokio::spawn(serve_until_shutdown(
+            listener,
+            state.app_state(),
+            async move {
+                let _ = stop_rx.await;
+            },
+            SHUTDOWN_GRACE_PERIOD,
+        ));
+
+        // The admin sends the DELETE and goes away while the purge runs.
+        let mut stream = tokio::net::TcpStream::connect(addr).await.unwrap();
+        let request = format!(
+            "DELETE /admin/rooms/doomed HTTP/1.1\r\nHost: zemdb\r\nAuthorization: Bearer \
+             {ADMIN_SECRET}\r\nContent-Length: 0\r\n\r\n"
+        );
+        stream.write_all(request.as_bytes()).await.unwrap();
+        tokio::time::timeout(Duration::from_secs(10), reached_rx)
+            .await
+            .expect("the purge was not reached")
+            .unwrap();
+        drop(stream);
+
+        if !shutdown {
+            // Control: the detached deletion finishes on its own.
+            resume_tx.send(()).unwrap();
+            let deadline = tokio::time::Instant::now() + Duration::from_secs(10);
+            while room_dir.exists() && tokio::time::Instant::now() < deadline {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        }
+        // Orderly shutdown (SIGTERM): it does not wait for the detached deletion.
+        stop_tx.send(()).unwrap();
+        tokio::time::timeout(Duration::from_secs(5), server)
+            .await
+            .expect("serve_until_shutdown waited for the deletion")
+            .unwrap()
+            .expect("orderly shutdown");
+        resume_tx
+    });
+
+    // `main` returns and the runtime is dropped: tasks are cancelled at their next poll and
+    // blocking work is waited for. The parked purge resumes shortly after the drop starts.
+    std::thread::spawn(move || {
+        std::thread::sleep(Duration::from_millis(300));
+        let _ = resume_tx.send(());
+    });
+    drop(runtime);
+
+    // Next start.
+    let restarted = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    restarted.block_on(async {
+        let state = TestState::new(dir.path(), |_| {});
+        (
+            state.manager.room_exists(&room_id).unwrap(),
+            state.relay.active_snapshot_seq(&room_id),
+        )
+    })
+}
+
+/// Control: without a shutdown, the deletion whose client went away completes.
+#[test]
+fn audit_l2_dropped_room_deletion_completes_without_a_shutdown() {
+    let (exists, snapshot) = audit_l2_dropped_delete(false);
+    assert!(!exists && snapshot.is_none(), "exists={exists} snapshot={snapshot:?}");
+}
+
+/// Fails on `50fe195`: an orderly shutdown cuts the detached deletion between purging the
+/// room's snapshot and removing its directory.
+#[test]
+fn audit_l2_dropped_room_deletion_is_cut_halfway_by_an_orderly_shutdown() {
+    let (exists, snapshot) = audit_l2_dropped_delete(true);
+    assert!(
+        !exists || snapshot.is_some(),
+        "INV-L2: the dropped DELETE was cut halfway by the orderly shutdown: the room still \
+         exists ({exists}) but its staged snapshot is gone ({snapshot:?})"
+    );
+}
