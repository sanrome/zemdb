+/// Audit §3.7, INV-L3 (fails on `50fe195`): syncing the parent of a new data directory fails, so
+/// `open_room` fails; the next `open_room` finds the directory already there and never syncs its
+/// entry again, yet acknowledges batches stored under it.
+#[tokio::test]
+async fn audit_l3_data_directory_whose_sync_failed_is_never_synced_again() {
+    let dir = tempfile::tempdir().unwrap();
+    let engine = engine_at(&dir.path().join("data"));
+    let room = RoomId::new("audit-data-dir").unwrap();
+    fail_point::arm("sync_dir", dir.path());
+    assert!(engine.open_room(&room, schema()).await.is_err());
+
+    // Armed again: any later sync of the data directory's parent consumes it.
+    fail_point::arm("sync_dir", dir.path());
+    engine.open_room(&room, schema()).await.unwrap();
+    engine.apply_batch(&room, vec![insert(1)]).await.unwrap();
+    assert!(
+        !fail_point::is_armed("sync_dir", dir.path()),
+        "INV-L3: apply_batch acknowledged seq 1 under a data directory whose entry was never \
+         synced after its sync failed; a power loss can drop the whole directory"
+    );
+}
