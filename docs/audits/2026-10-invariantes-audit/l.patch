+// ---------------------------------------------------------------------------------------------
+// Audit §3.7, INV-L2: the operation is polled by hand and dropped after its k-th suspension,
+// for every k until it completes. After each drop the room must be either untouched or fully
+// changed, or marked failed; if it still takes writes, memory and disk must agree.
+// ---------------------------------------------------------------------------------------------
+
+/// Polls `fut`, letting the runtime (and the blocking pool) run between polls, and drops it
+/// after it has returned `Pending` `suspensions` times. Returns whether it completed first.
+async fn audit_poll_then_drop<F: std::future::Future>(fut: F, suspensions: usize) -> bool {
+    let mut fut = std::pin::pin!(fut);
+    let mut seen = 0;
+    loop {
+        let ready =
+            std::future::poll_fn(|cx| std::task::Poll::Ready(fut.as_mut().poll(cx).is_ready()))
+                .await;
+        if ready {
+            return true;
+        }
+        if seen == suspensions {
+            return false;
+        }
+        seen += 1;
+        tokio::time::sleep(Duration::from_millis(2)).await;
+    }
+}
+
+/// After dropping an operation that would have moved `room` from the rows of `old_keys` to the
+/// rows of `new_keys`: the room is consistent with one of them, in memory and after a reopen.
+async fn audit_check_after_drop(
+    engine: DiskStorageEngine,
+    dir: &std::path::Path,
+    room: &RoomId,
+    k: usize,
+    old: (u64, std::ops::RangeInclusive<i64>),
+    new: (u64, std::ops::RangeInclusive<i64>),
+) {
+    // Blocking work handed off before the drop lands.
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    let memory_head = engine.get_head_seq(room).await.unwrap().get();
+    let extra = 9_000 + k as i64;
+    let files: Vec<String> = std::fs::read_dir(dir)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    let snap_head = std::fs::read(dir.join(format!("room_{room}.snap")))
+        .ok()
+        .and_then(|b| crate::disk::format::FileHeader::decode(b[..64].try_into().unwrap()).ok())
+        .map(|h| h.head_seq);
+    eprintln!("k={k}: before reopen files={files:?} snap_head={snap_head:?}");
+    let usable = engine
+        .apply_batch(room, vec![insert_key(memory_head + 1, extra)])
+        .await
+        .is_ok();
+    let reopened = reopen(engine, dir, room).await;
+    let head = reopened.get_head_seq(room).await.unwrap().get();
+    let base = if usable { head - 1 } else { head };
+    eprintln!("k={k}: memory_head={memory_head} usable={usable} reopened_head={head}");
+    if usable {
+        assert_eq!(head, memory_head + 1, "k={k}: memory and disk disagree after the drop");
+        assert!(has_key(&reopened, room, extra).await, "k={k}: acknowledged write lost");
+    }
+    let keys = if base == old.0 {
+        old.1
+    } else {
+        assert_eq!(base, new.0, "k={k}: head {base} is neither the old nor the new state");
+        new.1
+    };
+    for key in keys {
+        assert!(has_key(&reopened, room, key).await, "k={k}: row {key} missing at head {base}");
+    }
+}
