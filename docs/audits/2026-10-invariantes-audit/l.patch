+/// Audit §3.7, INV-L3 (fails on `50fe195`): the sync that makes a new room's directory entry
+/// durable fails; a retried creation finds the directory already there and never syncs its
+/// parent again, yet answers 201 and the room acknowledges commits.
+#[tokio::test]
+async fn audit_l3_room_directory_whose_sync_failed_is_never_synced_again() {
+    let dir = tempdir().unwrap();
+    let manager = new_manager(&dir);
+    let room_id = RoomId::new("room-l3").unwrap();
+    let rooms_dir = dir.path().join("rooms");
+
+    fail_point::arm("sync_dir", &rooms_dir);
+    let failed = manager
+        .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+        .await;
