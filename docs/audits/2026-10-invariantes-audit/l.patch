+/// Audit §3.7, INV-L2 (fails on `50fe195`; needs the two `audit.*` pause points added to this
+/// copy). `apply_snapshot` is dropped while its rename waits on the blocking pool: the room is
+/// marked failed and, as `RoomFailed` asks, closed and reopened. Nothing keeps the reopen from
+/// running before that rename: here it lands after the reopen loaded the previous snapshot, so
+/// the reopened room serves (and acknowledges writes on) a state its files no longer hold.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn audit_l2_rename_of_a_dropped_apply_snapshot_lands_in_the_reopened_room() {
+    let dir = tempfile::tempdir().unwrap();
+    let room = RoomId::new("audit-late-rename").unwrap();
+    let engine = open_engine(dir.path(), &room).await;
+    let wal_path = engine.wal_file_path(&room);
+    apply_range(&engine, &room, 1..=3).await;
+    let snapshot = snapshot_with_rows(&room, 101, 5).await;
+
+    let mut rename =
+        fail_point::arm_blocking_pause("audit.apply_snapshot.rename_blocking", &wal_path);
+    {
+        let apply =
+            engine.apply_snapshot(&room, schema(), snapshot.into(), SequenceNumber::from(5u64));
+        let mut apply = std::pin::pin!(apply);
+        tokio::select! {
+            _ = &mut apply => panic!("apply_snapshot finished"),
+            _ = rename.reached() => {}
+        }
+    } // The caller gives up: the future is dropped while the rename is in flight.
+    assert_room_failed(&engine, &room, 4).await;
+    engine.close_room(&room).await.unwrap();
+
+    let mut loaded = fail_point::arm_pause("audit.recovery.snapshot_loaded", &wal_path);
+    let reopened = engine_at(dir.path());
+    let open = tokio::spawn({
+        let (engine, room) = (reopened.clone(), room.clone());
+        async move { engine.open_room(&room, schema()).await }
+    });
+    loaded.reached().await; // The reopen has loaded the previous snapshot...
+    rename.release(); // ...when the late rename lands.
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(5);
+    while !staged_snapshot_files(dir.path()).is_empty() {
+        assert!(tokio::time::Instant::now() < deadline, "rename did not land");
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    loaded.release();
+    open.await.unwrap().unwrap();
+
+    assert_eq!(reopened.get_head_seq(&room).await.unwrap().get(), 3);
+    reopened.apply_batch(&room, vec![insert(4)]).await.unwrap();
+    reopened.apply_batch(&room, vec![insert(5)]).await.unwrap();
+
+    let again = reopen(reopened, dir.path(), &room).await;
+    let head = again.get_head_seq(&room).await.unwrap().get();
+    let (has4, has5) = (has_key(&again, &room, 4).await, has_key(&again, &room, 5).await);
+    assert!(
+        has4 && has5,
+        "INV-L2: batches 4 and 5, acknowledged by the reopened room, are gone after the next \
+         reopen (head {head}, row 4: {has4}, row 5: {has5}): the abandoned apply_snapshot's \
+         rename replaced the snapshot under the reopened room"
+    );
+}
