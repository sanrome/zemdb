index 0fa24bd..320f95b 100644
--- a/crates/server/src/api/tests/control_plane.rs
+++ b/crates/server/src/api/tests/control_plane.rs
@@ -151,3 +151,161 @@ async fn room_deletion_finishes_when_the_request_is_dropped() {
     assert!(!room_dir.exists());
