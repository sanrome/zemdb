+// ---------------------------------------------------------------------------------------------
+// Audit §3.7 (INV-L3, INV-L4). These tests assert the invariant and fail on `50fe195`.
+// ---------------------------------------------------------------------------------------------
+
+/// INV-L3: a record whose `sync_data` failed is read back from the page cache when the room
+/// reopens, and a retry of it is acknowledged, without any successful sync of `active.wal` in
+/// between. A power loss may then drop everything after the last successful sync.
+#[tokio::test]
+async fn audit_l3_retry_after_a_failed_sync_is_acknowledged_without_any_successful_sync() {
+    let fx = Fixture::new(RoomLifecycleOverrides::default()).await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+    let active = fx.room_dir().join("segments").join("active.wal");
+
+    // Record 1 is durable (sync_data succeeded).
+    commit(&sender, &client, mutation(1), seq(0), insert_op(1))
+        .await
+        .unwrap();
+    let last_synced_len = fs::metadata(&active).unwrap().len();
+
+    // Record 2 reaches the file, but its sync_data fails: the room stops.
+    fail_point::arm("warm_append_sync", &active);
+    let failed = commit(&sender, &client, mutation(2), seq(1), insert_op(2)).await;
+    assert!(matches!(failed, Err(ServerError::Unavailable(_))), "{failed:?}");
+
+    // The reopened room reads record 2 back (page cache) and acknowledges the retry.
+    let recovered = fx.sender().await;
+    let retry = commit(&recovered, &client, mutation(2), seq(1), insert_op(2))
+        .await
+        .unwrap();
+    assert_eq!(retry.assigned_seq, seq(2), "CommitAck sent for mutation 2 at seq 2");
+
+    // Neither the reopen nor the deduplicated retry synced active.wal, so a power loss now can
+    // leave it at its last synced length.
+    fx.manager.shutdown_all().await;
+    let file = fs::OpenOptions::new().write(true).open(&active).unwrap();
+    file.set_len(last_synced_len).unwrap();
+    drop(file);
+
+    let reopened = fx.sender().await;
+    let other = commit(&reopened, &client, mutation(3), seq(1), insert_op(3))
+        .await
+        .unwrap();
+    assert_ne!(
+        other.assigned_seq,
+        seq(2),
+        "INV-L3: seq 2 was acknowledged for mutation 2 although no sync of it ever succeeded; \
+         after a power loss the mutation is gone and seq 2 is assigned to mutation 3"
+    );
+    fx.manager.shutdown_all().await;
+}
+
+/// INV-L3: the directory sync that makes a new `active.wal` durable fails; the reopened room
+/// finds the file already there and never syncs its directory entry again, yet acknowledges
+/// commits stored in it.
+#[tokio::test]
+async fn audit_l3_active_wal_whose_directory_sync_failed_is_never_synced_again() {
+    let fx = Fixture::new(RoomLifecycleOverrides::default()).await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+    let segments = fx.room_dir().join("segments");
+
+    // The first commit creates active.wal; making its directory entry durable fails.
+    fail_point::arm("sync_dir", &segments);
+    let failed = commit(&sender, &client, mutation(1), seq(0), insert_op(1)).await;
+    assert!(matches!(failed, Err(ServerError::Unavailable(_))), "{failed:?}");
+    assert!(segments.join("active.wal").exists());
+
+    // Armed again: any later sync of the segments directory consumes it.
+    fail_point::arm("sync_dir", &segments);
+    let recovered = fx.sender().await;
+    for (n, last_ack) in [(1u8, 0u64), (2, 1)] {
+        let ack = commit(&recovered, &client, mutation(n), seq(last_ack), insert_op(n.into()))
+            .await
+            .unwrap();
+        assert_eq!(ack.assigned_seq, seq(n.into()));
+    }
+    // Still armed means no sync of the segments directory ran; checking also disarms it.
+    let never_synced = fail_point::check("sync_dir", &segments).is_err();
+    fx.manager.shutdown_all().await;
+
+    // A power loss may drop the directory entry no sync ever covered.
+    let mut reused = None;
+    if never_synced {
+        fs::remove_file(segments.join("active.wal")).unwrap();
+        let reopened = fx.sender().await;
+        reused = Some(
+            commit(&reopened, &client, mutation(9), seq(0), insert_op(9))
+                .await
+                .unwrap()
+                .assigned_seq,
+        );
+        fx.manager.shutdown_all().await;
+    }
+    assert!(
+        !never_synced,
+        "INV-L3: CommitAcks for seqs 1 and 2 were sent while the directory entry of active.wal \
+         had never been synced (its sync failed and nothing retried it); after a power loss \
+         that drops the entry, the next commit gets seq {reused:?}"
+    );
+}
+
+/// INV-L4: a key in the deduplication window before a reopen is not in it after the reopen,
+/// because a recognized retry refreshes the key's LRU recency while the reopen hydrates the
+/// last `dedup_lru_capacity` keys in log order. The retry is then applied a second time.
+#[tokio::test]
+async fn audit_l4_a_key_in_the_dedup_window_is_dropped_by_the_reopen() {
+    let fx = Fixture::with_options(
+        RoomLifecycleOverrides::default(),
+        |config| config.dedup_lru_capacity = 2,
+        None,
+    )
+    .await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+
+    commit(&sender, &client, mutation(1), seq(0), insert_op(1))
+        .await
+        .unwrap();
+    commit(&sender, &client, mutation(2), seq(1), insert_op(2))
+        .await
+        .unwrap();
+    // A retry of mutation 1 is recognized (and refreshes it).
+    let first_retry = commit(&sender, &client, mutation(1), seq(2), insert_op(1))
+        .await
+        .unwrap();
+    assert_eq!(first_retry.assigned_seq, seq(1));
+    commit(&sender, &client, mutation(3), seq(2), insert_op(3))
+        .await
+        .unwrap();
+    // Mutation 1 is in the window right before the reopen.
+    let before = commit(&sender, &client, mutation(1), seq(3), insert_op(1))
+        .await
+        .unwrap();
+    assert_eq!(before.assigned_seq, seq(1), "in the window before the reopen");
+
+    assert!(fx.manager.shutdown_room(&fx.room_id).await);
+    let reopened = fx.sender().await;
+    let after = commit(&reopened, &client, mutation(1), seq(3), insert_op(1))
+        .await
+        .unwrap();
+    assert_eq!(
+        after.assigned_seq,
+        seq(1),
+        "INV-L4: the reopen dropped mutation 1 from the dedup window; its retry was sequenced \
+         again as a new operation"
+    );
+    fx.manager.shutdown_all().await;
+}
+
+/// Note for §3.3 (INV-Y4), same root cause as the INV-L4 test above: without any reopen, a
+/// recognized retry of an older mutation evicts one of the last `dedup_lru_capacity` mutations,
+/// whose own retry is then sequenced again.
+#[tokio::test]
+async fn audit_note_y4_a_refreshed_retry_evicts_a_newer_mutation_from_the_window() {
+    let fx = Fixture::with_options(
+        RoomLifecycleOverrides::default(),
+        |config| config.dedup_lru_capacity = 2,
+        None,
+    )
+    .await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+    commit(&sender, &client, mutation(1), seq(0), insert_op(1))
+        .await
+        .unwrap();
+    commit(&sender, &client, mutation(2), seq(1), insert_op(2))
+        .await
+        .unwrap();
+    commit(&sender, &client, mutation(1), seq(2), insert_op(1))
+        .await
+        .unwrap();
+    commit(&sender, &client, mutation(3), seq(2), insert_op(3))
+        .await
+        .unwrap();
+    // Mutation 2 is one of the last 2 committed mutations (seqs 2 and 3).
+    let retry = commit(&sender, &client, mutation(2), seq(3), insert_op(2))
+        .await
+        .unwrap();
+    assert_eq!(retry.assigned_seq, seq(2), "the retry of mutation 2 was sequenced again");
+    fx.manager.shutdown_all().await;
+}
