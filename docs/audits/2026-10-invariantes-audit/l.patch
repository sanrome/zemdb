+    assert!(rooms_dir.join(room_id.as_str()).is_dir());
+
+    // Armed again: any later sync of rooms/ consumes it.
+    fail_point::arm("sync_dir", &rooms_dir);
+    manager
+        .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+        .await
+        .expect("the retried creation succeeds");
+    let client = zemdb_core::id::ClientId::new("writer").unwrap();
+    manager
+        .ask(&room_id, |reply| RoomCommand::RegisterClient {
+            client_id: client.clone(),
+            current_seq: None,
+            known_incarnation: None,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let row = zemdb_core::value::RowBuilder::new()
+        .set("id", 1i64)
+        .set("title", "task")
+        .build();
+    let op = crate::actor::test_support::test_schema()
+        .to_operation_insert("tasks", &row, 1000)
+        .unwrap();
+    let ack = manager
+        .ask(&room_id, |reply| RoomCommand::Commit {
+            client_id: client.clone(),
+            mutation_id: zemdb_core::id::MutationId::new([1; 16]),
+            last_ack_seq: SequenceNumber::new(0),
+            op,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(ack.assigned_seq, SequenceNumber::new(1));
+    let never_synced = fail_point::is_armed("sync_dir", &rooms_dir);
+    manager.shutdown_all().await;
+    assert!(
+        !never_synced,
+        "INV-L3: the room was created (201) and acknowledged seq 1 while its directory entry in \
+         rooms/ had never been synced; a power loss can drop the whole room"
+    );
+}
+
+/// Audit §3.7, evidence for a proposed invariant (room deletion is atomic): a deletion cut while
+/// `remove_dir_all` runs (a crash, or the `exit(1)` of a shutdown past its grace) can leave the
+/// room's log without its `meta_room.json`; a room created again with the same id then inherits
+/// the deleted room's log under its new incarnation.
+#[tokio::test]
+async fn audit_proposal_room_recreated_after_a_partial_deletion_inherits_the_old_log() {
+    let dir = tempdir().unwrap();
+    let manager = new_manager(&dir);
+    let room_id = RoomId::new("reborn").unwrap();
+    manager
+        .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+        .await
+        .unwrap();
+    let client = zemdb_core::id::ClientId::new("writer").unwrap();
+    manager
+        .ask(&room_id, |reply| RoomCommand::RegisterClient {
+            client_id: client.clone(),
+            current_seq: None,
+            known_incarnation: None,
+            reply,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    for n in 1..=3u8 {
+        let row = zemdb_core::value::RowBuilder::new()
+            .set("id", i64::from(n))
+            .set("title", "old room")
+            .build();
+        let op = crate::actor::test_support::test_schema()
+            .to_operation_insert("tasks", &row, 1000)
+            .unwrap();
+        manager
+            .ask(&room_id, |reply| RoomCommand::Commit {
+                client_id: client.clone(),
+                mutation_id: zemdb_core::id::MutationId::new([n; 16]),
+                last_ack_seq: SequenceNumber::new(0),
+                op,
+                reply,
+            })
+            .await
+            .unwrap()
+            .unwrap();
+    }
+    manager.shutdown_all().await;
+    // `remove_dir_all` removed meta_room.json before it was cut.
+    fs::remove_file(meta_room_path(&dir, &room_id)).unwrap();
+
+    let manager = new_manager(&dir);
+    manager
+        .create_room(room_id.clone(), SchemaId::new("first").unwrap(), None)
+        .await
+        .unwrap();
+    let (_, head_seq) = manager.log_bounds(&room_id).await.unwrap();
+    manager.shutdown_all().await;
+    assert_eq!(
+        head_seq,
+        SequenceNumber::new(0),
+        "a room created after a partial deletion starts with the deleted room's log"
+    );
+}
