+async fn inv_s3_torn_append_header_with_embedded_frame_refuses_to_open() {
+    let tmp = tempfile::tempdir().unwrap();
+    let dir = tmp.path().join("data");
+    let eng = engine(&dir);
+    eng.open_room(&room(), schema()).await.unwrap();
+    for seq in 1..=3 {
+        eng.apply_batch(&room(), vec![user(seq, 10)]).await.unwrap();
+    }
+    eng.close_room(&room()).await.unwrap();
+    drop(eng);
+    let wal_path = dir.join("room_sim.wal");
+    let mut wal = std::fs::read(&wal_path).unwrap();
+    let confirmed = wal.len();
+    // The batch being appended when the process crashed (never acknowledged).
+    let mut frame = encode_wal_batch(&[item_with_embedded_frame(4, 1, 1200, 1_000_000)], None).unwrap();
+    let in_first_sector = 512 - confirmed % 512;
+    frame[..in_first_sector].fill(0);
+    wal.extend_from_slice(&frame);
+    std::fs::write(&wal_path, &wal).unwrap();
+    let eng = engine(&dir);
+    let res = eng.open_room(&room(), schema()).await;
+    eprintln!("open after a torn append: {res:?}");
+    assert!(res.is_ok(), "room does not reopen after a crash while appending: {res:?}");
+    assert_eq!(eng.get_head_seq(&room()).await.unwrap().get(), 3);
+}
