+/// INV-S2: while one writer applies batches and snapshots and another task compacts, every scan
+/// of a table equals that table after some prefix of the confirmed events, and prefixes never go
+/// back.
+#[tokio::test(flavor = "multi_thread", worker_threads = 6)]
+async fn sim_readers_see_a_prefix_under_concurrent_writes_compactions_and_snapshots() {
+    let rounds: u64 = std::env::var("SIM_SEEDS").ok().and_then(|s| s.parse().ok()).unwrap_or(4);
+    for seed in 0..rounds {
+        let mut rng = Rng(9000 + seed);
+        // The events, decided up front, and the USERS table after each prefix.
+        let mut events = Vec::new();
+        for _ in 0..60 {
+            if rng.pct(8) {
+                let extra = 1 + rng.below(3);
+                let (b, s) = snapshot_ahead(&mut rng, &events, extra).await;
+                events.push(Event::Snapshot(b, s));
+            } else {
+                events.push(Event::Batch(random_batch(&mut rng, head_of(&events))));
+            }
+        }
+        let mut prefixes = Vec::new();
+        for k in 0..=events.len() {
+            let d = oracle(&events[..k]).await;
+            let users: Vec<String> = d.1.into_iter().filter(|r| r.starts_with("0:")).collect();
+            prefixes.push((d.0, users));
+        }
+        let tmp = tempfile::tempdir().unwrap();
+        let eng = DiskStorageEngine::new(
+            DiskStorageOptions::new(tmp.path()).auto_compact(true).min_compaction_bytes(512).compaction_ratio(0.5),
+        )
+        .unwrap();
+        eng.open_room(&room(), schema()).await.unwrap();
+        let done = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let prefixes = std::sync::Arc::new(prefixes);
+        let mut readers = Vec::new();
+        for _ in 0..3 {
+            let (eng, done, prefixes) = (eng.clone(), done.clone(), prefixes.clone());
+            readers.push(tokio::spawn(async move {
+                let mut last = 0usize;
+                let mut scans = 0;
+                while !done.load(std::sync::atomic::Ordering::Acquire) {
+                    let mut s = eng.scan_by_id(&room(), USERS, ScanOptions::default()).await.unwrap();
+                    let mut rows = Vec::new();
+                    while let Some(item) = s.next().await {
+                        let (pk, row) = item.unwrap();
+                        rows.push(format!("0:{pk:?}={row:?}"));
+                        tokio::task::yield_now().await;
+                    }
+                    let found = (last..prefixes.len()).find(|&k| prefixes[k].1 == rows);
+                    match found {
+                        Some(k) => last = k,
+                        None => return Err(format!("scan matches no prefix at or after {last}")),
+                    }
+                    scans += 1;
+                }
+                Ok(scans)
+            }));
+        }
+        let compactor = {
+            let (eng, done) = (eng.clone(), done.clone());
+            tokio::spawn(async move {
+                while !done.load(std::sync::atomic::Ordering::Acquire) {
+                    let _ = eng.compact_room(&room()).await;
+                    tokio::task::yield_now().await;
+                }
+            })
+        };
+        for ev in &events {
+            match ev {
+                Event::Batch(b) => {
+                    eng.apply_batch(&room(), b.clone()).await.unwrap();
+                }
+                Event::Snapshot(bytes, s) => {
+                    eng.apply_snapshot(&room(), schema(), bytes.clone().into(), SequenceNumber::from(*s))
+                        .await
+                        .unwrap();
+                }
+            }
+        }
+        done.store(true, std::sync::atomic::Ordering::Release);
+        compactor.await.unwrap();
+        for r in readers {
+            let scans = r.await.unwrap().unwrap_or_else(|e| panic!("seed {seed}: {e}"));
+            assert!(scans > 0);
+        }
+        assert_eq!(dump(&eng, &room()).await, oracle(&events).await);
+        eng.close_room(&room()).await.unwrap();
+        let eng2 = engine(tmp.path());
+        eng2.open_room(&room(), schema()).await.unwrap();
+        assert_eq!(dump(&eng2, &room()).await, oracle(&events).await);
+    }
+}
