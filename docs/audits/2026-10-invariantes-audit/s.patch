+/// INV-S4: a torn tail in the WAL that holds the unknown table is not truncated before
+/// `SchemaMismatch`, and the same applies with the table only in `.wal.compacting`.
+#[tokio::test]
+async fn inv_s4_schema_mismatch_before_truncating_a_torn_tail() {
+    let only_users = || {
+        Schema::builder()
+            .table(
+                TableSchema::builder("users")
+                    .table_id(USERS)
+                    .primary_key("id", DataType::Int)
+                    .column("name", DataType::String),
+            )
+            .build()
+    };
+    for in_compacting in [false, true] {
+        let tmp = tempfile::tempdir().unwrap();
+        let dir = tmp.path().join("data");
+        let eng = engine(&dir);
+        eng.open_room(&room(), schema()).await.unwrap();
+        eng.apply_batch(&room(), vec![user(1, 5)]).await.unwrap();
+        eng.apply_batch(&room(), vec![item_with_embedded_frame(2, 7, 3, 9)]).await.unwrap();
+        if in_compacting {
+            crate::fail_point::arm("compaction.phase2", &eng.snap_file_path(&room()));
+            assert!(eng.compact_room(&room()).await.is_err());
+            eng.apply_batch(&room(), vec![user(3, 5)]).await.unwrap();
+        }
+        eng.close_room(&room()).await.unwrap();
+        drop(eng);
+        let wal_path = dir.join("room_sim.wal");
+        let mut wal = std::fs::read(&wal_path).unwrap();
+        wal.extend_from_slice(&[0xBA, 0x7C, 1, 2, 3]); // torn header
+        std::fs::write(&wal_path, &wal).unwrap();
+        let before = files_of(&dir);
+        let eng = engine(&dir);
+        let err = eng.open_room(&room(), only_users()).await.unwrap_err();
+        assert!(matches!(err, StorageError::SchemaMismatch { table_id: ITEMS, .. }), "{err:?}");
+        assert!(files_of(&dir) == before, "files changed before SchemaMismatch");
+        eng.open_room(&room(), schema()).await.unwrap();
+        assert_eq!(
+            eng.get_head_seq(&room()).await.unwrap().get(),
+            if in_compacting { 3 } else { 2 }
+        );
+    }
+}
