+//! Audit simulation (INV-S1, INV-S2, INV-S3, INV-D3): random batches, compactions, snapshots and
+//! reopens, with a crash image or an injected I/O error at the k-th fail/pause point, checked
+//! against a `MemoryStorageEngine` oracle.
+
+use crate::disk::compactor::compacting_wal_path;
+use crate::fail_point::{CrashPlan, CRASH};
+use crate::{
+    DiskStorageEngine, DiskStorageOptions, MemoryStorageEngine, ScanOptions, StorageEngine,
+    StorageError,
+};
+use futures::StreamExt;
+use std::path::{Path, PathBuf};
+use zemdb_core::protocol::wal_frame::{decode_wal_batch_from_slice, encode_wal_batch};
+use zemdb_core::{
+    ColumnUpdate, CompactRow, DataType, Operation, PrimaryKey, RoomId, Schema, SequenceNumber,
+    SequencedOperation, TableSchema, Value, WalBatchDecodeResult,
+};
+
+// ---------------------------------------------------------------------------------------------
+// Infrastructure
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);
+        z ^ (z >> 31)
+    }
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n.max(1)
+    }
+    fn pct(&mut self, p: u64) -> bool {
+        self.below(100) < p
+    }
+}
+
+const USERS: u16 = 0;
+const ITEMS: u16 = 1;
+
+fn schema() -> Schema {
+    let users = TableSchema::builder("users")
+        .table_id(USERS)
+        .primary_key("id", DataType::Int)
+        .column("name", DataType::String);
+    let items = TableSchema::builder("items")
+        .table_id(ITEMS)
+        .primary_key("id", DataType::Int)
+        .column("data", DataType::Bytes);
+    Schema::builder().table(users).table(items).build()
+}
+
+fn room() -> RoomId {
+    RoomId::new("sim").unwrap()
+}
+
+fn engine(dir: &Path) -> DiskStorageEngine {
+    DiskStorageEngine::new(DiskStorageOptions::new(dir).auto_compact(false)).unwrap()
+}
+
+#[derive(Clone, Debug)]
+enum Event {
+    Batch(Vec<SequencedOperation>),
+    Snapshot(Vec<u8>, u64),
+}
+
+type Dump = (u64, Vec<String>);
+
+async fn dump<E: StorageEngine>(e: &E, room: &RoomId) -> Dump {
+    let head = e.get_head_seq(room).await.unwrap().get();
+    let mut rows = Vec::new();
+    for t in [USERS, ITEMS] {
+        let mut s = e.scan_by_id(room, t, ScanOptions::default()).await.unwrap();
+        while let Some(item) = s.next().await {
+            let (pk, row) = item.unwrap();
+            rows.push(format!("{t}:{pk:?}={row:?}"));
+        }
+    }
+    (head, rows)
+}
+
+async fn oracle_engine(events: &[Event]) -> MemoryStorageEngine {
+    let m = MemoryStorageEngine::new();
+    m.open_room(&room(), schema()).await.unwrap();
+    for ev in events {
+        match ev {
+            Event::Batch(ops) => {
+                m.apply_batch(&room(), ops.clone()).await.unwrap();
+            }
+            Event::Snapshot(bytes, seq) => {
+                m.apply_snapshot(
+                    &room(),
+                    schema(),
+                    bytes.clone().into(),
+                    SequenceNumber::from(*seq),
+                )
+                .await
+                .unwrap();
+            }
+        }
+    }
+    m
+}
+
+async fn oracle(events: &[Event]) -> Dump {
+    dump(&oracle_engine(events).await, &room()).await
+}
+
+fn head_of(events: &[Event]) -> u64 {
+    let mut head = 0;
+    for ev in events {
+        match ev {
+            Event::Batch(ops) => head = ops.last().map_or(head, |o| o.seq.get()),
+            Event::Snapshot(_, s) => head = *s,
+        }
+    }
+    head
+}
+
+fn random_value(rng: &mut Rng, table: u16) -> Value {
+    if table == USERS {
+        let len = if rng.pct(10) { 2000 + rng.below(3000) } else { 1 + rng.below(30) };
+        let s: String = (0..len).map(|i| (b'a' + ((i + rng.below(26)) % 26) as u8) as char).collect();
+        Value::String(s.into())
+    } else if rng.pct(30) {
+        // A valid WAL frame stored as a value.
+        let fake = SequencedOperation::new(
+            1 + rng.below(1_000_000),
+            Operation::delete(USERS, PrimaryKey::single(rng.below(50) as i64), 1),
+        );
+        Value::Bytes(encode_wal_batch(&[fake], None).unwrap().into())
+    } else {
+        let len = rng.below(64);
+        Value::Bytes((0..len).map(|_| rng.below(256) as u8).collect::<Vec<_>>().into())
+    }
+}
+
+fn random_op(rng: &mut Rng, seq: u64) -> SequencedOperation {
+    let table = if rng.pct(50) { USERS } else { ITEMS };
+    let key = rng.below(12) as i64;
+    let pk = PrimaryKey::single(key);
+    let roll = rng.below(100);
+    let op = if roll < 60 {
+        let row = CompactRow::new(vec![Value::Int(key), random_value(rng, table)]);
+        Operation::insert(table, pk, row, seq)
+    } else if roll < 85 {
+        Operation::update(table, pk, vec![ColumnUpdate::new(1, random_value(rng, table))], seq)
+    } else {
+        Operation::delete(table, pk, seq)
+    };
+    SequencedOperation::new(seq, op)
+}
+
+fn random_batch(rng: &mut Rng, head: u64) -> Vec<SequencedOperation> {
+    let n = 1 + rng.below(4);
+    (0..n).map(|i| random_op(rng, head + 1 + i)).collect()
+}
+
+/// A snapshot of the state reached from `events` plus `extra` random batches, and its head.
+async fn snapshot_ahead(rng: &mut Rng, events: &[Event], extra: u64) -> (Vec<u8>, u64) {
+    let m = oracle_engine(events).await;
+    let mut head = head_of(events);
+    for _ in 0..extra {
+        let b = random_batch(rng, head);
+        head = b.last().unwrap().seq.get();
+        m.apply_batch(&room(), b).await.unwrap();
+    }
+    (m.create_snapshot(&room()).await.unwrap(), head)
+}
+
+#[derive(Clone, Debug)]
+enum Op {
+    Batch(Vec<SequencedOperation>),
+    GapBatch(Vec<SequencedOperation>),
+    InvalidBatch(Vec<SequencedOperation>),
+    Compact,
+    SnapshotAhead(Vec<u8>, u64),
+    SnapshotBehindOrEqual(Vec<u8>, u64),
+    SnapshotWrongHead(Vec<u8>, u64),
+    Reopen,
+    FailedCompact(&'static str),
+}
+
+const COMPACTION_FAILURES: [&str; 5] = [
+    "compaction.phase2",
+    "snapshot.stage_write",
+    "compaction.phase3_rename",
+    "compaction.phase3_sync",
+    "compaction.cleanup",
+];
+
+async fn random_step(rng: &mut Rng, events: &[Event]) -> Op {
+    let head = head_of(events);
+    let roll = rng.below(100);
+    if roll < 50 {
+        Op::Batch(random_batch(rng, head))
+    } else if roll < 54 {
+        let mut b = random_batch(rng, head);
+        for o in &mut b {
+            *o = SequencedOperation::new(o.seq.get() + 1, o.op.clone());
+        }
+        Op::GapBatch(b)
+    } else if roll < 57 {
+        let mut b = random_batch(rng, head);
+        let last = b.len() - 1;
+        let seq = b[last].seq;
+        b[last] = SequencedOperation::new(seq, Operation::delete(9, PrimaryKey::single(1i64), 1));
+        Op::InvalidBatch(b)
+    } else if roll < 66 {
+        Op::Compact
+    } else if roll < 75 {
+        Op::FailedCompact(COMPACTION_FAILURES[rng.below(5) as usize])
+    } else if roll < 84 {
+        let extra = 1 + rng.below(3);
+        let (bytes, seq) = snapshot_ahead(rng, events, extra).await;
+        Op::SnapshotAhead(bytes, seq)
+    } else if roll < 88 {
+        // At the head (or behind it, from a prefix).
+        let cut = rng.below(events.len() as u64 + 1) as usize;
+        let prefix = &events[..cut];
+        let (bytes, seq) = snapshot_ahead(rng, prefix, 0).await;
+        Op::SnapshotBehindOrEqual(bytes, seq)
+    } else if roll < 90 {
+        let extra = 1 + rng.below(3);
+        let (bytes, seq) = snapshot_ahead(rng, events, extra).await;
+        Op::SnapshotWrongHead(bytes, seq)
+    } else {
+        Op::Reopen
+    }
+}
+
+fn arm(root: &Path, target: usize, dest: Option<PathBuf>, inject_error: bool) {
+    let mut g = CRASH.lock().unwrap_or_else(|e| e.into_inner());
+    g.retain(|p| p.root != root);
+    g.push(CrashPlan {
+        root: root.to_path_buf(),
+        target,
+        dest,
+        inject_error,
+        hits: Vec::new(),
+        taken: None,
+    });
+}
+
+fn disarm(root: &Path) -> Option<CrashPlan> {
+    let mut g = CRASH.lock().unwrap_or_else(|e| e.into_inner());
+    let pos = g.iter().position(|p| p.root == root)?;
+    Some(g.remove(pos))
+}
+
+fn taken(root: &Path) -> Option<&'static str> {
+    CRASH.lock().unwrap_or_else(|e| e.into_inner()).iter().find(|p| p.root == root).and_then(|p| p.taken)
+}
+
+/// Runs `op` on `engine`. Returns the result as a string-ish outcome.
+async fn run_op(
+    engine: &DiskStorageEngine,
+    op: &Op,
+) -> Result<Result<u64, StorageError>, String> {
+    let (e, r, op) = (engine.clone(), room(), op.clone());
+    let handle = tokio::spawn(async move {
+        match op {
+            Op::Batch(b) | Op::GapBatch(b) | Op::InvalidBatch(b) => {
+                e.apply_batch(&r, b).await.map(|s| s.get())
+            }
+            Op::Compact => e.compact_room(&r).await.map(|_| 0),
+            Op::FailedCompact(point) => {
+                let path = if point == "compaction.phase2" || point == "snapshot.stage_write" {
+                    e.snap_file_path(&r)
+                } else {
+                    e.wal_file_path(&r)
+                };
+                crate::fail_point::arm(point, &path);
+                let res = e.compact_room(&r).await.map(|_| 0);
+                // Disarm if the point was never reached.
+                let _ = crate::fail_point::check(point, &path);
+                res
+            }
+            Op::SnapshotAhead(bytes, seq) | Op::SnapshotBehindOrEqual(bytes, seq) => e
+                .apply_snapshot(&r, schema(), bytes.into(), SequenceNumber::from(seq))
+                .await
+                .map(|s| s.get()),
+            Op::SnapshotWrongHead(bytes, seq) => e
+                .apply_snapshot(&r, schema(), bytes.into(), SequenceNumber::from(seq + 1))
+                .await
+                .map(|s| s.get()),
+            Op::Reopen => unreachable!(),
+        }
+    });
+    match handle.await {
+        Ok(r) => Ok(r),
+        Err(e) => Err(format!("task: {e}")),
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// INV-S3: crash images at every fail/pause point
+
+static STATS: std::sync::Mutex<Vec<String>> = std::sync::Mutex::new(Vec::new());
+fn stat(s: String) {
+    STATS.lock().unwrap().push(s);
+}
+fn print_stats() {
+    let mut m = std::collections::BTreeMap::<String, usize>::new();
+    for s in STATS.lock().unwrap().drain(..) {
+        *m.entry(s).or_default() += 1;
+    }
+    for (k, v) in m {
+        eprintln!("    {v:5} {k}");
+    }
+}
+
+struct CrashCase {
+    seed: u64,
+    target: usize,
+}
+
+/// Runs the scenario of `seed` with a crash image at the `target`-th point. Returns the number
+/// of points hit (when `target` is 0, only counts) and an error description on violation.
+async fn crash_trial(case: &CrashCase, steps: usize, nested: Option<usize>) -> Result<usize, String> {
+    let tmp = tempfile::tempdir().unwrap();
+    let data = tmp.path().join("data");
+    let image = tmp.path().join("image");
+    let image2 = tmp.path().join("image2");
+    let mut rng = Rng(case.seed);
+
+    arm(&data, case.target, Some(image.clone()), false);
+    let mut eng = engine(&data);
+    let mut events: Vec<Event> = Vec::new();
+    let mut candidates: Option<(Vec<Vec<Event>>, String)> = None;
+    if let Err(e) = eng.open_room(&room(), schema()).await {
+        disarm(&data);
+        return Err(format!("initial open failed: {e}"));
+    }
+    if taken(&data).is_some() {
+        candidates = Some((vec![vec![]], "initial open".into()));
+    }
+    for step in 0..steps {
+        if candidates.is_some() {
+            break;
+        }
+        let op = random_step(&mut rng, &events).await;
+        let before = events.clone();
+        let mut after: Option<Vec<Event>> = None;
+        match &op {
+            Op::Reopen => {
+                eng.close_room(&room()).await.map_err(|e| format!("close: {e}"))?;
+                eng = engine(&data);
+                eng.open_room(&room(), schema()).await.map_err(|e| format!("reopen: {e}"))?;
+            }
+            _ => {
+                let res = run_op(&eng, &op).await?;
+                let head = head_of(&events);
+                match (&op, res) {
+                    (Op::Batch(b), Ok(h)) => {
+                        assert_eq!(h, b.last().unwrap().seq.get());
+                        let mut a = events.clone();
+                        a.push(Event::Batch(b.clone()));
+                        after = Some(a.clone());
+                        events = a;
+                    }
+                    (Op::SnapshotAhead(bytes, seq), Ok(h)) => {
+                        assert_eq!(h, *seq);
+                        let mut a = events.clone();
+                        a.push(Event::Snapshot(bytes.clone(), *seq));
+                        after = Some(a.clone());
+                        events = a;
+                    }
+                    (Op::Compact, Ok(_)) => {}
+                    (Op::FailedCompact(_), _) => {}
+                    (Op::GapBatch(_), Err(StorageError::SequenceMismatch { .. })) => {}
+                    (Op::InvalidBatch(_), Err(StorageError::TableNotFound { .. }))
+                    | (Op::InvalidBatch(_), Err(StorageError::SchemaValidation(_))) => {}
+                    (Op::SnapshotBehindOrEqual(_, seq), Ok(h)) if *seq == head && h == head => {}
+                    (Op::SnapshotBehindOrEqual(_, seq), Err(StorageError::SnapshotBehind { .. }))
+                        if *seq < head => {}
+                    (Op::SnapshotWrongHead(..), Err(StorageError::SnapshotHeadMismatch { .. })) => {}
+                    (op, res) => {
+                        disarm(&data);
+                        return Err(format!("step {step}: unexpected {res:?} for {:?}", short(op)));
+                    }
+                }
+            }
+        }
+        if let Some(name) = taken(&data) {
+            let mut c = vec![before];
+            if let Some(a) = after {
+                c.push(a);
+            }
+            let kind = short(&op).split('(').next().unwrap().to_string();
+            stat(format!("{kind} @ {name}"));
+            candidates = Some((c, format!("step {step} {:?} at {name}", short(&op))));
+        }
+        // In-memory state always equals the oracle of confirmed events (INV-S2/S1).
+        let mem = dump(&eng, &room()).await;
+        if mem != oracle(&events).await {
+            disarm(&data);
+            return Err(format!("step {step}: in-memory state differs from oracle"));
+        }
+    }
+    let plan = disarm(&data).unwrap();
+    let hits = plan.hits.len();
+    let _ = eng.close_room(&room()).await;
+    drop(eng);
+    let Some((cands, where_)) = candidates else {
+        return Ok(hits);
+    };
+
+    // Optionally crash again during the recovery of the image.
+    let mut target_dir = image.clone();
+    if let Some(k2) = nested {
+        arm(&image, k2, Some(image2.clone()), false);
+        let e2 = engine(&image);
+        let _ = e2.open_room(&room(), schema()).await;
+        let p = disarm(&image).unwrap();
+        let _ = e2.close_room(&room()).await;
+        drop(e2);
+        if let Some(n) = p.taken {
+            stat(format!("nested recovery crash @ {n}"));
+            target_dir = image2.clone();
+        }
+    }
+
+    let rec = engine(&target_dir);
+    rec.open_room(&room(), schema())
+        .await
+        .map_err(|e| format!("recovery of crash image ({where_}) failed: {e}"))?;
+    let got = dump(&rec, &room()).await;
+    let mut ok = false;
+    for c in &cands {
+        if oracle(c).await == got {
+            ok = true;
+        }
+    }
+    if !ok {
+        let want: Vec<u64> = cands.iter().map(|c| head_of(c)).collect();
+        return Err(format!(
+            "crash image ({where_}, nested={nested:?}) recovered head {} rows {}, expected one of heads {want:?}",
+            got.0,
+            got.1.len()
+        ));
+    }
+    // The recovered room keeps working and stays durable.
+    let head = got.0;
+    let b = random_batch(&mut rng, head);
+    rec.apply_batch(&room(), b.clone()).await.map_err(|e| format!("write after recovery: {e}"))?;
+    let _ = rec.compact_room(&room()).await;
+    rec.close_room(&room()).await.unwrap();
+    let rec2 = engine(&target_dir);
+    rec2.open_room(&room(), schema()).await.map_err(|e| format!("reopen after recovery: {e}"))?;
+    assert_eq!(rec2.get_head_seq(&room()).await.unwrap().get(), b.last().unwrap().seq.get());
+    Ok(hits)
+}
+
+fn short(op: &Op) -> String {
+    match op {
+        Op::Batch(b) => format!("Batch({}..={})", b[0].seq.get(), b.last().unwrap().seq.get()),
+        Op::GapBatch(_) => "GapBatch".into(),
+        Op::InvalidBatch(_) => "InvalidBatch".into(),
+        Op::Compact => "Compact".into(),
+        Op::SnapshotAhead(_, s) => format!("SnapshotAhead({s})"),
+        Op::SnapshotBehindOrEqual(_, s) => format!("SnapshotBehindOrEqual({s})"),
+        Op::SnapshotWrongHead(_, s) => format!("SnapshotWrongHead({s})"),
+        Op::Reopen => "Reopen".into(),
+        Op::FailedCompact(p) => format!("FailedCompact({p})"),
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn sim_crash_images_recover_a_confirmed_state() {
+    let seeds: u64 = std::env::var("SIM_SEEDS").ok().and_then(|s| s.parse().ok()).unwrap_or(6);
+    let steps: usize = std::env::var("SIM_STEPS").ok().and_then(|s| s.parse().ok()).unwrap_or(30);
+    let mut failures = Vec::new();
+    let mut trials = 0;
+    for seed in 1..=seeds {
+        let hits = crash_trial(&CrashCase { seed, target: 0 }, steps, None).await;
+        let hits = match hits {
+            Ok(h) => h,
+            Err(e) => {
+                failures.push(format!("seed {seed} dry run: {e}"));
+                continue;
+            }
+        };
+        let mut nrng = Rng(seed * 7919);
+        let mut set = tokio::task::JoinSet::new();
+        for target in 1..=hits {
+            let nested = if nrng.pct(50) { Some(1 + nrng.below(14) as usize) } else { None };
+            trials += 1;
+            while set.len() >= 12 {
+                if let Some(Ok(Err(e))) = set.join_next().await { failures.push(e); }
+            }
+            set.spawn(async move {
+                crash_trial(&CrashCase { seed, target }, steps, nested)
+                    .await
+                    .map(|_| ())
+                    .map_err(|e| format!("seed {seed} target {target} nested {nested:?}: {e}"))
+            });
+        }
+        while let Some(r) = set.join_next().await {
+            match r { Ok(Err(e)) => failures.push(e), Err(e) => failures.push(format!("seed {seed}: join {e}")), _ => {} }
+        }
+    }
+    eprintln!("crash trials: {trials}, failures: {}", failures.len());
+    print_stats();
+    for f in failures.iter().take(30) {
+        eprintln!("  {f}");
+    }
+    assert!(failures.is_empty());
+}
+
+// ---------------------------------------------------------------------------------------------
+// INV-S1 / INV-L3: an injected I/O error (or panic) at the k-th point
+
+async fn reopen_and_reconcile(
+    eng: &mut DiskStorageEngine,
+    data: &Path,
+    cands: &[Vec<Event>],
+) -> Result<Vec<Event>, String> {
+    let _ = eng.close_room(&room()).await;
+    *eng = engine(data);
+    let mut tries = 0;
+    loop {
+        match eng.open_room(&room(), schema()).await {
+            Ok(()) => break,
+            Err(e) if tries < 2 => {
+                tries += 1;
+                let _ = e;
+                *eng = engine(data);
+            }
+            Err(e) => return Err(format!("reopen failed: {e}")),
+        }
+    }
+    let got = dump(eng, &room()).await;
+    for c in cands {
+        if oracle(c).await == got {
+            return Ok(c.clone());
+        }
+    }
+    let want: Vec<u64> = cands.iter().map(|c| head_of(c)).collect();
+    Err(format!("after reopen head {} not in candidates {want:?}", got.0))
+}
+
+async fn error_trial(seed: u64, target: usize, steps: usize) -> Result<(usize, Option<&'static str>), String> {
+    let r = error_trial_inner(seed, target, steps).await;
+    if let Ok((_, Some(n))) = &r { stat(format!("injected @ {n}")); }
+    r
+}
+
+async fn error_trial_inner(seed: u64, target: usize, steps: usize) -> Result<(usize, Option<&'static str>), String> {
+    let tmp = tempfile::tempdir().unwrap();
+    let data = tmp.path().join("data");
+    let mut rng = Rng(seed);
+    arm(&data, target, None, true);
+    let mut eng = engine(&data);
+    if eng.open_room(&room(), schema()).await.is_err() {
+        let _ = reopen_and_reconcile(&mut eng, &data, &[vec![]]).await?;
+    }
+    let mut events: Vec<Event> = Vec::new();
+    for step in 0..steps {
+        let op = random_step(&mut rng, &events).await;
+        let head = head_of(&events);
+        if let Op::Reopen = op {
+            events = reopen_and_reconcile(&mut eng, &data, &[events.clone()]).await
+                .map_err(|e| format!("step {step} reopen: {e}"))?;
+            continue;
+        }
+        let res = run_op(&eng, &op).await;
+        let mut ambiguous: Option<Vec<Vec<Event>>> = None;
+        match (&op, res) {
+            (Op::Batch(b), Ok(Ok(h))) => {
+                if h != b.last().unwrap().seq.get() {
+                    return Err(format!("step {step}: batch Ok with head {h}"));
+                }
+                events.push(Event::Batch(b.clone()));
+            }
+            (Op::SnapshotAhead(bytes, seq), Ok(Ok(h))) if h == *seq => {
+                events.push(Event::Snapshot(bytes.clone(), *seq));
+            }
+            (Op::Compact, Ok(Ok(_))) => {}
+            (Op::FailedCompact(_), Ok(Err(StorageError::RoomFailed { .. }))) => {
+                ambiguous = Some(vec![events.clone()]);
+            }
+            (Op::FailedCompact(_), _) => {}
+            (Op::GapBatch(_), Ok(Err(StorageError::SequenceMismatch { .. }))) => {}
+            (Op::InvalidBatch(_), Ok(Err(StorageError::TableNotFound { .. })))
+            | (Op::InvalidBatch(_), Ok(Err(StorageError::SchemaValidation(_)))) => {}
+            (Op::SnapshotBehindOrEqual(_, seq), Ok(Ok(h))) if *seq == head && h == head => {}
+            (Op::SnapshotBehindOrEqual(_, seq), Ok(Err(StorageError::SnapshotBehind { .. })))
+                if *seq < head => {}
+            (Op::SnapshotWrongHead(..), Ok(Err(StorageError::SnapshotHeadMismatch { .. }))) => {}
+            (Op::Batch(b), _) => {
+                let mut a = events.clone();
+                a.push(Event::Batch(b.clone()));
+                ambiguous = Some(vec![events.clone(), a]);
+            }
+            (Op::SnapshotAhead(bytes, seq), _) => {
+                let mut a = events.clone();
+                a.push(Event::Snapshot(bytes.clone(), *seq));
+                ambiguous = Some(vec![events.clone(), a]);
+            }
+            (Op::Compact, _) if rng.pct(50) => {
+                // Keep going on the same room; a later RoomFailed is handled below.
+            }
+            (_, Ok(Err(StorageError::RoomFailed { .. }))) | (Op::Compact, _) => {
+                ambiguous = Some(vec![events.clone()]);
+            }
+            (op, res) => {
+                // An injected error turned a deterministic rejection into an I/O error.
+                if taken(&data).is_some() {
+                    ambiguous = Some(vec![events.clone()]);
+                } else {
+                    return Err(format!("step {step}: unexpected {res:?} for {}", short(op)));
+                }
+            }
+        }
+        if let Some(c) = ambiguous {
+            events = reopen_and_reconcile(&mut eng, &data, &c)
+                .await
+                .map_err(|e| format!("step {step} {} (point {:?}): {e}", short(&op), taken(&data)))?;
+        } else {
+            let mem = dump(&eng, &room()).await;
+            if mem != oracle(&events).await {
+                return Err(format!("step {step}: in-memory state differs from oracle after {}", short(&op)));
+            }
+        }
+    }
+    let plan = disarm(&data).unwrap();
+    let final_events = reopen_and_reconcile(&mut eng, &data, &[events.clone()])
+        .await
+        .map_err(|e| format!("final reopen (point {:?}): {e}", plan.taken))?;
+    let _ = final_events;
+    Ok((plan.hits.len(), plan.taken))
+}
