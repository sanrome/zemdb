+    eng.apply_batch(&room(), vec![SequencedOperation::new(2, upd)]).await.unwrap();
+    let live = eng.get_by_id(&room(), USERS, &PrimaryKey::single(1i64)).await.unwrap().unwrap();
+    eng.close_room(&room()).await.unwrap();
