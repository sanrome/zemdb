+// ---------------------------------------------------------------------------------------------
+// INV-D3: damaged WALs recover exactly a prefix, or fail without touching anything
+
+fn frame_bounds(bytes: &[u8]) -> Vec<(usize, usize, u64)> {
+    let mut out = Vec::new();
+    let mut off = 0;
+    while off < bytes.len() {
+        match decode_wal_batch_from_slice(&bytes[off..]).unwrap() {
+            WalBatchDecodeResult::Ok { ops, bytes_consumed, .. } => {
+                let last = ops.last().map_or(0, |o| o.seq.get());
+                out.push((off, off + bytes_consumed, last));
+                off += bytes_consumed;
+            }
+            other => panic!("unexpected {other:?}"),
+        }
+    }
+    out
+}
+
+fn files_of(dir: &Path) -> Vec<(String, Vec<u8>)> {
+    let mut v: Vec<_> = std::fs::read_dir(dir)
+        .unwrap()
+        .map(|e| e.unwrap())
+        .filter(|e| !e.file_name().to_string_lossy().ends_with(".lock"))
+        .map(|e| (e.file_name().to_string_lossy().into_owned(), std::fs::read(e.path()).unwrap()))
+        .collect();
+    v.sort();
+    v
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn sim_damaged_active_wal_recovers_a_prefix_or_fails_untouched() {
+    let trials: u64 = std::env::var("SIM_DAMAGE").ok().and_then(|s| s.parse().ok()).unwrap_or(400);
+    let mut failures = Vec::new();
+    for seed in 0..trials {
+        let mut rng = Rng(1000 + seed);
+        let tmp = tempfile::tempdir().unwrap();
+        let base = tmp.path().join("base");
+        let eng = engine(&base);
+        eng.open_room(&room(), schema()).await.unwrap();
+        let mut events = Vec::new();
+        let n = 2 + rng.below(8);
+        for _ in 0..n {
+            let b = random_batch(&mut rng, head_of(&events));
+            eng.apply_batch(&room(), b.clone()).await.unwrap();
+            events.push(Event::Batch(b));
+        }
+        eng.close_room(&room()).await.unwrap();
+        drop(eng);
+        let wal_path = base.join("room_sim.wal");
+        let wal = std::fs::read(&wal_path).unwrap();
+        let frames = frame_bounds(&wal);
+        assert_eq!(frames.len() as u64, n);
+
+        let trial = tmp.path().join("trial");
+        crate::fail_point::copy_dir(&base, &trial);
+        let twal = trial.join("room_sim.wal");
+        let kind = rng.below(4);
+        let p = rng.below(wal.len() as u64) as usize;
+        let mut damaged = wal.clone();
+        match kind {
+            0 => damaged.truncate(p),
+            1 => damaged[p..].iter_mut().for_each(|b| *b = 0),
+            2 => damaged[p] ^= 1 << rng.below(8),
+            _ => {
+                let end = (p + 1 + rng.below(40) as usize).min(damaged.len());
+                damaged[p..end].iter_mut().for_each(|b| *b = 0)
+            }
+        }
+        // First byte actually changed (a truncation changes the length at p).
+        let p = if kind == 0 {
+            if p == wal.len() { continue; }
+            p
+        } else {
+            match (0..wal.len()).find(|&i| damaged[i] != wal[i]) {
+                Some(i) => i,
+                None => continue,
+            }
+        };
+        std::fs::write(&twal, &damaged).unwrap();
+        let before = files_of(&trial);
+        // Frame holding p and whether valid frames follow it.
+        let idx = frames.iter().position(|(s, e, _)| p >= *s && p < *e).unwrap();
+        let rec = engine(&trial);
+        let res = rec.open_room(&room(), schema()).await;
+        let prefix_state = {
+            let mut ev = events.clone();
+            ev.truncate(idx);
+            oracle(&ev).await
+        };
+        match res {
+            Ok(()) => {
+                let got = dump(&rec, &room()).await;
+                // Last byte actually changed: frames starting after it are intact.
+                let last_changed = if kind == 0 || kind == 1 {
+                    wal.len() - 1
+                } else {
+                    (0..wal.len()).rev().find(|&i| damaged[i] != wal[i]).unwrap()
+                };
+                let last_frame_damaged = !frames.iter().any(|(s, _, _)| *s > last_changed);
+                let damage_reaches_end = kind == 0 || kind == 1;
+                if !(last_frame_damaged || damage_reaches_end) {
+                    failures.push(format!("seed {seed} kind {kind} p {p}: damage in frame {idx}/{} followed by valid frames was accepted (head {})", frames.len(), got.0));
+                } else if prefix_state != got {
+                    failures.push(format!("seed {seed} kind {kind} p {p}: recovered head {} is not the prefix before frame {idx}", got.0));
+                }
+                rec.close_room(&room()).await.unwrap();
+                let after_len = std::fs::metadata(&twal).unwrap().len() as usize;
+                if after_len != frames[idx].0 {
+                    failures.push(format!("seed {seed} kind {kind} p {p}: truncated to {after_len}, expected {}", frames[idx].0));
+                }
+            }
+            Err(StorageError::WalCorruption(_)) => {
+                if files_of(&trial) != before {
+                    failures.push(format!("seed {seed} kind {kind} p {p}: corruption changed files"));
+                }
+                let damage_reaches_end = kind == 0 || kind == 1;
+                if damage_reaches_end {
+                    failures.push(format!("seed {seed} kind {kind} p {p}: tail damage reported as corruption"));
+                } else if idx == frames.len() - 1 {
+                    // Allowed only if the damaged header hides an embedded frame.
+                    let (s, _, _) = frames[idx];
+                    if p >= s + 18 {
+                        failures.push(format!("seed {seed} kind {kind} p {p}: payload damage in the last frame reported as corruption"));
+                    }
+                }
+            }
+            Err(e) => failures.push(format!("seed {seed} kind {kind} p {p}: unexpected error {e}")),
+        }
+    }
+    eprintln!("damage trials: {trials}, failures: {}", failures.len());
+    for f in failures.iter().take(30) {
+        eprintln!("  {f}");
+    }
+    assert!(failures.is_empty());
+}
