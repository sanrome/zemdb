+/// INV-S1 at the edge of the sequence space, across a reopen and a compaction.
+#[tokio::test]
+async fn inv_s1_batch_at_u64_max_survives_reopen_and_compaction() {
+    let tmp = tempfile::tempdir().unwrap();
+    let dir = tmp.path().join("data");
+    let tables = std::collections::HashMap::from([
+        (USERS, crate::memory::Table::new()),
+        (ITEMS, crate::memory::Table::new()),
+    ]);
+    let raw = bincode::serialize(&crate::memory::RoomSnapshotRef {
+        head_seq: SequenceNumber::from(u64::MAX - 1),
+        tables: &tables,
+    })
+    .unwrap();
+    let snap = crate::snapshot::encode_snapshot_envelope(&raw, false, 0).unwrap();
+    for compact in [false, true] {
+        let _ = std::fs::remove_dir_all(&dir);
+        let eng = engine(&dir);
+        eng.open_room(&room(), schema()).await.unwrap();
+        eng.apply_snapshot(&room(), schema(), snap.clone().into(), SequenceNumber::from(u64::MAX - 1))
+            .await
+            .unwrap();
+        assert_eq!(eng.apply_batch(&room(), vec![user(u64::MAX, 3)]).await.unwrap().get(), u64::MAX);
+        let past = eng.apply_batch(&room(), vec![user(u64::MAX, 3)]).await;
+        assert!(matches!(past, Err(StorageError::SequenceMismatch { .. })), "{past:?}");
+        if compact {
+            eng.compact_room(&room()).await.unwrap();
+        }
+        eng.close_room(&room()).await.unwrap();
+        let eng = engine(&dir);
+        eng.open_room(&room(), schema()).await.unwrap();
+        assert_eq!(eng.get_head_seq(&room()).await.unwrap().get(), u64::MAX);
+    }
+}
