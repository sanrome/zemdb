+/// Audit hook: counts every fail/pause point reached under `root` and, at the `target`-th one,
+/// either copies `root` to `dest` (a crash image) or makes that point fail (an injected error).
+#[cfg(test)]
+pub(crate) struct CrashPlan {
+    pub root: std::path::PathBuf,
+    pub target: usize,
+    pub dest: Option<std::path::PathBuf>,
+    pub inject_error: bool,
+    pub hits: Vec<&'static str>,
+    pub taken: Option<&'static str>,
+}
+
+#[cfg(test)]
+pub(crate) static CRASH: std::sync::Mutex<Vec<CrashPlan>> = std::sync::Mutex::new(Vec::new());
+
+#[cfg(test)]
+pub(crate) fn copy_dir(from: &Path, to: &Path) {
+    std::fs::create_dir_all(to).unwrap();
+    for entry in std::fs::read_dir(from).unwrap() {
+        let entry = entry.unwrap();
+        if entry.file_type().unwrap().is_file() {
+            let _ = std::fs::copy(entry.path(), to.join(entry.file_name()));
+        }
+    }
+}
+
+/// Returns true if this hit must fail (error injection mode).
+#[cfg(test)]
+fn crash_point(name: &'static str, path: &Path) -> bool {
+    let mut guard = CRASH.lock().unwrap_or_else(|e| e.into_inner());
+    let Some(plan) = guard.iter_mut().find(|p| path.starts_with(&p.root)) else { return false };
+    plan.hits.push(name);
+    if plan.taken.is_none() && plan.hits.len() == plan.target {
+        plan.taken = Some(name);
+        if let Some(dest) = &plan.dest {
+            copy_dir(&plan.root, dest);
+        }
+        return plan.inject_error;
+    }
+    false
+}
