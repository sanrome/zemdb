+/// `.wal.compacting` damaged after an interrupted absorb: accepted only when the active WAL
+/// covers it; damage in its own (older) records is corruption.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn sim_damaged_compacting_wal() {
+    let trials: u64 = std::env::var("SIM_DAMAGE").ok().and_then(|s| s.parse().ok()).unwrap_or(300);
+    let mut failures = Vec::new();
+    for seed in 0..trials {
+        let mut rng = Rng(5000 + seed);
+        let tmp = tempfile::tempdir().unwrap();
+        let base = tmp.path().join("base");
+        let eng = engine(&base);
+        eng.open_room(&room(), schema()).await.unwrap();
+        let mut events = Vec::new();
+        for _ in 0..(1 + rng.below(5)) {
+            let b = random_batch(&mut rng, head_of(&events));
+            eng.apply_batch(&room(), b.clone()).await.unwrap();
+            events.push(Event::Batch(b));
+        }
+        // Leave `.wal.compacting` with these records.
+        crate::fail_point::arm("compaction.phase2", &eng.snap_file_path(&room()));
+        assert!(eng.compact_room(&room()).await.is_err());
+        let old_frames = events.len();
+        for _ in 0..(1 + rng.below(5)) {
+            let b = random_batch(&mut rng, head_of(&events));
+            eng.apply_batch(&room(), b.clone()).await.unwrap();
+            events.push(Event::Batch(b));
+        }
+        eng.close_room(&room()).await.unwrap();
+        drop(eng);
+        let wal = std::fs::read(base.join("room_sim.wal")).unwrap();
+        let cpath = compacting_wal_path(&base.join("room_sim.wal"));
+        let compacting = std::fs::read(&cpath).unwrap();
+        // The interrupted absorb: the active WAL appended, with damage somewhere in the file.
+        let mut combined = compacting.clone();
+        let absorb = rng.pct(70);
+        if absorb {
+            combined.extend_from_slice(&wal);
+        }
+        let original_combined = combined.clone();
+        let p = rng.below(combined.len() as u64) as usize;
+        let kind = rng.below(3);
+        match kind {
+            0 => combined[p] ^= 1 << rng.below(8),
+            1 => {
+                let end = (p + 1 + rng.below(40) as usize).min(combined.len());
+                combined[p..end].iter_mut().for_each(|b| *b = 0)
+            }
+            _ => combined.truncate(p),
+        }
+        let p = if kind == 2 {
+            p
+        } else {
+            match (0..combined.len()).find(|&i| combined[i] != original_combined[i]) {
+                Some(i) => i,
+                None => continue,
+            }
+        };
+        let trial = tmp.path().join("trial");
+        crate::fail_point::copy_dir(&base, &trial);
+        std::fs::write(compacting_wal_path(&trial.join("room_sim.wal")), &combined).unwrap();
+        let before = files_of(&trial);
+        let rec = engine(&trial);
+        let res = rec.open_room(&room(), schema()).await;
+        let in_old = p < compacting.len();
+        match res {
+            Ok(()) => {
+                let got = dump(&rec, &room()).await;
+                if got != oracle(&events).await {
+                    failures.push(format!(
+                        "seed {seed} kind {kind} p {p} (old part: {in_old}, absorb {absorb}): recovered head {} != {} ",
+                        got.0,
+                        head_of(&events)
+                    ));
+                }
+                let _ = old_frames;
+            }
+            Err(StorageError::WalCorruption(msg)) => {
+                if std::env::var("SIM_DEBUG").is_ok() && !in_old {
+                    let cf = frame_bounds(&original_combined);
+                    let idx = cf.iter().position(|(s, e, _)| p >= *s && p < *e);
+                    eprintln!("seed {seed} kind {kind} p {p} compacting_len {} combined_len {} frames {:?} damaged frame {:?} msg {msg}",
+                        compacting.len(), original_combined.len(), cf, idx);
+                    if let Some(i) = idx {
+                        let (s0, e0, _) = cf[i];
+                        let payload = &original_combined[s0 + 18..e0];
+                        let embedded = payload.windows(2).filter(|w| *w == [0xBA, 0x7C]).count();
+                        eprintln!("   in header: {}, magic occurrences in payload: {embedded}", p < s0 + 18);
+                    }
+                }
+                if files_of(&trial) != before {
+                    failures.push(format!("seed {seed}: corruption changed files"));
+                }
+                if !in_old && kind != 2 {
+                    // Damage in the absorbed copy is covered by the active WAL.
+                    failures.push(format!("seed {seed} kind {kind} p {p}: damage in the absorbed copy rejected"));
+                }
+                if kind == 2 && !in_old {
+                    failures.push(format!("seed {seed} p {p}: truncated absorbed copy rejected"));
+                }
+            }
+            Err(e) => failures.push(format!("seed {seed} kind {kind} p {p}: unexpected error {e}")),
+        }
+    }
+    eprintln!("compacting damage trials: {trials}, failures: {}", failures.len());
+    for f in failures.iter().take(30) {
+        eprintln!("  {f}");
+    }
+    assert!(failures.is_empty());
+}
