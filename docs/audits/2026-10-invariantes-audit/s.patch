+// ---------------------------------------------------------------------------------------------
+// INV-S3 break: a crash while absorbing leaves `.wal.compacting` torn in a way recovery refuses,
+// although the active WAL still holds every record of the damaged copy.
+
+/// An `items` row whose value holds `padding` bytes and then a complete, valid WAL frame (a
+/// value any room member can write).
+fn item_with_embedded_frame(seq: u64, key: i64, padding: usize, fake_seq: u64) -> SequencedOperation {
+    let fake = SequencedOperation::new(fake_seq, Operation::delete(USERS, PrimaryKey::single(1i64), 1));
+    let mut data = vec![b'x'; padding];
+    data.extend_from_slice(&encode_wal_batch(&[fake], None).unwrap());
+    let row = CompactRow::new(vec![Value::Int(key), Value::Bytes(data.into())]);
+    SequencedOperation::new(seq, Operation::insert(ITEMS, PrimaryKey::single(key), row, seq))
+}
+
+fn user(seq: u64, name_len: usize) -> SequencedOperation {
+    let row = CompactRow::new(vec![Value::Int(seq as i64), Value::String("u".repeat(name_len).into())]);
+    SequencedOperation::new(seq, Operation::insert(USERS, PrimaryKey::single(seq as i64), row, seq))
+}
+
+/// Builds a room whose `.wal.compacting` holds batches `1..=old` (a compaction failed before
+/// staging) and whose active WAL holds `later`, closes it, and returns the directory, the bytes
+/// of `.wal.compacting` and of the active WAL.
+async fn room_with_orphan(
+    dir: &Path,
+    old: u64,
+    later: Vec<Vec<SequencedOperation>>,
+) -> (Vec<u8>, Vec<u8>, u64) {
+    let eng = engine(dir);
+    eng.open_room(&room(), schema()).await.unwrap();
+    for seq in 1..=old {
+        eng.apply_batch(&room(), vec![user(seq, 10)]).await.unwrap();
+    }
+    crate::fail_point::arm("compaction.phase2", &eng.snap_file_path(&room()));
+    assert!(eng.compact_room(&room()).await.is_err());
+    let mut head = old;
+    for b in later {
+        head = eng.apply_batch(&room(), b).await.unwrap().get();
+    }
+    eng.close_room(&room()).await.unwrap();
+    let wal = std::fs::read(dir.join("room_sim.wal")).unwrap();
+    let compacting = std::fs::read(compacting_wal_path(&dir.join("room_sim.wal"))).unwrap();
+    (compacting, wal, head)
+}
+
+/// The `.wal.compacting` a crash leaves while `absorb_wal_into_compacting` appends `wal` to
+/// `compacting` (one write, one sync at the end): the appended copy with `damage` applied.
+fn torn_absorb(dir: &Path, compacting: &[u8], wal: &[u8], damage: impl Fn(&mut [u8])) {
+    let mut copy = wal.to_vec();
+    damage(&mut copy);
+    let mut torn = compacting.to_vec();
+    torn.extend_from_slice(&copy);
+    std::fs::write(compacting_wal_path(&dir.join("room_sim.wal")), torn).unwrap();
+}
+
+/// Crash while absorbing; the first appended sector (the bytes of the header of the first
+/// absorbed batch) did not reach the disk, later sectors did. The batch holds a value that
+/// embeds a valid frame.
+#[tokio::test]
+async fn inv_s3_torn_absorb_header_with_embedded_frame_refuses_to_open() {
+    let tmp = tempfile::tempdir().unwrap();
+    let dir = tmp.path().join("data");
+    let (compacting, wal, head) = room_with_orphan(
+        &dir,
+        3,
+        vec![vec![item_with_embedded_frame(4, 1, 1200, 1_000_000)], vec![user(5, 10)]],
+    )
+    .await;
+    // Bytes of the copy that share the 512-byte sector of the copy's first byte.
+    let in_first_sector = 512 - compacting.len() % 512;
+    torn_absorb(&dir, &compacting, &wal, |copy| copy[..in_first_sector].fill(0));
+
+    let eng = engine(&dir);
+    let res = eng.open_room(&room(), schema()).await;
+    eprintln!("open after a torn absorb: {res:?}");
+    // INV-S3: every record of the damaged copy is in the active WAL (4 and 5), so recovery
+    // should reach head 5.
+    assert!(res.is_ok(), "room does not reopen after a crash while absorbing: {res:?}");
+    assert_eq!(eng.get_head_seq(&room()).await.unwrap().get(), head);
+}
