+/// INV-Y6: "el cursor de un cliente nunca retrocede". Registering again with a lower cursor
+/// (or without one) replaces the entry and moves the cursor back.
+#[tokio::test]
+async fn audit_y6_registering_again_moves_the_cursor_back() {
+    let fx = Fixture::new(RoomLifecycleOverrides::default()).await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+    for n in 1..=3u8 {
+        commit(&sender, &client, mutation(n), seq(n as u64 - 1), insert_op(n.into()))
+            .await
+            .unwrap();
+    }
+    ack(&sender, &client, seq(3)).await.unwrap();
+    assert_eq!(cursor(&sender, &client).await, Some(seq(3)));
+
+    register_at(&sender, &client, Some((seq(1), fx.incarnation))).await;
+    let after_lower = cursor(&sender, &client).await;
+    register(&sender, &client).await;
+    let after_none = cursor(&sender, &client).await;
+    assert_eq!(
+        (after_lower, after_none),
+        (Some(seq(3)), Some(seq(3))),
+        "the cursor moved back"
+    );
+    fx.manager.shutdown_all().await;
+}
