+// ---------------------------------------------------------------------------------------------
+// AUDIT INV-Y1 / INV-Y2: simulation against an oracle vector of accepted operations.
+// ---------------------------------------------------------------------------------------------
+
+struct AuditRng(u64);
+
+impl AuditRng {
+    fn next(&mut self) -> u64 {
+        // splitmix64
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n.max(1)
+    }
+}
+
+/// An operation of a random size (a few bytes to a few KiB), so that byte limits of RAM and
+/// of the active segment cut at varying places.
+fn audit_op(seq: u64, rng: &mut AuditRng) -> SequencedOperation {
+    let len = match rng.below(10) {
+        0 => 3_000 + rng.below(3_000) as usize,
+        1..=3 => 200 + rng.below(800) as usize,
+        _ => rng.below(40) as usize,
+    };
+    let row = zemdb_core::value::CompactRow::new(vec![
+        Value::Int(seq as i64),
+        Value::Bytes(vec![(seq % 251) as u8; len].into()),
+    ]);
+    SequencedOperation::new(
+        SequenceNumber::new(seq),
+        Operation::insert(1, PrimaryKey::single(Value::Int(seq as i64)), row, seq),
+    )
+}
+
+/// Follows `has_more` from `cursor` with random batch sizes and returns the concatenation, or
+/// the first error. Panics on an empty batch flagged `has_more` (no progress) or an empty batch
+/// below the head.
+fn audit_chain(
+    log: &TieredLog,
+    cursor: u64,
+    rng: &mut AuditRng,
+) -> Result<Vec<SequencedOperation>, ServerError> {
+    let mut out: Vec<SequencedOperation> = Vec::new();
+    let mut at = cursor;
+    let mut rounds = 0;
+    loop {
+        let batch = 1 + rng.below(7) as u32;
+        let (ops, has_more) = log.fetch_deltas(SequenceNumber::new(at), batch)?;
+        assert!(ops.len() <= batch as usize, "batch over its size");
+        if at < log.head_seq().get() {
+            assert!(!ops.is_empty(), "empty batch below the head from {at}");
+        }
+        if let Some(last) = ops.last() {
+            at = last.seq.get();
+        }
+        let progressed = !ops.is_empty();
+        out.extend(ops);
+        if !has_more {
+            break;
+        }
+        assert!(progressed, "has_more without progress from {at}");
+        rounds += 1;
+        assert!(rounds < 100_000);
+    }
+    Ok(out)
+}
+
+fn audit_check(log: &TieredLog, oracle: &[SequencedOperation], rng: &mut AuditRng, step: usize) {
+    let head = log.head_seq().get();
+    let tail = log.tail_seq().get();
+    // INV-Y1: the head is the number of accepted operations, the tail is within [1, head + 1].
+    assert_eq!(head, oracle.len() as u64, "step {step}: head");
+    assert!(tail >= 1 && tail <= head + 1, "step {step}: tail {tail} head {head}");
+
+    // Cursors: every boundary plus a sample of the retained range.
+    let mut cursors = vec![tail - 1, head, head.saturating_sub(1).max(tail - 1)];
+    for segment in log.segments.iter() {
+        for c in [segment.start_seq.get() - 1, segment.start_seq.get(), segment.end_seq.get()] {
+            if c + 1 >= tail && c <= head {
+                cursors.push(c);
+            }
+        }
+    }
+    if let Some(min) = log.hot_buffer.min_seq() {
+        for c in [min.get().saturating_sub(1), min.get()] {
+            if c + 1 >= tail && c <= head {
+                cursors.push(c);
+            }
+        }
+    }
+    for _ in 0..6 {
+        cursors.push(tail - 1 + rng.below(head + 2 - tail));
+    }
+    for c in cursors {
+        let got = audit_chain(log, c, rng)
+            .unwrap_or_else(|e| panic!("step {step}: cursor {c} (tail {tail}, head {head}): {e}"));
+        let expected = &oracle[c as usize..];
+        assert!(
+            got.as_slice() == expected,
+            "step {step}: cursor {c} (tail {tail}, head {head}) got {:?}",
+            seqs(&got)
+        );
+    }
+    // Below the retained range: an explicit error, never a batch.
+    if tail >= 2 {
+        let c = rng.below(tail - 1);
+        assert!(
+            matches!(
+                log.fetch_deltas(SequenceNumber::new(c), 5),
+                Err(ServerError::BehindCompaction)
+            ),
+            "step {step}: cursor {c} below tail {tail}"
+        );
+    }
+}
+
+#[test]
+fn audit_y2_simulated_reads_reconstruct_the_exact_suffix() {
+    for seed in 0..24u64 {
+        let mut rng = AuditRng(seed.wrapping_mul(0x2545_F491_4F6C_DD1D) + 1);
+        let dir = tempdir().unwrap();
+        let policy = RoomLifecyclePolicy {
+            ram_max_ops: 1 + rng.below(6) as usize,
+            ram_max_bytes: 2_000 + rng.below(10_000),
+            segment_max_bytes: 1_500 + rng.below(8_000),
+            ram_ttl: Duration::from_secs(60),
+            warm_disk_ttl: Duration::from_secs(if rng.below(2) == 0 { 0 } else { 600 }),
+            cold_disk_ttl: Duration::from_secs(3_600),
+            max_room_disk_bytes: if rng.below(3) == 0 {
+                20_000 + rng.below(20_000)
+            } else {
+                u64::MAX / 4
+            },
+            ..RoomLifecyclePolicy::default()
+        };
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        let mut oracle: Vec<SequencedOperation> = Vec::new();
+        let mut last_tail = log.tail_seq().get();
+        for step in 0..45 {
+            match rng.below(10) {
+                0..=4 => {
+                    for _ in 0..1 + rng.below(6) {
+                        let op = audit_op(oracle.len() as u64 + 1, &mut rng);
+                        let id = MutationId::from_u128(u128::from(op.seq.get()));
+                        let outcome = log.append(op.clone(), Some(id)).unwrap();
+                        assert!(outcome.rotation_error.is_none());
+                        oracle.push(op);
+                    }
+                }
+                5 => {
+                    // RAM TTL window, compression, cold TTL (sometimes) and quota.
+                    let later = match rng.below(3) {
+                        0 => Duration::ZERO,
+                        1 => Duration::from_secs(120),
+                        _ => Duration::from_secs(7_200),
+                    };
+                    log.run_maintenance_sync_at(MaintenanceClock::after(later))
+                        .unwrap();
+                }
+                6 => {
+                    let head = log.head_seq().get();
+                    let target = 1 + rng.below(head.max(1));
+                    log.prune_older_than(SequenceNumber::new(target)).unwrap();
+                }
+                7 => {
+                    let _ = log.force_rotate_warm().unwrap();
+                }
+                _ => {
+                    drop(log);
+                    let (reopened, _) =
+                        TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+                    log = reopened;
+                }
+            }
+            let tail = log.tail_seq().get();
+            assert!(tail >= last_tail, "seed {seed} step {step}: tail moved back");
+            last_tail = tail;
+            audit_check(&log, &oracle, &mut rng, step);
+        }
+    }
+}
