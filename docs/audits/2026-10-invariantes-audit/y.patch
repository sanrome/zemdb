+// ---------------------------------------------------------------------------------------------
+// AUDIT INV-Y2 / Y4 / Y5 / Y6 / Y7 (actor level).
+// ---------------------------------------------------------------------------------------------
+
+/// INV-Y2 through the actor: commits from three clients with random cursors; every catch-up
+/// is a prefix of the oracle suffix after the cursor, and a `/sync` chain from any cursor
+/// rebuilds the exact suffix.
+#[tokio::test]
+async fn audit_y2_commit_catchup_and_sync_chains_deliver_the_exact_suffix() {
+    let fx = Fixture::new(RoomLifecycleOverrides {
+        ram_max_ops: Some(3),
+        warm_disk_ttl_secs: Some(0),
+        ..RoomLifecycleOverrides::default()
+    })
+    .await;
+    let sender = fx.sender().await;
+    let clients: Vec<ClientId> = ["a", "b", "c"]
+        .iter()
+        .map(|c| ClientId::new(*c).unwrap())
+        .collect();
+    for c in &clients {
+        register(&sender, c).await;
+    }
+    // A client that stays at cursor 0 (its lease outlives the test) holds the whole log.
+    if std::env::var("AUDIT_HOLDER").is_ok() {
+        register(&sender, &ClientId::new("holder").unwrap()).await;
+    }
+    let mut oracle: Vec<Operation> = Vec::new();
+    let mut state = 0x1234_5678_u64;
+    let mut next = || {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        state
+    };
+    // Each client's cursor only moves forward, as an honest client's does.
+    let mut cursors = [0u64; 3];
+    for n in 1..=150u64 {
+        let idx = (next() % 3) as usize;
+        let client = &clients[idx];
+        let head = oracle.len() as u64;
+        let last_ack = cursors[idx] + next() % (head - cursors[idx] + 1);
+        cursors[idx] = last_ack;
+        let op = insert_op(n as i64);
+        let resp = commit(
+            &sender,
+            client,
+            MutationId::from_u128(u128::from(n)),
+            seq(last_ack),
+            op.clone(),
+        )
+        .await
+        .unwrap();
+        oracle.push(op);
+        assert_eq!(resp.assigned_seq, seq(n));
+        let expected: Vec<(u64, Operation)> = (last_ack + 1..=n)
+            .map(|s| (s, oracle[(s - 1) as usize].clone()))
+            .collect();
+        let got: Vec<(u64, Operation)> = resp
+            .catchup_ops
+            .iter()
+            .map(|op| (op.seq.get(), op.op.clone()))
+            .collect();
+        assert!(expected.starts_with(&got), "commit {n} from {last_ack}");
+        if !resp.has_more {
+            assert_eq!(got, expected, "commit {n}: complete catch-up");
+        }
+        if n % 25 == 0 {
+            // Let the slow tick compress sealed segments.
+            tokio::time::sleep(Duration::from_millis(600)).await;
+        }
+    }
+    let reader = &clients[0];
+    let tail = metrics(&sender).await.tail_seq.get();
+    println!("tail before the sync chains: {tail}");
+    for c in [0u64, 1, 2, 3, 50, 99, 100, 148, 149, 150] {
+        let tail = metrics(&sender).await.tail_seq.get();
+        if c + 1 < tail {
+            assert!(matches!(
+                sync_from(&sender, reader, seq(c)).await,
+                Err(ServerError::BehindCompaction)
+            ));
+            continue;
+        }
+        let mut at = c;
+        let mut got = Vec::new();
+        loop {
+            let (tx, rx) = oneshot::channel();
+            sender
+                .send(RoomCommand::Sync {
+                    client_id: reader.clone(),
+                    from_seq: seq(at),
+                    max_batch_size: (1 + next() % 9) as u32,
+                    reply: tx,
+                })
+                .await
+                .unwrap();
+            let batch = rx.await.unwrap().unwrap();
+            if let Some(last) = batch.ops.last() {
+                at = last.seq.get();
+            }
+            got.extend(batch.ops.into_iter().map(|op| (op.seq.get(), op.op)));
+            if !batch.has_more {
+                break;
+            }
+        }
+        let expected: Vec<(u64, Operation)> = (c + 1..=150)
+            .map(|s| (s, oracle[(s - 1) as usize].clone()))
+            .collect();
+        assert_eq!(got, expected, "sync chain from {c}");
+    }
+    fx.manager.shutdown_all().await;
+}
