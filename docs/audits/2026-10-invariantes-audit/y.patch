+/// Operations larger than a third of a response: the byte budget cuts every batch, in every
+/// tier, and the chain still reconstructs each suffix exactly.
+#[test]
+fn audit_y2_byte_budget_cuts_never_skip_an_operation_across_tiers() {
+    let dir = tempdir().unwrap();
+    let policy = RoomLifecyclePolicy {
+        ram_max_ops: 2,
+        ram_max_bytes: MAX_LOG_BYTES_LIMIT,
+        warm_disk_ttl: Duration::ZERO,
+        ..RoomLifecyclePolicy::default()
+    };
+    let (mut log, _) = TieredLog::open_or_create(dir.path(), policy).unwrap();
+    let mut oracle = Vec::new();
+    for seq in 1..=4 {
+        let op = large_op(seq, 5 * MIB + (seq as usize) * 100 * KIB);
+        log.append(op.clone(), None).unwrap();
+        oracle.push(op);
+    }
+    // 1..=2 and 3..=4 sealed and compressed to cold.
+    log.run_maintenance_sync().unwrap();
+    for seq in 5..=7 {
+        let op = large_op(seq, 5 * MIB + (seq as usize) * 100 * KIB);
+        log.append(op.clone(), None).unwrap();
+        oracle.push(op);
+    }
+    // 5..=6 sealed warm, 7 in active.wal and RAM.
+    assert!(count_in(&log, Tier::Cold) >= 1);
+    let mut rng = AuditRng(7);
+    for c in 0..=7u64 {
+        let got = audit_chain(&log, c, &mut rng).unwrap();
+        assert!(got.as_slice() == &oracle[c as usize..], "cursor {c}: {:?}", seqs(&got));
+    }
+}
