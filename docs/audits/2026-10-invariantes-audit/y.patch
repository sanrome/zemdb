+/// INV-Y5 (literal reading): a commit rejected with `BehindCompaction` emits the SSE event
+/// `snapshot_wanted` (the room asks for a snapshot, §7.2 *Ordering*). Nothing else changes.
+#[tokio::test]
+async fn audit_y5_commit_rejected_behind_the_log_emits_snapshot_wanted() {
+    let (fx, writer, tail) = pruned_room().await;
+    let behind = seq(tail.get() - 2);
+    let stale = ClientId::new("stale").unwrap();
+    let sender = fx
+        .restart_with_roster(&[
+            (&writer, "Connected", 8),
+            (&stale, "Connected", behind.get()),
+        ])
+        .await;
+    let mut events = subscribe(&sender).await;
+    let head_before = metrics(&sender).await.head_seq;
+    let res = commit(&sender, &stale, mutation(42), behind, insert_op(42)).await;
+    assert!(matches!(res, Err(ServerError::BehindCompaction)), "{res:?}");
+    assert_eq!(metrics(&sender).await.head_seq, head_before);
+    assert_eq!(cursor(&sender, &stale).await, Some(behind));
+    let event = tokio::time::timeout(Duration::from_millis(200), events.recv()).await;
+    assert!(
+        event.is_err(),
+        "a rejected commit emitted an SSE event: {event:?}"
+    );
+    fx.manager.shutdown_all().await;
+}
