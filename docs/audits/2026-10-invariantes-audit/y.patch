+/// INV-Y2 with the log changing between pages: appends, compression, RAM TTL, cold TTL, quota
+/// and pruning run between the pages of a chain. Every page continues the cursor exactly, its
+/// `has_more` is exact, and an error is only `BehindCompaction` for a cursor behind the tail.
+#[test]
+fn audit_y2_pages_stay_exact_while_the_log_changes_between_them() {
+    for seed in 100..124u64 {
+        let mut rng = AuditRng(seed.wrapping_mul(0x9E37_79B9) + 11);
+        let dir = tempdir().unwrap();
+        let policy = RoomLifecyclePolicy {
+            ram_max_ops: 1 + rng.below(5) as usize,
+            ram_max_bytes: 1_500 + rng.below(6_000),
+            segment_max_bytes: 1_200 + rng.below(5_000),
+            ram_ttl: Duration::from_secs(60),
+            warm_disk_ttl: Duration::ZERO,
+            cold_disk_ttl: Duration::from_secs(3_600),
+            max_room_disk_bytes: 30_000 + rng.below(30_000),
+            ..RoomLifecyclePolicy::default()
+        };
+        let (mut log, _) = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap();
+        let mut oracle: Vec<SequencedOperation> = Vec::new();
+        let append = |log: &mut TieredLog, oracle: &mut Vec<SequencedOperation>, rng: &mut AuditRng| {
+            for _ in 0..1 + rng.below(4) {
+                let op = audit_op(oracle.len() as u64 + 1, rng);
+                log.append(op.clone(), None).unwrap();
+                oracle.push(op);
+            }
+        };
+        for _ in 0..10 {
+            append(&mut log, &mut oracle, &mut rng);
+        }
+        for chain in 0..30 {
+            let tail = log.tail_seq().get();
+            let head = log.head_seq().get();
+            let mut at = tail - 1 + rng.below(head + 2 - tail);
+            loop {
+                let batch = 1 + rng.below(5) as u32;
+                let (tail, head) = (log.tail_seq().get(), log.head_seq().get());
+                match log.fetch_deltas(SequenceNumber::new(at), batch) {
+                    Ok((ops, has_more)) => {
+                        let n = ops.len() as u64;
+                        assert!(
+                            ops.as_slice() == &oracle[at as usize..(at + n) as usize],
+                            "seed {seed} chain {chain}: page from {at}"
+                        );
+                        assert_eq!(has_more, at + n < head, "seed {seed}: has_more from {at}");
+                        assert!(at == head || n > 0, "seed {seed}: empty page below head");
+                        at += n;
+                        if !has_more {
+                            break;
+                        }
+                    }
+                    Err(ServerError::BehindCompaction) => {
+                        assert!(at + 1 < tail, "seed {seed}: BehindCompaction at {at}, tail {tail}");
+                        break;
+                    }
+                    Err(e) => panic!("seed {seed}: {e}"),
+                }
+                // The log moves on between pages.
+                match rng.below(8) {
+                    0 | 1 => append(&mut log, &mut oracle, &mut rng),
+                    2 => {
+                        let later = [Duration::ZERO, Duration::from_secs(120), Duration::from_secs(7_200)]
+                            [rng.below(3) as usize];
+                        log.run_maintenance_sync_at(MaintenanceClock::after(later)).unwrap();
+                    }
+                    3 => {
+                        let target = 1 + rng.below(log.head_seq().get().max(1));
+                        log.prune_older_than(SequenceNumber::new(target)).unwrap();
+                    }
+                    4 => {
+                        drop(log);
+                        log = TieredLog::open_or_create(dir.path(), policy.clone()).unwrap().0;
+                    }
+                    _ => {}
+                }
+            }
+            append(&mut log, &mut oracle, &mut rng);
+        }
+    }
+}
diff --git a/crates/storage/tests/audit_y8_convergence_tests.rs b/crates/storage/tests/audit_y8_convergence_tests.rs
new file mode 100644
index 0000000..1bca1a7
--- /dev/null
+++ b/crates/storage/tests/audit_y8_convergence_tests.rs
@@ -0,0 +1,327 @@
+//! AUDIT INV-Y8: replicas that apply the same prefix of the log converge, whether they apply
+//! every operation or restore a snapshot taken at S (by either engine) and apply the rest.
+
+mod common;
+
+use futures::StreamExt;
+use zemdb_core::*;
+use zemdb_storage::{
+    DiskStorageEngine, DiskStorageOptions, MemoryStorageEngine, ScanOptions, StorageEngine,
+};
+
+const ITEMS: u16 = 0;
+const NOTES: u16 = 1;
+
+/// `items`: composite key (Float, Int) and three nullable columns. `notes`: an Int key, a
+/// required string and a nullable float.
+fn schema() -> Schema {
+    let items = TableSchema::builder("items")
+        .table_id(ITEMS)
+        .primary_key("k", DataType::Float)
+        .primary_key("n", DataType::Int)
+        .nullable_column("a", DataType::String)
+        .nullable_column("b", DataType::Int)
+        .nullable_column("c", DataType::Float);
+    let notes = TableSchema::builder("notes")
+        .table_id(NOTES)
+        .primary_key("id", DataType::Int)
+        .column("text", DataType::String)
+        .nullable_column("w", DataType::Float);
+    Schema::builder().table(items).table(notes).build()
+}
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n
+    }
+}
+
+fn float(rng: &mut Rng) -> f64 {
+    match rng.below(7) {
+        0 => 0.0,
+        1 => -0.0,
+        2 => f64::NAN,
+        3 => f64::from_bits(f64::NAN.to_bits() | 1),
+        4 => -f64::NAN,
+        5 => 1.5,
+        _ => -2.25,
+    }
+}
+
+fn float_value(rng: &mut Rng) -> Value {
+    // `Value::Float` directly: `From<f64>` would canonicalize -0.0.
+    Value::Float(float(rng))
+}
+
+fn random_op(rng: &mut Rng) -> Operation {
+    if rng.below(2) == 0 {
+        let pk_k = float_value(rng);
+        let pk_n = Value::Int(rng.below(2) as i64);
+        let pk = PrimaryKey::composite([pk_k.clone(), pk_n.clone()]);
+        match rng.below(6) {
+            0 | 1 => {
+                // Row key columns equal (by Value::eq) to the key, maybe with other bits
+                // (0.0 vs -0.0); short rows sometimes.
+                let k_in_row = match &pk_k {
+                    Value::Float(f) if *f == 0.0 && rng.below(2) == 0 => Value::Float(-*f),
+                    other => other.clone(),
+                };
+                let mut values = vec![k_in_row, pk_n];
+                let width = rng.below(4);
+                if width >= 1 {
+                    values.push(if rng.below(3) == 0 { Value::Null } else { Value::String(format!("s{}", rng.below(3)).into()) });
+                }
+                if width >= 2 {
+                    values.push(Value::Int(rng.below(5) as i64));
+                }
+                if width >= 3 {
+                    values.push(float_value(rng));
+                }
+                Operation::insert(ITEMS, pk, CompactRow::new(values), rng.next())
+            }
+            2..=4 => {
+                let mut updates = Vec::new();
+                for idx in 2..=4u16 {
+                    if rng.below(2) == 0 {
+                        let v = match idx {
+                            2 => Value::String(format!("u{}", rng.below(3)).into()),
+                            3 => {
+                                if rng.below(4) == 0 {
+                                    Value::Null
+                                } else {
+                                    Value::Int(rng.below(9) as i64)
+                                }
+                            }
+                            _ => float_value(rng),
+                        };
+                        updates.push(ColumnUpdate::new(idx, v));
+                    }
+                }
+                if updates.is_empty() {
+                    updates.push(ColumnUpdate::new(3, Value::Int(7)));
+                }
+                Operation::update(ITEMS, pk, updates, rng.next())
+            }
+            _ => Operation::delete(ITEMS, pk, rng.next()),
+        }
+    } else {
+        let id = rng.below(4) as i64;
+        let pk = PrimaryKey::single(id);
+        match rng.below(5) {
+            0 | 1 => {
+                let mut values = vec![Value::Int(id), Value::String(format!("t{}", rng.below(3)).into())];
+                if rng.below(2) == 0 {
+                    values.push(float_value(rng));
+                }
+                Operation::insert(NOTES, pk, CompactRow::new(values), rng.next())
+            }
+            2 | 3 => {
+                let updates = if rng.below(2) == 0 {
+                    vec![ColumnUpdate::new(2, float_value(rng))]
+                } else {
+                    vec![
+                        ColumnUpdate::new(1, Value::String("x".into())),
+                        ColumnUpdate::new(2, Value::Null),
+                    ]
+                };
+                Operation::update(NOTES, pk, updates, rng.next())
+            }
+            _ => Operation::delete(NOTES, pk, rng.next()),
+        }
+    }
+}
+
+/// A value with floats spelled as bits, so that -0.0 and 0.0 (or two NaNs) are told apart.
+fn bits(v: &Value) -> String {
+    match v {
+        Value::Float(f) => format!("F{:016x}", f.to_bits()),
+        other => format!("{other:?}"),
+    }
+}
+
+type Dump = Vec<(u16, Vec<String>, Vec<String>)>;
+
+async fn dump(engine: &dyn StorageEngine, room: &RoomId) -> Dump {
+    let mut out = Vec::new();
+    for table in [ITEMS, NOTES] {
+        let mut stream = engine
+            .scan_by_id(room, table, ScanOptions::new())
+            .await
+            .unwrap();
+        while let Some(item) = stream.next().await {
+            let (pk, row) = item.unwrap();
+            out.push((
+                table,
+                pk.iter().map(bits).collect(),
+                row.iter().map(bits).collect(),
+            ));
+        }
+    }
+    out
+}
+
+async fn apply_in_batches(
+    engine: &dyn StorageEngine,
+    room: &RoomId,
+    ops: &[SequencedOperation],
+    rng: &mut Rng,
+) {
+    let mut i = 0;
+    while i < ops.len() {
+        let n = (1 + rng.below(5) as usize).min(ops.len() - i);
+        engine
+            .apply_batch(room, ops[i..i + n].to_vec())
+            .await
+            .unwrap();
+        i += n;
+    }
+}
+
+fn disk(dir: &std::path::Path) -> DiskStorageEngine {
+    DiskStorageEngine::new(DiskStorageOptions::new(dir).auto_compact(false)).unwrap()
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn audit_y8_snapshot_at_any_point_converges_with_the_full_log_in_both_engines() {
+    let room = RoomId::new("conv").unwrap();
+    for seed in 0..40u64 {
+        let mut rng = Rng(seed * 7919 + 3);
+        let len = 20 + rng.below(60);
+        let log: Vec<SequencedOperation> = (1..=len)
+            .map(|s| SequencedOperation::new(s, random_op(&mut rng)))
+            .collect();
+        for op in &log {
+            schema().validate_operation(&op.op).unwrap();
+        }
+
+        // Oracle: the whole log on a memory engine.
+        let oracle_engine = MemoryStorageEngine::new();
+        oracle_engine.open_room(&room, schema()).await.unwrap();
+        apply_in_batches(&oracle_engine, &room, &log, &mut rng).await;
+        let oracle = dump(&oracle_engine, &room).await;
+
+        // The whole log on a disk engine, then reopened (replayed from its WAL).
+        let dir = tempfile::tempdir().unwrap();
+        let full_disk = disk(dir.path());
+        full_disk.open_room(&room, schema()).await.unwrap();
+        let mid = log.len() / 2;
+        apply_in_batches(&full_disk, &room, &log[..mid], &mut rng).await;
+        full_disk.compact_room(&room).await.unwrap();
+        apply_in_batches(&full_disk, &room, &log[mid..], &mut rng).await;
+        assert_eq!(dump(&full_disk, &room).await, oracle, "seed {seed}: disk");
+        full_disk.close_room(&room).await.unwrap();
+        let full_disk = disk(dir.path());
+        full_disk.open_room(&room, schema()).await.unwrap();
+        assert_eq!(dump(&full_disk, &room).await, oracle, "seed {seed}: disk reopened");
+
+        let s = rng.below(len + 1) as usize;
+        for source_is_disk in [false, true] {
+            let src_dir = tempfile::tempdir().unwrap();
+            let src_disk = disk(src_dir.path());
+            let src_mem = MemoryStorageEngine::new();
+            let source: &dyn StorageEngine = if source_is_disk { &src_disk } else { &src_mem };
+            source.open_room(&room, schema()).await.unwrap();
+            apply_in_batches(source, &room, &log[..s], &mut rng).await;
+            let snapshot = source.create_snapshot(&room).await.unwrap();
+
+            for target_is_disk in [false, true] {
+                let dst_dir = tempfile::tempdir().unwrap();
+                let dst_disk = disk(dst_dir.path());
+                let dst_mem = MemoryStorageEngine::new();
+                let target: &dyn StorageEngine =
+                    if target_is_disk { &dst_disk } else { &dst_mem };
+                target.open_room(&room, schema()).await.unwrap();
+                target
+                    .apply_snapshot(
+                        &room,
+                        schema(),
+                        bytes::Bytes::from(snapshot.clone()),
+                        SequenceNumber::new(s as u64),
+                    )
+                    .await
+                    .unwrap_or_else(|e| panic!("seed {seed} S={s}: restore: {e}"));
+                apply_in_batches(target, &room, &log[s..], &mut rng).await;
+                assert_eq!(
+                    dump(target, &room).await,
+                    oracle,
+                    "seed {seed} S={s} source disk={source_is_disk} target disk={target_is_disk}"
+                );
+                if target_is_disk {
+                    dst_disk.close_room(&room).await.unwrap();
+                    let reopened = disk(dst_dir.path());
+                    reopened.open_room(&room, schema()).await.unwrap();
+                    assert_eq!(dump(&reopened, &room).await, oracle, "seed {seed}: reopened");
+                }
+            }
+        }
+    }
+}
+
+/// The physical width of a row depends on the schema the replica held when it applied an
+/// `Update`: same log, same logical rows, different `CompactRow`s.
+#[tokio::test]
+async fn audit_y8_update_widening_depends_on_the_schema_held_when_applying() {
+    let v1 = || {
+        let t = TableSchema::builder("t")
+            .table_id(0)
+            .primary_key("id", DataType::Int)
+            .nullable_column("a", DataType::String);
+        Schema::builder().table(t).build()
+    };
+    let v2 = || {
+        let mut s = v1();
+        s.add_column("t", ColumnDef::new("b", DataType::Int).nullable(true))
+            .unwrap();
+        s
+    };
+    let room = RoomId::new("widen").unwrap();
+    let log = vec![
+        SequencedOperation::new(
+            1,
+            Operation::insert(
+                0,
+                PrimaryKey::single(1),
+                CompactRow::new(vec![Value::Int(1), Value::String("x".into())]),
+                1,
+            ),
+        ),
+        SequencedOperation::new(
+            2,
+            Operation::update(
+                0,
+                PrimaryKey::single(1),
+                vec![ColumnUpdate::new(1, Value::String("y".into()))],
+                2,
+            ),
+        ),
+    ];
+    // A: opened before the column was added (DEF-34: it keeps v1 while open).
+    let a = MemoryStorageEngine::new();
+    a.open_room(&room, v1()).await.unwrap();
+    a.apply_batch(&room, log.clone()).await.unwrap();
+    // C: opened after it.
+    let c = MemoryStorageEngine::new();
+    c.open_room(&room, v2()).await.unwrap();
+    c.apply_batch(&room, log.clone()).await.unwrap();
+    // B: restores A's snapshot at 2 with the current schema.
+    let b = MemoryStorageEngine::new();
+    b.open_room(&room, v2()).await.unwrap();
+    let snap = a.create_snapshot(&room).await.unwrap();
+    b.apply_snapshot(&room, v2(), bytes::Bytes::from(snap), SequenceNumber::new(2))
+        .await
+        .unwrap();
+    let pk = PrimaryKey::single(1);
+    let ra = a.get_by_id(&room, 0, &pk).await.unwrap().unwrap();
+    let rb = b.get_by_id(&room, 0, &pk).await.unwrap().unwrap();
+    let rc = c.get_by_id(&room, 0, &pk).await.unwrap().unwrap();
+    println!("A (v1): {ra:?}\nB (snapshot of A, v2): {rb:?}\nC (v2): {rc:?}");
+    assert_eq!(rb, rc, "same prefix, same schema now, different rows");
+}
