+/// INV-Y7 (scope): a client that registers without a cursor and then syncs with a cursor of
+/// another incarnation is served; the incarnation is only checked at registration.
+#[tokio::test]
+async fn audit_y7_a_cursor_after_registering_without_one_is_not_checked() {
