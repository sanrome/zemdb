+/// INV-Y4: §5.1.4 promises that the cache "holds the last `dedup_lru_capacity` mutations".
+/// A retry refreshes the LRU recency of an old key, so the next new mutation evicts a newer
+/// one: here mutation 2 is among the last 2 mutations (2 and 3) and its retry is sequenced
+/// again.
+#[tokio::test]
+async fn audit_y4_retry_of_a_mutation_in_the_window_is_not_sequenced_again() {
+    let fx = Fixture::with_options(
+        RoomLifecycleOverrides::default(),
+        |config| config.dedup_lru_capacity = 2,
+        None,
+    )
+    .await;
+    let sender = fx.sender().await;
+    let client = ClientId::new("writer").unwrap();
+    register(&sender, &client).await;
+    for n in 1..=2u8 {
+        commit(&sender, &client, mutation(n), seq(0), insert_op(n.into()))
+            .await
+            .unwrap();
+    }
+    // A lost CommitAck: the client retries mutation 1 (recognised).
+    let retry1 = commit(&sender, &client, mutation(1), seq(0), insert_op(1))
+        .await
+        .unwrap();
+    assert_eq!(retry1.assigned_seq, seq(1));
+    commit(&sender, &client, mutation(3), seq(0), insert_op(3))
+        .await
+        .unwrap();
+
+    // The last two mutations are 2 and 3: a retry of 2 is inside the window.
+    let retry2 = commit(&sender, &client, mutation(2), seq(0), insert_op(2))
+        .await
+        .unwrap();
+    assert_eq!(
+        retry2.assigned_seq,
+        seq(2),
+        "retry of mutation 2 was sequenced again (head was 3)"
+    );
+    fx.manager.shutdown_all().await;
+}
+
