diff --git a/crates/server/src/actor/command.rs b/crates/server/src/actor/command.rs
index ac4d6af..79292ac 100644
--- a/crates/server/src/actor/command.rs
+++ b/crates/server/src/actor/command.rs
@@ -86,6 +86,9 @@ pub struct RoomMetrics {
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub enum RoomEvent {
     HeadAdvanced(SequenceNumber),
+    /// Performance spike: a committed operation, encoded once and in base64, sent instead of
+    /// `HeadAdvanced` when `ZEMDB_PERF_SSE_OPS` is set.
+    OpsAppended(SequenceNumber, std::sync::Arc<str>),
     SchemaReloaded(SchemaId),
     /// A client was designated to upload a snapshot. Carries no data: a client learns whether
     /// it is the designee from its next heartbeat.
diff --git a/crates/server/src/actor/room.rs b/crates/server/src/actor/room.rs
index d1e9ce5..6a65cd8 100644
--- a/crates/server/src/actor/room.rs
+++ b/crates/server/src/actor/room.rs
@@ -575,7 +575,16 @@ impl RoomActor {
         // the client Connected. Persisted on the next maintenance tick.
         self.observe(client_id, Some(last_ack_seq));
 
-        let _ = self.events_tx.send(RoomEvent::HeadAdvanced(new_seq));
+        static SSE_OPS: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        let event = if *SSE_OPS.get_or_init(|| std::env::var_os("ZEMDB_PERF_SSE_OPS").is_some()) {
+            use base64::Engine;
+            let bytes = zemdb_core::encode_message(&seq_op).unwrap_or_default();
+            let data = base64::engine::general_purpose::STANDARD.encode(bytes);
+            RoomEvent::OpsAppended(new_seq, data.into())
+        } else {
+            RoomEvent::HeadAdvanced(new_seq)
+        };
+        let _ = self.events_tx.send(event);
 
         // Catch-up for 1-RTT synchronization.
         let reservation = self.reserve_frame(client_id);
diff --git a/crates/server/src/api/sse.rs b/crates/server/src/api/sse.rs
